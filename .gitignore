# Scratch / inbox — Yoshi's local workspaces, not part of the project source
_scratch/
_inbox/
scratch_xref_*/

# Local agent / editor config — not project source
.claude/

# S175 — sandbox-probe leftovers from the cowork-mount permission test.
# The mount allowed create + overwrite but blocked delete, so these two
# 0-byte / marker files were left behind and can only be removed from
# the Mac side. Safe to `rm app/_writetest app/_dirtest` whenever.
app/_writetest
app/_dirtest

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets — NEVER commit
.env
.env.local
.env.*.local
*.pem
*.key

# Android signing keystore — S174. The keystore file contains the
# private key that signs Android .apk / .aab releases. Losing it OR
# leaking it would compromise the ability to ship signed updates.
# The SHA-256 fingerprint of the public cert IS public (it lives in
# app/public/.well-known/assetlinks.json) — only the keystore file
# itself stays out of git.
_signing/
*.keystore
*.jks

# S191 — APKs now ship via GitHub Releases, not git. Repo stays under
# GitHub's 100 MB file limit; bandwidth/storage quotas don't apply to
# Releases assets. Landing.tsx download link points at
# /releases/latest/download/remnant-bible.apk which auto-resolves to
# the most recently published release.
*.apk
*.aab

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
dist/
build/
*.tar.gz
bible-companion.zip

# Logs
*.log
logs/

# Restoration pipeline validation reports — regenerated on each run
restoration-pipeline/validation-reports/*.txt
restoration-pipeline/validation-reports/*.json

# Pre-patch backup snapshots of parsed JSONs (kept locally for safety, not version control)
source-texts/parsed/*.pre-*

# Large unparsed source texts — parsed/ JSONs are committed; raw sources can be re-fetched
# (Uncomment if source-texts/ grows past comfortable repo size)
# source-texts/extras/
# source-texts/strongs-greek/
# source-texts/strongs-hebrew/
# source-texts/kjv/
# Outputs scratchpad — local-only by default; spec-gating render artifacts (Phase_*.html)
# commit so they survive session boundaries (locked S160 after S159's BDB sample-render
# was lost to the session-scratchpad / project-outputs naming collision).
outputs/*
!outputs/Phase_*.html
.~lock.*#
