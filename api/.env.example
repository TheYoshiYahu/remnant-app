# Copy to .env (gitignored) and edit values for local dev.

# Postgres connection string consumed by asyncpg.
# Example: postgres://yoshi:secret@localhost:5432/remnant_app
DATABASE_URL=postgres://localhost:5432/remnant_app

# Path to the four parsed Restored Names JSON files seed.py loads.
# Defaults to ../source-texts/parsed/ relative to api/ if unset.
PARSED_JSON_DIR=../source-texts/parsed

# Path to schema.sql, applied by `python seed.py --bootstrap`.
SCHEMA_SQL_PATH=../data-schema/schema.sql

# CORS origin(s) the API trusts. PWA dev server, prod subdomain, etc.
# Comma-separated.
CORS_ORIGINS=http://localhost:5173,https://bible.remnantofpromise.org
