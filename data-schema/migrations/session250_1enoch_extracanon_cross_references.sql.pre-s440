   AND sv.edition_slug='enoch' AND sv.book_slug='1-enoch' AND sv.chapter_number=25 AND sv.verse_number=2
   AND tv.edition_slug='canon' AND tv.book_slug='jude' AND tv.chapter_number=1 AND tv.verse_number=6
