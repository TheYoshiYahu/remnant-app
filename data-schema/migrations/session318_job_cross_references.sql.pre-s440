-- ----- fragment: minion_job_14.sql (Job 14) -----
-- Job chapter 14 — man's brief days and the resurrection question
-- tag: job14  |  session prefix: s318  |  temp view: _s318_job14_lookup
-- slug prefix: job-14-...  |  sort_order band start: 33125 (+1 per thread)
-- source book_slug=job, chapter 14
--
-- THREADS (4):
--   33125 job-14-man-of-few-days-is-as-a-flower-cut-down         [free + EXTRAS]
--         (Job 14:1-2 -> Ps90:5-6, Ps103:15-16, Isa40:6-8, James1:10-11, 1Pet1:24, +Sirach14:17)
--   33126 job-14-is-there-hope-of-a-tree-if-it-be-cut-down       [EXTRAS]
--         (Job 14:7-12 -> Wisdom2:1, Wisdom2:5; the tree's hope vs man's death, dark counter-voice)
--   33127 job-14-if-a-man-die-shall-he-live-again-the-resurrection-question  [free + EXTRAS]
--         (Job 14:13-14 -> Job19:25, Job19:26, Dan12:2, John5:28, John5:29, 1Cor15:51, 1Cor15:52, +2Esdras7:32)
--   33128 job-14-thou-shalt-call-and-i-will-answer-the-work-of-thine-hands   [free + EXTRAS]
--         (Job 14:15 -> Job19:27, +Wisdom3:1, +Wisdom3:4; longing for reunion with the Creator)
--
-- GUARD: 14:14's question ("If a man die, shall he live again?") is asked in genuine darkness
--   (vv.10-12 say man lieth down and riseth not till the heavens be no more). The answer
--   (resurrection) is the CANON'S FORWARD reply -- Job's own later confession (19:25-26),
--   Daniel 12:2, John 5:28-29, 1 Cor 15 -- NOT Job's present certainty. "my change" = the
--   resurrection transformation (1 Cor 15:51-52, "we shall all be changed"). The suffering of
--   the righteous is held honestly; the hope is the canon answering across the dark.
--
-- Job 14 coverage:
--   v.1-2  (few days / flower cut down / fleeth as a shadow)
--          NT:     James1:10-11 (flower of grass passeth away), 1Pet1:24 (all flesh is as grass) -> threaded
--          Extras: Sirach14:17-18 (all flesh waxeth old as a garment; green leaves on a thick tree) -> threaded
--          Tanakh: Ps90:5-6, Ps103:15-16, Isa40:6-8 (grass/flower withereth) -> threaded
--   v.3-6  (judgment on such an one / clean out of unclean / appointed bounds / hireling's day)
--          NT: none warranted   Extras: none warranted   Tanakh: folded into v.1-2 frailty thread (hireling = 14:6)
--   v.7-9  (hope of a tree, if cut down it will sprout again)
--          NT:     none warranted   Extras: Wisdom2:5 (after our end no returning) as dark contrast -> threaded
--          Tanakh: contrast held within Job 14 (tree's hope vs man v.10) -> threaded
--   v.10-12 (man dieth and wasteth away; lieth down and riseth not till heavens be no more)
--          NT:     none warranted (resurrection answer carried in v.13-14 thread)
--          Extras: Wisdom2:1 (no man known to have returned from the grave) -> threaded (the darkness)
--          Tanakh: bound to v.7-9 (the contrast) and v.13-14 (the question)
--   v.13-14 (hide me in the grave... If a man die, shall he live again? till my change come) ** keystone **
--          NT:     John5:28-29 (all in the graves shall hear his voice), 1Cor15:51-52 (we shall all be changed) -> threaded
--          Extras: 2Esdras7:32 (earth shall restore those asleep in her; dust those in silence) -> threaded
--          Tanakh: Job19:25-26 (my redeemer liveth... in my flesh shall I see), Dan12:2 (sleep in dust shall awake) -> threaded
--   v.15   (Thou shalt call, and I will answer; desire to the work of thine hands)
--          NT:     none warranted   Extras: Wisdom3:1,4 (souls of the righteous in the hand of God; hope full of immortality) -> threaded
--          Tanakh: Job19:27 (whom I shall see for myself) -> threaded
--   v.16-22 (numberest my steps / transgression sealed in a bag / mountain falling / destroyest hope of man / his flesh shall have pain)
--          NT: none warranted   Extras: none warranted   Tanakh: frailty/judgment folded into v.1-2 & v.7-12 threads

CREATE TEMP VIEW _s318_job14_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================ B. cross_references ============================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: man of few days, as a flower cut down (14:1-2)
    ('canon','job',14,2, 'canon','psalms',90,5, 'free',
      E'*Thou carriest them away as with a flood; they are as a sleep: in the morning they are like grass which groweth up* (Psalm 90:5). Moses'' psalm sings what Job groans -- *he cometh forth like a flower, and is cut down* (Job 14:2). The same brevity: man flourishes a morning and is gone.'),
    ('canon','job',14,2, 'canon','psalms',90,6, 'free',
      E'*In the morning it flourisheth, and groweth up; in the evening it is cut down, and withereth* (Psalm 90:6). The flower of Job 14:2 -- *he cometh forth like a flower, and is cut down* -- is the grass of Psalm 90: up by morning, withered by night, the measure of mortal days.'),
    ('canon','job',14,2, 'canon','psalms',103,15, 'free',
      E'*As for man, his days are as grass: as a flower of the field, so he flourisheth* (Psalm 103:15). David names Job''s very image -- the flower of the field. *He cometh forth like a flower, and is cut down* (Job 14:2); but Psalm 103 sets the frailty against *the mercy of Yahuah... from everlasting to everlasting* (103:17).'),
    ('canon','job',14,2, 'canon','psalms',103,16, 'free',
      E'*For the wind passeth over it, and it is gone; and the place thereof shall know it no more* (Psalm 103:16). Job''s flower *fleeth also as a shadow, and continueth not* (Job 14:2) -- the wind passes, the place forgets. Frail dust, held only by the Father who *remembereth that we are dust* (Ps 103:14).'),
    ('canon','job',14,2, 'canon','isaiah',40,6, 'free',
      E'*The voice said, Cry. And he said, What shall I cry? All flesh is grass, and all the goodliness thereof is as the flower of the field* (Isaiah 40:6). Isaiah cries Job''s lament forward into the comfort of Yahuah: man is grass, *he cometh forth like a flower, and is cut down* (Job 14:2).'),
    ('canon','job',14,2, 'canon','isaiah',40,8, 'free',
      E'*The grass withereth, the flower fadeth: but the word of our Elohim (God) shall stand for ever* (Isaiah 40:8). Here Job''s grief meets its answer: the flower of Job 14:2 fades, yet *the word of our Elohim shall stand for ever*. Frail man passes; the covenant word does not.'),
    ('canon','job',14,2, 'canon','james',1,10, 'free',
      E'*But the rich, in that he is made low: because as the flower of the grass he shall pass away* (James 1:10). James lifts Job''s figure into apostolic warning -- *he cometh forth like a flower, and is cut down* (Job 14:2); riches and stature fade as the flower of the grass.'),
    ('canon','job',14,2, 'canon','james',1,11, 'free',
      E'*For the sun is no sooner risen with a burning heat, but it withereth the grass, and the flower thereof falleth... so also shall the rich man fade away in his ways* (James 1:11). The flower *cut down* of Job 14:2 is the flower whose grace perishes under the sun in James -- man''s glory does not endure.'),
    ('canon','job',14,2, 'canon','1-peter',1,24, 'free',
      E'*For all flesh is as grass, and all the glory of man as the flower of grass. The grass withereth, and the flower thereof falleth away* (1 Peter 1:24). Peter quotes Isaiah back over Job''s very lament -- *he cometh forth like a flower, and is cut down* (Job 14:2) -- then turns to the hope: *But the word of Yahuah endureth for ever* (1:25).'),
    ('canon','job',14,2, 'apocrypha','ecclesiasticus',14,17, 'extras',
      E'*All flesh waxeth old as a garment: for the covenant from the beginning is, You shall die the death* (Sirach 14:17). Ben Sira reads Job''s frailty as the Eden-sentence -- man wears out like cloth. *He cometh forth like a flower, and is cut down: he fleeth also as a shadow* (Job 14:2): the appointed end of all flesh.'),
    -- Thread 2: is there hope of a tree, if it be cut down (14:7-12)
    ('canon','job',14,7, 'apocrypha','the-wisdom-of-solomon',2,5, 'extras',
      E'*For our time is a very shadow that passeth away; and after our end there is no returning: for it is fast sealed, so that no man comes again* (Wisdom 2:5). The ungodly in Wisdom say what Job feels in the dark -- the tree may sprout, *but man dieth, and wasteth away... and where is he?* (Job 14:7,10). Wisdom voices the despair that 14:14 will dare to question.'),
    ('canon','job',14,10, 'apocrypha','the-wisdom-of-solomon',2,1, 'extras',
      E'*Our life is short and tedious, and in the death of a man there is no remedy: neither was there any man known to have returned from the grave* (Wisdom 2:1). This is the dark verdict Job wrestles -- *man dieth, and wasteth away: yea, man giveth up the ghost, and where is he?* (Job 14:10). The canon records the darkness honestly before it answers it.'),
    -- Thread 3: if a man die, shall he live again -- the resurrection question (14:13-14)
    ('canon','job',14,14, 'canon','job',19,25, 'free',
      E'*For I know that my redeemer liveth, and that he shall stand at the latter day upon the earth* (Job 19:25). Job''s own later confession answers his own question: the man who asked *If a man die, shall he live again?* (14:14) comes to *know* his Goel lives and shall stand at the last day.'),
    ('canon','job',14,14, 'canon','job',19,26, 'free',
      E'*And though after my skin worms destroy this body, yet in my flesh shall I see Elohim (God)* (Job 19:26). The change Job waits for in 14:14 -- *till my change come* -- is named five chapters on: though the body rot, *in my flesh shall I see Elohim*. The resurrection hope rising out of the same sufferer.'),
    ('canon','job',14,14, 'canon','daniel',12,2, 'free',
      E'*And many of them that sleep in the dust of the earth shall awake, some to everlasting life, and some to shame and everlasting contempt* (Daniel 12:2). Job lay man down to *not awake, nor be raised out of their sleep* (14:12) and then asked *shall he live again?* (14:14). Daniel speaks the awakening from the dust that Job longed to see.'),
    ('canon','job',14,14, 'canon','john',5,28, 'free',
      E'*Marvel not at this: for the hour is coming, in the which all that are in the graves shall hear his voice* (John 5:28). The grave where Job begged to be hidden (14:13) is not the end: the Formed Son declares the hour when all in the graves hear his voice -- the direct answer to *If a man die, shall he live again?* (14:14).'),
    ('canon','job',14,14, 'canon','john',5,29, 'free',
      E'*And shall come forth; they that have done good, unto the resurrection of life; and they that have done evil, unto the resurrection of damnation* (John 5:29). Job''s question (14:14) is answered with the two resurrections -- coming forth from the graves, as Daniel foretold (Dan 12:2), some to life and some to contempt.'),
    ('canon','job',14,14, 'canon','1-corinthians',15,51, 'free',
      E'*Behold, I shew you a mystery; We shall not all sleep, but we shall all be changed* (1 Corinthians 15:51). Job waited *till my change come* (14:14); Paul names that change a mystery now revealed -- not all sleep, but all are changed. The very word Job groped for in the dark.'),
    ('canon','job',14,14, 'canon','1-corinthians',15,52, 'free',
      E'*In a moment, in the twinkling of an eye, at the last trump: for the trumpet shall sound, and the dead shall be raised incorruptible, and we shall be changed* (1 Corinthians 15:52). *Till my change come* (Job 14:14) lands here -- the dead raised incorruptible at the last trump. Job''s appointed waiting answered in the twinkling of an eye.'),
    ('canon','job',14,14, 'apocrypha','2-esdras',7,32, 'extras',
      E'*And the earth shall restore those that are asleep in her, and so shall the dust those that dwell in silence, and the secret places shall deliver those souls that were committed to them* (2 Esdras 7:32). The Second-Temple hope speaks Job''s answer plainly -- the dust that swallowed the dead gives them back. *If a man die, shall he live again?* (Job 14:14): the earth shall restore those asleep in her.'),
    -- Thread 4: thou shalt call, and I will answer -- the work of thine hands (14:15)
    ('canon','job',14,15, 'canon','job',19,27, 'free',
      E'*Whom I shall see for myself, and mine eyes shall behold, and not another; though my reins be consumed within me* (Job 19:27). The reunion Job longs for in 14:15 -- *Thou shalt call, and I will answer thee* -- becomes his confessed hope: to see Elohim for himself, with his own eyes, the Creator desiring again the work of his hands.'),
    ('canon','job',14,15, 'apocrypha','the-wisdom-of-solomon',3,1, 'extras',
      E'*But the souls of the righteous are in the hand of Yahuah (God), and there shall no torment touch them* (Wisdom 3:1). Job''s plea -- *thou wilt have a desire to the work of thine hands* (14:15) -- is met by Wisdom''s assurance: the righteous are held in the hand of Yahuah, not abandoned to the grave.'),
    ('canon','job',14,15, 'apocrypha','the-wisdom-of-solomon',3,4, 'extras',
      E'*For though they be punished in the sight of men, yet is their hope full of immortality* (Wisdom 3:4). Against the seeming destruction of the righteous, Wisdom answers Job''s longing for reunion (14:15) -- their hope is *full of immortality*. The desire of the Creator for the work of his hands does not die with the body.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job14_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job14_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================ C. threads ============================
-- Thread 1 (33125) -- free? NO: contains Sirach (extras) -> tier extras
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-14-man-of-few-days-is-as-a-flower-cut-down',
       E'Man of Few Days, as a Flower Cut Down',
       E'*Man that is born of a woman is of few days, and full of trouble. He cometh forth like a flower, and is cut down: he fleeth also as a shadow, and continueth not* (Job 14:1-2). Job names the universal frailty, and the whole canon sings it back. Moses: *they are like grass which groweth up; in the morning it flourisheth, and groweth up; in the evening it is cut down, and withereth* (Psalm 90:5-6). David: *As for man, his days are as grass: as a flower of the field, so he flourisheth. For the wind passeth over it, and it is gone* (Psalm 103:15-16) -- yet held by Him who *remembereth that we are dust*. Isaiah turns the lament into comfort: *All flesh is grass... The grass withereth, the flower fadeth: but the word of our Elohim (God) shall stand for ever* (Isaiah 40:6,8). James and Peter carry Job''s flower into apostolic teaching -- *as the flower of the grass he shall pass away* (James 1:10); *all flesh is as grass, and all the glory of man as the flower of grass* (1 Peter 1:24). Ben Sira reads it as the Eden-sentence: *All flesh waxeth old as a garment: for the covenant from the beginning is, You shall die the death* (Sirach 14:17). Frail man fades; the word of Yahuah does not.',
       sv.verse_id, ev.verse_id, 'extras', 33125
  FROM _s318_job14_lookup sv, _s318_job14_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=14 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=14 AND ev.verse_number=2
ON CONFLICT (slug) DO NOTHING;

-- Thread 2 (33126) -- extras (Wisdom)
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-14-is-there-hope-of-a-tree-if-it-be-cut-down',
       E'Is There Hope of a Tree, If It Be Cut Down',
       E'*For there is hope of a tree, if it be cut down, that it will sprout again, and that the tender branch thereof will not cease. Though the root thereof wax old in the earth... yet through the scent of water it will bud* (Job 14:7-9). The tree has hope: cut down, it sprouts again at the scent of water. Then the contrast cuts: *But man dieth, and wasteth away: yea, man giveth up the ghost, and where is he?* (Job 14:10). *So man lieth down, and riseth not: till the heavens be no more, they shall not awake* (14:12). Job stands in genuine darkness here -- the tree''s sprouting only sharpens the question of man''s silence. The same despairing voice is recorded in Wisdom on the lips of the ungodly: *Our life is short and tedious, and in the death of a man there is no remedy: neither was there any man known to have returned from the grave* (Wisdom 2:1); *our time is a very shadow that passeth away; and after our end there is no returning: for it is fast sealed, so that no man comes again* (Wisdom 2:5). The canon does not hide the darkness; it lets the sufferer ask honestly, before the resurrection answer breaks (14:14; Job 19:25-26).',
       sv.verse_id, ev.verse_id, 'extras', 33126
  FROM _s318_job14_lookup sv, _s318_job14_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=14 AND sv.verse_number=7
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=14 AND ev.verse_number=12
ON CONFLICT (slug) DO NOTHING;

-- Thread 3 (33127) -- extras (2 Esdras)
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-14-if-a-man-die-shall-he-live-again-the-resurrection-question',
       E'If a Man Die, Shall He Live Again -- the Resurrection Question',
       E'*O that thou wouldest hide me in the grave... until thy wrath be past, that thou wouldest appoint me a set time, and remember me! If a man die, shall he live again? all the days of my appointed time will I wait, till my change come* (Job 14:13-14). This is the great question, asked in the dark -- Job has just said man *lieth down, and riseth not* (14:12). He does not yet know the answer; he waits for it. And the canon answers him forward. From his own mouth, chapters later: *I know that my redeemer liveth, and that he shall stand at the latter day upon the earth... yet in my flesh shall I see Elohim (God)* (Job 19:25-26). Daniel sees the awakening: *many of them that sleep in the dust of the earth shall awake, some to everlasting life* (Daniel 12:2). The Formed Son declares the hour: *all that are in the graves shall hear his voice, and shall come forth; they that have done good, unto the resurrection of life* (John 5:28-29). Paul names the change Job waited for: *We shall not all sleep, but we shall all be changed, in a moment, in the twinkling of an eye, at the last trump... and the dead shall be raised incorruptible, and we shall be changed* (1 Corinthians 15:51-52). The Second-Temple hope says it plainly: *the earth shall restore those that are asleep in her, and so shall the dust those that dwell in silence* (2 Esdras 7:32). *My change* is the resurrection transformation -- the answer to a question asked across the grave.',
       sv.verse_id, ev.verse_id, 'extras', 33127
  FROM _s318_job14_lookup sv, _s318_job14_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=14 AND sv.verse_number=13
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=14 AND ev.verse_number=14
ON CONFLICT (slug) DO NOTHING;

-- Thread 4 (33128) -- extras (Wisdom)
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-14-thou-shalt-call-and-i-will-answer-the-work-of-thine-hands',
       E'Thou Shalt Call, and I Will Answer -- the Work of Thine Hands',
       E'*Thou shalt call, and I will answer thee: thou wilt have a desire to the work of thine hands* (Job 14:15). Out of the darkness rises the deepest longing -- not merely to live again, but to be wanted again by the Creator, to be called and to answer, the Maker desiring the work of his own hands. Job''s confessed hope reaches the same end: *Whom I shall see for myself, and mine eyes shall behold, and not another* (Job 19:27) -- the reunion of the creature with his Elohim, face to face. Wisdom answers the longing against all appearance of loss: *the souls of the righteous are in the hand of Yahuah (God), and there shall no torment touch them* (Wisdom 3:1); *though they be punished in the sight of men, yet is their hope full of immortality* (Wisdom 3:4). The Father does not forget the work of his hands; the desire is mutual, and it does not die in the grave.',
       sv.verse_id, ev.verse_id, 'extras', 33128
  FROM _s318_job14_lookup sv, _s318_job14_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=14 AND sv.verse_number=15
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=14 AND ev.verse_number=15
ON CONFLICT (slug) DO NOTHING;

