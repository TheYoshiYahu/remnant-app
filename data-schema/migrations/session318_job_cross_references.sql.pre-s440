-- Thread 5 members (KEYSTONE)
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('job',33,23,1,E'*An interpreter, one among a thousand* (Job 33:23) — Elihu names the mediator Job sought.'),
    ('job',33,24,2,E'*I have found a ransom* (Job 33:24) — the daysman is the ransom-bearer.'),
    ('1-timothy',2,5,3,E'*One mediator between Elohim (God) and men, the man HaMashiach Yahusha* (1 Timothy 2:5) — the ONE who lays his hand on both, Yahuah-of-the-Name AND the man, never a co-equal trinity.'),
    ('hebrews',8,6,4,E'*The mediator of a better covenant* (Hebrews 8:6) — the Torah written on the heart, not replaced.'),
    ('hebrews',9,15,5,E'*The mediator of the new testament... the promise of eternal inheritance* (Hebrews 9:15) — the daysman whose death redeems.')
  ) AS m(tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN _s318_job09_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=9 AND sv.verse_number=33
  JOIN _s318_job09_lookup tv ON tv.edition_slug='canon' AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
  JOIN cross_reference_threads t ON t.slug='job-9-neither-is-there-any-daysman-betwixt-us'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_10.sql (Job 10) -----
-- Book: Job  Chapter: 10  (Job's soul weary of life — "I will speak in the bitterness of my soul")
-- Session prefix: s318   Tag: job10   Slug prefix: job-10-...
-- Sort band start: 33025 (+1 per thread)
-- Temp view: _s318_job10_lookup
--
-- THREADS (3):
--   1. job-10-thine-hands-have-made-me-the-clay-the-creator-who-formed-me-in-the-womb  [extras]
--        Job 10:8,9,11,12 -> Psalm 139:13, Jeremiah 1:5, Isaiah 64:8, Genesis 2:7,
--        Wisdom of Solomon 7:2 (extras), 2 Maccabees 7:23 (extras)
--        targets: Tanakh (Psalm/Jeremiah/Isaiah/Genesis) + Extras (Wisdom, 2 Maccabees)
--   2. job-10-wilt-thou-bring-me-into-dust-again-the-dust-returns-the-spirit-to-elohim  [free]
--        Job 10:9 -> Genesis 3:19, Ecclesiastes 12:7, Psalm 104:29
--        targets: Tanakh only
--   3. job-10-the-thing-formed-answering-him-that-formed-it-the-potter-over-the-clay  [free]
--        Job 10:8 -> Isaiah 64:8, Romans 9:20 (NT forward)
--        targets: Tanakh + NT
--
-- Per-chapter coverage:
--   v.1-2 (weary of life / I will speak in bitterness):
--        NT:     none warranted (lament idiom; carried in thread summaries)
--        Extras: none warranted
--        Tanakh: none warranted (Job 7:11 same-book idiom; not threaded)
--   v.3-7 (despise the work of thine hands / eyes of flesh / searchest my sin):
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: work-of-thine-hands seed carried into thread 1 (v.8)
--   v.8 (Thine hands have made me and fashioned me together):
--        NT:     Romans 9:20 (the thing formed) -> thread 3
--        Extras: none warranted at v.8 directly
--        Tanakh: Isaiah 64:8 (clay/potter) -> threads 1 & 3
--   v.9 (made me as the clay; bring me into dust again):
--        NT:     none warranted directly (potter/clay -> thread 3 via v.8)
--        Extras: none warranted
--        Tanakh: Genesis 3:19 / Ecclesiastes 12:7 / Psalm 104:29 (dust-return) -> thread 2
--   v.10-12 (poured me out as milk, curdled as cheese / clothed with skin and flesh /
--           granted me life and favour, thy visitation preserved my spirit):
--        NT:     none warranted (forming-in-womb -> handled via thread 1 weave)
--        Extras: Wisdom of Solomon 7:1-2 (fashioned in womb, compacted in blood),
--                2 Maccabees 7:22-23 (the Creator formed the members, gives breath/life again) -> thread 1
--        Tanakh: Psalm 139:13-16, Jeremiah 1:5 (formed in the belly) -> thread 1
--   v.13-17 (hid in thine heart / markest me / huntest me as a fierce lion):
--        NT:     none warranted (lament; not threaded)
--        Extras: none warranted
--        Tanakh: none warranted
--   v.18-19 (brought me forth out of the womb / carried from the womb to the grave):
--        NT:     none warranted
--        Extras: none warranted (womb-forming weight already on thread 1)
--        Tanakh: none warranted (Job 3:11 same-book; not threaded)
--   v.20-22 (take comfort a little / land of darkness and the shadow of death):
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: none warranted (the longing carried in thread 1/2 summary prose)
--
-- GUARD: the clay/potter forming = Yahuah the Creator who fashioned Job (the Formed Son the
--   agent of creation per the framework); the lament is HONEST, not faithless — Job pleads WITH
--   the hands that made him, never denies them. Father is NOT made a man. Extras 2 Maccabees
--   carries resurrection-hope (give breath and life AGAIN), the forward answer to the dust-fear.

CREATE TEMP VIEW _s318_job10_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: the Creator who formed me in the womb (Job 10:8-12)
    ('canon','job',10,9,'canon','psalms',139,13,'free',
     E'*For thou hast possessed my reins: thou hast covered me in my mother''s womb.* (Psalm 139:13) Job''s plea *thou hast made me as the clay* (Job 10:9) is the very confession David sings — the same hand that wove him in secret. The Creator who formed the inward parts is the One Job now beseeches.'),
    ('canon','job',10,9,'canon','jeremiah',1,5,'free',
     E'*Before I formed thee in the belly I knew thee; and before thou camest forth out of the womb I sanctified thee* (Jeremiah 1:5). The forming hand of Job 10 — *Thine hands have made me and fashioned me together round about* (Job 10:8) — is the same hand that knew Jeremiah before the belly: Yahuah forms each in the womb and ordains the life.'),
    ('canon','job',10,8,'canon','isaiah',64,8,'free',
     E'*But now, O Yahuah (LORD), thou art our father; we are the clay, and thou our potter; and we all are the work of thy hand.* (Isaiah 64:8) Job names himself *as the clay* (Job 10:9); Isaiah names the whole people the same — the potter and the clay, the work of his hand, the relation Job pleads from even in the bitterness of his soul.'),
    ('canon','job',10,11,'canon','genesis',2,7,'free',
     E'*And Yahuah Elohim (the LORD God) formed man of the dust of the ground, and breathed into his nostrils the breath of life; and man became a living soul.* (Genesis 2:7) Job''s *thou hast clothed me with skin and flesh, and hast fenced me with bones and sinews* (Job 10:11) recounts that first forming made personal — the Former of Adam from dust is the Former of Job in the womb.'),
    ('canon','job',10,11,'apocrypha','the-wisdom-of-solomon',7,2,'extras',
     E'*And in my mother''s womb was fashioned to be flesh in the time of ten months, being compacted in blood, of the seed of man* (Wisdom of Solomon 7:2). Solomon''s wisdom describes the same hidden craft Job marvels at — *Hast thou not poured me out as milk, and curdled me like cheese? Thou hast clothed me with skin and flesh* (Job 10:10-11): the flesh compacted, fashioned, clothed in the womb by the Creator''s hand.'),
    ('canon','job',10,12,'apocrypha','2-maccabees',7,23,'extras',
     E'*But doubtless the Creator of the world, who formed the generation of man, and found out the beginning of all things, will also of his own mercy give you breath and life again* (2 Maccabees 7:23). The mother of the seven sons confesses the very Creator Job confesses — *Thou hast granted me life and favour, and thy visitation hath preserved my spirit* (Job 10:12) — and carries it forward past the dust-fear: the One who formed will give breath and life AGAIN.'),
    -- THREAD 2: wilt thou bring me into dust again (Job 10:9)
    ('canon','job',10,9,'canon','genesis',3,19,'free',
     E'*In the sweat of thy face shalt thou eat bread, till thou return unto the ground; for out of it wast thou taken: for dust thou art, and unto dust shalt thou return.* (Genesis 3:19) Job''s dread *and wilt thou bring me into dust again?* (Job 10:9) reaches back to the sentence on Adam — dust to dust — the curse of mortality every son of Adam carries.'),
    ('canon','job',10,9,'canon','ecclesiastes',12,7,'free',
     E'*Then shall the dust return to the earth as it was: and the spirit shall return unto Elohim (God) who gave it.* (Ecclesiastes 12:7) The Preacher answers Job''s fear of the dust: the dust returns, yes — but the spirit returns to the One who gave it. *Thy visitation hath preserved my spirit* (Job 10:12) is held even in the dust.'),
    ('canon','job',10,9,'canon','psalms',104,29,'free',
     E'*Thou hidest thy face, they are troubled: thou takest away their breath, they die, and return to their dust.* (Psalm 104:29) The whole creation returns to dust at the withdrawing of the Creator''s breath — the same Creator whose hands made Job, who now seems to *bring me into dust again* (Job 10:9).'),
    -- THREAD 3: the thing formed answering him that formed it (Job 10:8)
    ('canon','job',10,8,'canon','romans',9,20,'free',
     E'*Nay but, O man, who art thou that repliest against Elohim (God)? Shall the thing formed say to him that formed it, Why hast thou made me thus?* (Romans 9:20) Job''s honest cry *Thine hands have made me and fashioned me together round about; yet thou dost destroy me* (Job 10:8) is the very question of the thing formed to its Former — and the answer is the potter''s right over the clay, the relation Job never denies even as he pleads.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job10_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job10_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- THREAD 1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-10-thine-hands-have-made-me-the-clay-the-creator-who-formed-me-in-the-womb',
       E'Thine Hands Have Made Me: the Creator Who Formed Me as the Clay in the Womb',
       E'Even in the bitterness of his soul Job does not deny the hand that made him — he pleads WITH it. *Thine hands have made me and fashioned me together round about; yet thou dost destroy me* (Job 10:8); *Remember, I beseech thee, that thou hast made me as the clay* (Job 10:9); *Thou hast clothed me with skin and flesh, and hast fenced me with bones and sinews. Thou hast granted me life and favour, and thy visitation hath preserved my spirit* (Job 10:11-12). This is the womb-forming Creator — the Formed Son the agent of all making — the same hand that *covered me in my mother''s womb* (Psalm 139:13), that knew Jeremiah *before I formed thee in the belly* (Jeremiah 1:5), the *potter* of whom *we are the clay... and we all are the work of thy hand* (Isaiah 64:8), who *formed man of the dust of the ground, and breathed into his nostrils the breath of life* (Genesis 2:7). The restored witnesses marvel at the same hidden craft: *in my mother''s womb was fashioned to be flesh in the time of ten months, being compacted in blood* (Wisdom of Solomon 7:2). And it does not end in dust: *the Creator of the world, who formed the generation of man... will also of his own mercy give you breath and life again* (2 Maccabees 7:23). The hand that fashioned the clay holds the power to raise it.',
       sv.verse_id, ev.verse_id, 'extras', 33025
  FROM _s318_job10_lookup sv, _s318_job10_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=10 AND sv.verse_number=8
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=10 AND ev.verse_number=12
ON CONFLICT (slug) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-10-wilt-thou-bring-me-into-dust-again-the-dust-returns-the-spirit-to-elohim',
       E'Wilt Thou Bring Me Into Dust Again: the Dust Returns, the Spirit to Elohim',
       E'Job''s dread is the dread of every son of Adam: *Remember, I beseech thee, that thou hast made me as the clay; and wilt thou bring me into dust again?* (Job 10:9). It reaches back to the sentence in the garden — *dust thou art, and unto dust shalt thou return* (Genesis 3:19) — the curse of mortality on the flesh. The Preacher answers the fear: *Then shall the dust return to the earth as it was: and the spirit shall return unto Elohim (God) who gave it* (Ecclesiastes 12:7) — the dust goes down, but the spirit is not lost; it returns to its Giver. So too the Psalmist: *Thou hidest thy face, they are troubled: thou takest away their breath, they die, and return to their dust* (Psalm 104:29). The breath that animates the clay is the Creator''s to give and to take — and Job has already confessed that *thy visitation hath preserved my spirit* (Job 10:12).',
       sv.verse_id, ev.verse_id, 'free', 33026
  FROM _s318_job10_lookup sv, _s318_job10_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=10 AND sv.verse_number=9
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=10 AND ev.verse_number=9
ON CONFLICT (slug) DO NOTHING;

-- THREAD 3
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-10-the-thing-formed-answering-him-that-formed-it-the-potter-over-the-clay',
       E'The Thing Formed Answering Him That Formed It: the Potter Over the Clay',
       E'Job''s cry is the cry of the clay to its Former: *Thine hands have made me and fashioned me together round about; yet thou dost destroy me* (Job 10:8). It is honest, not faithless — he names the relation even as he pleads under it: *we are the clay, and thou our potter; and we all are the work of thy hand* (Isaiah 64:8). The apostle frames the same relation forward: *Nay but, O man, who art thou that repliest against Elohim (God)? Shall the thing formed say to him that formed it, Why hast thou made me thus?* (Romans 9:20). The potter holds power over the clay — and the wonder of Job is that the One who formed him is the One he runs TO, not from. The hand that fashioned the vessel is the hand that holds its hope.',
       sv.verse_id, ev.verse_id, 'free', 33027
  FROM _s318_job10_lookup sv, _s318_job10_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=10 AND sv.verse_number=8
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=10 AND ev.verse_number=8
ON CONFLICT (slug) DO NOTHING;

-- MEMBERS — THREAD 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*thou hast covered me in my mother''s womb* (Psalm 139:13) — the same hand that wove Job in secret.'
  FROM cross_reference_threads t
  JOIN _s318_job10_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=10 AND sv.verse_number=9
