INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*the tears of such as were oppressed... no comforter* (Ecclesiastes 4:1) — the trouble Job''s grave escapes: the weary at rest from the voice of the oppressor.'
