-- Thread 1 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('job',14,2, 'canon','psalms',90,5,  1, E'*they are as a sleep: in the morning they are like grass which groweth up* (Psalm 90:5) -- Moses'' frailty matches Job''s flower.'),
    ('job',14,2, 'canon','psalms',90,6,  2, E'*in the evening it is cut down, and withereth* (Psalm 90:6) -- up by morning, withered by night, the measure of Job''s days.'),
    ('job',14,2, 'canon','psalms',103,15, 3, E'*his days are as grass: as a flower of the field, so he flourisheth* (Psalm 103:15) -- David names Job''s very image.'),
    ('job',14,2, 'canon','psalms',103,16, 4, E'*the wind passeth over it, and it is gone; and the place thereof shall know it no more* (Psalm 103:16) -- the shadow that continueth not.'),
    ('job',14,2, 'canon','isaiah',40,6,  5, E'*All flesh is grass, and all the goodliness thereof is as the flower of the field* (Isaiah 40:6) -- the lament cried forward into comfort.'),
    ('job',14,2, 'canon','isaiah',40,8,  6, E'*The grass withereth, the flower fadeth: but the word of our Elohim shall stand for ever* (Isaiah 40:8) -- the frailty answered by the abiding word.'),
    ('job',14,2, 'canon','james',1,10,  7, E'*as the flower of the grass he shall pass away* (James 1:10) -- Job''s flower lifted into apostolic warning.'),
    ('job',14,2, 'canon','james',1,11,  8, E'*the flower thereof falleth... so also shall the rich man fade away* (James 1:11) -- man''s glory withers under the sun.'),
    ('job',14,2, 'canon','1-peter',1,24, 9, E'*all flesh is as grass, and all the glory of man as the flower of grass* (1 Peter 1:24) -- Peter quotes Isaiah over Job''s lament.'),
    ('job',14,2, 'apocrypha','ecclesiasticus',14,17, 10, E'*All flesh waxeth old as a garment* (Sirach 14:17) -- Ben Sira reads the frailty as the Eden-sentence.')
  ) AS m(src_slug,src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-14-man-of-few-days-is-as-a-flower-cut-down'
  JOIN _s318_job14_lookup sv ON sv.edition_slug='canon' AND sv.book_slug=m.src_slug AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job14_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

