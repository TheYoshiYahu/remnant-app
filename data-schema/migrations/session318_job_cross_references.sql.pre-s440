INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*It is he that sitteth upon the circle of the earth... that stretcheth out the heavens as a curtain* (Isaiah 40:22) — the same Creator who hangs the earth on nothing stretches the heavens like a tent.'
  FROM cross_reference_threads t
  JOIN _s318_job26_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=26 AND sv.verse_number=7
  JOIN _s318_job26_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='isaiah' AND tv.chapter_number=40 AND tv.verse_number=22
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-26-he-hangeth-the-earth-upon-nothing'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

