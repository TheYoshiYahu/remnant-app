-- ----- fragment: minion_job_26.sql (Job 26) -----
-- Chapter: Job 26 — Job's reply: the Creator's cosmic majesty
-- Tag: job26   Session prefix: s318   Temp view: _s318_job26_lookup
-- Sort band: 33425..33428 (one per thread)
-- Source book_slug=job, chapter 26 (edition canon)
--
-- Per-chapter coverage checklist (weighed all three libraries per verse-block):
--   v.1-6  (Job rebukes Bildad; Sheol/Abaddon naked before him)
--          NT:     none warranted   Extras: none warranted
--          Tanakh: lateral covered downstream in v.7+ majesty hymn — no standalone thread
--   v.7    He hangeth the earth upon nothing
--          NT:     none warranted (Heb 1 weighed — not a creation-suspension verse)
--          Extras: none warranted (Sirach 43 reserved for v.14 unsearchability)
--          Tanakh: Isaiah 40:22 (circle/stretched heavens), Psalm 104:5 (foundations not removed),
--                  Job 38:4-6 (where wast thou when I laid the foundations) → THREAD 1
--   v.8-10 He bindeth up the waters in his thick clouds; compassed the waters with bounds
--          NT:     none warranted   Extras: none warranted
--          Tanakh: Proverbs 30:4 (who hath bound the waters in a garment + his son's name),
--                  Psalm 104:6-9 (deep as a garment, a bound they may not pass),
--                  Job 38:8-11 (hitherto shalt thou come no further), Proverbs 8:29 (gave the sea
--                  his decree), Jeremiah 5:22 (sand for the bound of the sea) → THREAD 2
--   v.11   The pillars of heaven tremble at his reproof
--          (folded into THREAD 1/2 majesty; no standalone — adequately carried)
--   v.12-13 He divideth the sea / smiteth the proud / his hand hath formed the crooked serpent
--          NT:     Revelation 12:9 + Revelation 20:2 (the old serpent crushed) → THREAD 3
--          Extras: none warranted as MEMBER (chaoskampf carried by canon witnesses)
--          Tanakh: Psalm 74:13-14 (brakest the heads of the dragons / leviathan),
--                  Isaiah 51:9 (cut Rahab, wounded the dragon), Isaiah 27:1 (leviathan that crooked
--                  serpent slain), Genesis 3:15 frame, Proverbs 8:22-30 (Formed Wisdom agent) → THREAD 3
--   v.14   How little a portion is heard of him / the thunder of his power who can understand
--          NT:     Romans 11:33 (how unsearchable his judgments, ways past finding out)
--          Extras: Sirach 43:31-32 (who has seen him / hid greater things than these) [Ecclesiasticus]
--          Tanakh: Isaiah 40:28 (no searching of his understanding), Ecclesiastes 3:11 (cannot find
--                  out the work Elohim maketh) → THREAD 4 (EXTRAS, has Sirach member)
--
-- GUARD applied: the One who hangs the earth on nothing, garnishes the heavens, and FORMS/smites
-- the crooked serpent is the Formed Son — the agent of creation (Prov 8 Wisdom brought forth,
-- by him all things) — who HAS a Father (Prov 30:4 "what is his name, and what is his son's name").
-- NOT the Father made flesh, NOT a co-equal trinitarian person. The crooked serpent he formed and
-- smites = the chaos-power subdued at creation, the same dragon/leviathan, ultimately the old
-- serpent of Genesis 3:15 crushed at Revelation 20 — Yahuah's sovereign mastery, never a rival deity.
--
-- Threads (slug — target libraries):
--   1 job-26-he-hangeth-the-earth-upon-nothing            (Tanakh)            FREE   band 33425
--   2 job-26-he-bindeth-the-waters-in-his-thick-clouds    (Tanakh)            FREE   band 33426
--   3 job-26-his-hand-hath-formed-the-crooked-serpent     (Tanakh + NT)       FREE   band 33427
--   4 job-26-the-thunder-of-his-power-who-can-understand  (Tanakh + NT + Extras) EXTRAS band 33428


-- ===================================================================
-- A. TEMP VIEW
-- ===================================================================
CREATE TEMP VIEW _s318_job26_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');


-- ===================================================================
-- B. cross_references
-- ===================================================================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
  -- THREAD 1: v.7 earth hung upon nothing -------------------------------------------------
  ('canon','job',26,7,'canon','isaiah',40,22,'free',
   E'*It is he that sitteth upon the circle of the earth, and the inhabitants thereof are as grasshoppers; that stretcheth out the heavens as a curtain, and spreadeth them out as a tent to dwell in* (Isaiah 40:22). Job''s *He stretcheth out the north over the empty place, and hangeth the earth upon nothing* (Job 26:7) is the same Creator Isaiah names — the One enthroned above the circle of the earth who stretches the heavens like a tent. The earth is not propped on a beast or a pillar of the nations'' myths; it hangs on his word alone.'),
  ('canon','job',26,7,'canon','psalms',104,5,'free',
   E'*Who laid the foundations of the earth, that it should not be removed for ever* (Psalm 104:5). The earth that *hangeth upon nothing* (Job 26:7) is held immovable not by any support beneath it but by the will of the One who *laid the foundations* — the suspension and the stability are both his hand.'),
  ('canon','job',26,7,'canon','job',38,4,'free',
   E'*Where wast thou when I laid the foundations of the earth? declare, if thou hast understanding* (Job 38:4). What Job confesses in worship here — *He... hangeth the earth upon nothing* (Job 26:7) — Yahuah turns back on Job from the whirlwind, demanding the same wonder be felt as humility. The cosmos Job praises is the cosmos no man counselled or measured.'),

  -- THREAD 2: v.8-10 waters bound in clouds, sea's bound ----------------------------------
  ('canon','job',26,8,'canon','proverbs',30,4,'free',
   E'*Who hath ascended up into heaven, or descended? who hath gathered the wind in his fists? who hath bound the waters in a garment? who hath established all the ends of the earth? what is his name, and what is his son''s name, if thou canst tell?* (Proverbs 30:4). Job''s *He bindeth up the waters in his thick clouds; and the cloud is not rent under them* (Job 26:8) is Agur''s very riddle — the One who binds the waters above. And Agur lets the answer slip: this Maker has a *son'' s name* — the Formed Son, the agent of creation, who has a Father.'),
  ('canon','job',26,8,'canon','psalms',104,6,'free',
   E'*Thou coveredst it with the deep as with a garment: the waters stood above the mountains. At thy rebuke they fled; at the voice of thy thunder they hasted away* (Psalm 104:6-7). The Psalm sings the same wonder Job names — the waters *bound up in his thick clouds* (Job 26:8) and held above without bursting, governed by his thunder and not their own weight.'),
  ('canon','job',26,10,'canon','job',38,8,'free',
   E'*Or who shut up the sea with doors, when it brake forth, as if it had issued out of the womb?... And said, Hitherto shalt thou come, but no further: and here shall thy proud waves be stayed?* (Job 38:8,11). Job''s *He hath compassed the waters with bounds* (Job 26:10) is answered out of the whirlwind: the sea has a decreed boundary it cannot cross, doors the Creator set against the deep.'),
  ('canon','job',26,10,'canon','proverbs',8,29,'free',
   E'*When he gave to the sea his decree, that the waters should not pass his commandment: when he appointed the foundations of the earth* (Proverbs 8:29). The bound Job confesses — *He hath compassed the waters with bounds, until the day and night come to an end* (Job 26:10) — is the very decree Wisdom watched the Creator lay upon the sea before the foundations of the earth.'),
  ('canon','job',26,10,'canon','jeremiah',5,22,'free',
   E'*Fear ye not me? saith Yahuah (LORD)... which have placed the sand for the bound of the sea by a perpetual decree, that it cannot pass it: and though the waves thereof toss themselves, yet can they not prevail; though they roar, yet can they not pass over it* (Jeremiah 5:22). The same boundary Job marvels at — *He hath compassed the waters with bounds* (Job 26:10) — Jeremiah turns into a rebuke: the sea trembles at the decree, but rebellious Israel will not.'),

  -- THREAD 3: v.12-13 sea divided, proud smitten, crooked serpent formed -------------------
  ('canon','job',26,12,'canon','psalms',74,13,'free',
   E'*Thou didst divide the sea by thy strength: thou brakest the heads of the dragons in the waters. Thou brakest the heads of leviathan in pieces* (Psalm 74:13-14). Job''s *He divideth the sea with his power, and by his understanding he smiteth through the proud* (Job 26:12) is the same creation-victory: the Creator parting the waters and crushing the chaos-monster''s heads — the proud subdued at the dividing of the sea.'),
  ('canon','job',26,13,'canon','isaiah',51,9,'free',
   E'*Awake, awake, put on strength, O arm of Yahuah (LORD)... Art thou not it that hath cut Rahab, and wounded the dragon?* (Isaiah 51:9). When Job says *his hand hath formed the crooked serpent* (Job 26:13), the same arm that fashioned the deep''s great creature is the arm that wounds the dragon — the Creator''s mastery over the chaos-power, never a rival to it.'),
  ('canon','job',26,13,'canon','isaiah',27,1,'free',
   E'*In that day Yahuah (LORD) with his sore and great and strong sword shall punish leviathan the piercing serpent, even leviathan that crooked serpent; and he shall slay the dragon that is in the sea* (Isaiah 27:1). Job''s *crooked serpent* (Job 26:13) — the very phrase — is the leviathan the Creator formed and will at last slay. What his hand made, his sword subdues; the chaos-beast is wholly under him.'),
  ('canon','job',26,13,'canon','revelation',12,9,'free',
   E'*And the great dragon was cast out, that old serpent, called the Devil, and Satan, which deceiveth the whole world: he was cast out into the earth* (Revelation 12:9). The *crooked serpent* whose form was under the Creator''s hand (Job 26:13) is unmasked at the end as *that old serpent* of Eden — the dragon the Formed Son casts down. The enmity of Genesis 3:15 runs from the dividing of the sea to the casting out of the deceiver.'),
  ('canon','job',26,13,'canon','revelation',20,2,'free',
   E'*And he laid hold on the dragon, that old serpent, which is the Devil, and Satan, and bound him a thousand years* (Revelation 20:2). The crooked serpent the Creator''s *hand hath formed* (Job 26:13) is the dragon bound and at last cast into the lake of fire — the chaos-power that was always under his hand, finally and forever crushed (Genesis 3:15).'),
  ('canon','job',26,13,'canon','proverbs',8,22,'free',
   E'*Yahuah (LORD) possessed me in the beginning of his way, before his works of old... When he prepared the heavens, I was there: when he set a compass upon the face of the depth* (Proverbs 8:22,27). Job says *By his spirit he hath garnished the heavens; his hand hath formed the crooked serpent* (Job 26:13). The hand that garnishes the heavens and forms the deep''s creature is the Formed One — the Wisdom brought forth before the works of old, the Son by whom the heavens were prepared, who has a Father.'),

  -- THREAD 4: v.14 the unsearchable Creator ----------------------------------------------
  ('canon','job',26,14,'canon','romans',11,33,'free',
   E'*O the depth of the riches both of the wisdom and knowledge of Elohim (God)! how unsearchable are his judgments, and his ways past finding out!* (Romans 11:33). Job''s *Lo, these are parts of his ways: but how little a portion is heard of him? but the thunder of his power who can understand?* (Job 26:14) is the same confession the apostle reaches — the cosmic majesty just rehearsed is only the fringe of his ways, the rest beyond all searching.'),
  ('canon','job',26,14,'canon','isaiah',40,28,'free',
   E'*Hast thou not known? hast thou not heard, that El Olam (the everlasting God), Yahuah (LORD), the Creator of the ends of the earth, fainteth not, neither is weary? there is no searching of his understanding* (Isaiah 40:28). Job''s *how little a portion is heard of him* (Job 26:14) meets Isaiah''s *there is no searching of his understanding* — the Creator whose works fill the sky is himself unsearchable to the mind he made.'),
  ('canon','job',26,14,'canon','ecclesiastes',3,11,'free',
   E'*He hath made every thing beautiful in his time: also he hath set the world in their heart, so that no man can find out the work that Elohim (God) maketh from the beginning to the end* (Ecclesiastes 3:11). Job confesses the limit Qoheleth confesses — *but how little a portion is heard of him* (Job 26:14): man perceives the parts, but the whole work of the Maker, beginning to end, is past finding out.'),
  ('canon','job',26,14,'apocrypha','ecclesiasticus',43,31,'extras',
   E'*Who has seen him, that he might tell us? and who can magnify him as he is?... There are yet hid greater things than these be, for we have seen but a few of his works* (Sirach 43:31-32). Ben Sira closes his own creation-hymn exactly where Job does — *how little a portion is heard of him?* (Job 26:14). All the cosmic wonders are *but a few of his works*; the thunder of his power remains beyond the telling.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job26_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job26_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;


-- ===================================================================
-- C. cross_reference_threads
-- ===================================================================

-- THREAD 1 ------------------------------------------------------------
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-26-he-hangeth-the-earth-upon-nothing',
  E'He hangeth the earth upon nothing',
  E'Job, replying to Bildad, lifts his eyes off the quarrel and onto the Creator: *He stretcheth out the north over the empty place, and hangeth the earth upon nothing* (Job 26:7). The earth is propped on no beast, no pillar of the nations'' myths — it hangs on his word. Isaiah names the same Maker: *It is he that sitteth upon the circle of the earth... that stretcheth out the heavens as a curtain, and spreadeth them out as a tent to dwell in* (Isaiah 40:22). The Psalm sings the stability that follows the suspension — *Who laid the foundations of the earth, that it should not be removed for ever* (Psalm 104:5) — and out of the whirlwind Yahuah turns the wonder into humility: *Where wast thou when I laid the foundations of the earth? declare, if thou hast understanding* (Job 38:4). The cosmos Job praises is the cosmos no man counselled or measured. The hand that hangs the earth on nothing is the Formed Son, the agent of creation, who has a Father — never a rival, never the formless Source made visible by accident.',
  sv.verse_id, ev.verse_id, 'free', 33425
  FROM _s318_job26_lookup sv, _s318_job26_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=26 AND sv.verse_number=7
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=26 AND ev.verse_number=7
ON CONFLICT (slug) DO NOTHING;

-- THREAD 2 ------------------------------------------------------------
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-26-he-bindeth-the-waters-in-his-thick-clouds',
  E'He bindeth the waters, and set the sea its bound',
  E'Two acts of mastery over the waters frame Job''s hymn. Above: *He bindeth up the waters in his thick clouds; and the cloud is not rent under them* (Job 26:8) — the seas held aloft without bursting. Below: *He hath compassed the waters with bounds, until the day and night come to an end* (Job 26:10) — the deep fenced behind a line it cannot cross. Agur asks the riddle whose answer is this same Maker: *who hath bound the waters in a garment?... what is his name, and what is his son''s name, if thou canst tell?* (Proverbs 30:4) — and the Maker''s *son''s name* surfaces, the Formed Son who has a Father. The Psalm echoes the clouds and the rebuke that drives the deep (Psalm 104:6-7); the whirlwind answers the bound — *Hitherto shalt thou come, but no further: and here shall thy proud waves be stayed* (Job 38:11); Wisdom watched it laid — *When he gave to the sea his decree, that the waters should not pass his commandment* (Proverbs 8:29); and Jeremiah turns the boundary into a rebuke — the sea trembles at *a perpetual decree, that it cannot pass it... yet can they not prevail* (Jeremiah 5:22), but rebellious Israel will not tremble at the One the sea obeys.',
  sv.verse_id, ev.verse_id, 'free', 33426
  FROM _s318_job26_lookup sv, _s318_job26_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=26 AND sv.verse_number=8
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=26 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

-- THREAD 3 ------------------------------------------------------------
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-26-his-hand-hath-formed-the-crooked-serpent',
  E'His hand hath formed the crooked serpent',
  E'Job''s majesty-hymn rises to the Creator''s mastery over chaos: *He divideth the sea with his power, and by his understanding he smiteth through the proud. By his spirit he hath garnished the heavens; his hand hath formed the crooked serpent* (Job 26:12-13). This is the creation-victory the Psalmist sings — *Thou didst divide the sea by thy strength: thou brakest the heads of the dragons in the waters. Thou brakest the heads of leviathan in pieces* (Psalm 74:13-14) — and the arm Isaiah rouses: *Art thou not it that hath cut Rahab, and wounded the dragon?* (Isaiah 51:9). The very phrase returns: *leviathan that crooked serpent... he shall slay the dragon that is in the sea* (Isaiah 27:1). What his hand formed, his sword subdues — the chaos-power is wholly under him, never a rival deity. And the New Testament unmasks the beast: this crooked serpent is *that old serpent, called the Devil, and Satan* cast out of heaven (Revelation 12:9) and at last *bound... a thousand years* and cast into the lake of fire (Revelation 20:2). The enmity of Genesis 3:15 runs from the dividing of the sea to the crushing of the deceiver. And note whose hand does it: the One who *garnished the heavens* and *formed* the deep''s creature is the Formed Wisdom — *Yahuah possessed me in the beginning of his way... When he prepared the heavens, I was there: when he set a compass upon the face of the depth* (Proverbs 8:22,27) — the Son by whom all things were made, who has a Father.',
  sv.verse_id, ev.verse_id, 'free', 33427
  FROM _s318_job26_lookup sv, _s318_job26_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=26 AND sv.verse_number=12
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=26 AND ev.verse_number=13
ON CONFLICT (slug) DO NOTHING;

-- THREAD 4 ------------------------------------------------------------
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-26-the-thunder-of-his-power-who-can-understand',
  E'The thunder of his power who can understand',
  E'Job ends the hymn not with mastery but with awe at how little he has seen: *Lo, these are parts of his ways: but how little a portion is heard of him? but the thunder of his power who can understand?* (Job 26:14). The whole cosmic survey — the hung earth, the bound waters, the subdued serpent — is only the fringe. The apostle reaches the same confession: *O the depth of the riches both of the wisdom and knowledge of Elohim! how unsearchable are his judgments, and his ways past finding out!* (Romans 11:33). Isaiah had already said it of the Creator of the ends of the earth — *there is no searching of his understanding* (Isaiah 40:28) — and Qoheleth of his works — *no man can find out the work that Elohim maketh from the beginning to the end* (Ecclesiastes 3:11). Ben Sira closes his own creation-hymn on the very same note: *Who has seen him, that he might tell us?... There are yet hid greater things than these be, for we have seen but a few of his works* (Sirach 43:31-32). The thunder of his power remains beyond all telling; the Maker who fills the sky is himself unsearchable to the mind he made.',
  sv.verse_id, ev.verse_id, 'extras', 33428
  FROM _s318_job26_lookup sv, _s318_job26_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=26 AND sv.verse_number=14
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=26 AND ev.verse_number=14
ON CONFLICT (slug) DO NOTHING;


