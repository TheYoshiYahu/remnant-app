-- =====================================================================
-- Session 318 — Job FULL-LIBRARY cross-references
-- =====================================================================
-- Per-chapter-range full-library minions (Tanakh + extra-canonical + NT woven
-- per passage). Edition-aware schema; Come-and-See; sacred names restored;
-- son-of-man -> Son of Adam (kaph preserved). Idempotent: ON CONFLICT DO NOTHING.
-- Apply:  python3 api/apply_migration.py ../data-schema/migrations/session318_job_cross_references.sql
-- =====================================================================

\echo 'session318 — Job cross-references starting...'
BEGIN;

-- ----- fragment: minion_job_1.sql (Job 1) -----
-- Chapter: Job 1 — the heavenly court, the Accuser, and the testing of the righteous
-- Tag: job01 ; session prefix s318 ; temp view _s318_job01_lookup
-- sort_order band: 32800.. (one per thread)
-- Source: canon / job / chapter 1
--
-- Job 1 coverage:
--   v.1  (perfect & upright, feared Elohim, eschewed evil)
--        NT:     James 5:11 (patience of Job / Yahuah very pitiful) -> thread 1
--        Extras: none warranted (Job's blamelessness carried by canon witness)
--        Tanakh: Job 1:8 (Yahuah names him; lateral self-anchor) -> thread 1
--   v.2-5 (sons/substance; Job sanctifies & offers burnt offerings continually)
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: none warranted (covered by v.1 righteousness frame)
--   v.6-7 (sons of Elohim present before Yahuah; ha-satan among them; to and fro)
--        NT:     Revelation 12:10 (accuser of brethren cast down); Zechariah 3:1-2 lateral
--        Extras: 1 Enoch 40:7 (Satans forbidden to accuse before Yahuah of Spirits);
--                Jubilees 10:8 (Mastema chief of accusing spirits) -> thread 2
--        Tanakh: Zechariah 3:1-2 (Satan stands to resist Yahushua the high priest) -> thread 2
--   v.8-12 (the wager: Yahuah permits the testing; only upon himself put not forth thine hand)
--        NT:     Luke 22:31 (Satan desired to sift you); 1 Peter 5:8 (adversary roaring lion);
--                1 Corinthians 10:13 (Yahuah makes a way to escape) -> thread 3
--        Extras: none warranted (testing-by-permission carried by canon)
--        Tanakh: none warranted
--   v.13-19 (the four messengers; loss of all)
--        NT:     none warranted (narrative of loss; resolved at v.20-22)
--        Extras: none warranted
--        Tanakh: none warranted
--   v.20-22 (Yahuah gave and hath taken away; blessed be the name; Job sinned not)
--        NT:     James 5:11 (we count them happy which endure / the end of Yahuah) -> thread 4
--        Extras: none warranted
--        Tanakh: none warranted (worship-through-loss carried by canon)
--
-- Threads:
--   1 job-1-the-righteous-man-perfect-and-upright-who-feared-elohim   [free]  NT (James)
--   2 job-1-the-sons-of-elohim-and-the-accuser-before-the-throne      [extras] Extras (1 Enoch, Jubilees) + NT (Rev) + Tanakh (Zech)
--   3 job-1-the-adversary-desired-to-sift-the-righteous               [free]  NT (Luke, 1 Pet, 1 Cor)
--   4 job-1-yahuah-gave-and-yahuah-hath-taken-away-blessed-be-the-name [free] NT (James)
--
-- GUARDS held: the Accuser (ha-satan) is a real adversary who must ASK leave and act only by
-- Yahuah's permission (v.12) — never a co-equal power. Job's righteousness is covenant-
-- faithfulness held THROUGH loss (v.21-22), never a sin-merits-suffering ledger; the righteous
-- suffer. Yahusha is the Formed high priest the adversary stands to resist (Zech 3), the Father
-- the formless Source who sets the bound.

CREATE TEMP VIEW _s318_job01_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- =====================================================================
-- B. cross_references
-- =====================================================================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: the righteous man, perfect and upright
    ('canon','job',1,8,'canon','job',1,1,'free',
     E'*There was a man in the land of Uz, whose name was Job; and that man was perfect and upright, and one that feared Elohim (God), and eschewed evil* (Job 1:1). Yahuah Himself echoes the verdict to the Accuser''s face: *there is none like him in the earth, a perfect and an upright man, one that feareth Elohim (God), and escheweth evil* (Job 1:8). The righteousness is covenant-faithfulness — the fear of Elohim and the turning from evil — not a prosperity tally, and the testing that follows proves the righteous DO suffer.'),
    ('canon','job',1,1,'canon','james',5,11,'free',
     E'*Behold, we count them happy which endure. Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11). The apostle holds up Job — the *perfect and upright* man (Job 1:1) — as the pattern of endurance whose end vindicates the sufferer; the affliction was never the wage of sin but the proving of a faithfulness Yahuah Himself crowns.'),

    -- Thread 2: the sons of Elohim and the Accuser before the throne
    ('canon','job',1,6,'canon','revelation',12,10,'free',
     E'*Now is come salvation, and strength, and the kingdom of our Elohim (God), and the power of his Messiah (Christ): for the accuser of our brethren is cast down, which accused them before our Elohim (God) day and night* (Revelation 12:10). The day when *the sons of Elohim (God) came to present themselves before Yahuah (LORD), and Satan came also among them* (Job 1:6) is the same heavenly court where the Accuser presses his case against the righteous — until at the last he is cast down from it forever.'),
    ('canon','job',1,6,'canon','zechariah',3,1,'free',
     E'*And he shewed me Joshua the high priest standing before the angel of Yahuah (LORD), and Satan standing at his right hand to resist him* (Zechariah 3:1). The Accuser who stood *among them* before Yahuah (Job 1:6) stands again to resist the high priest; the throne-room indictment of Job is the recurring posture of the adversary against Yahuah''s servants.'),
    ('canon','job',1,7,'canon','zechariah',3,2,'free',
     E'*And Yahuah (LORD) said unto Satan, Yahuah (LORD) rebuke thee, O Satan; even Yahuah (LORD) that hath chosen Jerusalem rebuke thee: is not this a brand plucked out of the fire?* (Zechariah 3:2). When the adversary answers *From going to and fro in the earth, and from walking up and down in it* (Job 1:7), he is the same roving accuser whom Yahuah rebukes — never a co-equal, always under the word of the One who chooses and the One who is the Formed defender.'),
    ('canon','job',1,7,'enoch','1-enoch',40,7,'extras',
     E'*And I heard the fourth voice fending off the Satans and forbidding them to come before Yahuah (God) of Spirits to accuse them who dwell on the earth* (1 Enoch 40:7). The seer beholds the very court of Job 1 — the adversaries who would *present themselves before Yahuah* (Job 1:6) and go *to and fro in the earth* (Job 1:7) to accuse — and an angelic voice forbidding their accusation. The library reads its own scene: the Accuser is a real, restrained adversary, fended off before the throne.'),
    ('canon','job',1,6,'jubilees','jubilees',10,8,'extras',
     E'*And the chief of the spirits, Mastêmâ, came and said: "Yahuah (God), Creator, let some of them remain before me... for these are for corruption and leading astray before my judgment"* (Jubilees 10:8). Mastema — the prince of accusation — comes BEFORE Yahuah and ASKS, exactly as the Accuser does *among* the sons of Elohim (Job 1:6); his power over the sons of men is a tenth part granted by permission, never seized, the same bounded adversary who must request leave to touch Job.'),

    -- Thread 3: the adversary desired to sift the righteous (testing by permission)
    ('canon','job',1,11,'canon','luke',22,31,'free',
     E'*And Yahuah (Lord) said, Simon, Simon, behold, Satan hath desired to have you, that he may sift you as wheat* (Luke 22:31). When the Accuser demands *put forth thine hand now, and touch all that he hath, and he will curse thee to thy face* (Job 1:11), he is doing with Job what he later desires with Simon — he must ASK to sift the righteous; the testing is never his by right.'),
    ('canon','job',1,7,'canon','1-peter',5,8,'free',
     E'*Be sober, be vigilant; because your adversary the devil, as a roaring lion, walketh about, seeking whom he may devour* (1 Peter 5:8). The adversary who answered *From going to and fro in the earth, and from walking up and down in it* (Job 1:7) is the same prowling enemy Peter warns the brethren of — a real adversary on patrol, to be resisted, not feared as a rival throne.'),
    ('canon','job',1,12,'canon','1-corinthians',10,13,'free',
     E'*There hath no temptation taken you but such as is common to man: but Elohim (God) is faithful, who will not suffer you to be tempted above that ye are able; but will with the temptation also make a way to escape* (1 Corinthians 10:13). Yahuah sets the bound on the Accuser — *all that he hath is in thy power; only upon himself put not forth thine hand* (Job 1:12) — the same faithful hand that will not suffer His own to be tested beyond what they can bear.'),

    -- Thread 4: Yahuah gave and hath taken away; blessed be the name
    ('canon','job',1,21,'canon','james',5,11,'free',
     E'*Behold, we count them happy which endure. Ye have heard of the patience of Job... that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11). The worship that rises from the ash-heap — *Yahuah (LORD) gave, and Yahuah (LORD) hath taken away; blessed be the name of Yahuah (LORD)* (Job 1:21) — is the very patience James names; the end Yahuah brings vindicates the one who blessed the Name through total loss and *sinned not, nor charged Elohim (God) foolishly* (Job 1:22).')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job01_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job01_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- =====================================================================
-- C. cross_reference_threads
-- =====================================================================
-- Thread 1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-1-the-righteous-man-perfect-and-upright-who-feared-elohim',
       E'The Righteous Man, Perfect and Upright, Who Feared Elohim',
       E'*There was a man in the land of Uz, whose name was Job; and that man was perfect and upright, and one that feared Elohim (God), and eschewed evil* (Job 1:1). Yahuah Himself seals the verdict to the Accuser: *there is none like him in the earth, a perfect and an upright man, one that feareth Elohim (God), and escheweth evil* (Job 1:8). This is the foundation the whole book is built to defend: the righteousness of Job is covenant-faithfulness — the fear of Elohim and the turning from evil — and NOT a prosperity-gospel reward, NOR a ledger where suffering proves hidden sin. The very testing that follows exists to prove that the righteous DO suffer, and suffer blamelessly. The apostle holds him up as the pattern: *Behold, we count them happy which endure. Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11) — the affliction was the proving of a faithfulness Yahuah crowns, never the wage of a sin.',
       sv.verse_id, ev.verse_id, 'free', 32800
  FROM _s318_job01_lookup sv, _s318_job01_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=1 AND ev.verse_number=8
ON CONFLICT (slug) DO NOTHING;

-- Thread 2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-1-the-sons-of-elohim-and-the-accuser-before-the-throne',
       E'The Sons of Elohim and the Accuser Before the Throne',
       E'*Now there was a day when the sons of Elohim (God) came to present themselves before Yahuah (LORD), and Satan came also among them* (Job 1:6). *And Yahuah (LORD) said unto Satan, Whence comest thou? Then Satan answered Yahuah (LORD), and said, From going to and fro in the earth, and from walking up and down in it* (Job 1:7). Here is the heavenly court, and ha-satan — the Accuser, the adversary — must come AMONG the sons of Elohim and answer to Yahuah. He is a real adversary, never a co-equal power; he roves, he accuses, but he stands under the word of the throne. The restored library reads its own scene: *And I heard the fourth voice fending off the Satans and forbidding them to come before Yahuah (God) of Spirits to accuse them who dwell on the earth* (1 Enoch 40:7); and *the chief of the spirits, Mastêmâ, came and said: "Yahuah (God), Creator, let some of them remain before me..."* (Jubilees 10:8) — the prince of accusation comes before Yahuah and ASKS, his power granted by permission, never seized. The same adversary stands again to resist Yahuah''s servant: *and he shewed me Joshua the high priest standing before the angel of Yahuah (LORD), and Satan standing at his right hand to resist him* (Zechariah 3:1), met with *Yahuah (LORD) rebuke thee, O Satan* (Zechariah 3:2) — the Formed high priest the adversary cannot prevail against. And the indictment ends where the whole canon ends it: *the accuser of our brethren is cast down, which accused them before our Elohim (God) day and night* (Revelation 12:10).',
       sv.verse_id, ev.verse_id, 'extras', 32801
  FROM _s318_job01_lookup sv, _s318_job01_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=6
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=1 AND ev.verse_number=7
ON CONFLICT (slug) DO NOTHING;

-- Thread 3
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-1-the-adversary-desired-to-sift-the-righteous',
       E'The Adversary Desired to Sift the Righteous',
       E'The Accuser demands the right to test: *But put forth thine hand now, and touch all that he hath, and he will curse thee to thy face* (Job 1:11). And Yahuah sets the bound: *Behold, all that he hath is in thy power; only upon himself put not forth thine hand. So Satan went forth from the presence of Yahuah (LORD)* (Job 1:12). The adversary must ASK; he acts only by permission and only within a limit Yahuah draws. The Master names this same pattern over Simon: *behold, Satan hath desired to have you, that he may sift you as wheat* (Luke 22:31) — the sifting of the righteous is never the adversary''s by right. He is real and on patrol — *your adversary the devil, as a roaring lion, walketh about, seeking whom he may devour* (1 Peter 5:8), the same enemy *going to and fro in the earth* (Job 1:7) — but the faithful Father holds the limit: *Elohim (God) is faithful, who will not suffer you to be tempted above that ye are able; but will with the temptation also make a way to escape* (1 Corinthians 10:13). The hand that says *only upon himself put not forth thine hand* (Job 1:12) is the hand that makes the way.',
       sv.verse_id, ev.verse_id, 'free', 32802
  FROM _s318_job01_lookup sv, _s318_job01_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=7
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=1 AND ev.verse_number=12
ON CONFLICT (slug) DO NOTHING;

-- Thread 4
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-1-yahuah-gave-and-yahuah-hath-taken-away-blessed-be-the-name',
       E'Yahuah Gave, and Yahuah Hath Taken Away; Blessed Be the Name',
       E'Stripped of children and substance in a single day, Job *arose, and rent his mantle, and shaved his head, and fell down upon the ground, and worshipped* (Job 1:20), and said: *Naked came I out of my mother''s womb, and naked shall I return thither: Yahuah (LORD) gave, and Yahuah (LORD) hath taken away; blessed be the name of Yahuah (LORD)* (Job 1:21). This is the answer the Accuser said could never come — worship that blesses the Name through total loss. *In all this Job sinned not, nor charged Elohim (God) foolishly* (Job 1:22). The apostle gathers it into the church''s comfort: *Behold, we count them happy which endure. Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11) — the one who blessed the Name in the ashes is the one Yahuah vindicates in the end.',
       sv.verse_id, ev.verse_id, 'free', 32803
  FROM _s318_job01_lookup sv, _s318_job01_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=20
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=1 AND ev.verse_number=22
ON CONFLICT (slug) DO NOTHING;

-- =====================================================================
-- D. cross_reference_thread_members
-- =====================================================================
-- Thread 1 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'Yahuah Himself names Job *a perfect and an upright man, one that feareth Elohim (God), and escheweth evil* (Job 1:8) — the lateral self-anchor: the verdict of v.1 confirmed from the throne, righteousness as covenant-faithfulness, not a prosperity tally.'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=8
  JOIN _s318_job01_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=1 AND tv.verse_number=1
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-1-the-righteous-man-perfect-and-upright-who-feared-elohim'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'James 5:11 (NT) holds up *the patience of Job* and *the end of Yahuah* — the blameless man''s endurance vindicated, the affliction proven to be the proving of faith, never the wage of sin.'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=1
  JOIN _s318_job01_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='james' AND tv.chapter_number=5 AND tv.verse_number=11
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-1-the-righteous-man-perfect-and-upright-who-feared-elohim'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 2 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'1 Enoch 40:7 (extras) — the seer hears a voice *forbidding them to come before Yahuah (God) of Spirits to accuse them who dwell on the earth*: the library''s own picture of the Job 1 court, the Accuser real but fended off.'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=7
  JOIN _s318_job01_lookup tv ON tv.edition_slug='enoch' AND tv.book_slug='1-enoch' AND tv.chapter_number=40 AND tv.verse_number=7
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-1-the-sons-of-elohim-and-the-accuser-before-the-throne'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'Jubilees 10:8 (extras) — Mastema, chief of the spirits, *came and said* before Yahuah and ASKS for a portion: accusation by permission, the bounded adversary who must request leave, exactly as ha-satan comes *among them* (Job 1:6).'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=6
  JOIN _s318_job01_lookup tv ON tv.edition_slug='jubilees' AND tv.book_slug='jubilees' AND tv.chapter_number=10 AND tv.verse_number=8
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-1-the-sons-of-elohim-and-the-accuser-before-the-throne'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'Zechariah 3:1 (Tanakh) — *Satan standing at his right hand to resist* Joshua the high priest: the same throne-room adversary, now resisting Yahuah''s servant, the recurring posture of Job 1:6.'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=6
  JOIN _s318_job01_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='zechariah' AND tv.chapter_number=3 AND tv.verse_number=1
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-1-the-sons-of-elohim-and-the-accuser-before-the-throne'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 4, E'Zechariah 3:2 (Tanakh) — *Yahuah (LORD) rebuke thee, O Satan*: the adversary who roves *to and fro in the earth* (Job 1:7) is rebuked, never a co-equal, always under the word of the throne.'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=7
  JOIN _s318_job01_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='zechariah' AND tv.chapter_number=3 AND tv.verse_number=2
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-1-the-sons-of-elohim-and-the-accuser-before-the-throne'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 5, E'Revelation 12:10 (NT) — *the accuser of our brethren is cast down, which accused them before our Elohim (God) day and night*: where the canon ends the throne-room indictment of Job 1, the Accuser cast down forever.'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=6
  JOIN _s318_job01_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='revelation' AND tv.chapter_number=12 AND tv.verse_number=10
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-1-the-sons-of-elohim-and-the-accuser-before-the-throne'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 3 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'Luke 22:31 (NT) — *Satan hath desired to have you, that he may sift you as wheat*: the adversary must ASK to sift the righteous, exactly as he demands leave to touch Job (Job 1:11).'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=11
  JOIN _s318_job01_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='luke' AND tv.chapter_number=22 AND tv.verse_number=31
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-1-the-adversary-desired-to-sift-the-righteous'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'1 Peter 5:8 (NT) — *your adversary the devil, as a roaring lion, walketh about, seeking whom he may devour*: the same enemy *going to and fro in the earth* (Job 1:7), real and on patrol, to be resisted, not feared as a rival throne.'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=7
  JOIN _s318_job01_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='1-peter' AND tv.chapter_number=5 AND tv.verse_number=8
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-1-the-adversary-desired-to-sift-the-righteous'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'1 Corinthians 10:13 (NT) — *Elohim (God) is faithful, who will not suffer you to be tempted above that ye are able*: the bound Yahuah draws — *only upon himself put not forth thine hand* (Job 1:12) — is the same faithful hand that makes the way to escape.'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=12
  JOIN _s318_job01_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='1-corinthians' AND tv.chapter_number=10 AND tv.verse_number=13
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-1-the-adversary-desired-to-sift-the-righteous'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 4 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'James 5:11 (NT) — *the patience of Job* and *the end of Yahuah*: the worship that blessed the Name in the ashes (Job 1:21) is the endurance Yahuah vindicates, the answer the Accuser said could never come.'
  FROM cross_reference_threads t
  JOIN _s318_job01_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=1 AND sv.verse_number=21
  JOIN _s318_job01_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='james' AND tv.chapter_number=5 AND tv.verse_number=11
