  FROM cross_reference_threads t
  JOIN _s318_job06_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=6 AND sv.verse_number=4
  JOIN _s318_job06_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='hebrews' AND tv.chapter_number=12 AND tv.verse_number=5
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
