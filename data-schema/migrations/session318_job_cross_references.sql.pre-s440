INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 4, E'*yet your heavenly Father feedeth them. Are ye not much better than they?* (Matthew 6:26) — Yahusha (Jesus) carries the whirlwind forward: the Provider of the untended fowl will surely feed his people.'
  FROM cross_reference_threads t
  JOIN _s318_job39_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=39 AND sv.verse_number=29
  JOIN _s318_job39_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='matthew' AND tv.chapter_number=6 AND tv.verse_number=26
