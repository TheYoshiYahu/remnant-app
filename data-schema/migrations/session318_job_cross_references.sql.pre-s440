-- ----- fragment: minion_job_38.sql (Job 38) -----
-- Chapter: Job 38 — ★★★ YAHUAH ANSWERS JOB OUT OF THE WHIRLWIND (the Creator's self-revelation)
-- Tag: job38 ; session prefix: s318 ; temp view: _s318_job38_lookup
-- Sort band: 33725..33730 (+1 per thread, 6 threads)
-- Source: canon, book_slug=job, chapter 38
--
-- LENS: The answer to Job's anguish is the PRESENCE of the Creator, not a verdict. The One who
-- speaks from the storm, who laid the foundations, bounded the sea, set the constellations and the
-- ordinances of heaven is the Formed Son — the agent of creation (Prov 8; Col 1:16) — Yahuah who
-- HAS a Father, never the Father made flesh, never co-equal-trinity. The ordinances of heaven (38:33)
-- ground the appointed-times calendar: the luminaries set for signs and seasons (Gen 1:14), never abolished.
--
-- Job 38 coverage:
--   v.1-3 (theophany from the whirlwind):
--        NT:     none warranted (NT theophany witnesses point to the Formed Son but no single verse fits the storm-voice better than the Tanakh laterals; held to OT)
--        Extras: none warranted here (Enoch storm material is judgment-themed, not the answering-voice)
--        Tanakh: Exodus 19:16-18 (Sinai), Ezekiel 1:4 (the whirlwind/the Glory), Nahum 1:3 (way in the whirlwind), Psalm 104:3 (clouds his chariot)  → THREAD 1
--   v.4-7 (foundations of the earth; corner stone; morning stars sing, sons of Elohim shout):
--        NT:     Colossians 1:16 (all things created by the Son)  → THREAD 2
--        Extras: 1 Enoch 18:1-2 (cornerstone of the earth, four winds bearing it — CLEAN)  → THREAD 2
--        Tanakh: Proverbs 8:29-30 (wisdom present at the founding), Psalm 104:5 (laid the foundations), Job 1:6 (sons of Elohim)  → THREAD 2
--   v.8-11 (the sea shut with doors; hitherto, no further):
--        NT:     Mark 4:39 (the Formed Son rebukes the waves)  → THREAD 3
--        Extras: 1 Enoch 69:22 (through the oath the sea was created, the sand its bound — CLEAN)  → THREAD 3
--        Tanakh: Job 26:10 (compassed the waters with bounds), Proverbs 8:29 (gave the sea his decree), Jeremiah 5:22 (sand for the bound of the sea), Psalm 104:9 (set a bound they may not pass)  → THREAD 3
--   v.12-15 (commanded morning; dayspring): NT none warranted; Extras none warranted; Tanakh Ps 65:8 / Ps 19:4-6 weighed — folded into theophany/ordinances tone, NOT a separate thread (kept thread count curated)
--   v.16-18 (springs of the sea; gates of death; doors of the shadow of death):
--        NT:     Revelation 1:18 (the Formed Son holds the keys of death)  → THREAD 4
--        Extras: none warranted (Enoch death-chambers material is apparatus-heavy here)
--        Tanakh: Psalm 9:13 (liftest me up from the gates of death)  → THREAD 4
--   v.19-21 (way where light dwelleth): NT/Extras/Tanakh none warranted (poetic interrogation, no clean framework lateral)
--   v.22-30 (treasures of snow/hail; rain a father; womb of the ice; drops of dew):
--        NT:     none warranted
--        Extras: 1 Enoch 36:1 weighed (dew/rain/hoar-frost portals) — held; canon Psalms carry it more cleanly, kept thread free
--        Tanakh: Psalm 147:16-18 (snow like wool, ice, melteth them), Psalm 135:7 (lightnings for the rain, wind out of his treasuries)  → THREAD 5
--   v.31-33 (Pleiades, Orion, Mazzaroth, Arcturus; ordinances of heaven):
--        NT:     none warranted
--        Extras: 1 Enoch 2:1 (luminaries rise/set in order, transgress not their appointed order — CLEAN), 1 Enoch 18:13 (stars that did not come forth at their appointed times — CLEAN)  → THREAD 6
--        Tanakh: Job 9:9 (Arcturus, Orion, Pleiades), Amos 5:8 (maketh the seven stars and Orion), Isaiah 40:26 (calleth them all by names), Genesis 1:14-16 (lights for signs and seasons)  → THREAD 6
--   v.34-41 (clouds, lightnings, wisdom in the inward parts, the lion and the raven): none warranted as a framework thread (general providence; the chapter's keystones are the foundations/sea/ordinances above)
--
-- THREADS (6):
--   1 job-38-yahuah-answered-job-out-of-the-whirlwind        [free]   Exod19, Ezek1, Nahum1, Ps104
--   2 job-38-where-wast-thou-when-i-laid-the-foundations      [extras] Prov8, Ps104, Job1, Col1, 1Enoch18
--   3 job-38-hitherto-shalt-thou-come-but-no-further          [extras] Job26, Prov8, Jer5, Ps104, Mark4, 1Enoch69
--   4 job-38-the-gates-of-death-and-the-doors-of-the-shadow   [free]   Ps9, Rev1
--   5 job-38-the-treasures-of-the-snow-and-the-drops-of-dew   [free]   Ps147, Ps135
--   6 job-38-the-ordinances-of-heaven-pleiades-and-orion      [extras] Job9, Amos5, Isa40, Gen1, 1Enoch2, 1Enoch18

-- ============================================================================
-- A. TEMP VIEW
-- ============================================================================
CREATE TEMP VIEW _s318_job38_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================================================================
-- B. cross_references
-- ============================================================================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: the theophany out of the whirlwind (38:1-3)
    ('canon','job',38,1,'canon','exodus',19,18,'free',
      E'*And mount Sinai was altogether on a smoke, because Yahuah (LORD) descended upon it in fire: and the smoke thereof ascended as the smoke of a furnace, and the whole mount quaked greatly* (Exodus 19:18). When *Yahuah (LORD) answered Job out of the whirlwind* (Job 38:1) it is the same descending Presence that came down on Sinai in fire and thunder — the Formed Son who speaks out of the storm, who bears the Name and has a Father.'),
    ('canon','job',38,1,'canon','ezekiel',1,4,'free',
      E'*And I looked, and, behold, a whirlwind came out of the north, a great cloud, and a fire infolding itself, and a brightness was about it* (Ezekiel 1:4) — and what Ezekiel sees in that whirlwind is *the appearance of the likeness of the glory of Yahuah (LORD)* (Ezekiel 1:28). The whirlwind that answers Job (Job 38:1) is the same vehicle of the Glory: the answer to suffering is the unveiling of the Maker.'),
    ('canon','job',38,1,'canon','nahum',1,3,'free',
      E'*Yahuah (LORD) is slow to anger, and great in power... Yahuah (LORD) hath his way in the whirlwind and in the storm, and the clouds are the dust of his feet* (Nahum 1:3). The storm is not chaos but the very path of the Almighty; when He *answered Job out of the whirlwind* (Job 38:1) the tempest is His road, the clouds the dust beneath His feet.'),
    ('canon','job',38,3,'canon','psalms',104,3,'free',
      E'*Who maketh the clouds his chariot: who walketh upon the wings of the wind* (Psalm 104:3). The One who says *Gird up now thy loins like a man; for I will demand of thee* (Job 38:3) rides the very wind from which He speaks — the Formed Son enthroned upon the storm, summoning the man to stand before his Maker.'),

    -- THREAD 2: foundations of the earth, the morning stars (38:4-7)
    ('canon','job',38,6,'canon','proverbs',8,29,'free',
      E'*When he gave to the sea his decree, that the waters should not pass his commandment: when he appointed the foundations of the earth: Then I was by him, as one brought up with him* (Proverbs 8:29-30). The *foundations of the earth* and the *corner stone* laid in Job 38:4-6 were laid with Wisdom — the Formed Son — *by him* at the founding, daily His delight.'),
    ('canon','job',38,4,'canon','psalms',104,5,'free',
      E'*Who laid the foundations of the earth, that it should not be removed for ever* (Psalm 104:5). *Where wast thou when I laid the foundations of the earth?* (Job 38:4) — the man was not there; the Creator alone laid them, and they stand fixed by His word.'),
    ('canon','job',38,7,'canon','job',1,6,'free',
      E'*Now there was a day when the sons of Elohim (God) came to present themselves before Yahuah (LORD)* (Job 1:6). The same heavenly court that opens the book — the *sons of Elohim (God)* — is the host that *shouted for joy* at the founding (Job 38:7); the angelic council that watched Job''s trial first sang at creation.'),
    ('canon','job',38,7,'canon','colossians',1,16,'free',
      E'*For by him were all things created, that are in heaven, and that are in earth, visible and invisible, whether they be thrones, or dominions, or principalities, or powers: all things were created by him, and for him* (Colossians 1:16). When *the morning stars sang together, and all the sons of Elohim (God) shouted for joy* (Job 38:7) they rejoiced over the work of the Formed Son, the agent through whom every foundation was laid — He who has a Father, never the Father Himself.'),
    ('canon','job',38,6,'enoch','1-enoch',18,1,'extras',
      E'*I saw the treasuries of all the winds: I saw how He has ordered all creation by His wisdom, and how He has founded the world upon them. And I saw the cornerstone of the earth* (1 Enoch 18:1-2). Enoch is shown the very *corner stone* of Job 38:6 — the world founded by Wisdom, the pillars on which the earth is set.'),

    -- THREAD 3: the sea shut with doors, bounded (38:8-11)
    ('canon','job',38,10,'canon','job',26,10,'free',
      E'*He hath compassed the waters with bounds, until the day and night come to an end* (Job 26:10). What Job confessed earlier of the Maker — the waters circled with a fixed limit — Yahuah now turns back on him: *I... brake up for it my decreed place, and set bars and doors* (Job 38:10).'),
    ('canon','job',38,11,'canon','proverbs',8,29,'free',
      E'*When he gave to the sea his decree, that the waters should not pass his commandment* (Proverbs 8:29). The decree spoken to the sea — *Hitherto shalt thou come, but no further: and here shall thy proud waves be stayed* (Job 38:11) — is the same boundary Wisdom witnessed Him set at the founding.'),
    ('canon','job',38,11,'canon','jeremiah',5,22,'free',
      E'*Fear ye not me? saith Yahuah (LORD)... which have placed the sand for the bound of the sea by a perpetual decree, that it cannot pass it: and though the waves thereof toss themselves, yet can they not prevail* (Jeremiah 5:22). The *proud waves* that *shall be stayed* (Job 38:11) are held back by sand alone — and Jeremiah turns this very wonder into a summons to fear the Maker.'),
    ('canon','job',38,11,'canon','psalms',104,9,'free',
      E'*Thou hast set a bound that they may not pass over; that they turn not again to cover the earth* (Psalm 104:9). The bound set on the sea in Job 38:11 — *but no further* — is the same restraint the psalm sings: the waters that once covered the earth now kept behind His decree.'),
    ('canon','job',38,11,'canon','mark',4,39,'free',
      E'*And he arose, and rebuked the wind, and said unto the sea, Peace, be still. And the wind ceased, and there was a great calm* (Mark 4:39). The One who said to the sea *Hitherto shalt thou come, but no further* (Job 38:11) speaks the same word in flesh — the Formed Son who set the sea''s bound at creation now stills it with a word, and they marvel, *What manner of man is this?*'),
    ('canon','job',38,8,'enoch','1-enoch',69,22,'extras',
      E'*And through that oath the sea was created, and as its foundation He set for it the sand against the time of its anger, and it dare not pass beyond it from the creation of the world unto eternity* (1 Enoch 69:22). The sea *shut up... with doors, when it brake forth, as if it had issued out of the womb* (Job 38:8) is bound by the same creating oath — the sand its appointed limit, which it dare not overpass.'),

    -- THREAD 4: the gates of death (38:16-18)
    ('canon','job',38,17,'canon','psalms',9,13,'free',
      E'*Have mercy upon me, O Yahuah (LORD); consider my trouble which I suffer of them that hate me, thou that liftest me up from the gates of death* (Psalm 9:13). *Have the gates of death been opened unto thee? or hast thou seen the doors of the shadow of death?* (Job 38:17) — no man has; only Yahuah commands those gates, and He alone lifts His own up from them.'),
    ('canon','job',38,17,'canon','revelation',1,18,'free',
      E'*I am he that liveth, and was dead; and, behold, I am alive for evermore, Amen; and have the keys of hell and of death* (Revelation 1:18). The *doors of the shadow of death* no man can open (Job 38:17) are held by the Formed Son — He who passed through death and now carries its keys.'),

    -- THREAD 5: the treasures of snow, hail, and the drops of dew (38:22-30)
    ('canon','job',38,22,'canon','psalms',147,16,'free',
      E'*He giveth snow like wool: he scattereth the hoarfrost like ashes. He casteth forth his ice like morsels: who can stand before his cold? He sendeth out his word, and melteth them* (Psalm 147:16-18). The *treasures of the snow* and *the hoary frost of heaven* (Job 38:22, 29) are dispensed and dissolved at His word alone — the psalm answers Yahuah''s question with praise.'),
    ('canon','job',38,28,'canon','psalms',135,7,'free',
      E'*He causeth the vapours to ascend from the ends of the earth; he maketh lightnings for the rain; he bringeth the wind out of his treasuries* (Psalm 135:7). *Hath the rain a father? or who hath begotten the drops of dew?* (Job 38:28) — the rain has no father but Yahuah, who brings every storehouse of weather *out of his treasuries.*'),

    -- THREAD 6: Pleiades, Orion, and the ordinances of heaven (38:31-33)
    ('canon','job',38,31,'canon','job',9,9,'free',
      E'*Which maketh Arcturus, Orion, and Pleiades, and the chambers of the south* (Job 9:9). Job had already named the constellations as the Maker''s handiwork; now Yahuah asks whether the man can govern them — *Canst thou bind the sweet influences of Pleiades, or loose the bands of Orion?* (Job 38:31).'),
    ('canon','job',38,31,'canon','amos',5,8,'free',
      E'*Seek him that maketh the seven stars and Orion, and turneth the shadow of death into the morning... Yahuah (LORD) is his name* (Amos 5:8). The One who set *Pleiades* and *Orion* (Job 38:31) is named: Yahuah, whom Amos calls the people to seek — the Maker of the very stars no man can bind.'),
    ('canon','job',38,33,'canon','isaiah',40,26,'free',
      E'*Lift up your eyes on high, and behold who hath created these things, that bringeth out their host by number: he calleth them all by names by the greatness of his might... not one faileth* (Isaiah 40:26). *Knowest thou the ordinances of heaven?* (Job 38:33) — He who set those ordinances calls every star by name, and not one fails to keep its course.'),
    ('canon','job',38,33,'canon','genesis',1,14,'free',
      E'*And Elohim (God) said, Let there be lights in the firmament of the heaven to divide the day from the night; and let them be for signs, and for seasons, and for days, and years* (Genesis 1:14). The *ordinances of heaven* (Job 38:33) are the appointed-times architecture set on the fourth day — the luminaries for *signs* and *seasons,* the calendar of the feasts, fixed at creation and never abolished.'),
    ('canon','job',38,33,'enoch','1-enoch',2,1,'extras',
      E'*Observe ye everything that takes place in the heaven, how they do not change their orbits, and the luminaries which are in the heaven, how they all rise and set in order each in its season, and transgress not against their appointed order* (1 Enoch 2:1). This IS the *ordinances of heaven* (Job 38:33): the luminaries keeping their seasons, the fixed order Enoch is told to observe — the appointed-times calendar that governs the earth.'),
    ('canon','job',38,33,'enoch','1-enoch',18,13,'extras',
      E'*And the stars which roll over the fire are they which have transgressed the commandment of Yahuah (God) in the beginning of their rising, because they did not come forth at their appointed times* (1 Enoch 18:13). The *ordinances of heaven* (Job 38:33) are commandment: even the stars are judged by whether they come forth at their *appointed times* — the fixed order no man can set, which Yahuah alone governs.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job38_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job38_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================================================================
-- C. cross_reference_threads
-- ============================================================================
-- THREAD 1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-38-yahuah-answered-job-out-of-the-whirlwind',
  E'Yahuah Answered Job Out of the Whirlwind',
  E'After thirty-seven chapters of argument, *Then Yahuah (LORD) answered Job out of the whirlwind, and said... Gird up now thy loins like a man; for I will demand of thee, and answer thou me* (Job 38:1-3). The answer to Job''s anguish is not a verdict on his suffering but the PRESENCE of the Maker — the Formed Son who speaks from the storm, who bears the Name and has a Father. This is the same descending Presence that came down on Sinai: *And mount Sinai was altogether on a smoke, because Yahuah (LORD) descended upon it in fire... and the whole mount quaked greatly* (Exodus 19:18). It is the Glory Ezekiel saw: *And I looked, and, behold, a whirlwind came out of the north, a great cloud, and a fire infolding itself* (Ezekiel 1:4) — *the appearance of the likeness of the glory of Yahuah (LORD)* (Ezekiel 1:28). The storm is His very road: *Yahuah (LORD) hath his way in the whirlwind and in the storm, and the clouds are the dust of his feet* (Nahum 1:3). He rides the wind He speaks from: *Who maketh the clouds his chariot: who walketh upon the wings of the wind* (Psalm 104:3). Job will get no explanation — he gets his Maker, and that is the answer.',
  sv.verse_id, ev.verse_id, 'free', 33725
  FROM _s318_job38_lookup sv, _s318_job38_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=38 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=38 AND ev.verse_number=3
ON CONFLICT (slug) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-38-where-wast-thou-when-i-laid-the-foundations',
  E'Where Wast Thou When I Laid the Foundations — and the Morning Stars Sang',
  E'*Where wast thou when I laid the foundations of the earth?... Whereupon are the foundations thereof fastened? or who laid the corner stone thereof; When the morning stars sang together, and all the sons of Elohim (God) shouted for joy?* (Job 38:4-7). The man was not there; the Creator alone laid them — and He laid them with Wisdom, the Formed Son: *When he... appointed the foundations of the earth: Then I was by him, as one brought up with him: and I was daily his delight* (Proverbs 8:29-30). The foundations stand fixed forever: *Who laid the foundations of the earth, that it should not be removed for ever* (Psalm 104:5). The NT names the agent through whom they were laid: *For by him were all things created, that are in heaven, and that are in earth, visible and invisible... all things were created by him, and for him* (Colossians 1:16) — the Formed Son, who has a Father, never the Father Himself. The *sons of Elohim (God)* who *shouted for joy* are the same heavenly court that opens the book: *Now there was a day when the sons of Elohim (God) came to present themselves before Yahuah (LORD)* (Job 1:6). Enoch is shown the very corner stone: *I saw how He has ordered all creation by His wisdom, and how He has founded the world upon them. And I saw the cornerstone of the earth* (1 Enoch 18:1-2).',
  sv.verse_id, ev.verse_id, 'extras', 33726
  FROM _s318_job38_lookup sv, _s318_job38_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=38 AND sv.verse_number=4
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=38 AND ev.verse_number=7
ON CONFLICT (slug) DO NOTHING;

-- THREAD 3
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-38-hitherto-shalt-thou-come-but-no-further',
  E'Hitherto Shalt Thou Come, But No Further — the Sea Bounded',
  E'*Or who shut up the sea with doors, when it brake forth, as if it had issued out of the womb?... And said, Hitherto shalt thou come, but no further: and here shall thy proud waves be stayed?* (Job 38:8-11). The chaos-sea is no rival to the Maker; it is His infant, swaddled and bounded by His decree. Job had already confessed it: *He hath compassed the waters with bounds, until the day and night come to an end* (Job 26:10). Wisdom witnessed the decree set: *When he gave to the sea his decree, that the waters should not pass his commandment* (Proverbs 8:29). Jeremiah turns the same wonder into a summons to fear: *which have placed the sand for the bound of the sea by a perpetual decree, that it cannot pass it: and though the waves thereof toss themselves, yet can they not prevail* (Jeremiah 5:22). The psalm sings it: *Thou hast set a bound that they may not pass over; that they turn not again to cover the earth* (Psalm 104:9). The creating oath fixed it forever: *through that oath the sea was created, and as its foundation He set for it the sand against the time of its anger, and it dare not pass beyond it* (1 Enoch 69:22). And the One who set that bound at creation stilled it in flesh: *And he arose, and rebuked the wind, and said unto the sea, Peace, be still. And the wind ceased, and there was a great calm* (Mark 4:39) — the Formed Son, of whom they asked, *What manner of man is this, that even the wind and the sea obey him?*',
  sv.verse_id, ev.verse_id, 'extras', 33727
  FROM _s318_job38_lookup sv, _s318_job38_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=38 AND sv.verse_number=8
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=38 AND ev.verse_number=11
ON CONFLICT (slug) DO NOTHING;

-- THREAD 4
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-38-the-gates-of-death-and-the-doors-of-the-shadow',
  E'The Gates of Death and the Doors of the Shadow of Death',
  E'*Have the gates of death been opened unto thee? or hast thou seen the doors of the shadow of death?* (Job 38:17). No living man has passed those gates and returned to map them; the realm of the dead is beyond mortal command. Yet Yahuah lifts His own up from them: *Have mercy upon me, O Yahuah (LORD)... thou that liftest me up from the gates of death* (Psalm 9:13). And the Formed Son holds their keys, having passed through death Himself: *I am he that liveth, and was dead; and, behold, I am alive for evermore, Amen; and have the keys of hell and of death* (Revelation 1:18). The gates no man can open are held by the One who answered Job from the whirlwind — He who would one day enter death and walk out carrying its keys.',
  sv.verse_id, ev.verse_id, 'free', 33728
  FROM _s318_job38_lookup sv, _s318_job38_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=38 AND sv.verse_number=16
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=38 AND ev.verse_number=18
ON CONFLICT (slug) DO NOTHING;

-- THREAD 5
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-38-the-treasures-of-the-snow-and-the-drops-of-dew',
  E'The Treasures of the Snow and the Drops of Dew',
  E'*Hast thou entered into the treasures of the snow? or hast thou seen the treasures of the hail... Hath the rain a father? or who hath begotten the drops of dew? Out of whose womb came the ice?* (Job 38:22, 28-29). Every weather of heaven is stored and spent at Yahuah''s word alone — the rain has no father but Him. The psalm answers the questions with praise: *He giveth snow like wool: he scattereth the hoarfrost like ashes. He casteth forth his ice like morsels: who can stand before his cold? He sendeth out his word, and melteth them* (Psalm 147:16-18). And He draws every storehouse out together: *He causeth the vapours to ascend from the ends of the earth; he maketh lightnings for the rain; he bringeth the wind out of his treasuries* (Psalm 135:7). The man who cannot beget a drop of dew is in no place to call his Maker to account.',
  sv.verse_id, ev.verse_id, 'free', 33729
  FROM _s318_job38_lookup sv, _s318_job38_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=38 AND sv.verse_number=22
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=38 AND ev.verse_number=30
ON CONFLICT (slug) DO NOTHING;

-- THREAD 6
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-38-the-ordinances-of-heaven-pleiades-and-orion',
  E'Canst Thou Bind Pleiades — the Ordinances of Heaven',
  E'*Canst thou bind the sweet influences of Pleiades, or loose the bands of Orion?... Knowest thou the ordinances of heaven? canst thou set the dominion thereof in the earth?* (Job 38:31-33). Job had already named the constellations as the Maker''s work: *Which maketh Arcturus, Orion, and Pleiades, and the chambers of the south* (Job 9:9). And the Maker is named: *Seek him that maketh the seven stars and Orion... Yahuah (LORD) is his name* (Amos 5:8). He calls each star by name and not one fails: *Lift up your eyes on high, and behold who hath created these things, that bringeth out their host by number: he calleth them all by names by the greatness of his might... not one faileth* (Isaiah 40:26). The *ordinances of heaven* are the appointed-times architecture set on the fourth day: *Let there be lights in the firmament of the heaven to divide the day from the night; and let them be for signs, and for seasons, and for days, and years* (Genesis 1:14) — the calendar of the feasts, fixed at creation and never abolished. Enoch is told to observe that very order: *the luminaries which are in the heaven, how they all rise and set in order each in its season, and transgress not against their appointed order* (1 Enoch 2:1). It is commandment, and even the stars are judged by it: *the stars which... have transgressed the commandment of Yahuah (God) in the beginning of their rising, because they did not come forth at their appointed times* (1 Enoch 18:13). No man can set these ordinances; Yahuah alone governs the appointed times.',
  sv.verse_id, ev.verse_id, 'extras', 33730
  FROM _s318_job38_lookup sv, _s318_job38_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=38 AND sv.verse_number=31
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=38 AND ev.verse_number=33
ON CONFLICT (slug) DO NOTHING;

-- ============================================================================
-- D. cross_reference_thread_members
-- ============================================================================
-- THREAD 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.so, m.mnote
  FROM (VALUES
    (38,1,'canon','exodus',19,18, 1, E'Exodus 19:18 — Sinai: Yahuah descended in fire and the mount quaked; the same descending Presence answers from the whirlwind.'),
    (38,1,'canon','ezekiel',1,4, 2, E'Ezekiel 1:4 — the whirlwind out of the north bearing the Glory; the storm is the vehicle of the likeness of the glory of Yahuah.'),
    (38,1,'canon','nahum',1,3, 3, E'Nahum 1:3 — Yahuah has his way in the whirlwind and storm; the tempest is His road, the clouds the dust of His feet.'),
    (38,3,'canon','psalms',104,3, 4, E'Psalm 104:3 — He maketh the clouds his chariot and walketh on the wings of the wind; He rides the very storm He speaks from.')
  ) AS m(src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,so,mnote)
  JOIN cross_reference_threads t ON t.slug='job-38-yahuah-answered-job-out-of-the-whirlwind'
  JOIN _s318_job38_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job38_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.so, m.mnote
  FROM (VALUES
    (38,6,'canon','proverbs',8,29, 1, E'Proverbs 8:29-30 — Wisdom (the Formed Son) was by Him when He appointed the foundations of the earth, daily His delight.'),
    (38,4,'canon','psalms',104,5, 2, E'Psalm 104:5 — He laid the foundations that they should not be removed for ever; the man was not there to lay them.'),
    (38,7,'canon','job',1,6, 3, E'Job 1:6 — the sons of Elohim who present themselves before Yahuah are the host that shouted for joy at creation.'),
    (38,7,'canon','colossians',1,16, 4, E'Colossians 1:16 — all things created by the Formed Son; the morning stars rejoiced over His work. He has a Father.'),
    (38,6,'enoch','1-enoch',18,1, 5, E'1 Enoch 18:1-2 — Enoch is shown the cornerstone of the earth, the world founded by Wisdom on its pillars.')
  ) AS m(src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,so,mnote)
  JOIN cross_reference_threads t ON t.slug='job-38-where-wast-thou-when-i-laid-the-foundations'
