-- THREAD 3 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('job',32,18,'jeremiah',20,9,1,E'*...his word was in mine heart as a burning fire shut up in my bones... I could not stay* (Jeremiah 20:9) — the prophet''s constraint matches *the spirit within me constraineth me* (Job 32:18).'),
    ('job',32,20,'acts',4,20,2,E'*For we can not but speak the things which we have seen and heard* (Acts 4:20) — the apostles'' constraint matches *I will speak, that I may be refreshed* (Job 32:20).')
  ) AS m(src_slug,src_ch,src_v,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-32-the-spirit-within-me-constraineth-me'
  JOIN _s318_job32_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job32_lookup tv ON tv.edition_slug='canon' AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_33.sql (Job 33) -----
-- Chapter: Job 33 — Elihu's first address: El speaks, and the ransom is found
-- Tag: job33   Session prefix: s318   Temp view: _s318_job33_lookup
-- Sort band: 33600 (+1 per thread) → 33600..33604 (5 threads)
-- Source: canon / job / chapter 33
--
-- Job 33 coverage:
--   v.4   (Spirit of Elohim made me, breath of the Almighty gave me life)
--         NT:     none warranted (creation-of-man theme carried by Tanakh laterals)
--         Extras: none warranted
--         Tanakh: Genesis 2:7 (formed of dust, breathed breath of life); Job 32:8 (spirit in man, inspiration of the Almighty)  → THREAD 1
--   v.6   (I also am formed out of the clay)  — folded into THREAD 1 prose, no separate row
--   v.12-13 (Elohim greater than man, giveth not account)
--         NT/Extras/Tanakh: none warranted (Elihu's premise; set up in prose only)
--   v.14-16 (Elohim speaketh once, yea twice... in a dream, in a vision of the night... openeth the ears)
--         NT:     Hebrews 1:1-2 (spake by the prophets... in last days by his Son)  → THREAD 2
--         Extras: none warranted
--         Tanakh: Numbers 12:6 (make myself known in a vision, speak in a dream); Genesis 20:3 (Elohim came in a dream by night); Joel 2:28 (dreams/visions poured out)  → THREAD 2
--   v.17-18 (withdraw man from his purpose... keepeth back his soul from the pit) — folded into THREAD 4 / THREAD 5 prose
--   v.19-22 (chastened with pain upon his bed... soul draweth near unto the grave)
--         NT:     Hebrews 12:5-6 (despise not the chastening)  → THREAD 4
--         Extras: none warranted (Sirach 38 weighed; chastening-heals carried better by Job 5/Prov 3)
--         Tanakh: Job 5:17-18 (whom Elohim correcteth... woundeth and his hands make whole); Proverbs 3:11-12 (chastening of Yahuah whom he loveth)  → THREAD 4
--   v.23-28 ★★ THE RANSOM — messenger/interpreter, one among a thousand; "I have found a ransom"; delivered from the pit
--         NT:     1 Timothy 2:5-6 (one mediator... the man HaMashiach Yahusha; gave himself a ransom for all); Matthew 20:28 (Son of Adam... give his life a ransom for many)  → THREAD 5 (keystone)
--         Extras: Tobit 12:15 (Raphael... present the prayers of the saints... before the glory)  → THREAD 5
--         Tanakh: Job 9:33 (no daysman betwixt us); Job 16:19 (my witness is in heaven); Psalm 49:7-9 (none can redeem his brother, nor give Elohim a ransom); Psalm 49:15 (Elohim will redeem my soul from the power of the grave); Hosea 13:14 (I will ransom them from the power of the grave)  → THREAD 5
--   v.29-30 (bring back his soul from the pit, enlightened with the light of the living)  — folded into THREAD 5 prose
--   v.31-33 (hold thy peace, I shall teach thee wisdom) — Elihu's close; none warranted
--
-- Threads:
--   s318 job-33-the-spirit-of-el-made-me-and-the-breath-gave-life     (Tanakh)            band 33600
--   s318 job-33-el-speaketh-in-a-dream-in-a-vision-of-the-night        (Tanakh + NT)       band 33601
--   s318 job-33-the-chastening-that-wounds-and-makes-whole             (Tanakh + NT)       band 33602
--   s318 job-33-the-interpreter-one-among-a-thousand-i-have-found-a-ransom  (Tanakh + NT + extras)  band 33603  ★ KEYSTONE
--   s318 job-33-bring-back-his-soul-from-the-pit-to-see-the-light-of-the-living  (Tanakh + NT)  band 33604
--
-- GUARD: 33:23-24's interpreter/ransom is a Tanakh anticipation of the Formed Son, the ONE
--   Mediator who gives himself a ransom — he HAS a Father and intercedes WITH the Father
--   (NOT co-equal-trinity, NOT Arian). El speaking in dreams/visions = the genuine prophetic
--   self-revelation culminating in the Son (Heb 1:1-2). Elihu's TRUE sayings (El speaks; the
--   ransom) are held without endorsing his over-confident rebuke of Job.

CREATE TEMP VIEW _s318_job33_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: the Spirit of El made me, the breath gave me life (33:4)
    ('canon','job',33,4,'canon','genesis',2,7,'free',
      E'*And Yahuah Elohim (the LORD God) formed man of the dust of the ground, and breathed into his nostrils the breath of life; and man became a living soul.* (Genesis 2:7) Elihu names the same making: *The Spirit of Elohim (God) hath made me, and the breath of the Almighty hath given me life* (Job 33:4), and a verse later *I also am formed out of the clay* (Job 33:6). The dust and the breath of Genesis are the ground of every man who pleads — and the same hand that formed Adam can deliver his soul from the pit.'),
    ('canon','job',33,4,'canon','job',32,8,'free',
      E'*But there is a spirit in man: and the inspiration of the Almighty giveth them understanding.* (Job 32:8) Elihu''s own preface to this address; he repeats it as he begins — *The Spirit of Elohim (God) hath made me, and the breath of the Almighty hath given me life* (Job 33:4). His standing to speak is not his youth but the breath of El Shaddai in him; the same Spirit that gives life gives understanding.'),

    -- THREAD 2: El speaketh in a dream, in a vision of the night (33:14-16)
    ('canon','job',33,15,'canon','numbers',12,6,'free',
      E'*And he said, Hear now my words: If there be a prophet among you, I Yahuah (LORD) will make myself known unto him in a vision, and will speak unto him in a dream.* (Numbers 12:6) Yahuah''s own declared manner of revelation answers Job''s complaint that El is silent: *In a dream, in a vision of the night, when deep sleep falleth upon men... Then he openeth the ears of men, and sealeth their instruction* (Job 33:15-16). El does speak — *once, yea twice* (Job 33:14) — though man perceiveth it not.'),
    ('canon','job',33,15,'canon','genesis',20,3,'free',
      E'*But Elohim (God) came to Abimelech in a dream by night, and said to him, Behold, thou art but a dead man...* (Genesis 20:3) A living instance of Elihu''s claim — El speaks in the night-vision even to restrain a man from sin: *That he may withdraw man from his purpose, and hide pride from man* (Job 33:17). The dream is not silence but mercy, *He keepeth back his soul from the pit* (Job 33:18).'),
    ('canon','job',33,15,'canon','joel',2,28,'free',
      E'*And it shall come to pass afterward, that I will pour out my spirit upon all flesh; and your sons and your daughters shall prophesy, your old men shall dream dreams, your young men shall see visions:* (Joel 2:28) What Elihu names as El''s ancient way — *In a dream, in a vision of the night* (Job 33:15) — Joel sees poured out upon all flesh in the latter day. The God who *openeth the ears of men* (Job 33:16) will open them to a whole people.'),
    ('canon','job',33,14,'canon','hebrews',1,1,'free',
      E'*Elohim (God), who at sundry times and in divers manners spake in time past unto the fathers by the prophets, Hath in these last days spoken unto us by his Son...* (Hebrews 1:1-2) The truth Elihu defends — *For Elohim (God) speaketh once, yea twice, yet man perceiveth it not* (Job 33:14) — runs the whole canon: El has never stopped speaking, by dream and vision and prophet, until at last He speaks by the Son He appointed heir of all things.'),

    -- THREAD 3 (file thread 4): the chastening that wounds and makes whole (33:19-22)
    ('canon','job',33,19,'canon','job',5,17,'free',
      E'*Behold, happy is the man whom Elohim (God) correcteth: therefore despise not thou the chastening of the Almighty: For he maketh sore, and bindeth up: he woundeth, and his hands make whole.* (Job 5:17-18) The pain Elihu describes — *He is chastened also with pain upon his bed... His flesh is consumed away* (Job 33:19,21) — is read here not as God''s enmity but as His correction, the wound that goes before the binding-up, the bedside affliction that *bring[s] back his soul from the pit* (Job 33:30).'),
    ('canon','job',33,19,'canon','proverbs',3,11,'free',
      E'*My son, despise not the chastening of Yahuah (LORD); neither be weary of his correction: For whom Yahuah (LORD) loveth he correcteth; even as a father the son in whom he delighteth.* (Proverbs 3:11-12) The bones in *strong pain* (Job 33:19) are a father''s correction, not an enemy''s blow — answering Job''s cry that El *counteth me for his enemy* (Job 33:10). The rod is love working to *withdraw man from his purpose* (Job 33:17).'),
    ('canon','job',33,19,'canon','hebrews',12,5,'free',
      E'*And ye have forgotten the exhortation which speaketh unto you as unto children, My son, despise not thou the chastening of Yahuah (Lord)... For whom Yahuah (Lord) loveth he chasteneth, and scourgeth every son whom he receiveth.* (Hebrews 12:5-6) The bedside affliction of Job 33:19 is the Father''s discipline of sons; the New Testament quotes Proverbs back as the settled lens — the chastening that *bindeth up* (Job 5:18) is the proof of sonship, not of wrath.'),

    -- THREAD 4 (file thread 5): the interpreter, one among a thousand — I have found a ransom (33:23-28) ★ KEYSTONE
    ('canon','job',33,23,'canon','1-timothy',2,5,'free',
      E'*For there is one Elohim (God), and one mediator between Elohim (God) and men, the man HaMashiach Yahusha (Christ Jesus); Who gave himself a ransom for all, to be testified in due time.* (1 Timothy 2:5-6) Here is the messenger Elihu hoped for, made flesh: *If there be a messenger with him, an interpreter, one among a thousand, to shew unto man his uprightness... Deliver him from going down to the pit: I have found a ransom* (Job 33:23-24). The one Mediator is the Formed Son, who has a Father and pleads with the Father — and the ransom He found is Himself.'),
    ('canon','job',33,24,'canon','matthew',20,28,'free',
      E'*Even as the Son of Adam came not to be ministered unto, but to minister, and to give his life a ransom for many.* (Matthew 20:28) Job 33:24''s word — *I have found a ransom* — is answered by the Son of Adam who IS the ransom found. What El declares over the dying man, *Deliver him from going down to the pit* (Job 33:24), the seed of Adam accomplishes by giving His own life for many.'),
    ('canon','job',33,23,'canon','job',9,33,'free',
      E'*Neither is there any daysman betwixt us, that might lay his hand upon us both.* (Job 9:33) Job longed for the very mediator Elihu now names — *an interpreter, one among a thousand, to shew unto man his uprightness* (Job 33:23). The daysman Job could not find is the one Mediator the canon will reveal, the hand laid on both Elohim and man.'),
    ('canon','job',33,23,'canon','job',16,19,'free',
      E'*Also now, behold, my witness is in heaven, and my record is on high.* (Job 16:19) Job''s plea for *one [to] plead for a man with Elohim (God)* (Job 16:21) is the same hope Elihu voices — the *interpreter* who would *shew unto man his uprightness* (Job 33:23). The witness on high and the interpreter among a thousand are one office: the heavenly Advocate who renders *unto man his righteousness* (Job 33:26).'),
    ('canon','job',33,24,'canon','psalms',49,7,'free',
      E'*None of them can by any means redeem his brother, nor give to Elohim (God) a ransom for him: (For the redemption of their soul is precious, and it ceaseth for ever:)* (Psalm 49:7-8) The psalm marks the impossibility — no man can pay the ransom — that makes Job 33:24''s *I have found a ransom* a divine act, not a human one. The price *that he should still live for ever, and not see corruption* (Psalm 49:9) is one only Elohim provides.'),
    ('canon','job',33,28,'canon','psalms',49,15,'free',
      E'*But Elohim (God) will redeem my soul from the power of the grave: for he shall receive me. Selah.* (Psalm 49:15) The deliverance Elihu promises — *He will deliver his soul from going into the pit, and his life shall see the light* (Job 33:28) — is the same redemption the psalmist trusts: not silver, but Elohim Himself receiving the soul out of the grave.'),
    ('canon','job',33,24,'canon','hosea',13,14,'free',
      E'*I will ransom them from the power of the grave; I will redeem them from death: O death, I will be thy plagues; O grave, I will be thy destruction...* (Hosea 13:14) The ransom *found* in Job 33:24 is the ransom Yahuah swears in Hosea — a ransom from the grave itself. *Deliver him from going down to the pit: I have found a ransom* (Job 33:24) anticipates the day death and the grave are themselves undone.'),
    ('canon','job',33,23,'apocrypha','tobit',12,15,'extras',
      E'*I am Raphael, one of the seven holy angels, which present the prayers of the saints, and which go in and out before the glory of the Holy One.* (Tobit 12:15) The restored library gives a picture of Elihu''s *messenger... an interpreter, one among a thousand* (Job 33:23) — the angel who carries a man''s prayers before the glory. It illuminates the office of intercession that Job 33 anticipates, fulfilled at last not by an angel but by the one Mediator who *render[s] unto man his righteousness* (Job 33:26).'),

    -- THREAD 5: bring back his soul from the pit, to the light of the living (33:29-30)
    ('canon','job',33,30,'canon','psalms',49,15,'free',
      E'*But Elohim (God) will redeem my soul from the power of the grave: for he shall receive me. Selah.* (Psalm 49:15) Elihu names El''s repeated work — *To bring back his soul from the pit, to be enlightened with the light of the living* (Job 33:30) — and the psalmist confesses it as personal hope. The God who brings the soul back from the pit is the God who receives it out of the grave into the light.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job33_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job33_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== threads =====
-- THREAD 1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-33-the-spirit-of-el-made-me-and-the-breath-gave-life',
       E'The Spirit of El made me, and the breath gave me life',
       E'Elihu grounds his standing to speak not in his youth but in his Maker: *The Spirit of Elohim (God) hath made me, and the breath of the Almighty hath given me life* (Job 33:4), and *I also am formed out of the clay* (Job 33:6). This is the making of Genesis itself — *And Yahuah Elohim (the LORD God) formed man of the dust of the ground, and breathed into his nostrils the breath of life; and man became a living soul* (Genesis 2:7). The dust and the breath are the ground of every man who pleads before El. Elihu''s own preface said the same: *But there is a spirit in man: and the inspiration of the Almighty giveth them understanding* (Job 32:8) — the breath that gives life gives understanding too. The hand that formed Adam from clay is the hand that can deliver his soul from the pit.',
       sv.verse_id, ev.verse_id, 'free', 33600
  FROM _s318_job33_lookup sv, _s318_job33_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=33 AND sv.verse_number=4
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=33 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-33-el-speaketh-in-a-dream-in-a-vision-of-the-night',
       E'El speaketh in a dream, in a vision of the night',
       E'Against Job''s complaint that El is silent and *giveth not account of any of his matters* (Job 33:13), Elihu insists El never stops speaking: *For Elohim (God) speaketh once, yea twice, yet man perceiveth it not. In a dream, in a vision of the night, when deep sleep falleth upon men... Then he openeth the ears of men, and sealeth their instruction* (Job 33:14-16). This is Yahuah''s own declared manner — *If there be a prophet among you, I Yahuah (LORD) will make myself known unto him in a vision, and will speak unto him in a dream* (Numbers 12:6) — and it happens in the narrative, *Elohim (God) came to Abimelech in a dream by night* (Genesis 20:3), even to restrain a man from sin. What was the way of the few, Joel sees poured out on the many: *your old men shall dream dreams, your young men shall see visions* (Joel 2:28). And the whole long manner reaches its end in the Son: *Elohim (God), who at sundry times and in divers manners spake in time past unto the fathers by the prophets, Hath in these last days spoken unto us by his Son* (Hebrews 1:1-2). El does speak — *once, yea twice* — until He speaks by the One He appointed heir of all things.',
       sv.verse_id, ev.verse_id, 'free', 33601
  FROM _s318_job33_lookup sv, _s318_job33_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=33 AND sv.verse_number=14
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=33 AND ev.verse_number=16
ON CONFLICT (slug) DO NOTHING;

-- THREAD 3 (file thread 4): chastening
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-33-the-chastening-that-wounds-and-makes-whole',
       E'The chastening that wounds and makes whole',
       E'Elihu reads the sufferer''s bedside agony — *He is chastened also with pain upon his bed, and the multitude of his bones with strong pain... His flesh is consumed away... Yea, his soul draweth near unto the grave* (Job 33:19-22) — not as El''s enmity but as His correction, the affliction that works *to withdraw man from his purpose, and hide pride from man* (Job 33:17). Job had cried that El *counteth me for his enemy* (Job 33:10); the wider canon answers that the rod is a Father''s love. *Behold, happy is the man whom Elohim (God) correcteth... For he maketh sore, and bindeth up: he woundeth, and his hands make whole* (Job 5:17-18). *My son, despise not the chastening of Yahuah (LORD)... For whom Yahuah (LORD) loveth he correcteth; even as a father the son in whom he delighteth* (Proverbs 3:11-12). The New Testament quotes the proverb back as the settled lens: *whom Yahuah (Lord) loveth he chasteneth, and scourgeth every son whom he receiveth* (Hebrews 12:5-6). The wound that *bindeth up* is the proof of sonship, the hand that brings the soul back from the pit.',
       sv.verse_id, ev.verse_id, 'free', 33602
  FROM _s318_job33_lookup sv, _s318_job33_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=33 AND sv.verse_number=19
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=33 AND ev.verse_number=22
ON CONFLICT (slug) DO NOTHING;

-- THREAD 4 (file thread 5): THE RANSOM ★ KEYSTONE
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-33-the-interpreter-one-among-a-thousand-i-have-found-a-ransom',
       E'The interpreter, one among a thousand: I have found a ransom',
       E'This is the Messianic heart of Elihu''s speech: *If there be a messenger with him, an interpreter, one among a thousand, to shew unto man his uprightness: Then he is gracious unto him, and saith, Deliver him from going down to the pit: I have found a ransom* (Job 33:23-24). The dying man is restored — *his flesh shall be fresher than a child''s*, he prays and *he shall see his face with joy: for he will render unto man his righteousness* (Job 33:25-26) — *He will deliver his soul from going into the pit, and his life shall see the light* (Job 33:28). Job had already longed for such a one: *Neither is there any daysman betwixt us, that might lay his hand upon us both* (Job 9:33); *behold, my witness is in heaven, and my record is on high* (Job 16:19). But no man can supply the price — *None of them can by any means redeem his brother, nor give to Elohim (God) a ransom for him* (Psalm 49:7) — so the ransom found is a divine act: *But Elohim (God) will redeem my soul from the power of the grave: for he shall receive me* (Psalm 49:15), and Yahuah swears it, *I will ransom them from the power of the grave; I will redeem them from death* (Hosea 13:14). The restored library shows the office anticipated — the messenger who carries prayers before the glory: *I am Raphael, one of the seven holy angels, which present the prayers of the saints, and which go in and out before the glory of the Holy One* (Tobit 12:15). And the interpreter among a thousand is made flesh in the Formed Son, who has a Father and pleads with the Father: *there is one Elohim (God), and one mediator between Elohim (God) and men, the man HaMashiach Yahusha (Christ Jesus); Who gave himself a ransom for all* (1 Timothy 2:5-6) — *the Son of Adam came not to be ministered unto, but to minister, and to give his life a ransom for many* (Matthew 20:28). The ransom El *found* is the Son He gave.',
       sv.verse_id, ev.verse_id, 'extras', 33603
  FROM _s318_job33_lookup sv, _s318_job33_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=33 AND sv.verse_number=23
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=33 AND ev.verse_number=28
ON CONFLICT (slug) DO NOTHING;

-- THREAD 5: bring back his soul from the pit
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-33-bring-back-his-soul-from-the-pit-to-see-the-light-of-the-living',
       E'Bring back his soul from the pit, to the light of the living',
       E'Elihu sums up El''s whole work toward man: *Lo, all these things worketh Elohim (God) oftentimes with man, To bring back his soul from the pit, to be enlightened with the light of the living* (Job 33:29-30). The speaking in dreams, the chastening on the bed, the interpreter and the ransom — all of it bends toward one end, to draw the soul back out of the grave into the light. The psalmist makes that hope personal: *But Elohim (God) will redeem my soul from the power of the grave: for he shall receive me. Selah* (Psalm 49:15). The God who *bring[s] back his soul from the pit* is the God who receives it, out of the grave and into the light of the living.',
       sv.verse_id, ev.verse_id, 'free', 33604
  FROM _s318_job33_lookup sv, _s318_job33_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=33 AND sv.verse_number=29
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=33 AND ev.verse_number=30
ON CONFLICT (slug) DO NOTHING;

