INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'*Ye ask, and receive not, because ye ask amiss, that ye may consume it upon your lusts* (James 4:3) — James names the vanity of 35:13 El will not regard: the proud, self-serving petition.'
  FROM cross_reference_threads t
