-- ----- fragment: minion_job_11.sql (Job 11) -----
-- Book/chapter: Job 11 — Zophar the Naamathite's first speech
-- Session prefix: s318   Tag: job11   Temp view: _s318_job11_lookup
-- Sort band: 33050 + 1 per thread (33050, 33051, 33052)
-- Source book_slug=job, chapter 11. All quotes verbatim from dump_canon.py job 11.
--
-- FRAMING: Zophar speaks a TRUE premise (Yahuah's unsearchable depth, 11:7-9) but deploys it
-- inside a FALSE retribution application (he assumes Job hides secret sin, 11:6; promises
-- repentance-of-hidden-sin will restore, 11:13-19). The true sayings are threaded FORWARD/OUT;
-- the retribution accusation is framed as the very error Yahuah rebukes at Job 42:7-8.
--
-- Job 11 coverage:
--   v.2-4  (Zophar opens — rebukes Job's "talk", calls his doctrine impure)
--          NT: none warranted   Extras: none warranted   Tanakh: none warranted (speech-frame, no doctrine to thread)
--   v.5-6  (the FALSE charge: Elohim would expose "secrets of wisdom"; "exacteth less than thine iniquity deserveth")
--          NT: none warranted   Extras: none warranted   Tanakh: Job 42:7-8 + 42:3 (THREAD 2 — the retribution error Yahuah rebukes)
--   v.7-9  ★ TRUE PREMISE: "Canst thou by searching find out Elohim? ... high as heaven ... deeper than hell ... longer than the earth ... broader than the sea"
--          NT: Romans 11:33-34 (unsearchable judgments)   Extras: Ecclesiasticus/Sirach 1:2-3 (who can find out height of heaven, breadth of earth, the deep, and wisdom)
--          Tanakh: Isaiah 40:28 / Psalm 145:3 / Isaiah 55:8-9 (THREAD 1 — unsearchable depth)
--   v.7-8  (the LIMIT of human searching — "what canst thou know?")
--          NT: none warranted (held in Thread 1)   Extras: none warranted   Tanakh: Deuteronomy 29:29 / Ecclesiastes 8:17 (THREAD 3 — secret things belong to Yahuah)
--   v.10-12 (if he cut off / he knoweth vain men / vain man would be wise)
--          NT: none warranted   Extras: none warranted   Tanakh: held within Thread 1's sovereignty frame (not separately threaded)
--   v.13-20 (Zophar's FALSE promise: put away iniquity → lift up thy face without spot, forget thy misery, secure)
--          NT: none warranted   Extras: none warranted   Tanakh: Job 42:7-8 (THREAD 2 — the retribution doctrine the book overturns)
--
-- THREADS:
--   s318 job-11-canst-thou-by-searching-find-out-elohim          band 33050  tier extras
--        [Isaiah 40:28 (free) | Psalm 145:3 (free) | Isaiah 55:8-9 (free) | Romans 11:33-34 (free) | Ecclesiasticus 1:2-3 (extras)]
--   s318 job-11-the-secrets-of-wisdom-the-error-yahuah-rebukes   band 33051  tier free
--        [Job 42:7 (free) | Job 42:8 (free) | Job 42:3 (free)]
--   s318 job-11-the-secret-things-belong-unto-yahuah             band 33052  tier free
--        [Deuteronomy 29:29 (free) | Ecclesiastes 8:17 (free)]

CREATE TEMP VIEW _s318_job11_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================================================================
-- B. cross_references
-- ============================================================================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: unsearchable depth (11:7-9)
    ('canon','job',11,7,'canon','isaiah',40,28,'free',
     E'*Hast thou not known? hast thou not heard, that El Olam (the everlasting God), Yahuah (LORD), the Creator of the ends of the earth, fainteth not, neither is weary? there is no searching of his understanding.* (Isaiah 40:28). Zophar''s true premise — *Canst thou by searching find out Elohim (God)? canst thou find out the Almighty unto perfection?* (Job 11:7) — is the very confession Yahuah presses on Yashar''el (Israel): the Creator''s understanding is past all searching.'),
    ('canon','job',11,7,'canon','psalms',145,3,'free',
     E'*Great is Yahuah (LORD), and greatly to be praised; and his greatness is unsearchable.* (Psalm 145:3). Job 11:7 asks whether man can *find out the Almighty unto perfection* — the Psalm answers that his greatness has no bottom to be measured; the premise stands even on the lips that misuse it.'),
    ('canon','job',11,8,'canon','isaiah',55,8,'free',
     E'*For my thoughts are not your thoughts, neither are your ways my ways, saith Yahuah (LORD).* (Isaiah 55:8). The height and depth of Job 11:8 — *It is as high as heaven; what canst thou do? deeper than hell; what canst thou know?* — is Isaiah''s same gulf between the Most High and man: a distance of understanding, not merely of place.'),
    ('canon','job',11,9,'canon','isaiah',55,9,'free',
     E'*For as the heavens are higher than the earth, so are my ways higher than your ways, and my thoughts than your thoughts.* (Isaiah 55:9). Job 11:9 measures Yahuah *longer than the earth, and broader than the sea* — the same immeasurable dimensions Isaiah sets between heaven and earth to humble the searching mind.'),
    ('canon','job',11,7,'canon','romans',11,33,'free',
     E'*O the depth of the riches both of the wisdom and knowledge of Elohim (God)! how unsearchable are his judgments, and his ways past finding out!* (Romans 11:33). The question of Job 11:7 — *Canst thou by searching find out Elohim (God)?* — is answered forward in Paul''s doxology: the depth of his wisdom is by design past all human finding-out.'),
    ('canon','job',11,7,'canon','romans',11,34,'free',
     E'*For who hath known the mind of Yahuah (Lord)? or who hath been his counsellor?* (Romans 11:34). Paul presses the very limit Zophar names in Job 11:7 — no man searches out the mind of Yahuah to perfection, none stood as his counsellor; the unsearchable El cannot be audited by the creature.'),
    ('canon','job',11,8,'apocrypha','ecclesiasticus',1,2,'extras',
     E'*Who can number the sand of the sea, and the drops of rain, and the days of eternity? Who can find out the height of heaven, and the breadth of the earth, and the deep, and wisdom?* (Ecclesiasticus 1:2-3). The restored wisdom-tradition echoes Job 11:8-9 almost word for word — *high as heaven ... deeper than hell ... longer than the earth, and broader than the sea* — confessing that the height of heaven and the breadth of the earth and the deep cannot be found out by man.'),
    -- THREAD 2: the retribution error Yahuah rebukes (11:6, 11:13-15)
    ('canon','job',11,6,'canon','job',42,7,'free',
     E'*And it was so, that after Yahuah (LORD) had spoken these words unto Job, Yahuah (LORD) said to Eliphaz the Temanite, My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath.* (Job 42:7). Zophar''s charge — *Elohim (God) exacteth of thee less than thine iniquity deserveth* (Job 11:6), the accusation of hidden sin — is the very retribution doctrine the book overturns; Yahuah''s wrath is kindled against the three friends, not against Job.'),
    ('canon','job',11,14,'canon','job',42,8,'free',
     E'*and my servant Job shall pray for you: for him will I accept ... in that ye have not spoken of me the thing which is right, like my servant Job.* (Job 42:8). Zophar''s false promise — *If iniquity be in thine hand, put it far away ... then shalt thou lift up thy face without spot* (Job 11:14-15) — assumes a hidden sin to repent of; yet in the end it is Zophar who needs Job to pray for him, the accused interceding for the accuser.'),
    ('canon','job',11,6,'canon','job',42,3,'free',
     E'*Who is he that hideth counsel without knowledge? therefore have I uttered that I understood not; things too wonderful for me, which I knew not.* (Job 42:3). Zophar claimed to know the *secrets of wisdom* (Job 11:6) and used them as a club; Job at the last confesses the opposite posture — that the deep things are *too wonderful for me, which I knew not* — the humility Zophar lacked.'),
    -- THREAD 3: the secret things belong to Yahuah (11:7-8)
    ('canon','job',11,7,'canon','deuteronomy',29,29,'free',
     E'*The secret things belong unto Yahuah Eloheinu (the LORD our God): but those things which are revealed belong unto us and to our children for ever, that we may do all the words of this law.* (Deuteronomy 29:29). Job 11:7 rightly fences the *secret things* off from man''s searching — yet the Torah completes the thought Zophar leaves out: the hidden belongs to Yahuah, but the revealed is given to us to DO; covenant obedience, not speculation, is the portion of the creature.'),
    ('canon','job',11,8,'canon','ecclesiastes',8,17,'free',
     E'*Then I beheld all the work of Elohim (God), that a man cannot find out the work that is done under the sun ... though a wise man think to know it, yet shall he not be able to find it.* (Ecclesiastes 8:17). Job 11:8 asks *what canst thou know?* — Qoheleth answers that even the wise man who *think to know* cannot find out the work of Elohim; the limit Zophar names against Job binds Zophar himself.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job11_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job11_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================================================================
-- C. cross_reference_threads
-- ============================================================================
-- THREAD 1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-11-canst-thou-by-searching-find-out-elohim',
       E'Canst Thou by Searching Find Out Elohim — the Unsearchable Depth',
       E'Zophar the Naamathite, the third friend, opens with a premise that is wholly TRUE: *Canst thou by searching find out Elohim (God)? canst thou find out the Almighty unto perfection? It is as high as heaven; what canst thou do? deeper than hell; what canst thou know? The measure thereof is longer than the earth, and broader than the sea.* (Job 11:7-9). No creature can audit the Most High to the bottom. This is the very confession Yahuah (LORD) presses on his scattered people: *that El Olam (the everlasting God), Yahuah (LORD), the Creator of the ends of the earth, fainteth not, neither is weary? there is no searching of his understanding.* (Isaiah 40:28); *Great is Yahuah (LORD), and greatly to be praised; and his greatness is unsearchable.* (Psalm 145:3). The height and depth Zophar measures is Isaiah''s same gulf: *For my thoughts are not your thoughts, neither are your ways my ways ... For as the heavens are higher than the earth, so are my ways higher than your ways* (Isaiah 55:8-9). It runs FORWARD into Paul''s doxology — *O the depth of the riches both of the wisdom and knowledge of Elohim (God)! how unsearchable are his judgments, and his ways past finding out! For who hath known the mind of Yahuah (Lord)? or who hath been his counsellor?* (Romans 11:33-34) — and OUT into the restored wisdom-tradition: *Who can find out the height of heaven, and the breadth of the earth, and the deep, and wisdom?* (Ecclesiasticus 1:2-3). The tragedy of the speech is that Zophar takes this true and glorious premise and bends it into a weapon — that the unsearchable El must therefore be hiding Job''s secret sin (Job 11:6). The premise is sound; the application is the error Yahuah will rebuke (Job 42:7).',
       sv.verse_id, ev.verse_id, 'extras', 33050
  FROM _s318_job11_lookup sv, _s318_job11_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=11 AND sv.verse_number=7
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=11 AND ev.verse_number=9
ON CONFLICT (slug) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-11-the-secrets-of-wisdom-the-error-yahuah-rebukes',
       E'The Secrets of Wisdom — the Retribution Error Yahuah Rebukes',
       E'From the true premise of Yahuah''s unsearchable depth Zophar draws a false conclusion: that Job''s suffering must mask hidden guilt. *And that he would shew thee the secrets of wisdom, that they are double to that which is! Know therefore that Elohim (God) exacteth of thee less than thine iniquity deserveth.* (Job 11:6) — the bare accusation that Job is getting off lightly for crimes he will not name. Then the false promise of restoration-by-repentance: *If thou prepare thine heart ... If iniquity be in thine hand, put it far away ... For then shalt thou lift up thy face without spot ... thou shalt forget thy misery* (Job 11:13-16). This is the retribution doctrine — suffering proves sin, repentance buys back blessing — that the whole book exists to overturn. The verdict falls at the end: *Yahuah (LORD) said to Eliphaz the Temanite, My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath.* (Job 42:7); and it is Job, the accused, who must intercede: *my servant Job shall pray for you: for him will I accept ... in that ye have not spoken of me the thing which is right* (Job 42:8). Zophar boasted of *the secrets of wisdom*; Job at the last confesses the only honest posture before the unsearchable El — *therefore have I uttered that I understood not; things too wonderful for me, which I knew not.* (Job 42:3). The friend who weaponized the secret things is corrected by the sufferer who bowed to them.',
       sv.verse_id, ev.verse_id, 'free', 33051
  FROM _s318_job11_lookup sv, _s318_job11_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=11 AND sv.verse_number=6
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=11 AND ev.verse_number=14
ON CONFLICT (slug) DO NOTHING;

-- THREAD 3
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-11-the-secret-things-belong-unto-yahuah',
       E'The Secret Things Belong Unto Yahuah — the Limit of Man''s Searching',
       E'Embedded in Zophar''s speech is a truth the Torah states cleanly: there is a boundary the creature cannot cross. *Canst thou by searching find out Elohim (God)? ... deeper than hell; what canst thou know?* (Job 11:7-8). Moses fences the same line and then opens the door Zophar leaves shut: *The secret things belong unto Yahuah Eloheinu (the LORD our God): but those things which are revealed belong unto us and to our children for ever, that we may do all the words of this law.* (Deuteronomy 29:29). The hidden belongs to Yahuah; the revealed is given that we may DO — covenant obedience, not speculation, is the portion of the creature, and Zophar''s error is to demand of Job the secret accounting that belongs to Yahuah alone. Qoheleth seals the limit: *a man cannot find out the work that is done under the sun ... though a wise man think to know it, yet shall he not be able to find it.* (Ecclesiastes 8:17). The very boundary Zophar names against Job binds Zophar himself — the wise man who thinks to know the secrets of another''s heart cannot find them out; that knowledge stays with the Most High.',
       sv.verse_id, ev.verse_id, 'free', 33052
  FROM _s318_job11_lookup sv, _s318_job11_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=11 AND sv.verse_number=7
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=11 AND ev.verse_number=8
ON CONFLICT (slug) DO NOTHING;

-- ============================================================================
-- D. cross_reference_thread_members
-- ============================================================================
-- THREAD 1 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (11,7,'canon','isaiah',40,28,1,E'Isaiah 40:28 — *there is no searching of his understanding*; the Creator''s depth that Job 11:7 confesses.'),
    (11,7,'canon','psalms',145,3,2,E'Psalm 145:3 — *his greatness is unsearchable*; the bottomless greatness Job 11:7 names.'),
    (11,8,'canon','isaiah',55,8,3,E'Isaiah 55:8 — *my thoughts are not your thoughts*; the gulf of understanding behind Job 11:8''s height and depth.'),
    (11,9,'canon','isaiah',55,9,4,E'Isaiah 55:9 — *the heavens are higher than the earth*; the immeasurable dimensions of Job 11:9.'),
    (11,7,'canon','romans',11,33,5,E'Romans 11:33 — *how unsearchable are his judgments*; Job 11:7''s question answered forward in Paul''s doxology.'),
    (11,7,'canon','romans',11,34,6,E'Romans 11:34 — *who hath known the mind of Yahuah (Lord)?*; none searches the Most High to perfection, none was his counsellor.'),
    (11,8,'apocrypha','ecclesiasticus',1,2,7,E'Ecclesiasticus 1:2-3 — *Who can find out the height of heaven, and the breadth of the earth, and the deep, and wisdom?*; the restored wisdom-tradition echoing Job 11:8-9.')
  ) AS m(src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN _s318_job11_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job11_lookup tv ON tv.edition_slug=m.tgt_edition AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
  JOIN cross_reference_threads t ON t.slug='job-11-canst-thou-by-searching-find-out-elohim'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- THREAD 2 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (11,6,'canon','job',42,7,1,E'Job 42:7 — *My wrath is kindled against thee, and against thy two friends*; the retribution charge of Job 11:6 condemned by Yahuah himself.'),
    (11,14,'canon','job',42,8,2,E'Job 42:8 — *my servant Job shall pray for you: for him will I accept*; the accused interceding for the accuser whose false promise was Job 11:14-15.'),
    (11,6,'canon','job',42,3,3,E'Job 42:3 — *things too wonderful for me, which I knew not*; the humble posture Zophar lacked when he boasted of the *secrets of wisdom*.')
  ) AS m(src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN _s318_job11_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job11_lookup tv ON tv.edition_slug=m.tgt_edition AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
  JOIN cross_reference_threads t ON t.slug='job-11-the-secrets-of-wisdom-the-error-yahuah-rebukes'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- THREAD 3 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (11,7,'canon','deuteronomy',29,29,1,E'Deuteronomy 29:29 — *The secret things belong unto Yahuah Eloheinu (the LORD our God)*; the Torah''s fence Job 11:7 confesses, with the door to obedience Zophar leaves shut.'),
    (11,8,'canon','ecclesiastes',8,17,2,E'Ecclesiastes 8:17 — *a wise man think to know it, yet shall he not be able to find it*; the limit of Job 11:8 binding the wise accuser himself.')
  ) AS m(src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN _s318_job11_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job11_lookup tv ON tv.edition_slug=m.tgt_edition AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
  JOIN cross_reference_threads t ON t.slug='job-11-the-secret-things-belong-unto-yahuah'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_12.sql (Job 12) -----
-- Book: Job  Chapter: 12  (Job's reply: with Yahuah is wisdom and might)
-- Session prefix: s318   Tag: job12   Slug prefix: job-12-   Sort band: 33075+
-- Source edition/book: canon / job  (chapter 12)
--
-- THREADS (4):
--   33075 job-12-the-creation-itself-teaches-of-its-maker    [FREE]  Tanakh(Ps104,Isa40)+NT(Acts17,Rom1)
--   33076 job-12-with-him-is-wisdom-and-strength             [EXTRAS] Tanakh(Prov8,Dan2)+NT(1Cor1)+Extras(Sirach1)
--   33077 job-12-he-discovereth-deep-things-out-of-darkness  [FREE]  Tanakh(Dan2)+NT(1Cor4)
--   33078 job-12-he-looseth-the-bond-of-kings-and-princes    [FREE]  Tanakh(Ps107,Isa40,1Sam2,Dan2)
--
-- FRAMING / GUARDS: Job here confesses Yahuah's (LORD's) sovereign wisdom MORE truly than his
-- three friends do — this is the faith-speech of the afflicted, not impiety. The Creator who
-- holds "the soul of every living thing, and the breath of all mankind" (12:10), in whose hand
-- "is wisdom and strength" (12:13), is the Formed Son, the agent of creation who HAS a Father
-- (Yahuah the Most High the formless Source) — never the Father made flesh, never a co-equal
-- second person. Wisdom-personified (Prov 8 / Sirach 1 / WisSol) is the Formed Word, not a
-- goddess. Sovereignty over kings/nations is covenant providence, not fatalism.
--
-- PER-CHAPTER COVERAGE CHECKLIST:
--   v.1-6  (Job rebukes his friends)         NT: none warranted  Extras: none warranted  Tanakh: none warranted (introductory dispute)
--   v.7-8  (ask the beasts/fowls/earth/fish) NT: none (covered by v.9-10 block)  Extras: none warranted  Tanakh: Ps104 (thr 33075)
--   v.9    (hand of Yahuah hath wrought this) NT: Acts17:24, Rom1:20 (thr 33075)  Extras: none warranted  Tanakh: Ps104, Isa40 (thr 33075)
--   v.10   (soul/breath of all in his hand)   NT: Acts17:25 (thr 33075)  Extras: none warranted  Tanakh: Ps104:29 (thr 33075)
--   v.11-12 (ear tries words / aged wisdom)   NT: none warranted  Extras: none warranted  Tanakh: none warranted (proverbial bridge)
--   v.13   (with him is wisdom and strength)  NT: 1Cor1:24-25 (thr 33076)  Extras: Sirach1:1 (thr 33076)  Tanakh: Prov8:14, Dan2:20-21 (thr 33076)
--   v.14-16 (breaketh down / waters / deceiver his) NT: none (v.16 wisdom folded to thr 33076)  Extras: none warranted  Tanakh: none warranted
--   v.22   (deep things out of darkness)      NT: 1Cor4:5 (thr 33077)  Extras: none warranted  Tanakh: Dan2:22 (thr 33077)
--   v.17-21 (counsellors/kings/princes/judges) NT: none warranted  Extras: none warranted  Tanakh: Ps107:40, Isa40:23, 1Sam2:7-8, Dan2:21 (thr 33078)
--   v.23-25 (increaseth/destroyeth nations)   NT: none warranted  Extras: none warranted  Tanakh: Ps107:40 (thr 33078, folded with v.21)
--
-- NO-ADD notes: v.1-6, 11-12, 14-15 carry no distinct framework weave warranting a separate
-- canon/extras link (dispute-rhetoric and proverbial bridges); they are recorded above as
-- "none warranted." v.16 "the deceived and the deceiver are his" is left UN-membered (Yahuah's
-- sovereignty over both is real but reads as a hard providence verse better not forced into a
-- forward type here).

CREATE TEMP VIEW _s318_job12_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===================== cross_references =====================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 33075: the creation itself teaches of its Maker (12:7-10)
    ('canon','job',12,9,'canon','psalms',104,24,'free',
      E'*O Yahuah (LORD), how manifold are thy works! in wisdom hast thou made them all: the earth is full of thy riches* (Psalm 104:24). Job''s challenge, *Who knoweth not in all these that the hand of Yahuah (LORD) hath wrought this?* (Job 12:9), is the very confession the psalmist sings: the beasts, the fowls, the earth and the sea all answer to the wisdom of the Maker''s hand.'),
    ('canon','job',12,10,'canon','psalms',104,29,'free',
      E'*Thou hidest thy face, they are troubled: thou takest away their breath, they die, and return to their dust* (Psalm 104:29). Job''s *In whose hand is the soul of every living thing, and the breath of all mankind* (Job 12:10) is the same truth: every creature''s breath is held and withdrawn by the hand of Yahuah (LORD).'),
    ('canon','job',12,9,'canon','isaiah',40,12,'free',
      E'*Who hath measured the waters in the hollow of his hand, and meted out heaven with the span, and comprehended the dust of the earth in a measure, and weighed the mountains in scales, and the hills in a balance?* (Isaiah 40:12). Isaiah''s rhetorical *Who?* echoes Job''s *Who knoweth not in all these that the hand of Yahuah (LORD) hath wrought this?* (Job 12:9) — creation in the Maker''s hand silences every rival.'),
    ('canon','job',12,9,'canon','acts',17,24,'free',
      E'*Elohim (God) that made the world and all things therein, seeing that he is Yahuah (Lord) of heaven and earth, dwelleth not in temples made with hands* (Acts 17:24). Paul on Mars'' hill preaches the same Creator Job points to in *the hand of Yahuah (LORD) hath wrought this* (Job 12:9) — the Formed Son the agent of creation, who has a Father and is not contained by men''s temples.'),
    ('canon','job',12,10,'canon','acts',17,25,'free',
      E'*Neither is worshipped with men''s hands, as though he needed any thing, seeing he giveth to all life, and breath, and all things* (Acts 17:25). Job''s *In whose hand is... the breath of all mankind* (Job 12:10) is filled forward: the Maker gives life and breath to all — the creature owes him everything and he needs nothing.'),
    ('canon','job',12,9,'canon','romans',1,20,'free',
      E'*For the invisible things of him from the creation of the world are clearly seen, being understood by the things that are made, even his eternal power and Godhead; so that they are without excuse* (Romans 1:20). Paul vindicates Job''s appeal to the beasts and the earth: *ask now the beasts, and they shall teach thee* (Job 12:7) — the creation itself declares the Maker, leaving none with excuse.'),

    -- THREAD 33076: with him is wisdom and strength (12:13,16)
    ('canon','job',12,13,'canon','proverbs',8,14,'free',
      E'*Counsel is mine, and sound wisdom: I am understanding; I have strength* (Proverbs 8:14). Wisdom personified — the Formed Word — speaks exactly Job''s confession: *With him is wisdom and strength, he hath counsel and understanding* (Job 12:13).'),
    ('canon','job',12,13,'canon','daniel',2,20,'free',
      E'*Blessed be the name of Elohim (God) for ever and ever: for wisdom and might are his* (Daniel 2:20). Daniel blesses Yahuah (LORD) in the very words of Job''s confession, *With him is wisdom and strength* (Job 12:13) — the secret-revealing God to whom wisdom and might belong.'),
    ('canon','job',12,16,'canon','daniel',2,21,'free',
      E'*And he changeth the times and the seasons: he removeth kings, and setteth up kings: he giveth wisdom unto the wise, and knowledge to them that know understanding* (Daniel 2:21). Job''s *With him is strength and wisdom* (Job 12:16) unfolds in Daniel''s doxology: the same God who owns wisdom and might is the One who gives it and rules the rise and fall of kings.'),
    ('canon','job',12,13,'canon','1-corinthians',1,24,'free',
      E'*But unto them which are called, both Yahudim (Jews) and Greeks, Messiah (Christ) the power of Elohim (God), and the wisdom of Elohim (God)* (1 Corinthians 1:24). The wisdom and strength Job confesses to be *with him* (Job 12:13) is gathered up in the Messiah (Christ) — the Formed Son who IS the power and wisdom of Elohim (God).'),
    ('canon','job',12,13,'apocrypha','ecclesiasticus',1,1,'extras',
      E'*All wisdom comes from Yahuah (God), and is with him for ever* (Ecclesiasticus / Sirach 1:1). Ben Sira opens with Job''s very claim: *With him is wisdom and strength* (Job 12:13) — wisdom is not a human possession but is *with him* for ever, the Formed Word at the Maker''s side.'),

    -- THREAD 33077: he discovereth deep things out of darkness (12:22)
    ('canon','job',12,22,'canon','daniel',2,22,'free',
      E'*He revealeth the deep and secret things: he knoweth what is in the darkness, and the light dwelleth with him* (Daniel 2:22). Daniel''s blessing answers Job almost word for word: *He discovereth deep things out of darkness, and bringeth out to light the shadow of death* (Job 12:22) — the God of light who alone unveils what darkness hides.'),
    ('canon','job',12,22,'canon','1-corinthians',4,5,'free',
      E'*Therefore judge nothing before the time, until Yahuah (Lord) come, who both will bring to light the hidden things of darkness, and will make manifest the counsels of the hearts: and then shall every man have praise of Elohim (God)* (1 Corinthians 4:5). Job''s *He discovereth deep things out of darkness, and bringeth out to light the shadow of death* (Job 12:22) is filled forward to the day Yahuah (Lord) comes and brings every hidden thing to light.'),

    -- THREAD 33078: he looseth the bond of kings and pours contempt on princes (12:17-25)
    ('canon','job',12,21,'canon','psalms',107,40,'free',
      E'*He poureth contempt upon princes, and causeth them to wander in the wilderness, where there is no way* (Psalm 107:40). The psalm repeats Job almost verbatim: *He poureth contempt upon princes* (Job 12:21) and *causeth them to wander in a wilderness where there is no way* (Job 12:24) — the Sovereign who unseats the proud and strands them.'),
    ('canon','job',12,17,'canon','isaiah',40,23,'free',
      E'*That bringeth the princes to nothing; he maketh the judges of the earth as vanity* (Isaiah 40:23). Isaiah voices Job''s confession of the One who *leadeth counsellors away spoiled, and maketh the judges fools* (Job 12:17) — before the Maker the mightiest rulers are nothing.'),
    ('canon','job',12,18,'canon','1-samuel',2,7,'free',
      E'*Yahuah (LORD) maketh poor, and maketh rich: he bringeth low, and lifteth up* (1 Samuel 2:7). Hannah''s song shares Job''s vision of the God who *looseth the bond of kings* (Job 12:18) and *poureth contempt upon princes* (Job 12:21) — He raises and casts down as He wills.'),
    ('canon','job',12,23,'canon','daniel',2,21,'free',
      E'*And he changeth the times and the seasons: he removeth kings, and setteth up kings* (Daniel 2:21). Job''s sweep over the nations — *He increaseth the nations, and destroyeth them: he enlargeth the nations, and straiteneth them again* (Job 12:23) — is Daniel''s confession of the God who governs the rise and fall of kingdoms.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job12_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job12_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===================== threads =====================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-12-the-creation-itself-teaches-of-its-maker',
       E'The creation itself teaches of its Maker',
       E'Job answers his friends not with impiety but with a deeper faith: he sends the inquirer to the creation itself. *But ask now the beasts, and they shall teach thee; and the fowls of the air, and they shall tell thee: Or speak to the earth, and it shall teach thee: and the fishes of the sea shall declare unto thee. Who knoweth not in all these that the hand of Yahuah (LORD) hath wrought this? In whose hand is the soul of every living thing, and the breath of all mankind* (Job 12:7-10). The psalmist sings the same testimony — *O Yahuah (LORD), how manifold are thy works! in wisdom hast thou made them all: the earth is full of thy riches* (Psalm 104:24) — and adds that the breath itself is His to give and withdraw: *Thou takest away their breath, they die, and return to their dust* (Psalm 104:29). Isaiah presses the same *Who?*: *Who hath measured the waters in the hollow of his hand... and weighed the mountains in scales* (Isaiah 40:12). The Maker Job points to is the Formed Son the agent of creation, who has a Father and *dwelleth not in temples made with hands* (Acts 17:24), who *giveth to all life, and breath, and all things* (Acts 17:25). Paul makes Job''s argument apostolic: *the invisible things of him from the creation of the world are clearly seen, being understood by the things that are made... so that they are without excuse* (Romans 1:20). The beasts and the earth are witnesses against every excuse.',
       sv.verse_id, ev.verse_id, 'free', 33075
  FROM _s318_job12_lookup sv, _s318_job12_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=12 AND sv.verse_number=7
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=12 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-12-with-him-is-wisdom-and-strength',
       E'With him is wisdom and strength',
       E'At the heart of Job''s reply stands the confession his friends mouthed but he believes: *With him is wisdom and strength, he hath counsel and understanding* (Job 12:13), and again *With him is strength and wisdom* (Job 12:16). This is the wisdom personified throughout the canon — the Formed Word at the Maker''s side, who says *Counsel is mine, and sound wisdom: I am understanding; I have strength* (Proverbs 8:14). Daniel blesses Yahuah (LORD) in Job''s own words: *Blessed be the name of Elohim (God) for ever and ever: for wisdom and might are his... and he changeth the times and the seasons: he removeth kings, and setteth up kings: he giveth wisdom unto the wise* (Daniel 2:20-21). Ben Sira opens his book the same way: *All wisdom comes from Yahuah (God), and is with him for ever* (Ecclesiasticus / Sirach 1:1) — wisdom is never a human credential, it is *with him*. And it is gathered up at last in the Messiah (Christ): *Messiah (Christ) the power of Elohim (God), and the wisdom of Elohim (God)* (1 Corinthians 1:24). The wisdom and strength Job confesses to be *with him* is the Formed Son himself.',
       sv.verse_id, ev.verse_id, 'extras', 33076
  FROM _s318_job12_lookup sv, _s318_job12_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=12 AND sv.verse_number=13
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=12 AND ev.verse_number=16
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-12-he-discovereth-deep-things-out-of-darkness',
       E'He discovereth deep things out of darkness',
       E'Job confesses the God to whom no secret is hidden: *He discovereth deep things out of darkness, and bringeth out to light the shadow of death* (Job 12:22). Daniel''s blessing answers it almost word for word: *He revealeth the deep and secret things: he knoweth what is in the darkness, and the light dwelleth with him* (Daniel 2:22) — the God of light who alone unveils what darkness conceals. And it runs forward to the day of reckoning: *judge nothing before the time, until Yahuah (Lord) come, who both will bring to light the hidden things of darkness, and will make manifest the counsels of the hearts* (1 Corinthians 4:5). What Job knows of the Creator''s searching light is the same light that will at last expose every hidden thing.',
       sv.verse_id, ev.verse_id, 'free', 33077
  FROM _s318_job12_lookup sv, _s318_job12_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=12 AND sv.verse_number=22
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=12 AND ev.verse_number=22
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-12-he-looseth-the-bond-of-kings-and-princes',
       E'He looseth the bond of kings and poureth contempt on princes',
       E'Job sweeps through the whole order of human power and shows it all subject to Yahuah (LORD): *He leadeth counsellors away spoiled, and maketh the judges fools. He looseth the bond of kings... He poureth contempt upon princes... He increaseth the nations, and destroyeth them... and causeth them to wander in a wilderness where there is no way* (Job 12:17-25). The psalmist repeats it almost verbatim: *He poureth contempt upon princes, and causeth them to wander in the wilderness, where there is no way* (Psalm 107:40). Isaiah confesses the same Sovereign: *That bringeth the princes to nothing; he maketh the judges of the earth as vanity* (Isaiah 40:23). Hannah had sung it: *Yahuah (LORD) maketh poor, and maketh rich: he bringeth low, and lifteth up* (1 Samuel 2:7). And Daniel names the providence over kingdoms: *he changeth the times and the seasons: he removeth kings, and setteth up kings* (Daniel 2:21). This is not blind fate but covenant rule — the Maker who holds the breath of all mankind also holds the thrones of the earth.',
       sv.verse_id, ev.verse_id, 'free', 33078
  FROM _s318_job12_lookup sv, _s318_job12_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=12 AND sv.verse_number=17
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=12 AND ev.verse_number=25
ON CONFLICT (slug) DO NOTHING;

