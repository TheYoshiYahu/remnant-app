SELECT t.id, cr.id, 1, E'*Thou didst divide the sea by thy strength: thou brakest the heads of the dragons in the waters... leviathan in pieces* (Psalm 74:13-14) — the same creation-victory: the sea divided, the chaos-monster crushed.'
