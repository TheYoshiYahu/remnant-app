-- ----- fragment: minion_job_7.sql (Job 7) -----
-- Chapter: Job 7 — Job's lament continues: the hireling's hard service, the vapour-life, and the wrestling with Yahuah's nearness
-- Tag: job07 ; session prefix s318 ; temp view _s318_job07_lookup
-- sort_order band: 32950.. (one per thread)
-- Source: canon / job / chapter 7
--
-- Job 7 coverage:
--   v.1-2  (appointed time to man upon earth / days like the days of an hireling)
--          NT:     none warranted (the hard-service frame carried by Tanakh wisdom-lit)
--          Extras: none warranted
--          Tanakh: Psalm 39:4-6 (make me know mine end, my days an handbreadth);
--                  Psalm 90:10 (days threescore years and ten, labour and sorrow) -> thread 1
--   v.6-7  (days swifter than a weaver's shuttle, spent without hope / life is wind)
--          NT:     James 4:14 (what is your life? a vapour that vanisheth away) -> thread 2
--          Extras: none warranted (vapour carried by James + Ps 39)
--          Tanakh: Psalm 39:5 (my days as an handbreadth, every man at best altogether vanity) -> thread 2
--   v.9-10 (as the cloud is consumed and vanisheth: he shall return no more to his house)
--          NT:     none warranted (Job speaks here within the limit of his own sight, pre-resurrection)
--          Extras: Wisdom of Solomon 2:1-5 (our life shall pass away as the trace of a cloud... no returning) -> thread 3
--          Tanakh: Psalm 90:3-6 (thou turnest man to destruction; as grass in the morning, cut down);
--                  Psalm 39:13 (before I go hence, and be no more) -> thread 3
--   v.16   (I would not live alway: let me alone; for my days are vanity) -> folded into thread 2/3 (vapour/vanity)
--   v.17-18 (What is man, that thou shouldest magnify him?... visit him every morning, try him every moment) ★
--          NT:     none warranted (the Psalm-8 honor is sung forward in Hebrews 2; here Job's INVERSION is the point — kept Tanakh-and-extras)
--          Extras: Ecclesiasticus 18:8-10 (what is man, and to which serveth he?... a thousand years to the days of eternity) -> thread 4
--          Tanakh: Psalm 8:4 (what is man, that thou art mindful of him? son of Adam, that thou visitest him);
--                  Psalm 144:3 (what is man, that thou takest knowledge of him! son of Adam) -> thread 4
--   v.20-21 (I have sinned, O preserver of men... now shall I sleep in the dust; thou shalt seek me, but I shall not be)
--          NT:     none warranted (the dust-sleep answered forward through Daniel 12 lateral, not an NT verse here)
--          Extras: none warranted
--          Tanakh: Job 19:25-26 (I know that my redeemer liveth... in my flesh shall I see Elohim) self-anchor;
--                  Daniel 12:2 (many that sleep in the dust of the earth shall awake) -> thread 5
--
-- Threads:
--   1 job-7-an-appointed-time-to-man-the-hirelings-hard-service        [free]   Tanakh (Ps 39, Ps 90)
--   2 job-7-my-days-are-swifter-than-a-weavers-shuttle-a-vapour-without-hope [free] NT (James) + Tanakh (Ps 39)
--   3 job-7-as-the-cloud-is-consumed-he-shall-return-no-more           [extras] Extras (Wisdom of Solomon) + Tanakh (Ps 90, Ps 39)
--   4 job-7-what-is-man-that-thou-shouldest-magnify-him-the-dark-inversion-of-psalm-8 [extras] Tanakh (Ps 8, Ps 144) + Extras (Ecclesiasticus)
--   5 job-7-now-shall-i-sleep-in-the-dust-yet-i-know-my-redeemer-liveth [free]  Tanakh (Job 19, Daniel 12)
--
-- GUARDS held:
--   ★ 7:17-18 is the RIGHTEOUS SUFFERER'S honest wrestling — the dark inversion of Psalm 8:4. Job feels
--     the divine attention (*visit him every morning... try him every moment*) as relentless scrutiny;
--     the Psalm sings the same nearness (*that thou visitest him*) as honor. The thread BINDS them without
--     resolving away the pain — the lament is kept whole, the Psalm's honor set beside the cry, not over it.
--   ★ "son of Adam" preserved exactly as the parse gives in Psalm 8:4 and Psalm 144:3 (NOT "son of man").
--   ★ 7:9-10 is Job speaking within the LIMIT OF HIS OWN SIGHT (pre-resurrection grief). Thread 3 does not
--     impose resurrection on the despair-verse itself; thread 5 holds the hope that Job himself confesses
--     elsewhere (19:25) and that the canon later seals (Daniel 12:2) — the grief is not erased, it is answered.
--   E'...' literals throughout; every apostrophe doubled.

CREATE TEMP VIEW _s318_job07_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- =====================================================================
-- B. cross_references
-- =====================================================================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: an appointed time to man — the hireling's hard service
    ('canon','job',7,1,'canon','psalms',39,4,'free',
     E'*Yahuah (LORD), make me to know mine end, and the measure of my days, what it is; that I may know how frail I am* (Psalm 39:4). Job''s opening cry — *Is there not an appointed time to man upon earth? are not his days also like the days of an hireling?* (Job 7:1) — is the same prayer turned to lament: man''s life is a measured, appointed term of hard labour, and the sufferer asks Yahuah to teach him the frailty he already feels in his bones.'),
    ('canon','job',7,2,'canon','psalms',39,6,'free',
     E'*Surely every man walketh in a vain shew: surely they are disquieted in vain: he heapeth up riches, and knoweth not who shall gather them* (Psalm 39:6). The hireling *earnestly desireth the shadow, and as an hireling looketh for the reward of his work* (Job 7:2) — man labours through a brief, vain show for a wage he barely grasps; the Psalm names the same disquiet, the same vanity, under the same brief sun.'),
    ('canon','job',7,1,'canon','psalms',90,10,'free',
     E'*The days of our years are threescore years and ten; and if by reason of strength they be fourscore years, yet is their strength labour and sorrow; for it is soon cut off, and we fly away* (Psalm 90:10). Moses'' psalm gives the measure of the *appointed time to man upon earth* (Job 7:1): the whole span is *labour and sorrow* — the hireling''s hard service Job feels as months of vanity and wearisome nights.'),

    -- Thread 2: my days are swifter than a weaver's shuttle — a vapour without hope
    ('canon','job',7,6,'canon','james',4,14,'free',
     E'*Whereas ye know not what shall be on the morrow. For what is your life? It is even a vapour, that appeareth for a little time, and then vanisheth away* (James 4:14). Job''s confession — *My days are swifter than a weaver''s shuttle, and are spent without hope* (Job 7:6) — is the very truth the apostle presses on the boasters: a life is a vapour, gone in the time a shuttle crosses the loom. James turns it to humility before Yahuah''s will; Job groans it from the ash-heap, but the measure of the life is one and the same.'),
    ('canon','job',7,7,'canon','psalms',39,5,'free',
     E'*Behold, thou hast made my days as an handbreadth; and mine age is as nothing before thee: verily every man at his best state is altogether vanity. Selah* (Psalm 39:5). When Job prays *O remember that my life is wind: mine eye shall no more see good* (Job 7:7), he speaks the Psalm''s confession — the days a mere handbreadth, the breath a passing wind, *every man at his best state altogether vanity* — the honest reckoning of the frail before the Everlasting.'),

    -- Thread 3: as the cloud is consumed — he shall return no more
    ('canon','job',7,9,'canon','psalms',90,3,'free',
     E'*Thou turnest man to destruction; and sayest, Return, ye children of men* (Psalm 90:3). Job''s grief — *As the cloud is consumed and vanisheth away: so he that goeth down to the grave shall come up no more* (Job 7:9) — speaks within the limit of his own sight; the Psalm holds the same turning of man back to the dust, but in the mouth of the One who also says *Return* — the destruction is real, yet it is His word, not the last word.'),
    ('canon','job',7,9,'canon','psalms',90,5,'free',
     E'*Thou carriest them away as with a flood; they are as a sleep: in the morning they are like grass which groweth up. In the morning it flourisheth, and groweth up; in the evening it is cut down, and withereth* (Psalm 90:5-6). The cloud *consumed and vanisheth away* (Job 7:9) is the grass cut down by evening — the same swift, total passing of the life of man, sung by Moses as Job laments it.'),
    ('canon','job',7,10,'canon','psalms',39,13,'free',
     E'*O spare me, that I may recover strength, before I go hence, and be no more* (Psalm 39:13). Job''s *He shall return no more to his house, neither shall his place know him any more* (Job 7:10) is the same cry — to *go hence, and be no more* — the sufferer pleading for a little respite before the place that knew him knows him no longer.'),
    ('canon','job',7,9,'apocrypha','the-wisdom-of-solomon',2,4,'extras',
     E'*And our name shall be forgotten in time... and our life shall pass away as the trace of a cloud, and shall be dispersed as a mist, that is driven away with the beams of the sun... For our time is a very shadow that passeth away; and after our end there is no returning: for it is fast sealed, so that no man comes again* (Wisdom of Solomon 2:4-5). The wisdom library puts Job''s very image — *as the cloud is consumed and vanisheth away... he shall come up no more* (Job 7:9) — in the mouth of the ungodly who reason WITHOUT hope. Job grieves it as a righteous man pressed to the wall; the ungodly seize it as license. The same shadow, the same vanishing cloud — but the heart that holds it makes all the difference.'),

    -- Thread 4: ★ what is man, that thou shouldest magnify him — the dark inversion of Psalm 8
    ('canon','job',7,17,'canon','psalms',8,4,'free',
     E'*What is man, that thou art mindful of him? and the son of Adam, that thou visitest him?* (Psalm 8:4). Here is the verse Job turns inside out. The Psalm sings the divine attention as honor — Yahuah crowns the son of Adam *with glory and honour* (Psalm 8:5). Job, on the ash-heap, feels that same nearness as relentless scrutiny: *What is man, that thou shouldest magnify him? and that thou shouldest set thine heart upon him?* (Job 7:17). One word — *visitest* / *visit him every morning* — sung as grace in the Psalm, dreaded as a watch set over him in the lament. Both are true; the suffering does not cancel the honor, and the honor does not silence the cry.'),
    ('canon','job',7,18,'canon','psalms',8,4,'free',
     E'*What is man, that thou art mindful of him? and the son of Adam, that thou visitest him?* (Psalm 8:4). The Psalm''s *thou visitest him* becomes Job''s *that thou shouldest visit him every morning, and try him every moment?* (Job 7:18) — the daily visitation that David sings as Yahuah''s tender mindfulness, Job in his anguish feels as a trial renewed with every dawn. The righteous sufferer wrestles honestly with the very nearness the Psalm adores.'),
    ('canon','job',7,17,'canon','psalms',144,3,'free',
     E'*Yahuah (LORD), what is man, that thou takest knowledge of him! or the son of Adam, that thou makest account of him!* (Psalm 144:3). David asks Job''s question a second time, and answers it with the brevity Job feels: *Man is like to vanity: his days are as a shadow that passeth away* (Psalm 144:4). *What is man, that thou shouldest magnify him?* (Job 7:17) — that Yahuah should *take knowledge* of so frail a shadow at all is the wonder both the singer and the sufferer hold, the one in praise, the other in trembling.'),
    ('canon','job',7,17,'apocrypha','ecclesiasticus',18,8,'extras',
     E'*What is man, and to which serveth he? what is his good, and what is his evil? The number of a man''s days at the most are an hundred years. As a drop of water to the sea, and a gravelstone in comparison of the sand; so are a thousand years to the days of eternity* (Ecclesiasticus 18:8-10). The wisdom library carries Job''s very question — *What is man, that thou shouldest magnify him?* (Job 7:17) — and answers it with the measure that frames it: man''s little span set against the days of eternity, a drop to the sea. Why should the Eternal set His heart on so small a thing? The library lets the wonder stand.'),

    -- Thread 5: now shall I sleep in the dust — yet I know my redeemer liveth
    ('canon','job',7,21,'canon','job',19,25,'free',
     E'*For I know that my redeemer liveth, and that he shall stand at the latter day upon the earth: And though after my skin worms destroy this body, yet in my flesh shall I see Elohim (God)* (Job 19:25-26). In chapter 7 Job sees only the grave: *now shall I sleep in the dust; and thou shalt seek me in the morning, but I shall not be* (Job 7:21). But the same mouth that despairs here will later confess the hope the despair cannot see — a living Redeemer (the Formed One who shall stand upon the earth) and flesh that shall yet see Elohim. The grief of 7:21 is not erased; it is the dark before the confession.'),
    ('canon','job',7,21,'canon','daniel',12,2,'free',
     E'*And many of them that sleep in the dust of the earth shall awake, some to everlasting life, and some to shame and everlasting contempt* (Daniel 12:2). Job''s *now shall I sleep in the dust... but I shall not be* (Job 7:21) is the sleep Daniel says shall not be the end: those who *sleep in the dust of the earth shall awake*. The morning Job thinks will not find him is answered by the resurrection morning the canon promises — the dust-sleep broken, the sleeper sought and found.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job07_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job07_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- =====================================================================
-- C. cross_reference_threads
-- =====================================================================
-- Thread 1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-7-an-appointed-time-to-man-the-hirelings-hard-service',
       E'An Appointed Time to Man: The Hireling''s Hard Service',
       E'Job''s lament opens with the measure of a human life: *Is there not an appointed time to man upon earth? are not his days also like the days of an hireling? As a servant earnestly desireth the shadow, and as an hireling looketh for the reward of his work* (Job 7:1-2). Life is a fixed term of hard labour — the hireling longing for the cool of evening and his wage. *So am I made to possess months of vanity, and wearisome nights are appointed to me* (Job 7:3). The Psalms sing the same frailty: *Yahuah (LORD), make me to know mine end, and the measure of my days, what it is; that I may know how frail I am* (Psalm 39:4), and *surely every man walketh in a vain shew... he heapeth up riches, and knoweth not who shall gather them* (Psalm 39:6). Moses gives the span its name: *The days of our years are threescore years and ten; and if by reason of strength they be fourscore years, yet is their strength labour and sorrow; for it is soon cut off, and we fly away* (Psalm 90:10). The whole appointed time is *labour and sorrow* — and the wisdom of it is to number these few days before Yahuah (Psalm 90:12).',
       sv.verse_id, ev.verse_id, 'free', 32950
  FROM _s318_job07_lookup sv, _s318_job07_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=7 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=7 AND ev.verse_number=2
ON CONFLICT (slug) DO NOTHING;

-- Thread 2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-7-my-days-are-swifter-than-a-weavers-shuttle-a-vapour-without-hope',
       E'My Days Are Swifter Than a Weaver''s Shuttle: A Vapour Without Hope',
       E'*My days are swifter than a weaver''s shuttle, and are spent without hope. O remember that my life is wind: mine eye shall no more see good* (Job 7:6-7). The shuttle flies across the loom and is gone; so the days of a man. The apostle presses the very same measure on those who boast of tomorrow: *Whereas ye know not what shall be on the morrow. For what is your life? It is even a vapour, that appeareth for a little time, and then vanisheth away* (James 4:14). James turns it to humble submission — *if Yahuah (Lord) will, we shall live, and do this, or that* (James 4:15); Job groans it from the ash-heap. But the truth of the life is one: a breath, a vapour, a shuttle''s pass. The Psalm sets the same handbreadth beside it: *Behold, thou hast made my days as an handbreadth; and mine age is as nothing before thee: verily every man at his best state is altogether vanity. Selah* (Psalm 39:5). Job''s *I would not live alway: let me alone; for my days are vanity* (Job 7:16) is the honest cry of a man who has reckoned how short and how heavy the span is.',
       sv.verse_id, ev.verse_id, 'free', 32951
  FROM _s318_job07_lookup sv, _s318_job07_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=7 AND sv.verse_number=6
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=7 AND ev.verse_number=7
ON CONFLICT (slug) DO NOTHING;

-- Thread 3
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-7-as-the-cloud-is-consumed-he-shall-return-no-more',
       E'As the Cloud Is Consumed: He Shall Return No More',
       E'*As the cloud is consumed and vanisheth away: so he that goeth down to the grave shall come up no more. He shall return no more to his house, neither shall his place know him any more* (Job 7:9-10). Here Job speaks within the limit of his own sight — the grief of a man who sees only the grave swallowing the life and the place forgetting the man. Moses sings the same turning, but in the mouth of the One whose word it is: *Thou turnest man to destruction; and sayest, Return, ye children of men* (Psalm 90:3); *thou carriest them away as with a flood; they are as a sleep: in the morning they are like grass which groweth up... in the evening it is cut down, and withereth* (Psalm 90:5-6). And Job''s plea echoes David''s: *O spare me, that I may recover strength, before I go hence, and be no more* (Psalm 39:13). The restored library shows the danger of this same image when it is seized WITHOUT hope — the ungodly reason, *our life shall pass away as the trace of a cloud... For our time is a very shadow that passeth away; and after our end there is no returning: for it is fast sealed, so that no man comes again* (Wisdom of Solomon 2:4-5), and from there they turn to oppress the poor and the righteous. Job grieves the vanishing cloud as a faithful man pressed to the wall; the ungodly twist it into license. The same shadow — but the heart that holds it makes all the difference, and Job''s heart will yet rise to the Redeemer (Job 19:25).',
       sv.verse_id, ev.verse_id, 'extras', 32952
  FROM _s318_job07_lookup sv, _s318_job07_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=7 AND sv.verse_number=9
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=7 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

-- Thread 4
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-7-what-is-man-that-thou-shouldest-magnify-him-the-dark-inversion-of-psalm-8',
       E'What Is Man, That Thou Shouldest Magnify Him: The Dark Inversion of Psalm 8',
       E'*What is man, that thou shouldest magnify him? and that thou shouldest set thine heart upon him? And that thou shouldest visit him every morning, and try him every moment?* (Job 7:17-18). This is one of the Tanakh''s most piercing turns. David sang the question as pure wonder and honor: *What is man, that thou art mindful of him? and the son of Adam, that thou visitest him? For thou hast made him a little lower than the angels, and hast crowned him with glory and honour* (Psalm 8:4-5). The same word — *visitest* — David adores as Yahuah''s tender mindfulness, the dignity of the son of Adam crowned. Job, on the ash-heap, feels that very nearness as relentless scrutiny: the divine *visiting* becomes a watch set over him, a trial renewed *every morning... every moment*. He does not deny the attention; he reels under its weight. David asks again in another psalm: *Yahuah (LORD), what is man, that thou takest knowledge of him! or the son of Adam, that thou makest account of him! Man is like to vanity: his days are as a shadow that passeth away* (Psalm 144:3-4) — that the Eternal should take account of so frail a shadow at all is the wonder. And the wisdom library carries it too: *What is man, and to which serveth he?... so are a thousand years to the days of eternity* (Ecclesiasticus 18:8-10). The honor of Psalm 8 does not silence Job''s cry, and Job''s cry does not cancel the honor. Both are kept whole — the righteous sufferer wrestling honestly with the unbearable, undeniable nearness of Yahuah.',
       sv.verse_id, ev.verse_id, 'extras', 32953
  FROM _s318_job07_lookup sv, _s318_job07_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=7 AND sv.verse_number=17
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=7 AND ev.verse_number=18
ON CONFLICT (slug) DO NOTHING;

-- Thread 5
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-7-now-shall-i-sleep-in-the-dust-yet-i-know-my-redeemer-liveth',
       E'Now Shall I Sleep in the Dust: Yet I Know My Redeemer Liveth',
       E'Job ends the lament with confession and the grave: *I have sinned; what shall I do unto thee, O thou preserver of men?... And why dost thou not pardon my transgression, and take away mine iniquity? for now shall I sleep in the dust; and thou shalt seek me in the morning, but I shall not be* (Job 7:20-21). In this chapter Job sees no farther than the dust — Yahuah will seek him in the morning and he will be gone. But the same man, pressed further into his grief, will rise to a hope the despair cannot yet see: *For I know that my redeemer liveth, and that he shall stand at the latter day upon the earth: And though after my skin worms destroy this body, yet in my flesh shall I see Elohim (God)* (Job 19:25-26) — the living Redeemer, the Formed One who shall stand upon the earth, and flesh that shall yet behold Elohim. And the canon seals it: *And many of them that sleep in the dust of the earth shall awake, some to everlasting life, and some to shame and everlasting contempt* (Daniel 12:2). The dust-sleep Job thinks is the end is the sleep that shall be broken; the morning he believes will not find him is the resurrection morning. The grief of 7:21 is not erased — it is the honest dark before the confession of the dawn.',
       sv.verse_id, ev.verse_id, 'free', 32954
  FROM _s318_job07_lookup sv, _s318_job07_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=7 AND sv.verse_number=20
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=7 AND ev.verse_number=21
ON CONFLICT (slug) DO NOTHING;

