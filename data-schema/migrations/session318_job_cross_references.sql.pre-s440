  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 4 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('job',34,21,'canon','proverbs',5,21,1,E'*The ways of man are before the eyes of Yahuah (LORD), and he pondereth all his goings* (Proverbs 5:21) — Wisdom echoes Elihu word for word.'),
    ('job',34,21,'canon','proverbs',15,3,2,E'*The eyes of Yahuah (LORD) are in every place, beholding the evil and the good* (Proverbs 15:3) — no corner unwatched.'),
    ('job',34,21,'canon','jeremiah',16,17,3,E'*Mine eyes are upon all their ways... neither is their iniquity hid from mine eyes* (Jeremiah 16:17) — Yahuah says of himself what Elihu confesses of him.'),
    ('job',34,21,'canon','hebrews',4,13,4,E'*All things are naked and opened unto the eyes of him with whom we have to do* (Hebrews 4:13) — the all-seeing eye in the judgment-context of the living Word.')
  ) AS m(src_slug,src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
