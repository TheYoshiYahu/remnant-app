-- ----- fragment: minion_job_18.sql (Job 18) -----
-- Job 18 — Bildad the Shuhite's second speech: the portrait of the wicked man's doom.
-- Session prefix: s318  |  tag: job18  |  slug prefix: job-18-  |  sort_order band: 33225+
-- Source book_slug=job, chapter 18 (edition canon).
--
-- FRAME GUARD: This entire speech is Bildad's RETRIBUTION DOCTRINE — the wicked-perish
-- portrait is TRUE of the genuinely wicked (the wisdom-laterals stand) but FALSELY APPLIED
-- to the innocent, suffering Job. Yahuah (LORD) rebukes the friends at Job 42:7: "ye have
-- not spoken of me the thing that is right, as my servant Job hath." The prose names that
-- misapplication on every thread. NOT threaded as a fulfilled type against Job.
--
-- Job 18 coverage:
--   v.5-6  (light/candle of the wicked put out)
--          NT:     none warranted (the wisdom-lateral is the strong weave)
--          Extras: none warranted
--          Tanakh: Proverbs 13:9, Proverbs 24:20 (the lamp/candle of the wicked put out) — THREADED
--   v.7    (steps straitened, own counsel casts him down)
--          NT/Extras/Tanakh: folded into thread 1 prose (own counsel cast him down) — no separate add
--   v.8-10 (net, snare, gin, trap for his feet)
--          NT:     none warranted
--          Extras: none warranted
--          Tanakh: none warranted as a distinct thread (Ps 9:15-16 the heathen sunk in their own pit
--                  is adjacent but a different figure; left unthreaded to keep curation tight)
--   v.11   (terrors on every side)
--          all libraries: none warranted (descriptive intensifier; not framework-bearing)
--   v.17   (his remembrance shall perish from the earth, no name in the street)
--          NT:     none warranted
--          Extras: none warranted
--          Tanakh: Proverbs 10:7 (the name of the wicked shall rot), Psalm 34:16 (to cut off
--                  the remembrance of them from the earth) — THREADED
--   v.21   (such are the dwellings of the wicked, him that knoweth not Elohim)
--          folded into thread-1 prose as the speech's summary line — no separate add
--
-- THREADS (2):
--   1. job-18-the-light-of-the-wicked-shall-be-put-out  (Tanakh-only; tier free)
--        Job 18:5,6  ->  Proverbs 13:9, Proverbs 24:20
--   2. job-18-his-remembrance-shall-perish-from-the-earth  (Tanakh-only; tier free)
--        Job 18:17  ->  Proverbs 10:7, Psalm 34:16
--
-- cross_reference rows: 4  |  thread_member rows: 4

CREATE TEMP VIEW _s318_job18_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== B. cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    ('canon','job',18,5,'canon','proverbs',13,9,'free',
     E'*The light of the righteous rejoiceth: but the lamp of the wicked shall be put out.* (Proverbs 13:9) Bildad''s *Yea, the light of the wicked shall be put out, and the spark of his fire shall not shine* (Job 18:5) speaks a true wisdom-principle — the lamp of the genuinely wicked does go dark — yet he weaponizes it as a false accusation against the innocent, suffering Job, the very error Yahuah (LORD) rebukes at Job 42:7 (*ye have not spoken of me the thing that is right*). The proverb stands; Bildad''s aim does not.'),
    ('canon','job',18,6,'canon','proverbs',24,20,'free',
     E'*For there shall be no reward to the evil man; the candle of the wicked shall be put out.* (Proverbs 24:20) Bildad''s *his candle shall be put out with him* (Job 18:6) is the same figure of the extinguished lamp — true of the man who *knoweth not Elohim (God)* (Job 18:21), but Bildad slanders Job with it. Yahuah (LORD) vindicates Job at the end (Job 42:7); the friends'' retribution-doctrine was rightly spoken of the wicked and wrongly hurled at the righteous.'),
    ('canon','job',18,17,'canon','proverbs',10,7,'free',
     E'*The memory of the just is blessed: but the name of the wicked shall rot.* (Proverbs 10:7) Bildad''s *His remembrance shall perish from the earth, and he shall have no name in the street* (Job 18:17) echoes the proverb on the rotting name of the wicked — a true end for the wicked, but a cruel falsehood pressed onto Job, whose name Yahuah (LORD) honours as *my servant Job* (Job 42:7-8).'),
    ('canon','job',18,17,'canon','psalms',34,16,'free',
     E'*The face of Yahuah (LORD) is against them that do evil, to cut off the remembrance of them from the earth.* (Psalm 34:16) Bildad declares the wicked''s *remembrance shall perish from the earth* (Job 18:17); the psalm grounds that cutting-off in the very face of Yahuah (LORD) set against evildoers. The principle is sound — yet Bildad misreads Job''s affliction as that sentence, when in truth *the eyes of Yahuah (LORD) are upon the righteous* (Psalm 34:15) and He delivers Job (Job 42).')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job18_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job18_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== C. threads =====
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-18-the-light-of-the-wicked-shall-be-put-out',
       E'The light of the wicked shall be put out',
       E'Bildad the Shuhite''s second speech paints the doom of the wicked man: *Yea, the light of the wicked shall be put out, and the spark of his fire shall not shine. The light shall be dark in his tabernacle, and his candle shall be put out with him* (Job 18:5-6). The figure is drawn straight from the wisdom of Yashar''el (Israel): *The light of the righteous rejoiceth: but the lamp of the wicked shall be put out* (Proverbs 13:9), and *For there shall be no reward to the evil man; the candle of the wicked shall be put out* (Proverbs 24:20). The principle is TRUE — the lamp of the man who *knoweth not Elohim (God)* (Job 18:21) does go dark, his own counsel casts him down (Job 18:7), and he is *driven from light into darkness* (Job 18:18). But Bildad WEAPONIZES this true principle as a false accusation against the innocent, suffering Job — and Yahuah (LORD) Himself overturns the slander at the end: *ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). Read the proverbs as the genuine end of the wicked; read Bildad''s aim as the very misapplication the book exists to rebuke.',
       sv.verse_id, ev.verse_id, 'free', 33225
  FROM _s318_job18_lookup sv, _s318_job18_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=18 AND sv.verse_number=5
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=18 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-18-his-remembrance-shall-perish-from-the-earth',
       E'His remembrance shall perish from the earth',
       E'Bildad presses the wicked man''s erasure: *His remembrance shall perish from the earth, and he shall have no name in the street... He shall neither have son nor nephew among his people* (Job 18:17,19). The wisdom-canon says the same of the truly wicked: *The memory of the just is blessed: but the name of the wicked shall rot* (Proverbs 10:7); and the psalm grounds it in Yahuah (LORD) Himself — *The face of Yahuah (LORD) is against them that do evil, to cut off the remembrance of them from the earth* (Psalm 34:16). The doctrine is sound. But Bildad reads Job''s affliction AS that sentence of cut-off — and he is wrong. The same psalm answers him: *The eyes of Yahuah (LORD) are upon the righteous, and his ears are open unto their cry* (Psalm 34:15), *Many are the afflictions of the righteous: but Yahuah (LORD) delivereth him out of them all* (Psalm 34:19). Yahuah honours Job''s name as *my servant Job* (Job 42:7-8) and restores his house — the very opposite of the perished remembrance Bildad pronounced.',
       sv.verse_id, ev.verse_id, 'free', 33226
  FROM _s318_job18_lookup sv, _s318_job18_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=18 AND sv.verse_number=17
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=18 AND ev.verse_number=17
ON CONFLICT (slug) DO NOTHING;

-- ===== D. thread_members =====
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (18,5,'canon','proverbs',13,9, 1, E'*The light of the righteous rejoiceth: but the lamp of the wicked shall be put out* (Proverbs 13:9) — the wisdom-source of Bildad''s figure; true of the wicked, misapplied to Job.'),
    (18,6,'canon','proverbs',24,20, 2, E'*the candle of the wicked shall be put out* (Proverbs 24:20) — the same extinguished-lamp end, true of him that *knoweth not Elohim (God)* (Job 18:21), not of vindicated Job (Job 42:7).')
  ) AS m(src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN _s318_job18_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job18_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
  JOIN cross_reference_threads t ON t.slug='job-18-the-light-of-the-wicked-shall-be-put-out'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (18,17,'canon','proverbs',10,7, 1, E'*the name of the wicked shall rot* (Proverbs 10:7) — the proverb behind *he shall have no name in the street* (Job 18:17); the wicked''s end, not Job''s, whom Yahuah names *my servant* (Job 42:8).'),
    (18,17,'canon','psalms',34,16, 2, E'*The face of Yahuah (LORD) is against them that do evil, to cut off the remembrance of them from the earth* (Psalm 34:16) — grounds the cutting-off in Yahuah Himself; yet His eyes are upon the righteous (Psalm 34:15,19), and He delivers Job.')
  ) AS m(src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN _s318_job18_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job18_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
  JOIN cross_reference_threads t ON t.slug='job-18-his-remembrance-shall-perish-from-the-earth'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_19.sql (Job 19) -----
-- Book: Job   Chapter: 19   Tag: job19   Session: s318
-- Temp view: _s318_job19_lookup
-- Slug prefix: job-19-...   Sort band: 33250..33255 (+1 per thread)
-- ★★★ KEYSTONE CHAPTER — THE REDEEMER LIVETH (the Goel confession, the bodily resurrection hope)
--
-- REDEEMER FRAMING (per Formed/Formless Christology): the Goel/Redeemer of 19:25 who "shall
-- STAND at the latter day UPON THE EARTH" is the FORMED SON — Yahuah who bears the Name and HAS
-- a Father, the kinsman-redeemer who buys back, avenges, and restores his own, who took flesh and
-- will stand bodily on the earth. NOT a trinitarian co-equal person; NOT a created/Arian being.
-- The Isaiah Redeemer-name cluster (41:14, 44:6, 47:4, 59:20) gives the Name "his redeemer ...
-- the Holy One of Yashar'el"; the standing-on-the-earth weaves FORWARD to Acts 1:11 / Zech 14:4 /
-- Rev 5:6 (the Lamb who STANDS) and Rom 11:26 (the Deliverer out of Sion = Isa 59:20). The
-- resurrection is BODILY — "in my flesh shall I see Eloah ... mine eyes shall behold" — Job 14:14's
-- question ("if a man die, shall he live again?") here ANSWERED. Job's hope is held inside present
-- darkness (19:13-22 total estrangement), not prosperity.
--
-- Job 19 coverage:
--   v.2-12  El hath overthrown me / fenced up my way / removed mine hope like a tree
--           NT:     none warranted (complaint; hope verses carry the weave)
--           Extras: none warranted
--           Tanakh: none warranted (internal to Job's lament)
--   v.13-19 He hath put my brethren far from me / kinsfolk failed / familiar friends forgotten / breath strange to my wife
--           NT:     John 1:11 (came unto his own, his own received him not) — Man-of-Sorrows pattern
--           Extras: none warranted
--           Tanakh: Psalm 38:11 (kinsmen stand afar off); Psalm 69:8 (stranger unto my brethren)
--           → THREAD 1 (job-19-he-hath-put-my-brethren-far-from-me)
--   v.20-22 escaped with the skin of my teeth / have pity O ye my friends / the hand of Eloah hath touched me
--           NT/Extras/Tanakh: folded into thread 1 (v.21 anchored in the isolation block)
--   v.23-24 oh that my words were graven with an iron pen and lead in the rock for ever
--           NT:     none warranted
--           Extras: none warranted
--           Tanakh: none warranted (the desire-to-be-recorded preface; led directly into the confession, summarized in thread 2)
--   v.25a   For I know that my Redeemer liveth (the Goel = the Formed Son who bears the Name)
--           NT:     Romans 11:26 (the Deliverer out of Sion) — quotes Isa 59:20
--           Extras: none warranted
--           Tanakh: Isaiah 41:14; Isaiah 44:6; Isaiah 47:4; Isaiah 59:20; Proverbs 23:11
--           → THREAD 2 (job-19-for-i-know-that-my-redeemer-liveth)
--   v.25b   and he shall stand at the latter day upon the earth (the second coming / the Lamb who stands)
--           NT:     Acts 1:11 (shall so come in like manner); Revelation 5:6 (stood a Lamb)
--           Extras: none warranted
--           Tanakh: Zechariah 14:4 (his feet shall stand ... upon the mount of Olives)
--           → THREAD 3 (job-19-he-shall-stand-at-the-latter-day-upon-the-earth)
--   v.26-27 in my flesh shall I see Eloah / mine eyes shall behold, and not another (BODILY resurrection)
--           NT:     John 5:28-29; 1 Corinthians 15:20,23,51-53; Philippians 3:21; 1 John 3:2
--           Extras: 1 Enoch 51:1 (the earth shall give back that which has been entrusted to it)
--           Tanakh: Job 14:14 (if a man die, shall he live again — now answered); Isaiah 26:19; Daniel 12:2
--           → THREAD 4 (job-19-in-my-flesh-shall-i-see-eloah)
--   v.28-29 the root of the matter is found in me / be ye afraid of the sword ... there is a judgment
--           NT:     none warranted
--           Extras: none warranted
--           Tanakh: none warranted (Job's closing rebuke to the friends; the judgment-coming is carried by the latter-day standing in thread 3)
--
-- THREADS (4):
--   1. job-19-he-hath-put-my-brethren-far-from-me        [Tanakh + NT]      free
--   2. job-19-for-i-know-that-my-redeemer-liveth         [Tanakh + NT]      free
--   3. job-19-he-shall-stand-at-the-latter-day-upon-the-earth  [Tanakh + NT] free
--   4. job-19-in-my-flesh-shall-i-see-eloah              [Tanakh + NT + Extras] extras

CREATE TEMP VIEW _s318_job19_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: He hath put my brethren far from me (the forsaken righteous one)
    ('canon','job',19,13,'canon','psalms',38,11,'free',
      E'Job''s estrangement is the lament-Psalm''s very picture: *My lovers and my friends stand aloof from my sore; and my kinsmen stand afar off* (Psalm 38:11). His word *He hath put my brethren far from me, and mine acquaintance are verily estranged from me* (Job 19:13) is the same righteous-sufferer abandoned by his own circle, the pattern the canon carries to the Man of Sorrows.'),
    ('canon','job',19,13,'canon','psalms',69,8,'free',
      E'The forsaking deepens into the reproach-Psalm''s confession: *I am become a stranger unto my brethren, and an alien unto my mother''s children* (Psalm 69:8). Job''s *mine acquaintance are verily estranged from me* (Job 19:13) and *My breath is strange to my wife* (Job 19:17) make him an alien in his own house, the same estrangement Messiah would bear before his own kin.'),
    ('canon','job',19,13,'canon','john',1,11,'free',
      E'The type the canon was carrying lands in the Formed Son: *He came unto his own, and his own received him not* (John 1:11). Job''s *He hath put my brethren far from me* (Job 19:13) and *they whom I loved are turned against me* (Job 19:19) is the righteous one forsaken by his own household — the Man of Sorrows pattern, the brethren who fail before the redeemer is owned.'),

    -- THREAD 2: For I know that my Redeemer liveth (the Goel = the Formed Son who bears the Name)
    ('canon','job',19,25,'canon','isaiah',41,14,'free',
      E'The Redeemer Job knows liveth bears the Name in Isaiah: *Fear not, thou worm Jacob ... I will help thee, saith Yahuah (LORD), and thy redeemer, the Holy One of Yashar''el (Israel)* (Isaiah 41:14). Job''s *I know that my redeemer liveth* (Job 19:25) confesses the same living Goel — the kinsman-redeemer who is Yahuah-of-the-Name and the Holy One who helps his own.'),
    ('canon','job',19,25,'canon','isaiah',44,6,'free',
      E'The Redeemer is named King and First and Last: *Thus saith Yahuah (LORD) the King of Yashar''el (Israel), and his redeemer Yahuah Tseva''ot (LORD of hosts); I am the first, and I am the last; and beside me there is no Elohim (God)* (Isaiah 44:6). Job''s living *redeemer* (Job 19:25) is this Goel — the Formed Son who bears the Name and stands as the First and the Last, who has a Father and is not another beside Him.'),
    ('canon','job',19,25,'canon','isaiah',47,4,'free',
      E'The redeemer''s Name is sounded over Babylon''s fall: *As for our redeemer, Yahuah Tseva''ot (LORD of hosts) is his name, the Holy One of Yashar''el (Israel)* (Isaiah 47:4). Job''s confession *I know that my redeemer liveth* (Job 19:25) rests on this same living Name — the Goel who avenges and buys back his own.'),
    ('canon','job',19,25,'canon','isaiah',59,20,'free',
      E'The Redeemer comes in person to his people: *And the Redeemer shall come to Zion, and unto them that turn from transgression in Jacob, saith Yahuah (LORD)* (Isaiah 59:20). Job''s *he shall stand ... upon the earth* (Job 19:25) is this same coming Goel — the Formed Son who arrives bodily to redeem Jacob, never abandoning his own.'),
    ('canon','job',19,25,'canon','proverbs',23,11,'free',
      E'The Goel is the mighty one who pleads the cause of the helpless: *For their redeemer is mighty; he shall plead their cause with thee* (Proverbs 23:11). Job, stripped and forsaken, knows his *redeemer liveth* (Job 19:25) — the mighty kinsman-redeemer who will plead his cause and stand for him at the latter day.'),
    ('canon','job',19,25,'canon','romans',11,26,'free',
      E'Isaiah''s coming Redeemer is sealed in the apostle: *And so all Yashar''el (Israel) shall be saved: as it is written, There shall come out of Sion the Deliverer, and shall turn away ungodliness from Jacob* (Romans 11:26). Job''s living *redeemer* who *shall stand ... upon the earth* (Job 19:25) is this Deliverer — the Formed Son who comes to redeem all Yashar''el, both houses gathered.'),

    -- THREAD 3: he shall stand at the latter day upon the earth (the second coming / the Lamb who stands)
    ('canon','job',19,25,'canon','zechariah',14,4,'free',
      E'The Redeemer who *shall stand at the latter day upon the earth* (Job 19:25) is the One whose feet touch the ground in the prophets: *And his feet shall stand in that day upon the mount of Olives, which is before Jerusalem on the east* (Zechariah 14:4). Job''s latter-day standing is the bodily arrival of the Formed Son on the earth, the same feet that shall cleave the mount of Olives.'),
    ('canon','job',19,25,'canon','acts',1,11,'free',
      E'The standing is the promised return: *this same Yahusha (Jesus), which is taken up from you into heaven, shall so come in like manner as ye have seen him go into heaven* (Acts 1:11). Job''s confession that his redeemer *shall stand ... upon the earth* (Job 19:25) is the second coming — the Formed Son who took flesh, ascended, and shall stand bodily upon the earth again.'),
    ('canon','job',19,25,'canon','revelation',5,6,'free',
      E'The latter-day Redeemer is the Lamb who STANDS: *And I beheld, and, lo, in the midst of the throne ... stood a Lamb as it had been slain* (Revelation 5:6). Job''s living redeemer who *shall stand ... upon the earth* (Job 19:25) is this slain-yet-living Lamb — the Formed Son who, though he died, liveth and stands, worthy to take the book and redeem his own.'),

    -- THREAD 4: in my flesh shall I see Eloah (the BODILY resurrection)
    ('canon','job',19,26,'canon','job',14,14,'free',
      E'The question Job asked earlier is here answered: *If a man die, shall he live again? all the days of my appointed time will I wait, till my change come* (Job 14:14). Now he knows — *though after my skin worms destroy this body, yet in my flesh shall I see Eloah (God)* (Job 19:26). The waiting of chapter 14 receives its answer: the man who dies shall indeed live again, raised in the flesh.'),
    ('canon','job',19,26,'canon','isaiah',26,19,'free',
      E'The flesh that sees Eloah is the dust that wakes and sings: *Thy dead men shall live, together with my dead body shall they arise. Awake and sing, ye that dwell in dust ... and the earth shall cast out the dead* (Isaiah 26:19). Job''s *in my flesh shall I see Eloah (God) ... mine eyes shall behold* (Job 19:26-27) is this same bodily resurrection — the dead raised, the dust awakened, the very flesh restored to see.'),
    ('canon','job',19,26,'canon','daniel',12,2,'free',
      E'The bodily rising is sealed in Daniel''s vision: *And many of them that sleep in the dust of the earth shall awake, some to everlasting life, and some to shame and everlasting contempt* (Daniel 12:2). Job''s *in my flesh shall I see Eloah (God)* (Job 19:26) is the same awakening from the dust — the body raised to behold its Redeemer, the resurrection hope held inside present darkness.'),
    ('canon','job',19,26,'canon','john',5,28,'free',
      E'The Formed Son names the hour Job longed for: *the hour is coming, in the which all that are in the graves shall hear his voice, And shall come forth* (John 5:28-29). Job''s *in my flesh shall I see Eloah (God)* (Job 19:26) is the body that comes forth from the grave at the voice of the redeemer who stands upon the earth.'),
    ('canon','job',19,26,'canon','1-corinthians',15,20,'free',
      E'The flesh that shall see Eloah rises because the firstfruits rose: *But now is Messiah (Christ) risen from the dead, and become the firstfruits of them that slept* (1 Corinthians 15:20). Job''s *in my flesh shall I see Eloah (God)* (Job 19:26) is the harvest that follows the firstfruits — the redeemer liveth, therefore the body that worms destroy shall yet be raised.'),
    ('canon','job',19,26,'canon','1-corinthians',15,53,'free',
      E'The body raised is the body changed and clothed: *For this corruptible must put on incorruption, and this mortal must put on immortality* (1 Corinthians 15:53). Job''s *though after my skin worms destroy this body, yet in my flesh shall I see Eloah (God)* (Job 19:26) is this mortal flesh raised incorruptible — the same body, transformed, beholding its Redeemer.'),
    ('canon','job',19,26,'canon','philippians',3,21,'free',
      E'The flesh that sees Eloah is fashioned like the risen redeemer''s: *Who shall change our vile body, that it may be fashioned like unto his glorious body* (Philippians 3:21). Job''s *in my flesh shall I see Eloah (God) ... mine eyes shall behold* (Job 19:26-27) is this body transformed — raised and glorified to behold the One who stands upon the earth.'),
    ('canon','job',19,27,'canon','1-john',3,2,'free',
      E'Job''s *mine eyes shall behold, and not another* (Job 19:27) is the seeing the apostle promises: *we know that, when he shall appear, we shall be like him; for we shall see him as he is* (1 John 3:2). Job''s own eyes, in his own flesh, shall behold his Redeemer — the bodily resurrection that sees Eloah face to face, and not another.'),
    ('canon','job',19,26,'enoch','1-enoch',51,1,'extras',
      E'The flesh restored is the earth giving back its dead: *And in those days shall the earth also give back that which has been entrusted to it, And Sheol also shall give back that which it has received* (1 Enoch 51:1). Job''s *in my flesh shall I see Eloah (God)* (Job 19:26) is this same restitution — the body the grave consumed given back, the dust returning its trust at the rising of the Elect One.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job19_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job19_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- THREAD 1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-19-he-hath-put-my-brethren-far-from-me',
  E'He hath put my brethren far from me — the righteous one forsaken by his own',
  E'Before the great confession, Job sinks to the bottom of human abandonment: *He hath put my brethren far from me, and mine acquaintance are verily estranged from me. My kinsfolk have failed, and my familiar friends have forgotten me* (Job 19:13-14). His own household counts him a stranger — *My breath is strange to my wife* (Job 19:17), *they whom I loved are turned against me* (Job 19:19) — and he can only plead, *Have pity upon me, have pity upon me, O ye my friends; for the hand of Elohim (God) hath touched me* (Job 19:21). This is the lament-Psalm''s own picture: *My lovers and my friends stand aloof from my sore; and my kinsmen stand afar off* (Psalm 38:11), and *I am become a stranger unto my brethren, and an alien unto my mother''s children* (Psalm 69:8). The canon carries this estrangement forward to the Man of Sorrows, the Formed Son of whom it is written, *He came unto his own, and his own received him not* (John 1:11). The righteous sufferer is forsaken by his own kin before the Redeemer is owned — and it is from inside this darkness, not from prosperity, that Job will confess the One who liveth.',
  sv.verse_id, ev.verse_id, 'free', 33250
  FROM _s318_job19_lookup sv, _s318_job19_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=19 AND sv.verse_number=13
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=19 AND ev.verse_number=21
ON CONFLICT (slug) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-19-for-i-know-that-my-redeemer-liveth',
  E'For I know that my Redeemer liveth — the living Goel who bears the Name',
  E'Out of total estrangement Job longs for his words to be *graven with an iron pen and lead in the rock for ever* (Job 19:24) — and then speaks the confession the iron pen was for: *For I know that my redeemer liveth* (Job 19:25). The redeemer is the **Goel**, the kinsman-redeemer who buys back, avenges, and restores his own — and the prophets give him the Name. *Fear not, thou worm Jacob ... I will help thee, saith Yahuah (LORD), and thy redeemer, the Holy One of Yashar''el (Israel)* (Isaiah 41:14); *Thus saith Yahuah (LORD) the King of Yashar''el (Israel), and his redeemer Yahuah Tseva''ot (LORD of hosts); I am the first, and I am the last; and beside me there is no Elohim (God)* (Isaiah 44:6); *As for our redeemer, Yahuah Tseva''ot (LORD of hosts) is his name, the Holy One of Yashar''el (Israel)* (Isaiah 47:4). This is the Formed Son — Yahuah who bears the Name and has a Father, the First and the Last who is yet not another beside the Most High, never a co-equal second person nor a created being, but the One drawn from the Formless to redeem his own. He is *mighty; he shall plead their cause* (Proverbs 23:11), and he comes in person: *And the Redeemer shall come to Zion, and unto them that turn from transgression in Jacob, saith Yahuah (LORD)* (Isaiah 59:20) — sealed in the apostle, *There shall come out of Sion the Deliverer, and shall turn away ungodliness from Jacob* (Romans 11:26). Job, stripped of everything, knows the living Goel will stand for him.',
  sv.verse_id, ev.verse_id, 'free', 33251
  FROM _s318_job19_lookup sv, _s318_job19_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=19 AND sv.verse_number=23
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=19 AND ev.verse_number=25
ON CONFLICT (slug) DO NOTHING;

-- THREAD 3
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-19-he-shall-stand-at-the-latter-day-upon-the-earth',
  E'He shall stand at the latter day upon the earth — the Redeemer''s bodily return',
  E'Job''s living redeemer does not stay hidden: *he shall stand at the latter day upon the earth* (Job 19:25). The Formed Son who bears the Name will arrive bodily, his feet on the ground — *And his feet shall stand in that day upon the mount of Olives, which is before Jerusalem on the east* (Zechariah 14:4). This is the promised return the apostles witnessed: *this same Yahusha (Jesus), which is taken up from you into heaven, shall so come in like manner as ye have seen him go into heaven* (Acts 1:11). And in the throne-vision he is the slain-yet-living One who STANDS: *And I beheld, and, lo, in the midst of the throne ... stood a Lamb as it had been slain* (Revelation 5:6). The Redeemer who liveth though Job''s flesh fails is the Lamb who, though he died, stands at the latter day to take the book, judge the earth, and redeem his own — *Be ye afraid of the sword ... that ye may know there is a judgment* (Job 19:29). Job''s hope is not escape from the body but the day his Redeemer stands upon the very earth where he suffered.',
  sv.verse_id, ev.verse_id, 'free', 33252
  FROM _s318_job19_lookup sv, _s318_job19_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=19 AND sv.verse_number=25
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=19 AND ev.verse_number=25
ON CONFLICT (slug) DO NOTHING;

-- THREAD 4
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-19-in-my-flesh-shall-i-see-eloah',
  E'In my flesh shall I see Eloah — the bodily resurrection',
  E'The confession reaches its peak in the body: *And though after my skin worms destroy this body, yet in my flesh shall I see Eloah (God): Whom I shall see for myself, and mine eyes shall behold, and not another* (Job 19:26-27). This is no disembodied survival — it is the same flesh, the same eyes, raised to behold the Redeemer. It answers the question Job had asked: *If a man die, shall he live again? all the days of my appointed time will I wait, till my change come* (Job 14:14). The prophets seal the answer — *Thy dead men shall live ... Awake and sing, ye that dwell in dust ... and the earth shall cast out the dead* (Isaiah 26:19), and *many of them that sleep in the dust of the earth shall awake, some to everlasting life* (Daniel 12:2). The restored library sings the same restitution: *And in those days shall the earth also give back that which has been entrusted to it, And Sheol also shall give back that which it has received* (1 Enoch 51:1). The Formed Son names the hour — *all that are in the graves shall hear his voice, And shall come forth* (John 5:28-29) — and the apostle grounds it in the firstfruits already risen: *now is Messiah (Christ) risen from the dead, and become the firstfruits of them that slept* (1 Corinthians 15:20); *this corruptible must put on incorruption, and this mortal must put on immortality* (1 Corinthians 15:53); *Who shall change our vile body, that it may be fashioned like unto his glorious body* (Philippians 3:21). Job''s own eyes, in his own flesh, shall behold him — *when he shall appear ... we shall see him as he is* (1 John 3:2). The hope is bodily, and it is held inside present darkness, the worms not yet kept from the skin.',
  sv.verse_id, ev.verse_id, 'extras', 33253
  FROM _s318_job19_lookup sv, _s318_job19_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=19 AND sv.verse_number=26
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=19 AND ev.verse_number=27
ON CONFLICT (slug) DO NOTHING;

