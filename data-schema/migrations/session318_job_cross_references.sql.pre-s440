-- ----- fragment: minion_job_3.sql (Job 3) -----
-- Job 3 — Job curses the day of his birth. The lament of the righteous in the depths,
-- voiced WITHOUT condemnation: the honest cry held inside faith, not a sin to be rebuked.
-- Tag: job03 | Session: s318 | sort_order band: 32850+
-- Slug prefix: job-3-
--
-- GUARD: this is the suffering of the righteous. No friends'-retribution theology imported;
-- no rebuke of Job for crying out. The grave-as-rest longing is held lightly, answered only
-- where the canon itself answers it (resurrection rest, the Man of Sorrows who shared the cry).
--
-- Job 3 coverage:
--   v.3-10  "Let the day perish wherein I was born"
--           NT:     none warranted (the prophet-parallel is the load-bearing weave)
--           Extras: none warranted
--           Tanakh: Jeremiah 20:14-18 (Jeremiah likewise curses the day of his birth) — STRONG lateral [thread 1]
--   v.11-19 "There the wicked cease... there the weary be at rest... small and great are there;
--            and the servant is free from his master"
--           NT:     none warranted here (rest-answered handled at v.20-23)
--           Extras: none warranted
--           Tanakh: Ecclesiastes 4:1-3 (the dead/never-born vs. the oppressed under the sun);
--                   Ecclesiastes 6:3-5 (the untimely birth has more rest than the unsatisfied) — STRONG lateral [thread 2]
--   v.20-23 "Wherefore is light given to him that is in misery... which long for death, but it cometh not"
--           NT:     Isaiah 53:3 is Tanakh; FORWARD-light = Revelation 14:13 (the dead who die in Yahuah rest from labours) [thread 3]
--           Extras: none warranted
--           Tanakh: Isaiah 53:3 (a man of sorrows, and acquainted with grief — the righteous Sufferer who shares the cry) [thread 3]
--   v.24-26 "the thing which I greatly feared is come upon me"
--           NT/Extras/Tanakh: none warranted as a standalone thread (folded into the lament's frame; quality over quantity)
--
-- Threads (3):
--   1. job-3-let-the-day-perish-jeremiah-likewise-cursed-the-day-of-his-birth        [free]  Tanakh lateral (Jeremiah 20)
--   2. job-3-there-the-weary-be-at-rest-the-grave-where-the-oppressed-are-free        [free]  Tanakh lateral (Ecclesiastes 4 + 6)
--   3. job-3-wherefore-is-light-given-to-him-that-is-in-misery-the-sufferer-shares-the-cry  [free]  Tanakh (Isaiah 53:3) + NT forward (Revelation 14:13)

CREATE TEMP VIEW _s318_job03_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================ CROSS_REFERENCES ============================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: Let the day perish — Jeremiah likewise cursed the day of his birth
    ('canon','job',3,3,'canon','jeremiah',20,14,'free',
      E'*Cursed be the day wherein I was born: let not the day wherein my mother bare me be blessed.* (Jeremiah 20:14) When Job opens his mouth — *Let the day perish wherein I was born* (Job 3:3) — he is not the first nor the last righteous one to cry it. The weeping prophet voices the very same lament, word for word in its shape. Two faithful men, crushed, curse the day of their birth — and the canon records the cry without condemning it.'),
    ('canon','job',3,3,'canon','jeremiah',20,15,'free',
      E'*Cursed be the man who brought tidings to my father, saying, A man child is born unto thee; making him very glad.* (Jeremiah 20:15) Job''s curse strikes at the night *in which it was said, There is a man child conceived* (Job 3:3); Jeremiah''s strikes at the messenger who carried the same glad news. The despair reaches all the way back to the announcement of life itself — the depth of the righteous sufferer''s anguish, not his apostasy.'),
    ('canon','job',3,10,'canon','jeremiah',20,17,'free',
      E'*Because he slew me not from the womb; or that my mother might have been my grave, and her womb to be always great with me.* (Jeremiah 20:17) Job grieves that the womb *shut not up the doors of my mother''s womb, nor hid sorrow from mine eyes* (Job 3:10); Jeremiah wishes the womb had been his grave. The same longing — that the place of birth had been the place of rest — binds the two laments into one.'),
    ('canon','job',3,11,'canon','jeremiah',20,18,'free',
      E'*Wherefore came I forth out of the womb to see labour and sorrow, that my days should be consumed with shame?* (Jeremiah 20:18) Job asks *Why died I not from the womb? why did I not give up the ghost when I came out of the belly?* (Job 3:11); Jeremiah asks why he came forth at all, only to see *labour and sorrow*. The question of the righteous in the depths — held inside faith, never severed from it.'),

    -- Thread 2: There the weary be at rest — the grave where the oppressed are free
    ('canon','job',3,17,'canon','ecclesiastes',4,1,'free',
      E'*So I returned, and considered all the oppressions that are done under the sun: and behold the tears of such as were oppressed, and they had no comforter; and on the side of their oppressors there was power; but they had no comforter.* (Ecclesiastes 4:1) Job sees a place where *the wicked cease from troubling; and there the weary be at rest* (Job 3:17). The Preacher names the trouble Job longs to escape — the tears of the oppressed who have no comforter; both look past it to the silence of the grave.'),
    ('canon','job',3,13,'canon','ecclesiastes',4,2,'free',
      E'*Wherefore I praised the dead which are already dead more than the living which are yet alive.* (Ecclesiastes 4:2) Job pictures the rest he was denied — *For now should I have lain still and been quiet, I should have slept: then had I been at rest* (Job 3:13). The Preacher reaches the same weary verdict, praising the dead above the living; the honest speech of faith pressed to its limit.'),
    ('canon','job',3,16,'canon','ecclesiastes',4,3,'free',
      E'*Yea, better is he than both they, which hath not yet been, who hath not seen the evil work that is done under the sun.* (Ecclesiastes 4:3) Job envies the one who never was — *as an hidden untimely birth I had not been; as infants which never saw light* (Job 3:16). The Preacher pronounces the never-born better than both the dead and the living; the very thought Job voices from the ash-heap.'),
    ('canon','job',3,16,'canon','ecclesiastes',6,3,'free',
      E'*If a man beget an hundred children, and live many years, so that the days of his years be many, and his soul be not filled with good, and also that he have no burial; I say, that an untimely birth is better than he.* (Ecclesiastes 6:3) Job calls himself better off as *an hidden untimely birth* (Job 3:16); the Preacher weighs the same: the untimely birth is better than the long-lived soul never filled with good. The grave, to the one in misery, looks like mercy.'),
    ('canon','job',3,13,'canon','ecclesiastes',6,5,'free',
      E'*Moreover he hath not seen the sun, nor known any thing: this hath more rest than the other.* (Ecclesiastes 6:5) Job longs to have *slept: then had I been at rest* (Job 3:13). The Preacher says the untimely birth that never saw the sun *hath more rest than the other* — naming, with Job, the grave as the place where the burdened finally rest.'),
    ('canon','job',3,19,'canon','ecclesiastes',6,6,'free',
      E'*Yea, though he live a thousand years twice told, yet hath he seen no good: do not all go to one place?* (Ecclesiastes 6:6) Job sees the great leveling: *The small and great are there; and the servant is free from his master* (Job 3:19). The Preacher seals it — *do not all go to one place?* In the grave the kings and the prisoners, the master and the freed servant, come at last to the same ground.'),

    -- Thread 3: Wherefore is light given to him that is in misery — the Sufferer shares the cry
    ('canon','job',3,20,'canon','isaiah',53,3,'free',
      E'*He is despised and rejected of men; a man of sorrows, and acquainted with grief: and we hid as it were our faces from him; he was despised, and we esteemed him not.* (Isaiah 53:3) Job asks *Wherefore is light given to him that is in misery, and life unto the bitter in soul* (Job 3:20). The righteous Servant does not answer the cry from a distance — he is himself *a man of sorrows, and acquainted with grief*. The Formed Son enters the very depth Job names, and bears it.'),
    ('canon','job',3,25,'canon','isaiah',53,4,'free',
      E'*Surely he hath borne our griefs, and carried our sorrows: yet we did esteem him stricken, smitten of Elohim (God), and afflicted.* (Isaiah 53:4) Job confesses *the thing which I greatly feared is come upon me, and that which I was afraid of is come unto me* (Job 3:25). The Servant carries the griefs and sorrows of such men — the dread that falls on the righteous is gathered up and borne by the One *smitten of Elohim (God), and afflicted*.'),
    ('canon','job',3,21,'canon','revelation',14,13,'free',
      E'*And I heard a voice from heaven saying unto me, Write, Blessed are the dead which die in Yahuah (Lord) from henceforth: Yea, saith the Spirit, that they may rest from their labours; and their works do follow them.* (Revelation 14:13) Job''s cry — *Which long for death, but it cometh not; and dig for it more than for hid treasures* (Job 3:21) — reaches forward to its answer. The rest he digs for in the grave is given, in Yahuah (Lord), to the faithful: they *rest from their labours*, and the longing is met at last.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job03_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job03_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================ THREADS ============================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-3-let-the-day-perish-jeremiah-likewise-cursed-the-day-of-his-birth',
       E'Let the day perish — Jeremiah likewise cursed the day of his birth',
       E'Job opens his mouth and curses his day: *Let the day perish wherein I was born, and the night in which it was said, There is a man child conceived* (Job 3:3). He wishes the womb had been his grave — *Because it shut not up the doors of my mother''s womb, nor hid sorrow from mine eyes* (Job 3:10) — and asks *Why died I not from the womb? why did I not give up the ghost when I came out of the belly?* (Job 3:11). This is the honest cry of the righteous in the depths, recorded without rebuke.\n\nJob is not alone. The weeping prophet voices the same lament, almost word for word: *Cursed be the day wherein I was born: let not the day wherein my mother bare me be blessed* (Jeremiah 20:14), *Cursed be the man who brought tidings to my father, saying, A man child is born unto thee; making him very glad* (Jeremiah 20:15). Jeremiah, too, wishes *that my mother might have been my grave, and her womb to be always great with me* (Jeremiah 20:17), and asks *Wherefore came I forth out of the womb to see labour and sorrow, that my days should be consumed with shame?* (Jeremiah 20:18).\n\nTwo faithful men, crushed under the hand of Yahuah (LORD), curse the day of their birth — and the canon holds the cry inside faith, never severing it. This is not the sin the friends will later accuse; it is the lament of the righteous, and Scripture lets it stand.',
       sv.verse_id, ev.verse_id, 'free', 32850
  FROM _s318_job03_lookup sv, _s318_job03_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=3 AND sv.verse_number=3
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=3 AND ev.verse_number=11
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-3-there-the-weary-be-at-rest-the-grave-where-the-oppressed-are-free',
       E'There the weary be at rest — the grave where the oppressed are free',
       E'From the ash-heap Job looks past his pain to the silence of the grave, and sees it as rest: *For now should I have lain still and been quiet, I should have slept: then had I been at rest* (Job 3:13). It is the great leveling — *There the wicked cease from troubling; and there the weary be at rest* (Job 3:17); *There the prisoners rest together; they hear not the voice of the oppressor* (Job 3:18); *The small and great are there; and the servant is free from his master* (Job 3:19). He even envies the one who never was: *as an hidden untimely birth I had not been; as infants which never saw light* (Job 3:16).\n\nThe Preacher walks the same ground. He considers *all the oppressions that are done under the sun... the tears of such as were oppressed, and they had no comforter* (Ecclesiastes 4:1), and from weariness *praised the dead which are already dead more than the living which are yet alive* (Ecclesiastes 4:2) — counting better still *he... which hath not yet been, who hath not seen the evil work that is done under the sun* (Ecclesiastes 4:3). He weighs the unsatisfied long-lived soul against the never-born and rules *that an untimely birth is better than he* (Ecclesiastes 6:3), for it *hath not seen the sun, nor known any thing: this hath more rest than the other* (Ecclesiastes 6:5).\n\nAnd both end at one place: *do not all go to one place?* (Ecclesiastes 6:6) — the very ground where, in Job''s words, the servant is free from his master. This is the honest speech of faith pressed to its limit, naming the grave as the place where the burdened finally rest.',
       sv.verse_id, ev.verse_id, 'free', 32851
  FROM _s318_job03_lookup sv, _s318_job03_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=3 AND sv.verse_number=13
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=3 AND ev.verse_number=19
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-3-wherefore-is-light-given-to-him-that-is-in-misery-the-sufferer-shares-the-cry',
       E'Wherefore is light given to him that is in misery — the Sufferer shares the cry',
       E'Job''s lament narrows to its hardest question: *Wherefore is light given to him that is in misery, and life unto the bitter in soul; Which long for death, but it cometh not; and dig for it more than for hid treasures* (Job 3:20-21). And he names the dread that has overtaken him: *For the thing which I greatly feared is come upon me, and that which I was afraid of is come unto me* (Job 3:25).\n\nThe canon does not answer this cry from a distance. The righteous Servant of Yahuah (LORD) enters the very depth Job names: *He is despised and rejected of men; a man of sorrows, and acquainted with grief* (Isaiah 53:3). The dread that falls on the faithful is not waved away but gathered up — *Surely he hath borne our griefs, and carried our sorrows: yet we did esteem him stricken, smitten of Elohim (God), and afflicted* (Isaiah 53:4). The Formed Son, who later took on flesh, knows the bitter soul from the inside.\n\nAnd the death Job digs for and cannot find is, at the last, answered with rest — not by ceasing, but in Yahuah (Lord): *Blessed are the dead which die in Yahuah (Lord) from henceforth: Yea, saith the Spirit, that they may rest from their labours; and their works do follow them* (Revelation 14:13). The longing of the one in misery is held, shared, and finally met.',
       sv.verse_id, ev.verse_id, 'free', 32852
  FROM _s318_job03_lookup sv, _s318_job03_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=3 AND sv.verse_number=20
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=3 AND ev.verse_number=25
ON CONFLICT (slug) DO NOTHING;

-- ============================ THREAD MEMBERS ============================
-- Thread 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*Cursed be the day wherein I was born* (Jeremiah 20:14) — Jeremiah''s lament opens with Job''s very curse upon the day of birth.'
