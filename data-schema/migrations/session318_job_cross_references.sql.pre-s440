  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-10-thine-hands-have-made-me-the-clay-the-creator-who-formed-me-in-the-womb'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- MEMBERS — THREAD 2
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*dust thou art, and unto dust shalt thou return* (Genesis 3:19) — the garden-sentence behind Job''s dread of the dust.'
  FROM cross_reference_threads t
  JOIN _s318_job10_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=10 AND sv.verse_number=9
