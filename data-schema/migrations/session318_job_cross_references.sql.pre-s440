-- ----- fragment: minion_job_5.sql (Job 5) -----
-- Book: Job  Chapter: 5  (Eliphaz the Temanite continues his first speech)
-- Session prefix: s318   Tag: job05   Temp view: _s318_job05_lookup
-- Slug prefix: job-5-...   sort_order band: 32900 (+1 per thread)
--
-- FRAMING NOTE: Eliphaz's governing DOCTRINE — that Job's suffering proves hidden
-- sin and is corrective discipline — is partly FALSE as applied to Job (the prologue
-- ch.1-2 names Job "perfect and upright," and Yahuah rebukes the three friends at
-- 42:7 for not speaking what is right). Yet individual SAYINGS inside the flawed
-- speech are TRUE in themselves and are quoted as scripture in the NT. The apparatus
-- threads the true sayings (5:11, 5:13, 5:17, 5:18) WITHOUT endorsing the misapplied
-- doctrine that all suffering is divine correction-for-sin.
--
-- Job 5 coverage:
--   v.1-7  NT: none warranted   Extras: none warranted   Tanakh: none warranted (Eliphaz's accusatory setup)
--   v.8-10 NT: none warranted   Extras: none warranted   Tanakh: none warranted (general doxology)
--   v.11   NT: none warranted   Extras: none warranted   Tanakh: Ps 113:7 + 1 Sam 2:7-8 (raises the low) -> threaded
--   v.12   NT: 1 Cor 3:19-20 (with v.13)   Extras: none   Tanakh: none -> folded into v.13 thread
--   v.13   NT: 1 Cor 3:19 (VERBATIM citation)   Extras: none warranted   Tanakh: none -> threaded
--   v.14-16 NT: none warranted  Extras: none warranted   Tanakh: none warranted
--   v.17   NT: Prov->Heb 12:5-6 (the chastening of sons)   Extras: none   Tanakh: Prov 3:11-12 -> threaded
--   v.18   NT: none warranted   Extras: none warranted   Tanakh: Deut 32:39 + Hosea 6:1 + 1 Sam 2:6 (kills/heals, one hand) -> threaded
--   v.19-27 NT: none warranted  Extras: none warranted   Tanakh: none warranted (Eliphaz's restoration promise)
--
-- Threads (slug -> target libraries):
--   job-5-13-he-taketh-the-wise-in-their-own-craftiness   [free; canon Tanakh+NT] -> 1 Cor 3:19 (apostolic verbatim citation of Job, Eliphaz the speaker noted)
--   job-5-17-happy-the-man-whom-elohim-correcteth         [free; canon Tanakh+NT] -> Prov 3:11-12, Heb 12:5-6
--   job-5-18-he-woundeth-and-his-hands-make-whole         [free; canon Tanakh]    -> Deut 32:39, Hosea 6:1, 1 Sam 2:6
--   job-5-11-set-up-on-high-those-that-be-low             [free; canon Tanakh]    -> Ps 113:7, 1 Sam 2:7-8

CREATE TEMP VIEW _s318_job05_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================================================
-- B. cross_references
-- ============================================================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- job-5-13 : He taketh the wise in their own craftiness (Eliphaz speaking; Paul cites it as scripture)
    ('canon','job',5,13,'canon','1-corinthians',3,19,'free',
      E'*For the wisdom of this world is foolishness with Elohim (God). For it is written, He taketh the wise in their own craftiness.* (1 Corinthians 3:19). Paul quotes Job''s line VERBATIM and names it scripture — *for it is written* — even though the words fall within a friend''s flawed speech. *He taketh the wise in their own craftiness: and the counsel of the froward is carried headlong* (Job 5:13). The true saying survives the misapplied doctrine: Yahuah (the LORD) snares the schemer with his own scheme.'),
    ('canon','job',5,13,'canon','1-corinthians',3,20,'free',
      E'*And again, Yahuah (Lord) knoweth the thoughts of the wise, that they are vain* (1 Corinthians 3:20). Paul pairs Job''s craftiness-line with Psalm 94:11 to seal the same verdict — the cleverness of the proud is undone by the One who reads their counsel. It answers *He taketh the wise in their own craftiness* (Job 5:13).'),
    ('canon','job',5,12,'canon','1-corinthians',3,19,'free',
      E'*For the wisdom of this world is foolishness with Elohim (God). For it is written, He taketh the wise in their own craftiness* (1 Corinthians 3:19). The verse Paul cites stands in a couplet with this one: *He disappointeth the devices of the crafty, so that their hands cannot perform their enterprise* (Job 5:12). The crafty plot and Yahuah (the LORD) empties their hands — the whole couplet is the wisdom Paul ratifies.'),
    -- job-5-17 : happy is the man whom Elohim correcteth (the chastening of sons)
    ('canon','job',5,17,'canon','proverbs',3,11,'free',
      E'*My son, despise not the chastening of Yahuah (LORD); neither be weary of his correction* (Proverbs 3:11). Eliphaz''s saying and Proverbs use the very same words — *despise not the chastening* — naming the discipline of Yahuah (the LORD) as a thing not to be spurned. Job 5:17: *therefore despise not thou the chastening of the Almighty.*'),
    ('canon','job',5,17,'canon','proverbs',3,12,'free',
      E'*For whom Yahuah (LORD) loveth he correcteth; even as a father the son in whom he delighteth* (Proverbs 3:12). The correction is a FATHER''S, not a judge''s — the mark of sonship and delight, not of rejection. So Eliphaz''s line is read rightly: *happy is the man whom Elohim (God) correcteth* (Job 5:17).'),
    ('canon','job',5,17,'canon','hebrews',12,5,'free',
      E'*And ye have forgotten the exhortation which speaketh unto you as unto children, My son, despise not thou the chastening of Yahuah (Lord), nor faint when thou art rebuked of him* (Hebrews 12:5). The writer of Hebrews roots the discipline of sons HERE — quoting the same Proverbs line that echoes Job — calling chastening proof of fatherhood, not wrath. It fills *despise not thou the chastening of the Almighty* (Job 5:17).'),
    ('canon','job',5,17,'canon','hebrews',12,6,'free',
      E'*For whom Yahuah (Lord) loveth he chasteneth, and scourgeth every son whom he receiveth* (Hebrews 12:6). The chastening of *the man whom Elohim (God) correcteth* (Job 5:17) is named love and reception of a son — the NT''s doctrine of discipline drawn straight from this soil.'),
    -- job-5-18 : he maketh sore, and bindeth up; he woundeth, and his hands make whole
    ('canon','job',5,18,'canon','deuteronomy',32,39,'free',
      E'*See now that I, even I, am he, and there is no god with me: I kill, and I make alive; I wound, and I heal: neither is there any that can deliver out of my hand* (Deuteronomy 32:39). The Song of Moses says with the divine "I" what Eliphaz says of the divine hand: *he woundeth, and his hands make whole* (Job 5:18). One hand wounds and heals — Yahuah (the LORD) alone, none beside him.'),
    ('canon','job',5,18,'canon','hosea',6,1,'free',
      E'*Come, and let us return unto Yahuah (LORD): for he hath torn, and he will heal us; he hath smitten, and he will bind us up* (Hosea 6:1). Hosea calls the two houses to return to the SAME hand that tore — *he maketh sore, and bindeth up* (Job 5:18) — because the wounding and the binding are one work of one Yahuah (the LORD).'),
    ('canon','job',5,18,'canon','1-samuel',2,6,'free',
      E'*Yahuah (LORD) killeth, and maketh alive: he bringeth down to the grave, and bringeth up* (1 Samuel 2:6). Hannah''s song confesses the same sovereign hand: *he woundeth, and his hands make whole* (Job 5:18). Death and life, the grave and the rising, are held in one hand.'),
    -- job-5-11 : to set up on high those that be low
    ('canon','job',5,11,'canon','psalms',113,7,'free',
      E'*He raiseth up the poor out of the dust, and lifteth the needy out of the dunghill* (Psalm 113:7). The Psalm sings what Eliphaz states: *To set up on high those that be low; that those which mourn may be exalted to safety* (Job 5:11). The reversal of the low is the signature of Yahuah (the LORD).'),
    ('canon','job',5,11,'canon','1-samuel',2,7,'free',
      E'*Yahuah (LORD) maketh poor, and maketh rich: he bringeth low, and lifteth up* (1 Samuel 2:7). Hannah names the same up-ending — the low set on high — that Job 5:11 describes: *To set up on high those that be low.*'),
    ('canon','job',5,11,'canon','1-samuel',2,8,'free',
      E'*He raiseth up the poor out of the dust, and lifteth up the beggar from the dunghill, to set them among princes, and to make them inherit the throne of glory* (1 Samuel 2:8). The same lifting from the dust to the throne fills out *that those which mourn may be exalted to safety* (Job 5:11).')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job05_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job05_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================================================
-- C. threads
-- ============================================================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-5-13-he-taketh-the-wise-in-their-own-craftiness',
  E'He taketh the wise in their own craftiness',
  E'Eliphaz declares of Yahuah (the LORD): *He disappointeth the devices of the crafty, so that their hands cannot perform their enterprise* (Job 5:12), *He taketh the wise in their own craftiness: and the counsel of the froward is carried headlong* (Job 5:13). The schemer is snared by his own scheme. Eliphaz''s larger doctrine — that Job''s affliction proves hidden sin — is rebuked by Yahuah at the end of the book (42:7); but THIS saying is true in itself, and Paul quotes it as scripture: *For the wisdom of this world is foolishness with Elohim (God). For it is written, He taketh the wise in their own craftiness* (1 Corinthians 3:19), then seals it with the Psalm, *And again, Yahuah (Lord) knoweth the thoughts of the wise, that they are vain* (1 Corinthians 3:20). The canon reads itself: an apostle lifts a line from a friend''s flawed speech and ratifies the true word inside it — the cleverness of the proud is overthrown by the One who reads their counsel.',
  sv.verse_id, ev.verse_id, 'free', 32900
  FROM _s318_job05_lookup sv, _s318_job05_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=5 AND sv.verse_number=12
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=5 AND ev.verse_number=13
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-5-17-happy-the-man-whom-elohim-correcteth',
  E'Happy is the man whom Elohim correcteth — the chastening of sons',
  E'*Behold, happy is the man whom Elohim (God) correcteth: therefore despise not thou the chastening of the Almighty* (Job 5:17). The saying is true even where Eliphaz misapplies it to Job: discipline received as a son''s is a blessing, not a curse. Proverbs carries the same words — *My son, despise not the chastening of Yahuah (LORD); neither be weary of his correction* (Proverbs 3:11), *For whom Yahuah (LORD) loveth he correcteth; even as a father the son in whom he delighteth* (Proverbs 3:12) — naming it a FATHER''S love, the mark of delight in a son. Hebrews roots the whole NT doctrine of discipline in this soil, quoting the line: *My son, despise not thou the chastening of Yahuah (Lord), nor faint when thou art rebuked of him* (Hebrews 12:5), *For whom Yahuah (Lord) loveth he chasteneth, and scourgeth every son whom he receiveth* (Hebrews 12:6). Chastening is proof of sonship and reception, never of rejection — the true word that survives the false frame.',
  sv.verse_id, ev.verse_id, 'free', 32901
  FROM _s318_job05_lookup sv, _s318_job05_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=5 AND sv.verse_number=17
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=5 AND ev.verse_number=17
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-5-18-he-woundeth-and-his-hands-make-whole',
  E'He woundeth, and his hands make whole — one hand kills and makes alive',
  E'*For he maketh sore, and bindeth up: he woundeth, and his hands make whole* (Job 5:18). The wounding and the healing are ONE work of ONE hand — and the canon says it again and again of Yahuah (the LORD) alone. The Song of Moses puts it in the divine "I": *See now that I, even I, am he, and there is no god with me: I kill, and I make alive; I wound, and I heal: neither is there any that can deliver out of my hand* (Deuteronomy 32:39). Hannah confesses it: *Yahuah (LORD) killeth, and maketh alive: he bringeth down to the grave, and bringeth up* (1 Samuel 2:6). And Hosea turns it into a call to the two houses to RETURN: *Come, and let us return unto Yahuah (LORD): for he hath torn, and he will heal us; he hath smitten, and he will bind us up* (Hosea 6:1). The same hand that tears is the hand that binds — there is no second power to flee to, only the One to return to.',
  sv.verse_id, ev.verse_id, 'free', 32902
  FROM _s318_job05_lookup sv, _s318_job05_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=5 AND sv.verse_number=18
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=5 AND ev.verse_number=18
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-5-11-set-up-on-high-those-that-be-low',
  E'To set up on high those that be low',
  E'*To set up on high those that be low; that those which mourn may be exalted to safety* (Job 5:11). The reversal of the low — the poor lifted, the mourner exalted — is the signature work of Yahuah (the LORD), sung across the canon. The Psalm: *He raiseth up the poor out of the dust, and lifteth the needy out of the dunghill* (Psalm 113:7). Hannah''s song: *Yahuah (LORD) maketh poor, and maketh rich: he bringeth low, and lifteth up* (1 Samuel 2:7), *He raiseth up the poor out of the dust, and lifteth up the beggar from the dunghill, to set them among princes, and to make them inherit the throne of glory* (1 Samuel 2:8). The dust to the throne — the same lifting Eliphaz names is the same lifting Hannah and the Psalmist celebrate as the heart of Yahuah''s governance.',
  sv.verse_id, ev.verse_id, 'free', 32903
  FROM _s318_job05_lookup sv, _s318_job05_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=5 AND sv.verse_number=11
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=5 AND ev.verse_number=11
ON CONFLICT (slug) DO NOTHING;

