-- ----- fragment: minion_job_16.sql (Job 16) -----
-- Book: Job   Chapter: 16   (Job's reply: miserable comforters and the witness on high)
-- Session prefix: s318   Tag: job16   Temp view: _s318_job16_lookup
-- Sort band start: 33175 (+1 per thread)
-- Source: canon / job / chapter 16
--
-- THREADS (3):
--   33175  job-16-miserable-comforters-are-ye-all                  [Tanakh]            tier free
--   33176  job-16-he-hath-set-me-up-for-his-mark                   [Tanakh]            tier free
--   33177  job-16-my-witness-is-in-heaven-the-advocate-who-pleads  [Tanakh + NT]       tier free
--
-- COVERAGE CHECKLIST (each meaningful verse-block; all three libraries weighed):
--   v.2  (miserable comforters are ye all — the friends' failure)
--        NT:     none warranted (the comforter-failure motif is carried laterally within the Tanakh)
--        Extras: none warranted
--        Tanakh: Job 13:4 (forgers of lies, physicians of no value) ; Psalm 69:20 (I looked... for comforters, but I found none)  [thread 1]
--   v.3-6  (vain words; I also could speak as ye do; my grief not asswaged)
--        NT/Extras/Tanakh: none warranted (Job's rhetoric; covered by the comforter-failure frame of v.2)
--   v.7-10  (he hath made me weary; teareth me in his wrath; gaped upon me; smitten on the cheek)
--        NT:     none warranted (smitten-cheek echoes Isa 50:6 / Lam 3:30 but is not Job's load here)
--        Extras: none warranted
--        Tanakh: folded into thread 2 (the same assault that climaxes in "set me up for his mark")
--   v.11-14  (delivered to the ungodly; broken asunder; set me up for his mark; his archers compass me)
--        NT:     none warranted (the suffering-righteous type runs forward, but Job's mark/archers image is Tanakh-internal)
--        Extras: none warranted
--        Tanakh: Lamentations 3:12-13 (set me as a mark for the arrow; the arrows of his quiver into my reins)  [thread 2]
--   v.15-18  (sackcloth; face foul with weeping; no injustice in mine hands; O earth cover not my blood)
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: none warranted (innocence-protest folds into the witness-on-high cry of v.19)
--   v.19-22  (★ my witness is in heaven, my record on high; O that one might plead for a man with Elohim)
--        NT:     1 John 2:1 (an advocate with the Father) ; Romans 8:34 (maketh intercession) ; Hebrews 7:25 (he ever liveth to make intercession)
--        Extras: none warranted
--        Tanakh: Job 9:33 (neither is there any daysman betwixt us) ; Job 19:25 (I know that my redeemer liveth)  [thread 3]
--
-- FRAMEWORK NOTE (thread 3, contested): 16:19-21 is one of the Tanakh's Messianic advocate-longings.
-- The "witness in heaven" / "one to plead for a man with Elohim" is the same daysman-longing of Job 9:33,
-- answered FORWARD in the Formed Son the advocate — who HAS a Father (1 John 2:1, "an advocate WITH the
-- Father"), who intercedes WITH the Father (Rom 8:34, "at the right hand of Elohim... maketh intercession"),
-- who "ever liveth to make intercession" (Heb 7:25). The Formed pleads man's cause before the Formless;
-- never a co-equal-trinity person, always the Son who has a Father and stands between. The suffering is the
-- testing of the righteous; the friends' failure is the indictment, not Job's guilt (his prayer is pure, 16:17).

CREATE TEMP VIEW _s318_job16_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================ CROSS_REFERENCES ============================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: miserable comforters (16:2) — the friends' failure (Tanakh lateral)
    ('canon','job',16,2,'canon','job',13,4,'free',
     E'*But ye are forgers of lies, ye are all physicians of no value.* (Job 13:4) — Job''s verdict on the very friends who came to comfort him. When he calls them *miserable comforters are ye all* (Job 16:2), this is the same indictment: men who should have healed the wound instead forged lies, *physicians of no value*. The failure is theirs, not Job''s — the comforters are the ones on trial.'),
    ('canon','job',16,2,'canon','psalms',69,20,'free',
     E'*Reproach hath broken my heart; and I am full of heaviness: and I looked for some to take pity, but there was none; and for comforters, but I found none.* (Psalm 69:20) — the suffering-righteous one looks for comforters and finds none, the very cry of Job''s *miserable comforters are ye all* (Job 16:2). The Psalter sings the same abandonment, the messianic-suffering lament where the righteous is left without a single true comforter.'),
    -- Thread 2: set me up for his mark / archers (16:12-13) — Tanakh lateral
    ('canon','job',16,12,'canon','lamentations',3,12,'free',
     E'*He hath bent his bow, and set me as a mark for the arrow.* (Lamentations 3:12) — Jeremiah''s lament takes up Job''s very image: where Job says *he hath... set me up for his mark* (Job 16:12), the man of sorrows in Lamentations is *set... as a mark for the arrow*. The righteous sufferer feels himself the target of El''s drawn bow, the testing of the upright that is never the verdict of guilt.'),
    ('canon','job',16,13,'canon','lamentations',3,13,'free',
     E'*He hath caused the arrows of his quiver to enter into my reins.* (Lamentations 3:13) — the same arrows that pierce Job: *His archers compass me round about, he cleaveth my reins asunder* (Job 16:13). Two righteous sufferers, one image — the quiver emptied into the reins — drawing Job''s ordeal into the canon''s long lament of the tested and afflicted just one.'),
    -- Thread 3: witness in heaven / one to plead (16:19,21) — Tanakh lateral + NT forward
    ('canon','job',16,21,'canon','job',9,33,'free',
     E'*Neither is there any daysman betwixt us, that might lay his hand upon us both.* (Job 9:33) — earlier Job mourned the absence of a mediator; now he reaches for one: *O that one might plead for a man with Elohim (God), as a man pleadeth for his neighbour!* (Job 16:21). The daysman-longing of chapter 9 becomes the open cry of chapter 16 — the ache for one who can stand between man and El and lay a hand on both.'),
    ('canon','job',16,19,'canon','job',19,25,'free',
     E'*For I know that my redeemer liveth, and that he shall stand at the latter day upon the earth:* (Job 19:25) — the witness-in-heaven cry deepens into certainty. Where Job says *behold, my witness is in heaven, and my record is on high* (Job 16:19), three chapters on he names that witness: a living Redeemer who shall stand for him. The heavenly advocate Job longed for is the Goel, the kinsman who vindicates.'),
    ('canon','job',16,19,'canon','1-john',2,1,'free',
     E'*My little children, these things write I unto you, that ye sin not. And if any man sin, we have an advocate with the Father, Yahusha HaMashiach (Jesus Christ) the righteous:* (1 John 2:1) — Job''s *my witness is in heaven, and my record is on high* (Job 16:19) is answered forward in the Formed Son the advocate. Note the grammar that holds the whole framework: an advocate *with the Father* — the Son who pleads man''s cause has a Father, stands between, never collapsed into a co-equal person.'),
    ('canon','job',16,21,'canon','romans',8,34,'free',
     E'*Who is he that condemneth? It is Messiah (Christ) that died, yea rather, that is risen again, who is even at the right hand of Elohim (God), who also maketh intercession for us.* (Romans 8:34) — Job''s longing, *O that one might plead for a man with Elohim (God)* (Job 16:21), is fulfilled: the risen Messiah at the right hand of Elohim *maketh intercession for us*. The one who pleads a man''s cause before El is the Formed Son who died and rose — the daysman come at last.'),
    ('canon','job',16,21,'canon','hebrews',7,25,'free',
     E'*Wherefore he is able also to save them to the uttermost that come unto Elohim (God) by him, seeing he ever liveth to make intercession for them.* (Hebrews 7:25) — the heavenly advocate Job cried for, *as a man pleadeth for his neighbour!* (Job 16:21), is the priest after Melek Tsadiq (Melchizedek) who *ever liveth to make intercession*. Job''s witness on high is no silent record but a living priest who pleads without ceasing before the Father.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job16_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job16_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================ THREADS ============================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-16-miserable-comforters-are-ye-all',
       E'Miserable comforters are ye all',
       E'Job answers his friends with the verdict the whole chapter rests on: *I have heard many such things: miserable comforters are ye all.* (Job 16:2) The men who came to console him have only wounded — he had already named them *forgers of lies, ye are all physicians of no value* (Job 13:4). The failure is theirs, not his; the comforters are the ones indicted, not the sufferer. And the Psalter sings the same abandonment of the righteous one: *Reproach hath broken my heart; and I am full of heaviness: and I looked for some to take pity, but there was none; and for comforters, but I found none.* (Psalm 69:20) The tested just man is left without a single true comforter — the lament Job opens here runs all the way through the canon''s song of the afflicted righteous.',
       sv.verse_id, ev.verse_id, 'free', 33175
  FROM _s318_job16_lookup sv, _s318_job16_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=16 AND sv.verse_number=2
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=16 AND ev.verse_number=2
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-16-he-hath-set-me-up-for-his-mark',
       E'He hath set me up for his mark',
       E'Job feels himself given over and made a target: *Elohim (God) hath delivered me to the ungodly, and turned me over into the hands of the wicked... he hath also taken me by my neck, and shaken me to pieces, and set me up for his mark. His archers compass me round about, he cleaveth my reins asunder.* (Job 16:11-13) This is the testing of the righteous, not the verdict of the guilty — Job''s prayer is pure (16:17). The same image returns in Jeremiah''s lament, where the man of sorrows is the target of El''s drawn bow: *He hath bent his bow, and set me as a mark for the arrow. He hath caused the arrows of his quiver to enter into my reins.* (Lamentations 3:12-13) Two righteous sufferers, one picture — the quiver emptied into the reins — binding Job''s ordeal to the canon''s long lament of the afflicted just one who is tested, not condemned.',
       sv.verse_id, ev.verse_id, 'free', 33176
  FROM _s318_job16_lookup sv, _s318_job16_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=16 AND sv.verse_number=12
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=16 AND ev.verse_number=13
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-16-my-witness-is-in-heaven-the-advocate-who-pleads',
       E'My witness is in heaven — the advocate who pleads for a man with Elohim',
       E'Out of the assault Job lifts his eyes and reaches past his accusers to one in heaven: *Also now, behold, my witness is in heaven, and my record is on high.* (Job 16:19) Then he cries the ache of the whole book: *O that one might plead for a man with Elohim (God), as a man pleadeth for his neighbour!* (Job 16:21) This is the daysman-longing he first mourned as absent — *Neither is there any daysman betwixt us, that might lay his hand upon us both* (Job 9:33) — now become an open prayer, and three chapters on it hardens into certainty: *For I know that my redeemer liveth, and that he shall stand at the latter day upon the earth* (Job 19:25). The witness on high is a living Goel who vindicates. The longing is answered forward in the Formed Son the advocate: *if any man sin, we have an advocate with the Father, Yahusha HaMashiach (Jesus Christ) the righteous* (1 John 2:1) — an advocate *with the Father*, the Son who pleads a man''s cause and has a Father, who stands between and is never collapsed into a co-equal person. He is *at the right hand of Elohim (God), who also maketh intercession for us* (Romans 8:34), the risen Messiah who pleads; and as the priest after Melek Tsadiq (Melchizedek) *he ever liveth to make intercession for them* (Hebrews 7:25). Job''s witness in heaven is no silent record but the living daysman come at last, pleading without ceasing before the Father.',
       sv.verse_id, ev.verse_id, 'free', 33177
  FROM _s318_job16_lookup sv, _s318_job16_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=16 AND sv.verse_number=19
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=16 AND ev.verse_number=21
ON CONFLICT (slug) DO NOTHING;

-- ============================ THREAD MEMBERS ============================
-- Thread 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*ye are all physicians of no value* (Job 13:4) — Job''s own verdict on the friends who failed to comfort.'
  FROM cross_reference_threads t
  JOIN _s318_job16_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=16 AND sv.verse_number=2
  JOIN _s318_job16_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=13 AND tv.verse_number=4
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-16-miserable-comforters-are-ye-all'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

