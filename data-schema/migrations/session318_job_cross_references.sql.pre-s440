-- ----- fragment: minion_job_40.sql (Job 40) -----
-- Chapter: Job 40 — Yahuah's challenge from the whirlwind, Job's first submission, and Behemoth
-- Tag: job40 ; session prefix s318 ; temp view _s318_job40_lookup
-- Sort band: 33775 (+1 per thread) -> 33775, 33776, 33777
-- Source: edition 'canon', book_slug 'job', chapter 40
--
-- Job 40 coverage:
--   v.2  (Shall he that contendeth instruct him / let him answer it)
--        NT:     Romans 3:19 (every mouth stopped); Romans 9:20 (who art thou that repliest) -> thread 1
--        Extras: none warranted (NT + Tanakh carry the silenced-creature weight)
--        Tanakh: Job 42:6; Psalm 39:9 -> thread 1
--   v.3-5 (JOB'S FIRST SUBMISSION — I am vile, lay mine hand upon my mouth, proceed no further)
--        NT:     Romans 3:19; Romans 9:20 -> thread 1
--        Extras: none warranted
--        Tanakh: Job 42:6 (full repentance); Psalm 39:9 (dumb because thou didst it) -> thread 1
--   v.6-9 (Gird up thy loins; hast thou an arm like Elohim)
--        NT:     none warranted (Tanakh arm-of-salvation block carries it forward)
--        Extras: none warranted
--        Tanakh: Isaiah 59:16; Psalm 98:1 -> thread 2
--   v.10-14 (Deck thyself with majesty... then will I confess thine own right hand can save thee)
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: Isaiah 59:16; Isaiah 63:5; Psalm 98:1; Psalm 33:16; Jonah 2:9 -> thread 2
--   v.15-19 (Behold now behemoth, which I made with thee; chief of the ways of Elohim)
--        NT:     none warranted (creature-mastery belongs to the Tanakh/extras frame)
--        Extras: 1 Enoch 60:7-8 (Behemoth named); 2 Esdras 6:50-52 (Leviathan reserved); Jubilees 2:11 (sea monsters made by His hands) -> thread 3
--        Tanakh: Psalm 50:10-11 (every beast is mine); Psalm 104:24-25 (manifold works) -> thread 3
--   v.20-24 (mountains bring him food... drinketh up a river... his nose pierceth through snares)
--        NT:     none warranted
--        Extras: 1 Enoch 60:7-8; 2 Esdras 6:50-52; Jubilees 2:11 -> thread 3
--        Tanakh: Psalm 50:10-11; Psalm 104:24-25 -> thread 3
--
-- Threads:
--   job-40-i-am-vile-i-will-lay-mine-hand-upon-my-mouth            (free)   Tanakh+NT  -> Job 42:6, Ps 39:9, Rom 3:19, Rom 9:20
--   job-40-thine-own-right-hand-cannot-save-only-els-arm-saves     (free)   Tanakh     -> Isa 59:16, Isa 63:5, Ps 98:1, Ps 33:16, Jonah 2:9
--   job-40-behemoth-the-chief-of-the-ways-of-el-mastered-by-maker  (extras) Tanakh+Extras -> Ps 50:10-11, Ps 104:24-25, 1 Enoch 60:7-8, 2 Esdras 6:50-52, Jubilees 2:11
--
-- Framing notes / guards:
--   * 40:4 "I am vile... I will lay mine hand upon my mouth" = the creature silenced before the Creator's
--     majesty, the BEGINNING of the true repentance completed in 42:6 — NOT the self-loathing the friends
--     tried to impose by false accusation, but the awe of the creature before El who needs no accounting.
--   * 40:14 "thine own right hand can save thee" framed as Yahuah's IRONY — anti-self-salvation, anti-flesh-merit:
--     only El's arm saves (Isaiah 59:16 / 63:5 / Psalm 98:1 / Jonah 2:9 "Salvation is of Yahuah").
--   * Behemoth = a REAL creature, the chief of El's creatures, whose mastery belongs to its Maker alone
--     (40:19 "he that made him can make his sword to approach unto him").
--   * Parse quoted EXACTLY: 40:2 reads "the Almighty" and "Elohim (God)" (not El Shaddai/Eloah) per dump_canon.

CREATE TEMP VIEW _s318_job40_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================ CROSS_REFERENCES ============================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: Job's first submission — the mouth stopped before the Creator
    ('canon','job',40,4,'canon','job',42,6,'free',
     E'After the whole storm of the whirlwind Job does not justify himself but melts: ''Wherefore I abhor myself, and repent in dust and ashes'' (Job 42:6). Job 40:4''s ''Behold, I am vile... I will lay mine hand upon my mouth'' is the FIRST submission; this is its completion — the creature silenced before El''s majesty passing into full repentance, never the self-loathing the friends tried to force, but the awe of the formed thing before its Former.'),
    ('canon','job',40,4,'canon','psalms',39,9,'free',
     E'''I was dumb, I opened not my mouth; because thou didst it'' (Psalm 39:9). The very gesture of Job 40:4 — ''I will lay mine hand upon my mouth'' — is David''s silence: the man stops his own complaint not because he is crushed by accusers but because he sees the hand of Yahuah (LORD) in it and submits.'),
    ('canon','job',40,2,'canon','romans',3,19,'free',
     E'''Now we know that what things soever the law saith, it saith to them who are under the law: that every mouth may be stopped, and all the world may become guilty before Elohim (God)'' (Romans 3:19). Job 40:2 demands, ''he that reproveth Elohim (God), let him answer it'' — and the creature cannot; the stopped mouth of Job is the stopped mouth of all flesh before the Judge.'),
    ('canon','job',40,2,'canon','romans',9,20,'free',
     E'''Nay but, O man, who art thou that repliest against Elohim (God)? Shall the thing formed say to him that formed it, Why hast thou made me thus?'' (Romans 9:20). This is Job 40:2 carried forward word for word — ''Shall he that contendeth with the Almighty instruct him?'' The thing formed cannot arraign the One who formed it; the only fitting answer is the hand laid upon the mouth.'),

    -- Thread 2: thine own right hand cannot save — only El''s arm saves
    ('canon','job',40,14,'canon','isaiah',59,16,'free',
     E'''And he saw that there was no man, and wondered that there was no intercessor: therefore his arm brought salvation unto him; and his righteousness, it sustained him'' (Isaiah 59:16). Job 40:14''s taunt — ''Then will I also confess unto thee that thine own right hand can save thee'' — is irony: no creature''s right hand saves; it is YAHUAH''s arm, not man''s, that brings salvation.'),
    ('canon','job',40,14,'canon','isaiah',63,5,'free',
     E'''And I looked, and there was none to help; and I wondered that there was none to uphold: therefore mine own arm brought salvation unto me; and my fury, it upheld me'' (Isaiah 63:5). The same answer to Job 40:14: where there is none to help, it is El''s OWN arm that saves — never the proud right hand of the creature challenged to deck itself with majesty.'),
    ('canon','job',40,9,'canon','psalms',98,1,'free',
     E'''O sing unto Yahuah (LORD) a new song; for he hath done marvellous things: his right hand, and his holy arm, hath gotten him the victory'' (Psalm 98:1). Job 40:9 asks, ''Hast thou an arm like Elohim (God)?'' — and the answer is no: the victory belongs to His right hand and His holy arm, the song the redeemed sing back to the only Saviour.'),
    ('canon','job',40,14,'canon','psalms',33,16,'free',
     E'''There is no king saved by the multitude of an host: a mighty man is not delivered by much strength'' (Psalm 33:16). The boast Yahuah (LORD) sets before Job in 40:14 collapses here — no strength of the creature, however mighty, delivers itself; deliverance is of Yahuah alone.'),
    ('canon','job',40,14,'canon','jonah',2,9,'free',
     E'''But I will sacrifice unto thee with the voice of thanksgiving; I will pay that that I have vowed. Salvation is of Yahuah (LORD)'' (Jonah 2:9). Out of the deep Jonah confesses what Job 40:14 forces from the proud heart: ''Salvation is of Yahuah (LORD)'' — never of thine own right hand.'),

    -- Thread 3: Behemoth, the chief of the ways of El, mastered by its Maker alone
    ('canon','job',40,15,'canon','psalms',50,10,'free',
     E'''For every beast of the forest is mine, and the cattle upon a thousand hills'' (Psalm 50:10). Job 40:15 — ''Behold now behemoth, which I made with thee'' — rests on this: the mightiest beast is Yahuah''s own handiwork and possession; man owns nothing he can master, El owns the greatest creature.'),
    ('canon','job',40,15,'canon','psalms',104,25,'free',
     E'''So is this great and wide sea, wherein are things creeping innumerable, both small and great beasts'' (Psalm 104:25). The creation-hymn that holds the great beasts in wisdom answers Behemoth in Job 40:15 — the chief of El''s creatures is one more wonder in the catalogue of works no man framed.'),
    ('canon','job',40,19,'enoch','1-enoch',60,7,'extras',
     E'''And on that day were two monsters parted, a female monster whose name is Leviathan, dwelling in the abysses of the ocean over the fountains of the waters'' (1 Enoch 60:7). The restored Enoch names the very pair Job 40 sets before us — Behemoth its mate — confirming that the chief of the ways of Elohim (God) (Job 40:19) is no myth but a real creature appointed and bounded by its Maker.'),
    ('canon','job',40,19,'enoch','1-enoch',60,8,'extras',
     E'''But the male is named Behemoth, who occupies with his breast a waste wilderness named Dudain, east of the garden where the elect and righteous dwell'' (1 Enoch 60:8). Enoch names Behemoth outright and gives him his appointed place — the untameable beast of Job 40:19 set in his bounds by El, who alone ''can make his sword to approach unto him.'''),
    ('canon','job',40,19,'apocrypha','2-esdras',6,52,'extras',
     E'''But to Leviathan you gavest the seventh part, namely, the moist; and have kept him to be devoured of whom you will, and when'' (2 Esdras 6:52). The great creature is reserved at the Maker''s pleasure — exactly the sovereignty of Job 40:19, ''he that made him can make his sword to approach unto him'': the Creator masters what no man can subdue.'),
    ('canon','job',40,15,'jubilees','jubilees',2,11,'extras',
     E'''And on the fifth day He created great sea monsters in the depths of the waters, for these were the first things of flesh that were created by His hands'' (Jubilees 2:11). Job 40:15''s ''behemoth, which I made with thee'' is rooted in creation week — the great creatures are the work of His hands, made and therefore wholly His to master.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job40_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job40_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================ THREADS ============================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-40-i-am-vile-i-will-lay-mine-hand-upon-my-mouth',
       E'Job 40: I am vile, I will lay mine hand upon my mouth',
       E'Out of the whirlwind Yahuah (LORD) presses the question that no creature can answer: ''Shall he that contendeth with the Almighty instruct him? he that reproveth Elohim (God), let him answer it'' (Job 40:2). And Job — who has demanded his day in court through forty chapters — at last breaks: ''Behold, I am vile; what shall I answer thee? I will lay mine hand upon my mouth. Once have I spoken; but I will not answer: yea, twice; but I will proceed no further'' (Job 40:4-5). This is the FIRST submission — not the self-loathing his friends tried to force on him by false accusation, but the awe of the formed creature before its Former. It is the beginning of the true repentance completed two chapters on: ''Wherefore I abhor myself, and repent in dust and ashes'' (Job 42:6). David knew the same silence — ''I was dumb, I opened not my mouth; because thou didst it'' (Psalm 39:9): the hand laid on the mouth not in being crushed but in seeing the hand of Yahuah in it. And the apostolic word carries Job 40:2 forward unchanged: ''that every mouth may be stopped, and all the world may become guilty before Elohim (God)'' (Romans 3:19); ''Nay but, O man, who art thou that repliest against Elohim (God)? Shall the thing formed say to him that formed it, Why hast thou made me thus?'' (Romans 9:20). The thing formed cannot arraign the One who formed it. The only fitting answer is the hand upon the mouth.',
       sv.verse_id, ev.verse_id, 'free', 33775
  FROM _s318_job40_lookup sv, _s318_job40_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=40 AND sv.verse_number=2
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=40 AND ev.verse_number=5
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-40-thine-own-right-hand-cannot-save-only-els-arm-saves',
       E'Job 40: only El''s arm saves — not thine own right hand',
       E'Yahuah (LORD) hands Job the throne of judgment and dares him to fill it: ''Hast thou an arm like Elohim (God)? or canst thou thunder with a voice like him?'' (Job 40:9). ''Deck thyself now with majesty and excellency... Cast abroad the rage of thy wrath: and behold every one that is proud, and abase him'' (Job 40:10-11). And then the irony that unmasks all flesh-merit: ''Then will I also confess unto thee that thine own right hand can save thee'' (Job 40:14) — IF you could do these things, you could save yourself; but you cannot, and you cannot. The creature does not deliver itself. The Tanakh answers with one voice: ''he saw that there was no man, and wondered that there was no intercessor: therefore his arm brought salvation unto him'' (Isaiah 59:16); ''there was none to uphold: therefore mine own arm brought salvation unto me'' (Isaiah 63:5); ''his right hand, and his holy arm, hath gotten him the victory'' (Psalm 98:1). No strength of the creature delivers it: ''There is no king saved by the multitude of an host: a mighty man is not delivered by much strength'' (Psalm 33:16). And from the belly of the deep the confession Job 40:14 forces from every proud heart: ''Salvation is of Yahuah (LORD)'' (Jonah 2:9). The right hand that saves is His alone.',
       sv.verse_id, ev.verse_id, 'free', 33776
  FROM _s318_job40_lookup sv, _s318_job40_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=40 AND sv.verse_number=6
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=40 AND ev.verse_number=14
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-40-behemoth-the-chief-of-the-ways-of-el-mastered-by-maker',
       E'Job 40: Behemoth, the chief of the ways of El, mastered by his Maker alone',
       E'''Behold now behemoth, which I made with thee; he eateth grass as an ox'' (Job 40:15). Yahuah (LORD) sets before Job the mightiest land-creature — ''his strength is in his loins''; ''his bones are as strong pieces of brass'' (Job 40:16, 18) — and crowns him: ''He is the chief of the ways of Elohim (God): he that made him can make his sword to approach unto him'' (Job 40:19). The chief of El''s creatures, untameable by man, is bounded and mastered by ONE alone — the Maker. ''He drinketh up a river, and hasteth not: he trusteth that he can draw up Jordan into his mouth'' (Job 40:23); no man takes him by the eyes or pierces his nose with snares. The Psalms ground the claim: ''every beast of the forest is mine, and the cattle upon a thousand hills'' (Psalm 50:10); ''this great and wide sea, wherein are things creeping innumerable, both small and great beasts'' (Psalm 104:25). The restored witnesses name the very creatures: ''were two monsters parted, a female monster whose name is Leviathan'' (1 Enoch 60:7), and ''the male is named Behemoth'' (1 Enoch 60:8), each set in his appointed place. They are reserved at El''s pleasure — ''have kept him to be devoured of whom you will, and when'' (2 Esdras 6:52) — for they are ''the first things of flesh that were created by His hands'' (Jubilees 2:11). The greatest creature man cannot subdue is the work of El''s hands, and his alone to master.',
       sv.verse_id, ev.verse_id, 'extras', 33777
  FROM _s318_job40_lookup sv, _s318_job40_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=40 AND sv.verse_number=15
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=40 AND ev.verse_number=24
ON CONFLICT (slug) DO NOTHING;

-- ============================ THREAD MEMBERS ============================
-- Thread 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'Job 42:6 — ''I abhor myself, and repent in dust and ashes'': the first submission of 40:4 completed in full repentance.'
  FROM cross_reference_threads t
  JOIN _s318_job40_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=40 AND sv.verse_number=4
  JOIN _s318_job40_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=42 AND tv.verse_number=6
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-40-i-am-vile-i-will-lay-mine-hand-upon-my-mouth'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'Psalm 39:9 — ''I was dumb... because thou didst it'': the silenced mouth that sees Yahuah''s hand and submits.'
  FROM cross_reference_threads t
  JOIN _s318_job40_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=40 AND sv.verse_number=4
  JOIN _s318_job40_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=39 AND tv.verse_number=9
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-40-i-am-vile-i-will-lay-mine-hand-upon-my-mouth'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'Romans 3:19 — ''every mouth may be stopped'': Job 40:2''s unanswerable challenge carried to all flesh.'
  FROM cross_reference_threads t
  JOIN _s318_job40_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=40 AND sv.verse_number=2
  JOIN _s318_job40_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='romans' AND tv.chapter_number=3 AND tv.verse_number=19
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-40-i-am-vile-i-will-lay-mine-hand-upon-my-mouth'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
