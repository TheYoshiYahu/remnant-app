INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('ecclesiastes',4,13,1,E'*Better is a poor and a wise child than an old and foolish king...* (Ecclesiastes 4:13) — wisdom is no respecter of crowns or years.'),
    ('1-corinthians',1,26,2,E'*...not many wise men after the flesh, not many mighty, not many noble, are called* (1 Corinthians 1:26) — standing does not make a man wise before El.'),
    ('1-corinthians',1,27,3,E'*...Elohim (God) hath chosen the foolish things of the world to confound the wise* (1 Corinthians 1:27) — the young Buzite confounding the aged.')
  ) AS m(tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
