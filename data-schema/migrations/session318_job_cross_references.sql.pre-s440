-- ----- fragment: minion_job_22.sql (Job 22) -----
-- Job chapter 22 — Eliphaz's third speech: the false accusation made explicit.
-- session prefix s318 ; tag job22 ; slug prefix job-22-... ; sort_order band 33325+ (+1 per thread)
-- temp view _s318_job22_lookup
--
-- LENS: Eliphaz now INVENTS specific sins (22:5-9) — pledge-stripping, water withheld, widows
-- sent empty, the arms of the fatherless broken — ALL FALSE. The prologue (Job 1:1, "perfect and
-- upright") and Job 31 (Job's own oath of innocence, the exact mirror) refute them, and Yahuah
-- HIMSELF rebukes the slander at Job 42:7 ("ye have not spoken of me the thing that is right").
-- The slander is FRAMED as the error; only the GENUINE wisdom buried in the false frame
-- (22:21-22 Torah from his mouth laid up in the heart; 22:27 prayer heard; 22:29 the humble
-- lifted up) is threaded FORWARD as a true word.
--
-- Job 22 coverage:
--   v.5-9  (the invented sins) NT:     none warranted (slander, not a fulfilled type)
--          Extras: none warranted
--          Tanakh: Job 31:16-22 (Job's mirror-oath of innocence) + Job 42:7 (Yahuah's verdict) — the rebuttal frame
--   v.12-14 (imputed wicked's creed "thick clouds... that he seeth not") NT: none warranted
--          Extras: none warranted
--          Tanakh: Psalm 139:7-8,11-12 (no fleeing his presence) + Isaiah 29:15 (woe to who say "who seeth us") — the creed answered
--   v.21-22 (Acquaint thyself; receive the law from his mouth, lay up his words in the heart) NT: none warranted here (the Tanakh Torah-on-heart cluster carries it)
--          Extras: none warranted
--          Tanakh: Deuteronomy 30:14 (the word in thy mouth and heart) + Psalm 119:11 (thy word hid in mine heart) + Jeremiah 31:33 (law in their inward parts) + Proverbs 2:1 (receive my words, hide my commandments) — the genuine word
--   v.27   (make thy prayer, and he shall hear thee) NT: none warranted
--          Extras: none warranted
--          Tanakh: Psalm 91:15 + Isaiah 58:9 + Jeremiah 29:12-13 (call and he answers) — prayer heard
--   v.29   (when men are cast down... There is lifting up; he saveth the humble) NT: James 4:6, James 4:10, 1 Peter 5:5, 1 Peter 5:6
--          Extras: none warranted
--          Tanakh: Proverbs 3:34 (he giveth grace unto the lowly — the root behind James/Peter)
--
-- Threads (5):
--   1 job-22-the-invented-sins-the-slander-Yahuah-rebukes        [Tanakh]      (22:5-9 -> Job 31:16,17,19,21,22; Job 42:7)
--   2 job-22-thick-clouds-a-covering-but-no-fleeing-his-presence [Tanakh]      (22:12-14 -> Ps 139:7,8,12; Isa 29:15)
--   3 job-22-receive-the-law-from-his-mouth-laid-up-in-the-heart [Tanakh]      (22:21-22 -> Deut 30:14; Ps 119:11; Jer 31:33; Prov 2:1)
--   4 job-22-make-thy-prayer-and-he-shall-hear-thee              [Tanakh]      (22:27 -> Ps 91:15; Isa 58:9; Jer 29:12)
--   5 job-22-there-is-lifting-up-he-saveth-the-humble            [free/NT+Tk]  (22:29 -> James 4:6, James 4:10, 1 Peter 5:5, 1 Peter 5:6; Prov 3:34)

CREATE TEMP VIEW _s318_job22_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: the invented sins — the slander Yahuah rebukes
    ('canon','job',22,6,'canon','job',31,16,'free',
      E'*If I have withheld the poor from their desire, or have caused the eyes of the widow to fail* (Job 31:16). Eliphaz charges *thou hast taken a pledge from thy brother for nought, and stripped the naked of their clothing* (Job 22:6) — but Job''s own oath of innocence swears the very opposite. The accusation is invented; the prologue called Job *perfect and upright* (Job 1:1), and here Job himself denies the crime under oath.'),
    ('canon','job',22,7,'canon','job',31,17,'free',
      E'*Or have eaten my morsel myself alone, and the fatherless hath not eaten thereof* (Job 31:17). Against Eliphaz''s charge *thou hast not given water to the weary to drink, and thou hast withholden bread from the hungry* (Job 22:7), Job answers that he shared his very morsel with the fatherless. The mirror exposes the slander.'),
    ('canon','job',22,7,'canon','job',31,19,'free',
      E'*If I have seen any perish for want of clothing, or any poor without covering* (Job 31:19). Eliphaz invents *thou hast not given water to the weary... and thou hast withholden bread from the hungry* (Job 22:7); Job''s oath swears he clothed the perishing. The friend imputes the wicked''s sins to the innocent.'),
    ('canon','job',22,9,'canon','job',31,21,'free',
      E'*If I have lifted up my hand against the fatherless, when I saw my help in the gate* (Job 31:21). Eliphaz''s climactic charge — *thou hast sent widows away empty, and the arms of the fatherless have been broken* (Job 22:9) — is answered word for word by Job''s sworn denial that he ever raised a hand against the fatherless.'),
    ('canon','job',22,9,'canon','job',31,22,'free',
      E'*Then let mine arm fall from my shoulder blade, and mine arm be broken from the bone* (Job 31:22). Eliphaz said *the arms of the fatherless have been broken* (Job 22:9); Job calls down that very breaking on his OWN arm if the charge be true. The accuser''s slander becomes the innocent''s self-curse — the surest proof the sin was invented.'),
    ('canon','job',22,5,'canon','job',42,7,'free',
      E'*My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). Eliphaz demanded *Is not thy wickedness great? and thine iniquities infinite?* (Job 22:5); at the end Yahuah (LORD) Himself pronounces that Eliphaz did NOT speak rightly. The verdict from heaven settles which man slandered — read 22:5 already under the sentence of 42:7.'),

    -- THREAD 2: thick clouds a covering — but there is no fleeing his presence
    ('canon','job',22,13,'canon','psalms',139,7,'free',
      E'*Whither shall I go from thy spirit? or whither shall I flee from thy presence?* (Psalm 139:7). Eliphaz imputes to Job the wicked''s creed: *How doth Elohim (God) know? can he judge through the dark cloud?* (Job 22:13). The Psalm answers the slander — there is no dark cloud thick enough to hide from the One whose presence fills all places.'),
    ('canon','job',22,14,'canon','psalms',139,8,'free',
      E'*If I ascend up into heaven, thou art there: if I make my bed in hell, behold, thou art there* (Psalm 139:8). Eliphaz puts on Job''s lips *thick clouds are a covering to him, that he seeth not* (Job 22:14); the Psalm strips the lie — heaven and the grave alike are open before Him.'),
    ('canon','job',22,14,'canon','psalms',139,12,'free',
      E'*Yea, the darkness hideth not from thee; but the night shineth as the day: the darkness and the light are both alike to thee* (Psalm 139:12). Against the imputed creed *thick clouds are a covering to him, that he seeth not* (Job 22:14), the darkness that Eliphaz says blinds Yahuah (LORD) is to Him as bright as noon.'),
    ('canon','job',22,13,'canon','isaiah',29,15,'free',
      E'*Woe unto them that seek deep to hide their counsel from Yahuah (LORD), and their works are in the dark, and they say, Who seeth us? and who knoweth us?* (Isaiah 29:15). Eliphaz frames the wicked''s saying — *How doth Elohim (God) know?* (Job 22:13) — and Isaiah pronounces the woe on exactly that creed. It is the heart of the godless, never Job''s.'),

    -- THREAD 3: receive the law from his mouth, laid up in the heart (the genuine word)
    ('canon','job',22,22,'canon','deuteronomy',30,14,'free',
      E'*But the word is very nigh unto thee, in thy mouth, and in thy heart, that thou mayest do it* (Deuteronomy 30:14). Buried in the false frame Eliphaz speaks a true word: *Receive, I pray thee, the law from his mouth, and lay up his words in thine heart* (Job 22:22). It is the Torah — not far off, but near, in the mouth and in the heart to be done.'),
    ('canon','job',22,22,'canon','psalms',119,11,'free',
      E'*Thy word have I hid in mine heart, that I might not sin against thee* (Psalm 119:11). Eliphaz''s counsel — *lay up his words in thine heart* (Job 22:22) — is the very practice the longest Psalm sings: the law treasured within is the guard against sin.'),
    ('canon','job',22,22,'canon','jeremiah',31,33,'free',
      E'*I will put my law in their inward parts, and write it in their hearts; and will be their Elohim (God), and they shall be my people* (Jeremiah 31:33). What Eliphaz commands a man to do — *lay up his words in thine heart* (Job 22:22) — Yahuah (LORD) promises to accomplish in the new covenant: the Torah written within, not abolished but engraved on the heart of the two-house people.'),
    ('canon','job',22,22,'canon','proverbs',2,1,'free',
      E'*My son, if thou wilt receive my words, and hide my commandments with thee* (Proverbs 2:1). The wisdom of *receive, I pray thee, the law from his mouth, and lay up his words in thine heart* (Job 22:22) is the same call Proverbs opens with — receive the words, hide the commandments, and the fear of Yahuah (LORD) follows.'),

    -- THREAD 4: make thy prayer, and he shall hear thee
    ('canon','job',22,27,'canon','psalms',91,15,'free',
      E'*He shall call upon me, and I will answer him: I will be with him in trouble; I will deliver him, and honour him* (Psalm 91:15). The true promise inside Eliphaz''s frame — *thou shalt make thy prayer unto him, and he shall hear thee* (Job 22:27) — is the covenant pledge: the one who calls is answered, kept, and honoured.'),
    ('canon','job',22,27,'canon','isaiah',58,9,'free',
      E'*Then shalt thou call, and Yahuah (LORD) shall answer; thou shalt cry, and he shall say, Here I am* (Isaiah 58:9). *Thou shalt make thy prayer unto him, and he shall hear thee* (Job 22:27) is fulfilled where the heart turns: the call is met by Yahuah''s (LORD''s) own *Here I am*.'),
    ('canon','job',22,27,'canon','jeremiah',29,12,'free',
      E'*Then shall ye call upon me, and ye shall go and pray unto me, and I will hearken unto you* (Jeremiah 29:12). The word *thou shalt make thy prayer unto him, and he shall hear thee* (Job 22:27) is the same hearkening Yahuah (LORD) pledges to the scattered — call, pray, and be heard.'),

    -- THREAD 5: there is lifting up — he saveth the humble
    ('canon','job',22,29,'canon','proverbs',3,34,'free',
      E'*Surely he scorneth the scorners: but he giveth grace unto the lowly* (Proverbs 3:34). Eliphaz''s genuine saying — *when men are cast down, then thou shalt say, There is lifting up; and he shall save the humble person* (Job 22:29) — is the same law of the kingdom: the lowly receive grace, the proud are scorned. This is the verse the apostles will quote.'),
    ('canon','job',22,29,'canon','james',4,6,'free',
      E'*But he giveth more grace. Wherefore he saith, Elohim (God) resisteth the proud, but giveth grace unto the humble* (James 4:6). *He shall save the humble person* (Job 22:29) is no isolated proverb — James lifts it forward as the settled rule of Yahuah''s (LORD''s) dealing: grace flows downward to the humble.'),
    ('canon','job',22,29,'canon','james',4,10,'free',
      E'*Humble yourselves in the sight of Yahuah (Lord), and he shall lift you up* (James 4:10). Eliphaz''s *when men are cast down, then thou shalt say, There is lifting up* (Job 22:29) is fulfilled in the apostolic command — the cast-down who humble themselves are the ones Yahuah (Lord) lifts up.'),
    ('canon','job',22,29,'canon','1-peter',5,5,'free',
      E'*be clothed with humility: for Elohim (God) resisteth the proud, and giveth grace to the humble* (1 Peter 5:5). *He shall save the humble person* (Job 22:29) — Peter weaves the same word as James, both reaching back to the Tanakh''s saving of the lowly.'),
    ('canon','job',22,29,'canon','1-peter',5,6,'free',
      E'*Humble yourselves therefore under the mighty hand of Elohim (God), that he may exalt you in due time* (1 Peter 5:6). The lifting up of Job 22:29 — *There is lifting up; and he shall save the humble person* — is Peter''s promise exactly: humble now, exalted in due time.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job22_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job22_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== threads =====
-- THREAD 1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-22-the-invented-sins-the-slander-Yahuah-rebukes',
       E'Job 22 — The Invented Sins: the slander Yahuah rebukes',
       E'Eliphaz''s third speech abandons all restraint and INVENTS specific crimes: *Is not thy wickedness great? and thine iniquities infinite?* (Job 22:5). He charges *thou hast taken a pledge from thy brother for nought, and stripped the naked of their clothing* (Job 22:6), *thou hast not given water to the weary to drink, and thou hast withholden bread from the hungry* (Job 22:7), and at the climax *thou hast sent widows away empty, and the arms of the fatherless have been broken* (Job 22:9). Every charge is false. Job''s own oath of innocence is the exact mirror — *If I have withheld the poor from their desire, or have caused the eyes of the widow to fail* (Job 31:16); *Or have eaten my morsel myself alone, and the fatherless hath not eaten thereof* (Job 31:17); *If I have seen any perish for want of clothing, or any poor without covering* (Job 31:19); *If I have lifted up my hand against the fatherless, when I saw my help in the gate* (Job 31:21) — and the self-curse that answers Eliphaz word for word: *Then let mine arm fall from my shoulder blade, and mine arm be broken from the bone* (Job 31:22). Eliphaz says the arms of the fatherless were broken; Job calls that very breaking down on his own arm if the charge be true. The matter is settled from heaven itself: *My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). Read the false accusation already under the verdict that condemns it — the comforter became the accuser, and Yahuah (LORD) named the slander as sin.',
       sv.verse_id, ev.verse_id, 'free', 33325
  FROM _s318_job22_lookup sv, _s318_job22_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=22 AND sv.verse_number=5
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=22 AND ev.verse_number=9
ON CONFLICT (slug) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-22-thick-clouds-a-covering-but-no-fleeing-his-presence',
       E'Job 22 — Thick Clouds a Covering: but there is no fleeing his presence',
       E'Eliphaz now imputes to Job the very creed of the godless. He points to the height — *Is not Elohim (God) in the height of heaven? and behold the height of the stars, how high they are!* (Job 22:12) — and then puts the wicked''s words in Job''s mouth: *And thou sayest, How doth Elohim (God) know? can he judge through the dark cloud? Thick clouds are a covering to him, that he seeth not* (Job 22:13-14). It is a slander, for the creed that Yahuah (LORD) is blinded by cloud belongs to the wicked alone. The Psalm answers it utterly: *Whither shall I go from thy spirit? or whither shall I flee from thy presence? If I ascend up into heaven, thou art there: if I make my bed in hell, behold, thou art there* (Psalm 139:7-8); *Yea, the darkness hideth not from thee; but the night shineth as the day: the darkness and the light are both alike to thee* (Psalm 139:12). And Isaiah pronounces the woe directly on the saying Eliphaz invents: *Woe unto them that seek deep to hide their counsel from Yahuah (LORD), and their works are in the dark, and they say, Who seeth us? and who knoweth us?* (Isaiah 29:15). No cloud is thick enough; the One whose presence fills heaven and the grave sees the dark as the day.',
       sv.verse_id, ev.verse_id, 'free', 33326
  FROM _s318_job22_lookup sv, _s318_job22_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=22 AND sv.verse_number=12
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=22 AND ev.verse_number=14
ON CONFLICT (slug) DO NOTHING;

-- THREAD 3
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-22-receive-the-law-from-his-mouth-laid-up-in-the-heart',
       E'Job 22 — Receive the Law from His Mouth, laid up in the heart',
       E'Buried inside the false frame, Eliphaz speaks a genuine word — the truest thing in his whole speech: *Acquaint now thyself with him, and be at peace: thereby good shall come unto thee. Receive, I pray thee, the law from his mouth, and lay up his words in thine heart* (Job 22:21-22). This is the Torah, received from Yahuah''s (LORD''s) own mouth and treasured within. Moses said the same: *But the word is very nigh unto thee, in thy mouth, and in thy heart, that thou mayest do it* (Deuteronomy 30:14) — never far off, but near, to be done. The Psalmist made it his practice: *Thy word have I hid in mine heart, that I might not sin against thee* (Psalm 119:11). Wisdom opens with the identical call: *My son, if thou wilt receive my words, and hide my commandments with thee* (Proverbs 2:1). And what Eliphaz can only command a man to do, Yahuah (LORD) Himself promises to accomplish in the new covenant: *I will put my law in their inward parts, and write it in their hearts; and will be their Elohim (God), and they shall be my people* (Jeremiah 31:33). The law laid up in the heart is not abolished — it is engraved within, the very mark of the restored two-house people. Even from a mouth that slanders, the Torah-from-his-mouth treasured in the heart shines as a true word.',
       sv.verse_id, ev.verse_id, 'free', 33327
  FROM _s318_job22_lookup sv, _s318_job22_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=22 AND sv.verse_number=21
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=22 AND ev.verse_number=22
ON CONFLICT (slug) DO NOTHING;

-- THREAD 4
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-22-make-thy-prayer-and-he-shall-hear-thee',
       E'Job 22 — Make thy Prayer, and he shall hear thee',
       E'Another true word inside the false frame: *Thou shalt make thy prayer unto him, and he shall hear thee, and thou shalt pay thy vows* (Job 22:27). The covenant pledge runs all through the Tanakh — the one who calls is answered. *He shall call upon me, and I will answer him: I will be with him in trouble; I will deliver him, and honour him* (Psalm 91:15). Isaiah promises Yahuah''s (LORD''s) own ready reply: *Then shalt thou call, and Yahuah (LORD) shall answer; thou shalt cry, and he shall say, Here I am* (Isaiah 58:9). And to the scattered exiles the same hearkening is sworn: *Then shall ye call upon me, and ye shall go and pray unto me, and I will hearken unto you* (Jeremiah 29:12). The prayer Eliphaz names as a future blessing for Job is in truth the standing promise of the covenant — call, pray, and be heard.',
       sv.verse_id, ev.verse_id, 'free', 33328
  FROM _s318_job22_lookup sv, _s318_job22_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=22 AND sv.verse_number=27
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=22 AND ev.verse_number=27
ON CONFLICT (slug) DO NOTHING;

-- THREAD 5
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-22-there-is-lifting-up-he-saveth-the-humble',
       E'Job 22 — There is Lifting Up: he saveth the humble',
       E'The last genuine word in Eliphaz''s speech reaches forward to the apostles themselves: *When men are cast down, then thou shalt say, There is lifting up; and he shall save the humble person* (Job 22:29). This is the settled law of the kingdom, first sung in Proverbs: *Surely he scorneth the scorners: but he giveth grace unto the lowly* (Proverbs 3:34). James lifts that very root forward: *But he giveth more grace. Wherefore he saith, Elohim (God) resisteth the proud, but giveth grace unto the humble* (James 4:6), and presses it to a command: *Humble yourselves in the sight of Yahuah (Lord), and he shall lift you up* (James 4:10). Peter weaves the identical word: *be clothed with humility: for Elohim (God) resisteth the proud, and giveth grace to the humble* (1 Peter 5:5); *Humble yourselves therefore under the mighty hand of Elohim (God), that he may exalt you in due time* (1 Peter 5:6). From a comforter who slandered, this saying runs true all the way to the New Testament: the cast-down who humble themselves are the very ones Yahuah (Lord) saves and lifts up.',
       sv.verse_id, ev.verse_id, 'free', 33329
  FROM _s318_job22_lookup sv, _s318_job22_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=22 AND sv.verse_number=29
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=22 AND ev.verse_number=29
ON CONFLICT (slug) DO NOTHING;

