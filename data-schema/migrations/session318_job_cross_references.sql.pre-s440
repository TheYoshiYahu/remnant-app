 WHERE t.slug='job-1-yahuah-gave-and-yahuah-hath-taken-away-blessed-be-the-name'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_2.sql (Job 2) -----
-- Book: Job  Chapter: 2  (the second heavenly court & the affliction of the righteous)
-- Session prefix: s318   tag: job02   temp view: _s318_job02_lookup
-- Slug prefix: job-2-...   sort_order band: 32825 + 1 per thread
-- Source: canon / book_slug=job / chapter 2
--
-- THEOLOGICAL GUARDS APPLIED:
--   * Job's afflictions are the TESTING of the righteous, never deserved punishment. The first
--     court already declared him "a perfect and an upright man" (1:8; 2:3); the second affliction
--     is permitted "without cause" (2:3) — the suffering of the integral one, NOT recompense for sin.
--     No prosperity-gospel: integrity is held THROUGH the loss, not rewarded by its removal.
--   * "shall we not receive evil?" (2:10) = receive ADVERSITY from Yahuah's sovereign hand, not
--     moral evil. Framed via Isaiah 45:7 / Lamentations 3:38 (Yahuah ordains weal and woe), never
--     a charge of wickedness against the Most High. "In all this did not Job sin with his lips" (2:10).
--   * The accuser is the permitted adversary under Yahuah's leash ("he is in thine hand; but save
--     his life," 2:6) — the sifting is bounded, the servant kept. Weave FORWARD to the sifting of
--     Simon (Luke 22:31), the messenger of Satan to buffet (2 Cor 12:7), the trial of faith tried
--     with fire (1 Peter 1:7) — and to James 5:11, the patience of Job and the END of Yahuah,
--     "very pitiful, and of tender mercy" (the tender-mercy outcome, not a transaction).
--
-- Job 2 coverage:
--   vv.1-6  (second court; sons of Elohim; Satan; skin for skin; "in thine hand; but save his life")
--        NT:     Luke 22:31 (Satan hath desired to sift you as wheat) [thread 1]
--        Extras: none warranted clean (Jubilees Mastema parse carries apparatus noise)
--        Tanakh: Job 1:8-12 (the first court; the leash on the accuser) [thread 1, lateral]
--   vv.7-8  (smitten with sore boils sole to crown; potsherd; ashes)
--        NT:     2 Corinthians 12:7 (thorn in the flesh, messenger of Satan to buffet) [thread 2]
--        Extras: Ecclesiasticus 2:4-5 (patient in low estate; furnace of adversity) [thread 2]
--        Tanakh: covered with v.10 sovereign-hand block [thread 2]
--   v.9     (the wife: "curse Elohim, and die" — the voice of despair, contrast Job's integrity)
--        NT:     none warranted (despair-voice; the integrity answer carries the weave in v.10)
--        Extras: none warranted
--        Tanakh: none warranted
--   v.10    (foolish women; "shall we receive good... and not receive evil?"; "did not Job sin with his lips")
--        NT:     James 5:11 (the patience of Job; very pitiful and of tender mercy);
--                1 Peter 1:7 (the trial of your faith, tried with fire) [thread 2]
--        Extras: Ecclesiasticus 2:4 (take cheerfully... be patient when brought low) [thread 2]
--        Tanakh: Isaiah 45:7 (I make peace and create evil); Lamentations 3:38 (out of the mouth
--                of El Elyon proceedeth not evil and good?); Job 1:21 (Yahuah gave, Yahuah hath
--                taken away; blessed be the name) [thread 2, sovereign-hand]
--   vv.11-13 (three friends; rent mantles; dust toward heaven; sat seven days in silence)
--        NT:     none warranted (the silent ministry of presence; the comfort that later turns
--                accusatory is the book's argument, not a forward type)
--        Extras: none warranted
--        Tanakh: none warranted (kept as a self-standing thread on mourning-with the afflicted)
--
-- THREADS (3):
--   1. job-2-again-the-sons-of-elohim-and-the-accuser-the-leash-and-the-sifting
--        members: Luke 22:31 (NT/free), Job 1:8 (Tanakh/free), Job 1:11 (Tanakh/free)  -> tier free
--   2. job-2-shall-we-receive-good-and-not-receive-evil-the-furnace-of-the-upright
--        members: 2 Corinthians 12:7 (NT/free), James 5:11 (NT/free), 1 Peter 1:7 (NT/free),
--                 Isaiah 45:7 (Tanakh/free), Lamentations 3:38 (Tanakh/free), Job 1:21 (Tanakh/free),
--                 Ecclesiasticus 2:4 (extras), Ecclesiasticus 2:5 (extras)            -> tier extras
--   (vv.11-13 carry no thread: the silent ministry of presence has no clean cross-library
--    witness, and an empty thread would fail the post-apply empty-thread sweep. The silence
--    is framed in the coverage checklist as "none warranted" across all three libraries.)

CREATE TEMP VIEW _s318_job02_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================ CROSS_REFERENCES ============================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: the second court, the leashed accuser, the sifting
    ('canon','job',2,1,'canon','luke',22,31,'free',
      E'Forward to the sifting of Simon: *And Yahuah (Lord) said, Simon, Simon, behold, Satan hath desired to have you, that he may sift you as wheat* (Luke 22:31). As in Job''s second court *the sons of Elohim (God) came to present themselves before Yahuah (LORD), and Satan came also among them* (Job 2:1), the accuser must first present himself and ask leave — the testing is permitted, bounded, and watched over, never autonomous.'),
    ('canon','job',2,6,'canon','job',1,8,'free',
      E'Lateral to the first court: *And Yahuah (LORD) said unto Satan, Hast thou considered my servant Job, that there is none like him in the earth, a perfect and an upright man, one that feareth Elohim (God), and escheweth evil?* (Job 1:8). Twice Yahuah names Job righteous BEFORE the affliction — so when He says *Behold, he is in thine hand; but save his life* (Job 2:6), the boils fall on a perfect man, the testing of the upright and never the wage of sin.'),
    ('canon','job',2,6,'canon','job',1,11,'free',
      E'Lateral to the leash on the accuser: *But put forth thine hand now, and touch all that he hath, and he will curse thee to thy face* (Job 1:11). The adversary cannot stretch out his own hand; he must petition, and Yahuah sets the bound — first *all that he hath* (1:11), now *his bone and his flesh* yet *save his life* (Job 2:6). The hedge is lowered by measure; the servant is never abandoned to the accuser.'),
    -- THREAD 2: receive good and not evil — the furnace of the upright
    ('canon','job',2,7,'canon','2-corinthians',12,7,'free',
      E'Forward to Paul''s affliction: *And lest I should be exalted above measure through the abundance of the revelations, there was given to me a thorn in the flesh, the messenger of Satan to buffet me, lest I should be exalted above measure* (2 Corinthians 12:7). As Satan *smote Job with sore boils from the sole of his foot unto his crown* (Job 2:7), the messenger of Satan is permitted to buffet the righteous in the body — yet the affliction works humility and the keeping power of grace, not destruction.'),
    ('canon','job',2,10,'canon','james',5,11,'free',
      E'Forward to the named patience and its end: *Behold, we count them happy which endure. Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11). When Job answers *What? shall we receive good at the hand of Elohim (God), and shall we not receive evil? In all this did not Job sin with his lips* (Job 2:10), this is the patience James commends — and its end is not a transaction but Yahuah''s tender mercy.'),
    ('canon','job',2,10,'canon','1-peter',1,7,'free',
      E'Forward to the trial of faith: *That the trial of your faith, being much more precious than of gold that perisheth, though it be tried with fire, might be found unto praise and honour and glory at the appearing of Yahusha HaMashiach (Jesus Christ)* (1 Peter 1:7). Job''s refusal — *shall we not receive evil? In all this did not Job sin with his lips* (Job 2:10) — is faith proven in the fire, the upright tried and found genuine.'),
    ('canon','job',2,10,'canon','isaiah',45,7,'free',
      E'Lateral to Yahuah''s sovereign hand: *I form the light, and create darkness: I make peace, and create evil: I Yahuah (LORD) do all these things* (Isaiah 45:7). Job''s *shall we not receive evil?* (Job 2:10) confesses the same — the adversity received is from Yahuah''s ordaining hand, weal and woe alike, never moral evil charged against the Most High.'),
    ('canon','job',2,10,'canon','lamentations',3,38,'free',
      E'Lateral to the source of weal and woe: *Out of the mouth of the El Elyon (most High) proceedeth not evil and good?* (Lamentations 3:38). The same theology of the sovereign hand frames Job''s *shall we receive good at the hand of Elohim (God), and shall we not receive evil?* (Job 2:10) — both good and adversity proceed under the Most High''s rule, received and not resented.'),
    ('canon','job',2,10,'canon','job',1,21,'free',
      E'Lateral to Job''s first confession: *Naked came I out of my mother''s womb, and naked shall I return thither: Yahuah (LORD) gave, and Yahuah (LORD) hath taken away; blessed be the name of Yahuah (LORD)* (Job 1:21). The integrity of *shall we not receive evil? In all this did not Job sin with his lips* (Job 2:10) is the same heart that blessed the Name when all was taken — worship that does not bargain.'),
    ('canon','job',2,8,'apocrypha','ecclesiasticus',2,4,'extras',
      E'Out to the wisdom of endurance: *Whatsoever is brought upon you take cheerfully, and be patient when you are changed to a low estate* (Ecclesiasticus 2:4). Job *took him a potsherd to scrape himself withal; and he sat down among the ashes* (Job 2:8) — the man brought to the lowest estate, scraping his sores in the dust, embodies the patient bearing the second-Temple wisdom counsels.'),
    ('canon','job',2,10,'apocrypha','ecclesiasticus',2,5,'extras',
      E'Out to the furnace of the upright: *For gold is tried in the fire, and acceptable men in the furnace of adversity* (Ecclesiasticus 2:5). Job''s *shall we not receive evil? In all this did not Job sin with his lips* (Job 2:10) is the acceptable man in the furnace — the same image 1 Peter takes up as faith *tried with fire* (1 Peter 1:7), adversity refining rather than condemning the righteous.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job02_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job02_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================ THREADS ============================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-2-again-the-sons-of-elohim-and-the-accuser-the-leash-and-the-sifting',
       E'Again the Sons of Elohim and the Accuser — the Leash and the Sifting',
       E'A second time the heavenly court convenes: *Again there was a day when the sons of Elohim (God) came to present themselves before Yahuah (LORD), and Satan came also among them to present himself before Yahuah (LORD)* (Job 2:1). The accuser is not autonomous — he must present himself, answer *From whence comest thou?* and petition for leave. Yahuah names Job twice over as *a perfect and an upright man, one that feareth Elohim (God), and escheweth evil* (Job 2:3; cf. *Hast thou considered my servant Job, that there is none like him in the earth* — Job 1:8), and grants the affliction only *without cause* — the testing of the righteous, never the wage of sin. The leash is exact: as the first court bounded the accuser to *all that he hath* (Job 1:11), the second bounds him to *his bone and his flesh* yet commands *he is in thine hand; but save his life* (Job 2:6). This is the pattern the Formed Son names over Simon: *behold, Satan hath desired to have you, that he may sift you as wheat* (Luke 22:31) — the sifting is desired by the adversary, permitted by Yahuah, bounded, and prayed-through, that *thy faith fail not*. The accuser may sift; he cannot keep.',
       sv.verse_id, ev.verse_id, 'free', 32825
  FROM _s318_job02_lookup sv, _s318_job02_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=2 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=2 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-2-shall-we-receive-good-and-not-receive-evil-the-furnace-of-the-upright',
       E'Shall We Receive Good and Not Receive Evil — the Furnace of the Upright',
       E'The accuser *smote Job with sore boils from the sole of his foot unto his crown* (Job 2:7), and the perfect man is reduced to scraping himself with a potsherd among the ashes (Job 2:8). His wife voices despair — *curse Elohim (God), and die* (Job 2:9) — but Job answers with the heart that had already blessed the Name when all was taken (*Yahuah (LORD) gave, and Yahuah (LORD) hath taken away; blessed be the name of Yahuah (LORD)* — Job 1:21): *What? shall we receive good at the hand of Elohim (God), and shall we not receive evil? In all this did not Job sin with his lips* (Job 2:10). The "evil" received is ADVERSITY from Yahuah''s sovereign hand, never moral evil charged against Him — the same confession Isaiah makes (*I make peace, and create evil: I Yahuah (LORD) do all these things* — Isaiah 45:7) and Lamentations asks (*Out of the mouth of the El Elyon (most High) proceedeth not evil and good?* — Lamentations 3:38). This is the testing of the righteous, not its punishment. The restored library names the pattern: *be patient when you are changed to a low estate... For gold is tried in the fire, and acceptable men in the furnace of adversity* (Ecclesiasticus 2:4-5). And the New Testament fills it forward: Paul''s *thorn in the flesh, the messenger of Satan to buffet me* (2 Corinthians 12:7); Peter''s *trial of your faith... though it be tried with fire* (1 Peter 1:7); and James'' own naming — *Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11). The end is not a prosperity payout but Yahuah''s tender mercy, and the proven faith of the man who would not sin with his lips.',
       sv.verse_id, ev.verse_id, 'extras', 32826
  FROM _s318_job02_lookup sv, _s318_job02_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=2 AND sv.verse_number=7
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=2 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

-- ============================ THREAD_MEMBERS ============================
-- Thread 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'Luke 22:31 — *Satan hath desired to have you, that he may sift you as wheat*: the accuser must petition for leave, the sifting permitted and bounded, as in Job''s second court.'
  FROM cross_reference_threads t
  JOIN _s318_job02_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=2 AND sv.verse_number=1
  JOIN _s318_job02_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='luke' AND tv.chapter_number=22 AND tv.verse_number=31
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-2-again-the-sons-of-elohim-and-the-accuser-the-leash-and-the-sifting'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'Job 1:8 — *a perfect and an upright man, one that feareth Elohim*: Yahuah names Job righteous before the affliction, so the boils of 2:6 fall on the upright, not the guilty.'
  FROM cross_reference_threads t
  JOIN _s318_job02_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=2 AND sv.verse_number=6
  JOIN _s318_job02_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=1 AND tv.verse_number=8
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-2-again-the-sons-of-elohim-and-the-accuser-the-leash-and-the-sifting'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'Job 1:11 — *put forth thine hand now, and touch all that he hath*: the accuser must ask; Yahuah sets the bound, lowered by measure to bone and flesh in 2:6 yet *save his life*.'
  FROM cross_reference_threads t
  JOIN _s318_job02_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=2 AND sv.verse_number=6
  JOIN _s318_job02_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=1 AND tv.verse_number=11
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-2-again-the-sons-of-elohim-and-the-accuser-the-leash-and-the-sifting'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 2
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'2 Corinthians 12:7 — *a thorn in the flesh, the messenger of Satan to buffet me*: Satan permitted to smite the righteous in the body, as he smote Job with boils, working humility not ruin.'
  FROM cross_reference_threads t
  JOIN _s318_job02_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=2 AND sv.verse_number=7
  JOIN _s318_job02_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='2-corinthians' AND tv.chapter_number=12 AND tv.verse_number=7
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-2-shall-we-receive-good-and-not-receive-evil-the-furnace-of-the-upright'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'James 5:11 — *the patience of Job, and... the end of Yahuah; that Yahuah is very pitiful, and of tender mercy*: the named patience of 2:10, whose end is Yahuah''s mercy, not a payout.'
  FROM cross_reference_threads t
  JOIN _s318_job02_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=2 AND sv.verse_number=10
  JOIN _s318_job02_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='james' AND tv.chapter_number=5 AND tv.verse_number=11
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-2-shall-we-receive-good-and-not-receive-evil-the-furnace-of-the-upright'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'1 Peter 1:7 — *the trial of your faith... though it be tried with fire*: Job''s refusal to sin with his lips is faith proven in the fire, more precious than perishing gold.'
  FROM cross_reference_threads t
  JOIN _s318_job02_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=2 AND sv.verse_number=10
  JOIN _s318_job02_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='1-peter' AND tv.chapter_number=1 AND tv.verse_number=7
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-2-shall-we-receive-good-and-not-receive-evil-the-furnace-of-the-upright'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 4, E'Isaiah 45:7 — *I make peace, and create evil: I Yahuah do all these things*: the "evil" Job receives is adversity from the sovereign hand, never moral evil charged against the Most High.'
  FROM cross_reference_threads t
  JOIN _s318_job02_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=2 AND sv.verse_number=10
  JOIN _s318_job02_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='isaiah' AND tv.chapter_number=45 AND tv.verse_number=7
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-2-shall-we-receive-good-and-not-receive-evil-the-furnace-of-the-upright'
