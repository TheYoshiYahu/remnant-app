  JOIN _s318_job07_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=7 AND sv.verse_number=17
  JOIN _s318_job07_lookup tv ON tv.edition_slug='apocrypha' AND tv.book_slug='ecclesiasticus' AND tv.chapter_number=18 AND tv.verse_number=8
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-7-what-is-man-that-thou-shouldest-magnify-him-the-dark-inversion-of-psalm-8'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 5 members
