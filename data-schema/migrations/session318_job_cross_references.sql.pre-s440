-- ----- fragment: minion_job_31.sql (Job 31) -----
-- Chapter: Job 31 — THE OATH OF INNOCENCE, the Torah lived from the inward heart
-- Tag: job31 ; session prefix: s318 ; temp view: _s318_job31_lookup
-- Sort band: 33550-33556 (7 threads, +1 per thread)
-- Source: canon / job / chapter 31
--
-- FRAMING GUARD: Job 31 is the Torah's righteousness lived from the INWARD heart — the
-- covenant with the eyes, the equal-creation of the servant, mercy to the poor, no idolatry of
-- gold/sun/moon, no rejoicing at an enemy's fall, no Adam-like hiding of sin. This is
-- covenant-faithfulness flowing from the fear of Yahuah — the heart-Torah the new covenant
-- writes on the inward parts (Jeremiah 31:33), NEVER self-righteous flesh-merit, NEVER
-- Torah-as-mere-external-rule. 31:1 anticipates Matthew 5:28 — the heart standard the Messiah
-- taught was already Job's lived life.
--
-- Job 31 coverage:
--   v.1   (covenant with the eyes / lust)
--         NT:     Matthew 5:28 (looketh to lust = adultery in the heart) — KEYSTONE forward
--         Extras: Sirach 9:5,8 (gaze not on a maid; turn away the eye)
--         Tanakh: Proverbs 6:25 (lust not in thine heart); Psalm 101:3 (set no wicked thing before mine eyes)
--   v.5-6 (walk in no deceit / weighed in an even balance)
--         NT:     none warranted (Dan 5:27 carries the eschatological weighing)
--         Extras: none warranted
--         Tanakh: Proverbs 16:11 (a just weight and balance are Yahuah's); Daniel 5:27 (weighed in the balances, found wanting); 1 Samuel 2:3 (by Yahuah actions are weighed)
--   v.13-15 (justice to manservant/maidservant / one Creator fashioned us both)
--         NT:     Ephesians 6:9 (masters, no respect of persons with the Master in heaven)
--         Extras: Sirach 7:20-21 (entreat not your servant evil; love a good servant)
--         Tanakh: Malachi 2:10 (have we not all one Father? one Elohim created us); Proverbs 14:31 (oppresseth the poor reproacheth his Maker)
--   v.16-23 (poor, widow, fatherless, the naked clothed)
--         NT:     Matthew 25:35-36 (I was hungry... naked and ye clothed me)
--         Extras: Sirach 4:10 (be a father to the fatherless); Tobit 4:16 (give bread to the hungry, garments to the naked)
--         Tanakh: Deuteronomy 15:7 (shut not thine hand from thy poor brother); Isaiah 58:7 (cover the naked, hide not from thine own flesh)
--   v.24-28 (not trusting gold; not worshipping sun/moon = denying El above)
--         NT:     Matthew 6:24 (cannot serve Elohim and mammon)
--         Extras: Wisdom of Solomon 13:2 (deemed the lights of heaven to be gods)
--         Tanakh: Deuteronomy 4:19 (lift not thine eyes to sun/moon to worship them)
--   v.29-30 (no rejoicing at the enemy's fall; no curse on his soul)
--         NT:     Romans 12:14 (bless them which persecute you; curse not); Matthew 5:44 (love your enemies)
--         Extras: none warranted (Jubilees 36 is brotherhood, not enemy-mercy)
--         Tanakh: Proverbs 24:17 (rejoice not when thine enemy falleth)
--   v.31-32 (open doors to stranger/traveller) — folded into mercy theme; no separate thread
--   v.33  (covered transgressions AS ADAM, hiding iniquity in the bosom)
--         NT:     1 John 1:9 (if we confess our sins, he is faithful to forgive)
--         Extras: none warranted
--         Tanakh: Genesis 3:8 (Adam hid himself from the presence of Yahuah Elohim); Proverbs 28:13 (he that covereth his sins shall not prosper)
--   v.35-40 (longing for the hearing / the adversary's book / "the words of Job are ended")
--         NT:     none warranted (the daysman/hearing longing answered across the book; not threaded here)
--         Extras: none warranted
--         Tanakh: none warranted
--
-- THREADS (7):
--   33550 job-31-1-i-made-a-covenant-with-mine-eyes        [NT + extras + Tanakh] tier extras
--   33551 job-31-6-weighed-in-an-even-balance              [Tanakh only]          tier free
--   33552 job-31-15-one-fashioned-us-in-the-womb           [NT + extras + Tanakh] tier extras
--   33553 job-31-19-the-poor-the-widow-the-fatherless-the-naked [NT + extras + Tanakh] tier extras
--   33554 job-31-26-neither-the-sun-nor-the-gold           [NT + extras + Tanakh] tier extras
--   33555 job-31-30-no-curse-on-his-enemys-soul            [NT + Tanakh]          tier free
--   33556 job-31-33-if-i-covered-as-adam                   [NT + Tanakh]          tier free

-- ============================================================================
-- A. TEMP VIEW
-- ============================================================================
CREATE TEMP VIEW _s318_job31_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================================================================
-- B. CROSS_REFERENCES
-- ============================================================================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1 — covenant with the eyes (31:1)
    ('canon','job',31,1,'canon','matthew',5,28,'free',
     E'*But I say unto you, That whosoever looketh on a woman to lust after her hath committed adultery with her already in his heart.* (Matthew 5:28). Job''s first oath — *I made a covenant with mine eyes; why then should I think upon a maid?* (Job 31:1) — kept in the heart the very standard the Messiah taught: adultery measured not at the deed but at the look and the thought. The covenant Job swore with his eyes is the heart-Torah, the inward purity, that Yahusha (Jesus) unfolds — not a new law but the old one read where it always lived, in the heart.'),
    ('canon','job',31,1,'canon','proverbs',6,25,'free',
     E'*Lust not after her beauty in thine heart; neither let her take thee with her eyelids.* (Proverbs 6:25). Wisdom forbids the lust *in thine heart* before it ever reaches the hand — exactly the place Job guarded when he made *a covenant with mine eyes* (Job 31:1). The fear of Yahuah polices the gaze itself.'),
    ('canon','job',31,1,'canon','psalms',101,3,'free',
     E'*I will set no wicked thing before mine eyes: I hate the work of them that turn aside; it shall not cleave to me.* (Psalm 101:3). David''s vow of the eyes is Job''s vow — *I made a covenant with mine eyes* (Job 31:1) — the resolve that no defiling thing should pass the gate of sight and cleave to the heart.'),
    ('canon','job',31,1,'apocrypha','ecclesiasticus',9,8,'extras',
     E'*Turn away your eye from a beautiful woman, and look not upon another''s beauty; for many have been deceived by the beauty of a woman; for herewith love is kindled as a fire.* (Sirach 9:8). The same wisdom Job swore by — *why then should I think upon a maid?* (Job 31:1) — and the same fire-image Job uses two verses on, naming lust *a fire that consumeth to destruction* (Job 31:12). Turn the eye away before the fire is kindled.'),

    -- THREAD 2 — weighed in an even balance (31:5-6)
    ('canon','job',31,6,'canon','proverbs',16,11,'free',
     E'*A just weight and balance are the LORD''S: all the weights of the bag are his work.* (Proverbs 16:11). Job invites the very scale Yahuah owns — *Let me be weighed in an even balance, that Elohim (God) may know mine integrity* (Job 31:6) — confident that the just balance is the Almighty''s own instrument and will read his integrity true.'),
    ('canon','job',31,6,'canon','daniel',5,27,'free',
     E'*TEKEL; Thou art weighed in the balances, and art found wanting.* (Daniel 5:27). The hand that wrote on Belshazzar''s wall is the balance Job asks to stand in — *Let me be weighed in an even balance, that Elohim (God) may know mine integrity* (Job 31:6). The wicked are found wanting; the man of integrity asks to be weighed and is not afraid.'),
    ('canon','job',31,6,'canon','1-samuel',2,3,'free',
     E'*Talk no more so exceeding proudly; let not arrogancy come out of your mouth: for Yahuah (LORD) is a Elohim (God) of knowledge, and by him actions are weighed.* (1 Samuel 2:3). Hannah''s song names the truth Job stakes his oath upon — *by him actions are weighed* — so Job can say *Let me be weighed in an even balance* (Job 31:6) and *Doth not he see my ways, and count all my steps?* (Job 31:4).'),

    -- THREAD 3 — one fashioned us both in the womb (31:13-15)
    ('canon','job',31,15,'canon','malachi',2,10,'free',
     E'*Have we not all one father? hath not one Elohim (God) created us? why do we deal treacherously every man against his brother, by profaning the covenant of our fathers?* (Malachi 2:10). Job''s ground for justice to his slave is the ground Malachi names — one Maker, one fashioning hand: *Did not he that made me in the womb make him? and did not one fashion us in the womb?* (Job 31:15). To despise the servant''s cause is to deal treacherously against one whom the same Elohim formed.'),
    ('canon','job',31,15,'canon','proverbs',14,31,'free',
     E'*He that oppresseth the poor reproacheth his Maker: but he that honoureth him hath mercy on the poor.* (Proverbs 14:31). The proverb makes the oppression of the lowly a reproach against the Creator himself — precisely Job''s fear: *What then shall I do when Elohim (God) riseth up?... Did not he that made me in the womb make him?* (Job 31:14-15). Mercy to the servant is reverence to the one Maker of them both.'),
    ('canon','job',31,15,'canon','ephesians',6,9,'free',
     E'*And, ye masters, do the same things unto them, forbearing threatening: knowing that your Master also is in heaven; neither is there respect of persons with him.* (Ephesians 6:9). The apostle binds the master to the slave under one Master above — the same equal-creation Job confessed: *Did not he that made me in the womb make him?* (Job 31:15). With Yahuah there is no respect of persons, so Job would not despise the cause of his manservant.'),
    ('canon','job',31,15,'apocrypha','ecclesiasticus',7,20,'extras',
     E'*Whereas your servant works truly, entreat him not evil, nor the hireling that bestoweth himself wholly for you.* (Sirach 7:20). The wisdom of the fathers commands the same justice Job swore by — not to despise the manservant''s cause: *If I did despise the cause of my manservant or of my maidservant, when they contended with me* (Job 31:13). The servant who labours truly is to be loved, never wronged.'),

    -- THREAD 4 — the poor, the widow, the fatherless, the naked (31:16-23)
    ('canon','job',31,19,'canon','deuteronomy',15,7,'free',
     E'*If there be among you a poor man of one of thy brethren within any of thy gates in thy land which Yahuah Elohayka (the LORD thy God) giveth thee, thou shalt not harden thine heart, nor shut thine hand from thy poor brother* (Deuteronomy 15:7). The Torah Job lived — *If I have withheld the poor from their desire, or have caused the eyes of the widow to fail* (Job 31:16). The open hand of Deuteronomy is the open hand Job swears he never closed.'),
    ('canon','job',31,19,'canon','isaiah',58,7,'free',
     E'*Is it not to deal thy bread to the hungry, and that thou bring the poor that are cast out to thy house? when thou seest the naked, that thou cover him; and that thou hide not thyself from thine own flesh?* (Isaiah 58:7). Isaiah''s true fast is Job''s lived life — *If I have seen any perish for want of clothing... If his loins have not blessed me, and if he were not warmed with the fleece of my sheep* (Job 31:19-20). To cover the naked and feed the hungry is the worship Yahuah seeks.'),
    ('canon','job',31,19,'canon','matthew',25,36,'free',
     E'*Naked, and ye clothed me: I was sick, and ye visited me: I was in prison, and ye came unto me.* (Matthew 25:36). The King''s judgment measures the nations by the mercy Job swore he kept — *If I have seen any perish for want of clothing... and if he were not warmed with the fleece of my sheep* (Job 31:19-20). What is done to the least is done to the Messiah; Job clothed them already.'),
    ('canon','job',31,19,'apocrypha','tobit',4,16,'extras',
     E'*Give of your bread to the hungry, and of your garments to them that are naked; and according to your abundance give alms* (Tobit 4:16). Tobit''s charge to his son is the very mercy Job swore by — *Or have eaten my morsel myself alone, and the fatherless hath not eaten thereof* (Job 31:17); *If I have seen any perish for want of clothing* (Job 31:19). Bread to the hungry, garment to the naked: the Torah''s mercy enacted.'),

    -- THREAD 5 — neither the sun nor the gold (31:24-28)
    ('canon','job',31,26,'canon','deuteronomy',4,19,'free',
     E'*And lest thou lift up thine eyes unto heaven, and when thou seest the sun, and the moon, and the stars, even all the host of heaven, shouldest be driven to worship them, and serve them* (Deuteronomy 4:19). The exact idolatry Job renounces — *If I beheld the sun when it shined, or the moon walking in brightness; And my heart hath been secretly enticed, or my mouth hath kissed my hand* (Job 31:26-27). To worship the lights is to deny *the Elohim (God) that is above* (Job 31:28).'),
    ('canon','job',31,26,'canon','matthew',6,24,'free',
     E'*No man can serve two masters... Ye cannot serve Elohim (God) and mammon.* (Matthew 6:24). Job had already refused the rival master — *If I have made gold my hope, or have said to the fine gold, Thou art my confidence* (Job 31:24). Trust set on gold is a god denied above; the heart serves One or the other.'),
    ('canon','job',31,26,'apocrypha','the-wisdom-of-solomon',13,2,'extras',
     E'*But deemed either fire, or wind, or the swift air, or the circle of the stars, or the violent water, or the lights of heaven, to be the gods which govern the world.* (Wisdom of Solomon 13:2). The folly Job stood clear of — to make *the lights of heaven* into gods — is the folly he names a judge-worthy iniquity: *If I beheld the sun when it shined, or the moon walking in brightness... This also were an iniquity to be punished by the judge: for I should have denied the Elohim (God) that is above* (Job 31:26,28).'),

    -- THREAD 6 — no curse on his enemy's soul (31:29-30)
    ('canon','job',31,30,'canon','proverbs',24,17,'free',
     E'*Rejoice not when thine enemy falleth, and let not thine heart be glad when he stumbleth* (Proverbs 24:17). The proverb Job lived — *If I rejoiced at the destruction of him that hated me, or lifted up myself when evil found him* (Job 31:29). The man who fears Yahuah does not gloat over a fallen foe.'),
    ('canon','job',31,30,'canon','romans',12,14,'free',
     E'*Bless them which persecute you: bless, and curse not.* (Romans 12:14). Paul names the height Job already kept — *Neither have I suffered my mouth to sin by wishing a curse to his soul* (Job 31:30). The heart-Torah blesses the enemy and forbids the cursing mouth, the same standard the Messiah taught: love your enemies.'),

    -- THREAD 7 — if I covered as Adam (31:33)
    ('canon','job',31,33,'canon','genesis',3,8,'free',
     E'*And they heard the voice of Yahuah Elohim (the LORD God) walking in the garden in the cool of the day: and Adam and his wife hid themselves from the presence of Yahuah Elohim (the LORD God) amongst the trees of the garden.* (Genesis 3:8). Job names the first hiding by name — *If I covered my transgressions as Adam, by hiding mine iniquity in my bosom* (Job 31:33). Where Adam concealed his sin from the presence of Yahuah, Job swears he covered nothing in his bosom.'),
    ('canon','job',31,33,'canon','proverbs',28,13,'free',
     E'*He that covereth his sins shall not prosper: but whoso confesseth and forsaketh them shall have mercy.* (Proverbs 28:13). The proverb sets the two ways Job sets — *If I covered my transgressions as Adam* (Job 31:33). To cover is Adam''s ruin; to confess and forsake is the way of mercy, and Job swears he hid nothing.'),
    ('canon','job',31,33,'canon','1-john',1,9,'free',
     E'*If we confess our sins, he is faithful and just to forgive us our sins, and to cleanse us from all unrighteousness.* (1 John 1:9). The apostle names the open way against Adam''s hiding — the way Job kept who would not cover *as Adam, by hiding mine iniquity in my bosom* (Job 31:33). Confession, not concealment, finds the faithful and just forgiveness.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job31_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job31_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================================================================
-- C. THREADS
-- ============================================================================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-31-1-i-made-a-covenant-with-mine-eyes',
       E'I Made a Covenant With Mine Eyes',
       E'Job''s oath of innocence opens at the eyes: *I made a covenant with mine eyes; why then should I think upon a maid?* (Job 31:1). This is the heart-Torah — purity policed not at the deed but at the look and the thought — and it is precisely the standard the Messiah taught: *But I say unto you, That whosoever looketh on a woman to lust after her hath committed adultery with her already in his heart* (Matthew 5:28). Job kept in his heart what Yahusha (Jesus) unfolds. Wisdom had long forbidden the lust *in thine heart; neither let her take thee with her eyelids* (Proverbs 6:25), and David vowed *I will set no wicked thing before mine eyes... it shall not cleave to me* (Psalm 101:3). The fathers'' wisdom warns with Job''s own fire-image: *Turn away your eye from a beautiful woman... for herewith love is kindled as a fire* (Sirach 9:8) — and Job names that fire two verses on, *a fire that consumeth to destruction* (Job 31:12). The covenant of the eyes is not flesh-merit; it is the fear of Yahuah guarding the inward man.',
       sv.verse_id, ev.verse_id, 'extras', 33550
  FROM _s318_job31_lookup sv, _s318_job31_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=31 AND ev.verse_number=1
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-31-6-weighed-in-an-even-balance',
       E'Let Me Be Weighed in an Even Balance',
       E'Job will not hide from the scale; he invites it: *Let me be weighed in an even balance, that Elohim (God) may know mine integrity* (Job 31:6), confident that *Doth not he see my ways, and count all my steps?* (Job 31:4). The balance he asks to stand in is Yahuah''s own instrument — *A just weight and balance are the LORD''S: all the weights of the bag are his work* (Proverbs 16:11). Hannah had sung the truth Job stakes his oath upon: *Yahuah (LORD) is a Elohim (God) of knowledge, and by him actions are weighed* (1 Samuel 2:3). The same balance that weighs the proud finds them wanting — *TEKEL; Thou art weighed in the balances, and art found wanting* (Daniel 5:27) — yet the man of integrity, walking in no deceit, asks to be weighed and is not afraid. This is not a boast of the flesh but the clear conscience of one who fears the Judge who counts every step.',
       sv.verse_id, ev.verse_id, 'free', 33551
  FROM _s318_job31_lookup sv, _s318_job31_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=5
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=31 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-31-15-one-fashioned-us-in-the-womb',
       E'Did Not One Fashion Us in the Womb?',
       E'Job grounds justice to his slave in the doctrine of one Creator: *If I did despise the cause of my manservant or of my maidservant, when they contended with me; What then shall I do when Elohim (God) riseth up?... Did not he that made me in the womb make him? and did not one fashion us in the womb?* (Job 31:13-15). The master and the servant are formed by one hand — the very ground Malachi names: *Have we not all one father? hath not one Elohim (God) created us?* (Malachi 2:10). To wrong the lowly is therefore a reproach against the Maker: *He that oppresseth the poor reproacheth his Maker* (Proverbs 14:31). The apostle binds master and slave under one Master above — *knowing that your Master also is in heaven; neither is there respect of persons with him* (Ephesians 6:9) — and the fathers'' wisdom enjoins the same: *Whereas your servant works truly, entreat him not evil* (Sirach 7:20). Here is the heart-Torah: not class and property but one fashioning hand, before which the servant''s cause is sacred.',
       sv.verse_id, ev.verse_id, 'extras', 33552
  FROM _s318_job31_lookup sv, _s318_job31_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=13
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=31 AND ev.verse_number=15
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-31-19-the-poor-the-widow-the-fatherless-the-naked',
       E'The Poor, the Widow, the Fatherless, the Naked Clothed',
       E'Job''s oath rolls through the whole Torah of mercy: *If I have withheld the poor from their desire, or have caused the eyes of the widow to fail; Or have eaten my morsel myself alone, and the fatherless hath not eaten thereof... If I have seen any perish for want of clothing, or any poor without covering; If his loins have not blessed me, and if he were not warmed with the fleece of my sheep* (Job 31:16-20). This is Deuteronomy lived: *thou shalt not harden thine heart, nor shut thine hand from thy poor brother* (Deuteronomy 15:7). It is Isaiah''s true fast: *when thou seest the naked, that thou cover him; and that thou hide not thyself from thine own flesh* (Isaiah 58:7). It is the King''s own measure of the nations: *Naked, and ye clothed me: I was sick, and ye visited me* (Matthew 25:36) — what is done to the least is done to the Messiah, and Job had clothed them already. The fathers'' wisdom charged the same — *be a father to the fatherless* (Sirach 4:10), *Give of your bread to the hungry, and of your garments to them that are naked* (Tobit 4:16). The Torah''s mercy is not external rule but the inward life of the man who feared Yahuah from his youth.',
       sv.verse_id, ev.verse_id, 'extras', 33553
  FROM _s318_job31_lookup sv, _s318_job31_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=16
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=31 AND ev.verse_number=23
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-31-26-neither-the-sun-nor-the-gold',
       E'Neither the Sun Nor the Gold: the El That Is Above',
       E'Job''s oath guards the first commandment from two rivals — wealth and the host of heaven: *If I have made gold my hope, or have said to the fine gold, Thou art my confidence... If I beheld the sun when it shined, or the moon walking in brightness; And my heart hath been secretly enticed, or my mouth hath kissed my hand: This also were an iniquity to be punished by the judge: for I should have denied the Elohim (God) that is above* (Job 31:24-28). The sun-and-moon worship is the very thing the Torah forbade: *lest thou lift up thine eyes unto heaven, and when thou seest the sun, and the moon, and the stars... shouldest be driven to worship them* (Deuteronomy 4:19); the folly that *deemed... the lights of heaven, to be the gods which govern the world* (Wisdom of Solomon 13:2). And the trust in gold is the rival master the Messiah named: *Ye cannot serve Elohim (God) and mammon* (Matthew 6:24). To set the heart on gold or to kiss the hand to the sun is to deny the El who is above them both — Job''s conscience held the throne for the Most High alone.',
       sv.verse_id, ev.verse_id, 'extras', 33554
  FROM _s318_job31_lookup sv, _s318_job31_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=24
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=31 AND ev.verse_number=28
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-31-30-no-curse-on-his-enemys-soul',
       E'I Have Not Suffered My Mouth to Curse His Soul',
       E'Job''s oath reaches the hardest ground — the enemy: *If I rejoiced at the destruction of him that hated me, or lifted up myself when evil found him: Neither have I suffered my mouth to sin by wishing a curse to his soul* (Job 31:29-30). He kept the proverb the heart must keep: *Rejoice not when thine enemy falleth, and let not thine heart be glad when he stumbleth* (Proverbs 24:17). And he kept, centuries before it was preached, the height the Messiah taught and the apostle commanded: *Bless them which persecute you: bless, and curse not* (Romans 12:14). No gloating over a fallen foe, no curse let loose from the mouth — this is the heart-Torah at its summit, the love that does not rejoice in another''s ruin even when that other is one''s own hater.',
       sv.verse_id, ev.verse_id, 'free', 33555
  FROM _s318_job31_lookup sv, _s318_job31_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=29
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=31 AND ev.verse_number=30
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-31-33-if-i-covered-as-adam',
       E'If I Covered My Transgressions as Adam',
       E'Job names the first sinner''s first instinct and swears he never shared it: *If I covered my transgressions as Adam, by hiding mine iniquity in my bosom* (Job 31:33). The hiding goes back to the garden — *Adam and his wife hid themselves from the presence of Yahuah Elohim (the LORD God) amongst the trees of the garden* (Genesis 3:8) — the concealment that has run in the blood ever since. Wisdom sets the two ways plainly: *He that covereth his sins shall not prosper: but whoso confesseth and forsaketh them shall have mercy* (Proverbs 28:13). And the apostle names the open way against Adam''s hiding: *If we confess our sins, he is faithful and just to forgive us our sins* (1 John 1:9). Job, who would not cover his iniquity in his bosom, walked the way of confession, not concealment — the inward honesty before Yahuah that is the very opposite of Adam''s fig leaves and flight. So the great oath closes, and *the words of Job are ended* (Job 31:40).',
       sv.verse_id, ev.verse_id, 'free', 33556
  FROM _s318_job31_lookup sv, _s318_job31_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=29
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=31 AND ev.verse_number=33
ON CONFLICT (slug) DO NOTHING;

-- ============================================================================
-- D. THREAD MEMBERS
-- ============================================================================
-- Thread 1 — covenant with the eyes
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*whosoever looketh on a woman to lust after her hath committed adultery with her already in his heart* (Matthew 5:28) — the heart standard the Messiah taught was already Job''s covenant of the eyes.'
  FROM cross_reference_threads t
  JOIN _s318_job31_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=1
  JOIN _s318_job31_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='matthew' AND tv.chapter_number=5 AND tv.verse_number=28
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-31-1-i-made-a-covenant-with-mine-eyes'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'*Lust not after her beauty in thine heart* (Proverbs 6:25) — wisdom forbids the lust in the heart before the hand, the place Job guarded.'
  FROM cross_reference_threads t
  JOIN _s318_job31_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=1
  JOIN _s318_job31_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='proverbs' AND tv.chapter_number=6 AND tv.verse_number=25
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-31-1-i-made-a-covenant-with-mine-eyes'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'*I will set no wicked thing before mine eyes... it shall not cleave to me* (Psalm 101:3) — David''s vow of the eyes is Job''s covenant.'
  FROM cross_reference_threads t
  JOIN _s318_job31_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=1
  JOIN _s318_job31_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=101 AND tv.verse_number=3
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-31-1-i-made-a-covenant-with-mine-eyes'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 4, E'*Turn away your eye from a beautiful woman... herewith love is kindled as a fire* (Sirach 9:8) — the fathers'' wisdom, with Job''s own fire-image (Job 31:12).'
  FROM cross_reference_threads t
  JOIN _s318_job31_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=1
  JOIN _s318_job31_lookup tv ON tv.edition_slug='apocrypha' AND tv.book_slug='ecclesiasticus' AND tv.chapter_number=9 AND tv.verse_number=8
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-31-1-i-made-a-covenant-with-mine-eyes'
