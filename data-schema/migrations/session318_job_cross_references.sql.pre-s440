-- ----- fragment: minion_job_35.sql (Job 35) -----
-- Job 35 — Elihu's third speech: man's righteousness or sin neither enriches
--   nor diminishes El. Source book_slug=job, chapter 35 (16 verses, Elihu).
-- session prefix s318 ; tag job35 ; temp view _s318_job35_lookup
-- slug prefix job-35-... ; sort_order band start 33650 (+1 per thread)
--
-- Job 35 coverage:
--   v.2-3  (My righteousness more than Elohim's / what profit if cleansed)
--          NT:     none warranted (folded into the v.6-8 self-sufficiency thread via Rom11:35)
--          Extras: none warranted
--          Tanakh: Job 22:2-3 (Eliphaz: can a man be profitable unto El?) — used in v.6-8 thread
--   v.6-8  (If thou sinnest / be righteous, what doest thou to him; profit the son of Adam)
--          NT:     Romans 11:35 (who hath first given to him); Luke 17:10 (unprofitable servants);
--                  Acts 17:25 (neither worshipped with men's hands as needing any thing)
--          Extras: none warranted
--          Tanakh: Job 22:2-3 (can a man be profitable unto El); Psalm 16:2 (my goodness extendeth not to thee)
--   v.10   (Where is Eloah my maker, who giveth songs in the night)
--          NT:     Acts 16:25 (Paul and Silas sang praises at midnight in prison)
--          Extras: none warranted
--          Tanakh: Psalm 42:8 (in the night his song shall be with me); Psalm 77:6 (my song in the night)
--   v.12-13 (they cry, none answereth, pride of evil men; El will not hear vanity)
--          NT:     James 4:3 (ye ask and receive not, because ye ask amiss)
--          Extras: none warranted
--          Tanakh: Psalm 66:18 (if I regard iniquity in my heart, Yahuah will not hear me)
--   v.4-5,9,11,14-16  framing/transitional — none warranted as anchors
--
-- THREADS (3):
--   job-35-if-thou-sinnest-what-doest-thou-against-him  [free] anchor 35:6–35:8
--       targets: Romans 11:35, Job 22:2, Job 22:3, Psalm 16:2, Luke 17:10, Acts 17:25 (all canon)
--       FRAME: El's self-sufficiency — man cannot put Yahuah in his debt; the anti-flesh-merit
--       truth that removes the BOAST, not obedience (Rom11:35 / Luke17:10 "unprofitable servants
--       ... we have done that which was our duty to do" = duty still owed). "son of Adam" at 35:8
--       rendered exactly.
--   job-35-who-giveth-songs-in-the-night  [free] anchor 35:10–35:10
--       targets: Psalm 42:8, Psalm 77:6, Acts 16:25 (all canon)
--   job-35-they-cry-but-none-giveth-answer  [free] anchor 35:12–35:13
--       targets: Psalm 66:18, James 4:3 (all canon)
--
-- All members canon (Tanakh + NT) → every thread tier_required='free'.

CREATE TEMP VIEW _s318_job35_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== B. cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: 35:6-8 El cannot be put in man's debt
    ('canon','job',35,6,'canon','romans',11,35,'free',
     E'Paul seals Elihu''s point: *Or who hath first given to him, and it shall be recompensed unto him again?* (Romans 11:35). Elihu asks *If thou sinnest, what doest thou against him? or if thy transgressions be multiplied, what doest thou unto him?* (Job 35:6) — no man first gives to Yahuah (the LORD) so as to lay him under obligation. The boast is excluded; El is never the debtor.'),
    ('canon','job',35,7,'canon','romans',11,35,'free',
     E'*Or who hath first given to him, and it shall be recompensed unto him again?* (Romans 11:35). To Elihu''s *If thou be righteous, what givest thou him? or what receiveth he of thine hand?* (Job 35:7) Paul answers from the other end of the canon: our righteousness puts nothing into Yahuah''s (the LORD''s) hand that he must repay. This removes the merit-boast, not the duty.'),
    ('canon','job',35,7,'canon','job',22,2,'free',
     E'Eliphaz had already pressed it: *Can a man be profitable unto Elohim (God), as he that is wise may be profitable unto himself?* (Job 22:2). Elihu echoes the same truth in *what givest thou him? or what receiveth he of thine hand?* (Job 35:7) — the Almighty gains nothing from the creature he made.'),
    ('canon','job',35,7,'canon','job',22,3,'free',
     E'*Is it any pleasure to the Almighty, that thou art righteous? or is it gain to him, that thou makest thy ways perfect?* (Job 22:3). Eliphaz frames Elihu''s *what givest thou him?* (Job 35:7): a man''s integrity is not El''s enrichment. Yahuah (the LORD) commands righteousness for the man''s good, not because he needs it.'),
    ('canon','job',35,7,'canon','psalms',16,2,'free',
     E'David confesses the same self-sufficiency of El: *O my soul, thou hast said unto Yahuah (LORD), Thou art my Lord: my goodness extendeth not to thee* (Psalm 16:2). Elihu''s *what givest thou him?* (Job 35:7) is answered — even the righteous man''s goodness reaches outward to his fellows, not up to enrich the Most High.'),
    ('canon','job',35,7,'canon','luke',17,10,'free',
     E'Yahusha (Jesus) teaches the posture this truth produces: *So likewise ye, when ye shall have done all those things which are commanded you, say, We are unprofitable servants: we have done that which was our duty to do* (Luke 17:10). Even after full obedience to Elihu''s question *what receiveth he of thine hand?* (Job 35:7), the servant has only paid a duty owed — the commandments still stand, the boast is gone.'),
    ('canon','job',35,8,'canon','acts',17,25,'free',
     E'Paul declares to Athens the El who needs nothing: *Neither is worshipped with men''s hands, as though he needed any thing, seeing he giveth to all life, and breath, and all things* (Acts 17:25). Elihu had said *Thy wickedness may hurt a man as thou art; and thy righteousness may profit the son of Adam* (Job 35:8) — our deeds touch our fellow man; the self-sufficient Maker is the giver, never the one supplied.'),
    -- Thread 2: 35:10 songs in the night
    ('canon','job',35,10,'canon','psalms',42,8,'free',
     E'The Maker Elihu says men fail to seek — *Where is Elohim (God) my maker, who giveth songs in the night* (Job 35:10) — is the very One the sons of Korah find in the dark: *Yet Yahuah (LORD) will command his lovingkindness in the daytime, and in the night his song shall be with me, and my prayer unto the Elohim (God) of my life* (Psalm 42:8). The song in the night is the comfort offered to all who turn and ask, *Where is Elohim my maker?*'),
    ('canon','job',35,10,'canon','psalms',77,6,'free',
     E'Asaph, sleepless and troubled, reaches for the same gift: *I call to remembrance my song in the night: I commune with mine own heart: and my spirit made diligent search* (Psalm 77:6). Elihu''s *who giveth songs in the night* (Job 35:10) names what Asaph seeks — the Maker who sets a song in the darkest hour for the one who will say, *Where is Elohim (God) my maker?*'),
    ('canon','job',35,10,'canon','acts',16,25,'free',
     E'The song in the night sounds at its loudest in the Philippian jail: *And at midnight Paul and Silas prayed, and sang praises unto Elohim (God): and the prisoners heard them* (Acts 16:25). Elihu lamented that *none saith, Where is Elohim (God) my maker, who giveth songs in the night* (Job 35:10) — Paul and Silas sought him, and the Maker put the very song Elihu spoke of into their mouths in the stocks.'),
    -- Thread 3: 35:12-13 the unheard cry of the proud
    ('canon','job',35,12,'canon','psalms',66,18,'free',
     E'David names why the cry goes unanswered: *If I regard iniquity in my heart, Yahuah (Lord) will not hear me* (Psalm 66:18). Elihu says *There they cry, but none giveth answer, because of the pride of evil men* (Job 35:12) — it is not El''s deafness but the unrepented heart that closes the ear of heaven.'),
    ('canon','job',35,13,'canon','james',4,3,'free',
     E'James exposes the same vanity in prayer: *Ye ask, and receive not, because ye ask amiss, that ye may consume it upon your lusts* (James 4:3). To Elihu''s *Surely Elohim (God) will not hear vanity, neither will the Almighty regard it* (Job 35:13), James answers — the proud man''s self-serving cry is the very vanity El will not regard.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job35_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job35_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== C. threads =====
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-35-if-thou-sinnest-what-doest-thou-against-him',
       E'If thou sinnest, what doest thou against him? — man cannot put El in his debt',
       E'Elihu lifts Job''s eyes off himself and onto the self-sufficiency of El: *If thou sinnest, what doest thou against him? or if thy transgressions be multiplied, what doest thou unto him? If thou be righteous, what givest thou him? or what receiveth he of thine hand? Thy wickedness may hurt a man as thou art; and thy righteousness may profit the son of Adam* (Job 35:6-8). No deed of the creature adds to or subtracts from the Maker — our righteousness and our sin land on our fellow man, never on El''s self-sufficiency. Eliphaz had already laid the same truth before Job: *Can a man be profitable unto Elohim (God), as he that is wise may be profitable unto himself?* (Job 22:2); *Is it any pleasure to the Almighty, that thou art righteous? or is it gain to him, that thou makest thy ways perfect?* (Job 22:3). David confessed it in worship: *Thou art my Lord: my goodness extendeth not to thee* (Psalm 16:2). Paul seals it from the far end of the canon as the death of every boast: *Or who hath first given to him, and it shall be recompensed unto him again?* (Romans 11:35) — no man gives first, so no man can lay Yahuah (the LORD) under obligation. Yet this truth removes only the boast, never the duty: Yahusha (Jesus) draws out exactly the right posture — *when ye shall have done all those things which are commanded you, say, We are unprofitable servants: we have done that which was our duty to do* (Luke 17:10) — the commandments still stand, fully owed, but earn no leverage over heaven. Paul preaches the same needless El at Athens: *Neither is worshipped with men''s hands, as though he needed any thing, seeing he giveth to all life, and breath, and all things* (Acts 17:25). El is forever the Giver, never the supplied; we obey because it is our duty and our good, not because we ever obligate the Almighty.',
       sv.verse_id, ev.verse_id, 'free', 33650
  FROM _s318_job35_lookup sv, _s318_job35_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=6
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=35 AND ev.verse_number=8
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-35-who-giveth-songs-in-the-night',
       E'Where is Eloah my maker, who giveth songs in the night',
       E'Elihu grieves the comfort men fail to seek: *But none saith, Where is Elohim (God) my maker, who giveth songs in the night* (Job 35:10). The Maker stands ready to set a song in the darkest hour — but the proud, in their oppression, cry out without ever turning to ask for him. The Psalms know this song. The sons of Korah find it in the deep: *Yet Yahuah (LORD) will command his lovingkindness in the daytime, and in the night his song shall be with me, and my prayer unto the Elohim (God) of my life* (Psalm 42:8). Asaph, too troubled to speak, reaches for it: *I call to remembrance my song in the night: I commune with mine own heart: and my spirit made diligent search* (Psalm 77:6). And the song sounds at its clearest in a Roman prison, where two men sought the Maker Elihu said none seeks: *And at midnight Paul and Silas prayed, and sang praises unto Elohim (God): and the prisoners heard them* (Acts 16:25). The Maker who gives songs in the night is no abstraction — he is the One who, when sought, puts praise in the mouth of the bound and the broken.',
       sv.verse_id, ev.verse_id, 'free', 33651
  FROM _s318_job35_lookup sv, _s318_job35_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=10
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=35 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-35-they-cry-but-none-giveth-answer',
       E'They cry, but none giveth answer — El will not hear vanity',
       E'Elihu explains the silence over the proud man''s prayer: *There they cry, but none giveth answer, because of the pride of evil men. Surely Elohim (God) will not hear vanity, neither will the Almighty regard it* (Job 35:12-13). It is not that El cannot hear; it is that the cry rises from an unrepentant, self-serving heart. David names the same barrier from the inside: *If I regard iniquity in my heart, Yahuah (Lord) will not hear me* (Psalm 66:18) — cherished sin shuts the ear of heaven. James carries it into the apostolic age as the anatomy of unanswered prayer: *Ye ask, and receive not, because ye ask amiss, that ye may consume it upon your lusts* (James 4:3). The vanity El will not regard is the proud petition that seeks only to feed its own appetite. The cry that He answers is the humbled, turning heart, not the demanding one.',
       sv.verse_id, ev.verse_id, 'free', 33652
  FROM _s318_job35_lookup sv, _s318_job35_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=12
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=35 AND ev.verse_number=13
ON CONFLICT (slug) DO NOTHING;

-- ===== D. thread_members =====
-- Thread 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*Or who hath first given to him, and it shall be recompensed unto him again?* (Romans 11:35) — no man gives to Yahuah (the LORD) first, so none can put him in his debt; Elihu''s *what doest thou against him?* answered.'
  FROM cross_reference_threads t
  JOIN _s318_job35_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=6
  JOIN _s318_job35_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='romans' AND tv.chapter_number=11 AND tv.verse_number=35
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-35-if-thou-sinnest-what-doest-thou-against-him'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'*Or who hath first given to him...* (Romans 11:35) again, answering 35:7 *what givest thou him? or what receiveth he of thine hand?* — the merit-boast excluded, the duty kept.'
  FROM cross_reference_threads t
  JOIN _s318_job35_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=7
  JOIN _s318_job35_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='romans' AND tv.chapter_number=11 AND tv.verse_number=35
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-35-if-thou-sinnest-what-doest-thou-against-him'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'*Can a man be profitable unto Elohim (God)...?* (Job 22:2) — Eliphaz''s lateral witness that El gains nothing from the creature, echoing 35:7.'
  FROM cross_reference_threads t
  JOIN _s318_job35_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=7
  JOIN _s318_job35_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=22 AND tv.verse_number=2
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-35-if-thou-sinnest-what-doest-thou-against-him'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 4, E'*Is it any pleasure to the Almighty, that thou art righteous?...* (Job 22:3) — a man''s integrity is not El''s gain; it is for the man''s good, not the Maker''s need.'
  FROM cross_reference_threads t
  JOIN _s318_job35_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=7
  JOIN _s318_job35_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=22 AND tv.verse_number=3
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-35-if-thou-sinnest-what-doest-thou-against-him'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 5, E'*my goodness extendeth not to thee* (Psalm 16:2) — David''s own confession that the righteous man''s goodness reaches his fellows, not up to enrich the Most High.'
  FROM cross_reference_threads t
  JOIN _s318_job35_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=7
  JOIN _s318_job35_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=16 AND tv.verse_number=2
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-35-if-thou-sinnest-what-doest-thou-against-him'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 6, E'*We are unprofitable servants: we have done that which was our duty to do* (Luke 17:10) — Yahusha (Jesus) gives the posture: full obedience pays a duty owed, earns no leverage; the boast gone, the commandment kept.'
  FROM cross_reference_threads t
  JOIN _s318_job35_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=7
  JOIN _s318_job35_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='luke' AND tv.chapter_number=17 AND tv.verse_number=10
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-35-if-thou-sinnest-what-doest-thou-against-him'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 7, E'*Neither is worshipped with men''s hands, as though he needed any thing...* (Acts 17:25) — Paul at Athens names the needless Giver; 35:8 *thy righteousness may profit the son of Adam* — our deeds touch our fellow, not El''s sufficiency.'
  FROM cross_reference_threads t
  JOIN _s318_job35_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=8
  JOIN _s318_job35_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='acts' AND tv.chapter_number=17 AND tv.verse_number=25
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-35-if-thou-sinnest-what-doest-thou-against-him'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 2
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*in the night his song shall be with me* (Psalm 42:8) — the sons of Korah find in the deep the very song Elihu says the Maker gives in the night.'
  FROM cross_reference_threads t
  JOIN _s318_job35_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=35 AND sv.verse_number=10
