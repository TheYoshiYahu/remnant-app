-- ----- fragment: minion_job_13.sql (Job 13) -----
-- Chapter: Job 13 — Job turns from the friends to El Himself.
-- Tag: job13 | session prefix: s318 | sort band: 33100+ (one per thread)
-- Source book_slug=job, chapter 13. All quotes verbatim from dump_canon.py.
--
-- Job 13 coverage:
--   v.4  (forgers of lies / physicians of no value):
--        NT:     none warranted (the lateral Job witnesses carry it)
--        Extras: Ecclesiasticus (Sirach) 6:8 — fair-weather friend abandons the day of trouble
--        Tanakh: Job 16:2 (miserable comforters are ye all); Job 42:7 (ye have not spoken right)
--   v.15 (Though he slay me, yet will I trust in him — KEYSTONE):
--        NT:     Romans 8:38-39 (nothing separates from the love of Elohim); 2 Timothy 1:12 (I know whom I have believed)
--        Extras: none warranted (canon carries the trust-through-the-slaying weave)
--        Tanakh: Habakkuk 3:17-18 (though the fig tree shall not blossom, yet I will rejoice in Yahuah); Psalm 23:4 (valley of the shadow, thou art with me)
--   v.16-19 (He shall be my salvation / I shall be justified / who will plead with me):
--        NT:     Romans 8:33-34 (It is Elohim that justifieth; who is he that condemneth)
--        Extras: none warranted
--        Tanakh: Isaiah 50:8-9 (He is near that justifieth me; who will contend with me) — also v.28 moth-eaten garment echoes Isa 50:9
--   v.24 (Wherefore hidest thou thy face, and holdest me for thine enemy):
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: Psalm 13:1 (how long wilt thou hide thy face); Psalm 88:14 (why hidest thou thy face from me); Deuteronomy 31:17 (I will hide my face — covenant frame)
--
-- Threads:
--   job-13-forgers-of-lies-physicians-of-no-value (v.4-5) -> Tanakh (Job 16:2, Job 42:7) + Extras (Sirach 6:8) = tier extras
--   job-13-though-he-slay-me-yet-will-i-trust-in-him (v.15) -> Tanakh (Hab 3:17-18, Ps 23:4) + NT (Rom 8:38-39, 2 Tim 1:12) = tier free
--   job-13-i-have-ordered-my-cause-i-shall-be-justified (v.16-19) -> Tanakh (Isa 50:8-9) + NT (Rom 8:33-34) = tier free
--   job-13-wherefore-hidest-thou-thy-face (v.24) -> Tanakh (Ps 13:1, Ps 88:14, Deut 31:17) = tier free
--
-- FRAMING GUARD (v.15): the supreme statement of covenant-faithfulness held WITHOUT prosperity —
-- trust THROUGH the slaying, never resignation-without-hope; Job's maintaining of his ways = the
-- integrity of the righteous before El, never self-righteous flesh-merit. The justification of
-- v.18 is the vindication of an upright cause before the Judge (Yahuah confirms it, Job 42:7),
-- not a Reformation imputation severed from walking uprightly.

CREATE TEMP VIEW _s318_job13_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================ cross_references ============================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: forgers of lies / physicians of no value (13:4)
    ('canon','job',13,4,'canon','job',16,2,'free',
     E'*I have heard many such things: miserable comforters are ye all* (Job 16:2). Three chapters on, Job names again what he charges here: *but ye are forgers of lies, ye are all physicians of no value* (Job 13:4). The friends prescribe doctrine to a wound they have not felt; their comfort is counterfeit medicine, and Job will take his cause past them to the Almighty.'),
    ('canon','job',13,4,'canon','job',42,7,'free',
     E'*And it was so, that after Yahuah (LORD) had spoken these words unto Job, Yahuah (LORD) said to Eliphaz the Temanite, My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). The verdict of the book vindicates Job''s rebuke — *ye are forgers of lies* (Job 13:4) — for the comforters spoke wrongly of Elohim (God), and Job, who held his integrity, spoke right.'),
    ('canon','job',13,4,'apocrypha','ecclesiasticus',6,8,'extras',
     E'*For some man is a friend for his own occasion, and will not abide in the day of your trouble* (Ecclesiasticus 6:8). The wisdom of Ben Sira draws the very portrait Job suffers: friends present in prosperity who, when the day of trouble comes, become *physicians of no value* (Job 13:4) — counsellors who abandon the man precisely when he bleeds.'),

    -- THREAD 2: Though he slay me, yet will I trust in him (13:15) — KEYSTONE
    ('canon','job',13,15,'canon','habakkuk',3,17,'free',
     E'*Although the fig tree shall not blossom, neither shall fruit be in the vines; the labour of the olive shall fail, and the fields shall yield no meat; the flock shall be cut off from the fold, and there shall be no herd in the stalls* (Habakkuk 3:17). Habakkuk strips away every visible provision — exactly the loss Job sits in — to set the stage for a trust that does not hang on rescue, the same ground as *though he slay me, yet will I trust in him* (Job 13:15).'),
    ('canon','job',13,15,'canon','habakkuk',3,18,'free',
     E'*Yet I will rejoice in Yahuah (LORD), I will joy in the Elohim (God) of my salvation* (Habakkuk 3:18). With the fields barren and the fold empty, the prophet''s *yet* answers Job''s *yet*: *though he slay me, yet will I trust in him* (Job 13:15). This is covenant-faithfulness held without prosperity — joy anchored in Yahuah (LORD) Himself, not in His gifts.'),
    ('canon','job',13,15,'canon','psalms',23,4,'free',
     E'*Yea, though I walk through the valley of the shadow of death, I will fear no evil: for thou art with me; thy rod and thy staff they comfort me* (Psalm 23:4). David walks the very valley Job stands in and fears no evil — not because the slaying is withheld but because *thou art with me*. So Job: *though he slay me, yet will I trust in him* (Job 13:15) — the trust that survives the shadow because its object is the Shepherd, not the safety.'),
    ('canon','job',13,15,'canon','romans',8,38,'free',
     E'*For I am persuaded, that neither death, nor life, nor angels, nor principalities, nor powers, nor things present, nor things to come* (Romans 8:38). Paul gathers death itself into the list that cannot break the bond — the New Testament voice of Job''s confession, *though he slay me, yet will I trust in him* (Job 13:15). Even the slaying is inside the love, not outside it.'),
    ('canon','job',13,15,'canon','romans',8,39,'free',
     E'*Nor height, nor depth, nor any other creature, shall be able to separate us from the love of Elohim (God), which is in HaMashiach Yahusha (Christ Jesus) our Lord* (Romans 8:39). The persuasion lands where Job''s did: nothing, not even being slain, severs the trusting one from Elohim (God). *Though he slay me, yet will I trust in him* (Job 13:15) is the same unbreakable bond, sung centuries before the Formed Son made it sure.'),
    ('canon','job',13,15,'canon','2-timothy',1,12,'free',
     E'*For the which cause I also suffer these things: nevertheless I am not ashamed: for I know whom I have believed, and am persuaded that he is able to keep that which I have committed unto him against that day* (2 Timothy 1:12). Paul in chains rests where Job rests in his ashes — not on deliverance from suffering but on the One trusted through it. *Though he slay me, yet will I trust in him* (Job 13:15): the trust that does not depend on being spared.'),

    -- THREAD 3: I have ordered my cause; I shall be justified (13:16-19)
    ('canon','job',13,18,'canon','isaiah',50,8,'free',
     E'*He is near that justifieth me; who will contend with me? let us stand together: who is mine adversary? let him come near to me* (Isaiah 50:8). The Servant of Isaiah speaks Job''s very confidence: *Behold now, I have ordered my cause; I know that I shall be justified... Who is he that will plead with me?* (Job 13:18-19). Both stand ready to face the court because their cause is true before El who is near.'),
    ('canon','job',13,18,'canon','isaiah',50,9,'free',
     E'*Behold, Adonai Yahuah (the Lord GOD) will help me; who is he that shall condemn me? lo, they all shall wax old as a garment; the moth shall eat them up* (Isaiah 50:9). The accusers wear out like a moth-eaten garment — the very image Job closes this chapter with, *as a garment that is moth eaten* (Job 13:28). The justified one stands; the contenders rot away. *I know that I shall be justified* (Job 13:18).'),
    ('canon','job',13,18,'canon','romans',8,33,'free',
     E'*Who shall lay any thing to the charge of Elohim''s (God''s) elect? It is Elohim (God) that justifieth* (Romans 8:33). Paul asks Job''s question — *Who is he that will plead with me?* (Job 13:19) — and answers it: the One who justifies is the only Judge. Job''s *I know that I shall be justified* (Job 13:18) is the same court, the same verdict from the same righteous El.'),
    ('canon','job',13,18,'canon','romans',8,34,'free',
     E'*Who is he that condemneth? It is Messiah (Christ) that died, yea rather, that is risen again, who is even at the right hand of Elohim (God), who also maketh intercession for us* (Romans 8:34). Job longs for a pleader; the New Testament names Him — the risen Messiah (Christ) who intercedes. *Behold now, I have ordered my cause; I know that I shall be justified* (Job 13:18): the cause is secured not by Job''s merit but by the Advocate at El''s right hand.'),

    -- THREAD 4: Wherefore hidest thou thy face (13:24)
    ('canon','job',13,24,'canon','psalms',13,1,'free',
     E'*How long wilt thou forget me, O Yahuah (LORD)? for ever? how long wilt thou hide thy face from me?* (Psalm 13:1). David asks Job''s question word for word — *Wherefore hidest thou thy face, and holdest me for thine enemy?* (Job 13:24). The hidden face is the deepest grief of the faithful: not the loss of things, but the felt withdrawal of the One they trust.'),
    ('canon','job',13,24,'canon','psalms',88,14,'free',
     E'*Yahuah (LORD), why castest thou off my soul? why hidest thou thy face from me?* (Psalm 88:14). The darkest psalm in the canon meets Job in his darkness, asking the same unanswered *why*. *Wherefore hidest thou thy face, and holdest me for thine enemy?* (Job 13:24) — the cry is laid bare in scripture, not silenced, and the faithful are given words for the hidden face.'),
    ('canon','job',13,24,'canon','deuteronomy',31,17,'free',
     E'*Then my anger shall be kindled against them in that day, and I will forsake them, and I will hide my face from them, and they shall be devoured, and many evils and troubles shall befall them; so that they will say in that day, Are not these evils come upon us, because our Elohim (God) is not among us?* (Deuteronomy 31:17). Torah names the hidden face as covenant-judgment for turning away — yet Job has not turned away, which makes his *Wherefore hidest thou thy face* (Job 13:24) the harder cry: the upright man feeling a withdrawal the wicked earn, and trusting still.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job13_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job13_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================ threads ============================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-13-forgers-of-lies-physicians-of-no-value',
       E'Forgers of Lies, Physicians of No Value',
       E'Job turns on his three comforters with a verdict: *But ye are forgers of lies, ye are all physicians of no value* (Job 13:4). They have prescribed doctrine to a wound they never felt, and Job wishes their silence were their wisdom — *O that ye would altogether hold your peace! and it should be your wisdom* (Job 13:5). Three chapters later he says it again: *I have heard many such things: miserable comforters are ye all* (Job 16:2). The wisdom of Ben Sira had already painted the type — *some man is a friend for his own occasion, and will not abide in the day of your trouble* (Ecclesiasticus 6:8) — the companion who vanishes the moment trouble comes. And the book itself renders the final verdict in Job''s favour: *Yahuah (LORD) said to Eliphaz the Temanite, My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). The false physicians spoke wrongly of Elohim (God); the suffering man, who held his integrity, spoke right.',
       sv.verse_id, ev.verse_id, 'extras', 33100
  FROM _s318_job13_lookup sv, _s318_job13_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=13 AND sv.verse_number=4
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=13 AND ev.verse_number=5
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-13-though-he-slay-me-yet-will-i-trust-in-him',
       E'Though He Slay Me, Yet Will I Trust in Him',
       E'Here is the summit of the book and one of the summits of all scripture: *Though he slay me, yet will I trust in him: but I will maintain mine own ways before him* (Job 13:15). This is not resignation that has given up hope; it is trust that has outlived rescue. Job has lost everything and expects nothing back — and still he will not let go of the One who took it, nor abandon the integrity of his walk. The prophet Habakkuk stands on the same bare ground: *Although the fig tree shall not blossom, neither shall fruit be in the vines... the flock shall be cut off from the fold, and there shall be no herd in the stalls* (Habakkuk 3:17) — *Yet I will rejoice in Yahuah (LORD), I will joy in the Elohim (God) of my salvation* (Habakkuk 3:18). David walks the valley and fears no evil because *thou art with me* (Psalm 23:4) — the presence, not the safety, is the comfort. And the New Testament makes the bond sure: *I am persuaded, that neither death, nor life... nor things present, nor things to come* (Romans 8:38), *nor any other creature, shall be able to separate us from the love of Elohim (God), which is in HaMashiach Yahusha (Christ Jesus) our Lord* (Romans 8:39). Paul in chains rests exactly where Job rests in ashes: *I know whom I have believed, and am persuaded that he is able to keep that which I have committed unto him against that day* (2 Timothy 1:12). The trust does not depend on being spared. To *maintain mine own ways before him* is the integrity of the righteous before El — never self-righteous flesh-merit, but the upright walk a man will not betray even under the rod.',
       sv.verse_id, ev.verse_id, 'free', 33101
  FROM _s318_job13_lookup sv, _s318_job13_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=13 AND sv.verse_number=15
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=13 AND ev.verse_number=15
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-13-i-have-ordered-my-cause-i-shall-be-justified',
       E'I Have Ordered My Cause; I Shall Be Justified',
       E'Out of the trust of verse 15 comes a courtroom confidence. *He also shall be my salvation: for an hypocrite shall not come before him* (Job 13:16), and Job lays out his case like a man certain of acquittal: *Behold now, I have ordered my cause; I know that I shall be justified. Who is he that will plead with me?* (Job 13:18-19). The Servant of Isaiah speaks the identical assurance: *He is near that justifieth me; who will contend with me? let us stand together: who is mine adversary?* (Isaiah 50:8) — *who is he that shall condemn me? lo, they all shall wax old as a garment; the moth shall eat them up* (Isaiah 50:9), the very moth-eaten garment Job names as the chapter closes (Job 13:28). The New Testament answers Job''s *who will plead with me* by naming both Judge and Advocate: *Who shall lay any thing to the charge of Elohim''s (God''s) elect? It is Elohim (God) that justifieth* (Romans 8:33); *Who is he that condemneth? It is Messiah (Christ) that died, yea rather, that is risen again, who is even at the right hand of Elohim (God), who also maketh intercession for us* (Romans 8:34). Job''s justification is the vindication of an upright cause before the only righteous Judge — confirmed when Yahuah (LORD) declares Job spoke right (Job 42:7) — not a verdict severed from a faithful walk, but the open standing of the righteous before El.',
       sv.verse_id, ev.verse_id, 'free', 33102
  FROM _s318_job13_lookup sv, _s318_job13_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=13 AND sv.verse_number=16
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=13 AND ev.verse_number=19
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-13-wherefore-hidest-thou-thy-face',
       E'Wherefore Hidest Thou Thy Face',
       E'Job''s confidence breaks into the rawest cry of the chapter: *Wherefore hidest thou thy face, and holdest me for thine enemy?* (Job 13:24). The deepest grief of the faithful is not the loss of things but the felt withdrawal of the One they trust. David asks it word for word: *How long wilt thou forget me, O Yahuah (LORD)? for ever? how long wilt thou hide thy face from me?* (Psalm 13:1). The darkest psalm in the canon meets him there: *Yahuah (LORD), why castest thou off my soul? why hidest thou thy face from me?* (Psalm 88:14). Torah names the hidden face as covenant-judgment on those who turn away — *I will forsake them, and I will hide my face from them... because our Elohim (God) is not among us?* (Deuteronomy 31:17). And that is what makes Job''s cry the harder: he has not turned away. He feels a withdrawal the wicked earn, and he keeps trusting through it — the same man who said *though he slay me, yet will I trust in him* (Job 13:15) now asks why the face he trusts is hidden, and asks it without letting go.',
       sv.verse_id, ev.verse_id, 'free', 33103
  FROM _s318_job13_lookup sv, _s318_job13_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=13 AND sv.verse_number=24
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=13 AND ev.verse_number=24
ON CONFLICT (slug) DO NOTHING;

