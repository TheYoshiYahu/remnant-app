-- ----- fragment: minion_job_41.sql (Job 41) -----
-- Job 41 — LEVIATHAN, the untameable sea-monster / the chaos-dragon only the Creator masters
-- tag: job41 ; session prefix: s318 ; sort band start 33800 (+1 per thread)
-- temp view: _s318_job41_lookup
--
-- THREADS (3):
--   job-41-none-can-stand-before-me-who-made-leviathan       [free + extras: Ps74, Isa27, 1Enoch60]
--   job-41-whatsoever-is-under-the-whole-heaven-is-mine       [free: Rom11, Ps24, Ps50, 1Cor10]
--   job-41-a-king-over-all-the-children-of-pride-old-serpent  [free + extras: Gen3, Isa27, Rev12, Rev20, Rev21, 2Esdras6]
--
-- Job 41 coverage:
--   v.1-10  (Canst thou draw out leviathan... who then is able to stand before me?)
--           NT:     none warranted directly (chaos-dragon theme carried forward in thread 3)
--           Extras: 1 Enoch 60:7 (Leviathan the abyss-monster) — woven
--           Tanakh: Psalm 74:13-14 (brakest the heads of leviathan), Isaiah 27:1 (Yahuah shall slay the dragon) — woven
--   v.11    (Who hath prevented me... whatsoever is under the whole heaven is mine)
--           NT:     Romans 11:35 (who hath first given to him), 1 Corinthians 10:26 (the earth is Yahuah's) — woven
--           Extras: none warranted
--           Tanakh: Psalm 24:1 (the earth is the LORD'S), Psalm 50:12 (the world is mine) — woven
--   v.12-32 (the scales, the eyes like the eyelids of the morning, the fire-breath, heart firm as a stone)
--           NT:     none warranted (descriptive)
--           Extras: none warranted (described within threads 1/3)
--           Tanakh: none warranted (descriptive; folded into thread 1 framing)
--   v.33-34 (Upon earth there is not his like... he is a king over all the children of pride)
--           NT:     Revelation 12:9, Revelation 20:2 (the dragon, that old serpent), Revelation 21:1 (no more sea) — woven
--           Extras: 2 Esdras 6:52 (Leviathan kept to be devoured of whom thou wilt) — woven
--           Tanakh: Genesis 3:15 (bruise the serpent's head), Isaiah 27:1 (slay the dragon) — woven
--
-- GUARD: Leviathan = a real untameable creature AND the standing biblical type of the chaos-dragon /
-- the old serpent that only Yahuah masters and will finally crush (Isa 27:1 -> Rev 20:2; the seed-war
-- serpent of Gen 3:15 crushed). 41:11 "whatsoever is under the whole heaven is mine" = El owes no
-- creature (Rom 11:35) — anti-flesh-merit. Names quoted exactly as the parse returns them.

CREATE TEMP VIEW _s318_job41_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== B. cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: none can stand before the One who made and masters leviathan
    ('canon','job',41,10,'canon','psalms',74,13,'free',
      E'Asaph sings the same untamed sea that Yahuah (God) alone subdues: *Thou didst divide the sea by thy strength: thou brakest the heads of the dragons in the waters* (Psalm 74:13). Job''s *None is so fierce that dare stir him up: who then is able to stand before me?* (Job 41:10) is answered here — no man, but the Creator, breaks the dragon-heads of the deep.'),
    ('canon','job',41,10,'canon','psalms',74,14,'free',
      E'The monster Job cannot so much as *stir up* is the very creature Yahuah (God) shatters: *Thou brakest the heads of leviathan in pieces, and gavest him to be meat to the people inhabiting the wilderness* (Psalm 74:14). What is utterly beyond man (*who then is able to stand before me?* — Job 41:10) is broken under the hand of the One who made him.'),
    ('canon','job',41,10,'canon','isaiah',27,1,'free',
      E'Job''s leviathan is the standing type of the chaos-serpent Yahuah will finally slay: *In that day Yahuah (LORD) with his sore and great and strong sword shall punish leviathan the piercing serpent, even leviathan that crooked serpent; and he shall slay the dragon that is in the sea* (Isaiah 27:1). No man may *stir him up* (Job 41:10) — only the Creator wields the sword that ends him.'),
    ('canon','job',41,1,'enoch','1-enoch',60,7,'extras',
      E'The restored witness names the same abyss-monster the LORD reserves: *And on that day were two monsters parted, a female monster whose name is Leviathan, dwelling in the abysses of the ocean over the fountains of the waters* (1 Enoch 60:7). Job''s *Canst thou draw out leviathan with an hook?* (Job 41:1) asks of a creature of the deep that man cannot reach — held in the abyss under Yahuah''s (God''s) hand alone.'),

    -- THREAD 2: whatsoever is under the whole heaven is mine — El owes no creature
    ('canon','job',41,11,'canon','romans',11,35,'free',
      E'Job 41:11 — *Who hath prevented me, that I should repay him? whatsoever is under the whole heaven is mine* — is Sha''ul''s (Paul''s) very argument that no man can put El in his debt: *Or who hath first given to him, and it shall be recompensed unto him again?* (Romans 11:35). The Creator owes no creature; salvation is never a wage earned but the gift of the One to whom all things already belong.'),
    ('canon','job',41,11,'canon','psalms',24,1,'free',
      E'Job''s *whatsoever is under the whole heaven is mine* (Job 41:11) is the song of David: *The earth is the LORD''S, and the fulness thereof; the world, and they that dwell therein* (Psalm 24:1). Man cannot lay El under obligation, for there is nothing man can give that is not already his.'),
    ('canon','job',41,11,'canon','psalms',50,12,'free',
      E'Yahuah (God) declares the same self-sufficiency at Asaph''s altar: *If I were hungry, I would not tell thee: for the world is mine, and the fulness thereof* (Psalm 50:12). El needs nothing from the worshipper — exactly Job 41:11, *Who hath prevented me, that I should repay him? whatsoever is under the whole heaven is mine.*'),
    ('canon','job',41,11,'canon','1-corinthians',10,26,'free',
      E'Sha''ul (Paul) grounds the believer''s liberty on the same truth: *For the earth is Yahuah''s (Lord''s), and the fulness thereof* (1 Corinthians 10:26). All belongs to the Maker (Job 41:11, *whatsoever is under the whole heaven is mine*); the creature receives, and cannot first give.'),

    -- THREAD 3: a king over all the children of pride — the old serpent crushed at last
    ('canon','job',41,34,'canon','genesis',3,15,'free',
      E'Leviathan, *a king over all the children of pride* (Job 41:34), is the chaos-serpent whose doom was spoken in the garden: *And I will put enmity between thee and the woman, and between thy seed and her seed; it shall bruise thy head, and thou shalt bruise his heel* (Genesis 3:15). The untamed proud dragon man cannot master is the very head the seed of the woman is sworn to crush.'),
    ('canon','job',41,34,'canon','isaiah',27,1,'free',
      E'The proud king-of-the-deep (Job 41:34, *he is a king over all the children of pride*) meets the sword of Yahuah: *In that day Yahuah (LORD)... shall punish leviathan the piercing serpent... and he shall slay the dragon that is in the sea* (Isaiah 27:1). What no man can subdue, the Creator will slay outright.'),
    ('canon','job',41,34,'canon','revelation',12,9,'free',
      E'Job''s untameable dragon-king is the *old serpent* at last cast down: *And the great dragon was cast out, that old serpent, called the Devil, and Satan, which deceiveth the whole world: he was cast out into the earth* (Revelation 12:9). The creature *king over all the children of pride* (Job 41:34) — the chief of pride himself — falls under the hand only the Maker can move.'),
    ('canon','job',41,34,'canon','revelation',20,2,'free',
      E'The chaos-monster none could *stir up* is bound by the Creator at the end: *And he laid hold on the dragon, that old serpent, which is the Devil, and Satan, and bound him a thousand years* (Revelation 20:2). Job''s *king over all the children of pride* (Job 41:34) is mastered at last — not by man, but by the One before whom none can stand.'),
    ('canon','job',41,34,'canon','revelation',21,1,'free',
      E'The deep that leviathan boils and rules (Job 41:31-34) is finally gone: *And I saw a new heaven and a new earth: for the first heaven and the first earth were passed away; and there was no more sea* (Revelation 21:1). The chaos-sea — the dragon''s domain, *king over all the children of pride* — is abolished in the new creation.'),
    ('canon','job',41,34,'apocrypha','2-esdras',6,52,'extras',
      E'The restored witness keeps Leviathan reserved for the Creator''s judgment: *But to Leviathan you gavest the seventh part, namely, the moist; and have kept him to be devoured of whom you will, and when* (2 Esdras 6:52). The proud monster (Job 41:34, *a king over all the children of pride*) is held in hand against the appointed day — devoured at Yahuah''s (God''s) will, never man''s.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job41_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job41_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== C. threads =====
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-41-none-can-stand-before-me-who-made-leviathan',
       E'None Can Stand Before the One Who Made Leviathan',
       E'Yahuah (God) walks Job through the one creature no man may touch: *Canst thou draw out leviathan with an hook? or his tongue with a cord which thou lettest down?* (Job 41:1). He will not make supplications, he will not be a servant, no banquet is made of him, no barbed iron fills his skin — *Lay thine hand upon him, remember the battle, do no more* (Job 41:8). And the lesson lands: *None is so fierce that dare stir him up: who then is able to stand before me?* (Job 41:10) — if man cannot face the creature, how shall he face the Creator?\n\nLeviathan is a real untameable beast of the deep, and the standing biblical type of the chaos-power only Yahuah masters. Asaph sings the conquest: *Thou didst divide the sea by thy strength: thou brakest the heads of the dragons in the waters. Thou brakest the heads of leviathan in pieces* (Psalm 74:13-14). Isaiah carries it forward to the day the Creator ends him outright: *In that day Yahuah (LORD) with his sore and great and strong sword shall punish leviathan the piercing serpent... and he shall slay the dragon that is in the sea* (Isaiah 27:1). The restored witness names the same abyss-monster Yahuah (God) holds in hand: *a female monster whose name is Leviathan, dwelling in the abysses of the ocean over the fountains of the waters* (1 Enoch 60:7). What man cannot draw out with a hook, the Maker reserves, masters, and will slay.',
       sv.verse_id, ev.verse_id, 'extras', 33800
  FROM _s318_job41_lookup sv, _s318_job41_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=41 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=41 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-41-whatsoever-is-under-the-whole-heaven-is-mine',
       E'Whatsoever Is Under the Whole Heaven Is Mine — El Owes No Creature',
       E'At the heart of the leviathan-speech Yahuah (God) states the ground of everything: *Who hath prevented me, that I should repay him? whatsoever is under the whole heaven is mine* (Job 41:11). No man can put the Creator in his debt, for there is nothing man holds that El did not first give. This is the anti-flesh-merit foundation the whole library rests on.\n\nDavid sings it: *The earth is the LORD''S, and the fulness thereof; the world, and they that dwell therein* (Psalm 24:1). Asaph sets it at the altar so no worshipper imagines El is fed by sacrifice: *If I were hungry, I would not tell thee: for the world is mine, and the fulness thereof* (Psalm 50:12). And Sha''ul (Paul) makes it the very argument that grace is gift, not wage: *Or who hath first given to him, and it shall be recompensed unto him again?* (Romans 11:35) — and grounds the believer''s liberty on it: *For the earth is Yahuah''s (Lord''s), and the fulness thereof* (1 Corinthians 10:26). The creature receives; he cannot first give. No man buys, earns, or obligates the One to whom *whatsoever is under the whole heaven* already belongs.',
       sv.verse_id, ev.verse_id, 'free', 33801
  FROM _s318_job41_lookup sv, _s318_job41_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=41 AND sv.verse_number=11
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=41 AND ev.verse_number=11
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-41-a-king-over-all-the-children-of-pride-old-serpent',
       E'A King Over All the Children of Pride — the Old Serpent Crushed at Last',
       E'The leviathan-speech closes on the creature''s terrible majesty: *Upon earth there is not his like, who is made without fear. He beholdeth all high things: he is a king over all the children of pride* (Job 41:33-34). His heart is *firm as a stone* (Job 41:24), iron is straw to him, he laughs at the spear, he makes the deep boil like a pot. He is the chief of the proud — and that is exactly the figure the canon traces from the garden to the end.\n\nThe enmity was spoken at the fall: *And I will put enmity between thee and the woman, and between thy seed and her seed; it shall bruise thy head, and thou shalt bruise his heel* (Genesis 3:15). Isaiah names the sword that ends him: *he shall slay the dragon that is in the sea* (Isaiah 27:1). And the Revelation shows the proud monster cast down, bound, and his sea abolished: *And the great dragon was cast out, that old serpent, called the Devil, and Satan, which deceiveth the whole world* (Revelation 12:9); *And he laid hold on the dragon, that old serpent... and bound him a thousand years* (Revelation 20:2); *there was no more sea* (Revelation 21:1). The restored witness keeps him reserved for that very day: *to Leviathan you gavest the seventh part... and have kept him to be devoured of whom you will, and when* (2 Esdras 6:52). The king over all the children of pride man cannot master is the head the seed of the woman crushes — at the Creator''s will, and never man''s.',
       sv.verse_id, ev.verse_id, 'extras', 33802
  FROM _s318_job41_lookup sv, _s318_job41_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=41 AND sv.verse_number=33
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=41 AND ev.verse_number=34
ON CONFLICT (slug) DO NOTHING;

-- ===== D. thread_members =====
-- THREAD 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (41,10,'canon','psalms',74,13,1,E'Psalm 74:13 — *thou brakest the heads of the dragons in the waters*: the Creator subdues the very deep Job cannot face.'),
    (41,10,'canon','psalms',74,14,2,E'Psalm 74:14 — *Thou brakest the heads of leviathan in pieces*: the monster none can stir up is shattered by Yahuah (God).'),
    (41,10,'canon','isaiah',27,1,3,E'Isaiah 27:1 — *he shall slay the dragon that is in the sea*: leviathan as the chaos-serpent the Creator alone will slay.'),
    (41,1,'enoch','1-enoch',60,7,4,E'1 Enoch 60:7 — *a female monster whose name is Leviathan, dwelling in the abysses of the ocean*: the restored witness names the abyss-monster man cannot reach.')
  ) AS m(src_v_src,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-41-none-can-stand-before-me-who-made-leviathan'
  JOIN _s318_job41_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=41 AND sv.verse_number=m.src_v
  JOIN _s318_job41_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (41,11,'canon','romans',11,35,1,E'Romans 11:35 — *who hath first given to him*: Sha''ul''s (Paul''s) proof that no man can put El in his debt.'),
    (41,11,'canon','psalms',24,1,2,E'Psalm 24:1 — *The earth is the LORD''S, and the fulness thereof*: all already belongs to the Maker.'),
    (41,11,'canon','psalms',50,12,3,E'Psalm 50:12 — *the world is mine, and the fulness thereof*: El needs nothing from the worshipper.'),
    (41,11,'canon','1-corinthians',10,26,4,E'1 Corinthians 10:26 — *the earth is Yahuah''s (Lord''s), and the fulness thereof*: the creature receives, and cannot first give.')
  ) AS m(src_v_src,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-41-whatsoever-is-under-the-whole-heaven-is-mine'
  JOIN _s318_job41_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=41 AND sv.verse_number=m.src_v
  JOIN _s318_job41_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- THREAD 3
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (41,34,'canon','genesis',3,15,1,E'Genesis 3:15 — *it shall bruise thy head*: the chief of pride is the serpent-head the seed of the woman crushes.'),
    (41,34,'canon','isaiah',27,1,2,E'Isaiah 27:1 — *he shall slay the dragon that is in the sea*: the proud king-of-the-deep meets Yahuah''s (LORD''s) sword.'),
    (41,34,'canon','revelation',12,9,3,E'Revelation 12:9 — *that old serpent, called the Devil, and Satan*: the untameable dragon-king cast down.'),
    (41,34,'canon','revelation',20,2,4,E'Revelation 20:2 — *he laid hold on the dragon, that old serpent... and bound him*: mastered at last by the Creator.'),
    (41,34,'canon','revelation',21,1,5,E'Revelation 21:1 — *there was no more sea*: the chaos-sea, the dragon''s domain, abolished in the new creation.'),
    (41,34,'apocrypha','2-esdras',6,52,6,E'2 Esdras 6:52 — *have kept him to be devoured of whom you will, and when*: Leviathan reserved for the Creator''s appointed judgment.')
  ) AS m(src_v_src,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-41-a-king-over-all-the-children-of-pride-old-serpent'
  JOIN _s318_job41_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=41 AND sv.verse_number=m.src_v
  JOIN _s318_job41_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_42.sql (Job 42) -----
-- Book: Job   Chapter: 42 (THE CAPSTONE — repentance, vindication, intercession, restoration)
-- Tag: job42   Session prefix: s318   Temp view: _s318_job42_lookup
-- Sort band: 33825..33830 (6 threads, +1 per thread)
--
-- Job 42 coverage:
--   v.1-6  JOB'S REPENTANCE / SIGHT OF YAHUAH ("now mine eye seeth thee... I abhor myself")
--          NT:     1 Corinthians 13:12 (see through a glass darkly → face to face), 1 John 3:2 (we shall see him as he is)
--          Extras: none warranted (canon + NT carry the seen-Glory weave fully)
--          Tanakh: Isaiah 6:5 (mine eyes have seen the King → Woe is me), Job 40:4 (I am vile, hand upon mouth),
--                  Psalm 51:17 (a broken and contrite heart), Ezekiel 36:31 (lothe yourselves in your own sight — PRE-EXISTING CR reused)
--   v.7-8  THE HEAVENLY VERDICT — Yahuah vindicates Job, rebukes the friends' retribution theology
--          ("ye have not spoken of me the thing that is right, as my servant Job hath")
--          NT:     James 5:11 (the end of Yahuah — vindication of the patient sufferer)
--          Extras: none warranted
--          Tanakh: Psalm 51:17 (the contrite, not the self-justifying friends, accepted) — kept in repentance thread; verdict thread stays Job-internal + James
--   v.8-10 JOB'S INTERCESSION — he prays for the friends who wronged him; the captivity is turned THROUGH the intercession
--          NT:     Isaiah 53:12 is Tanakh; FORWARD: Luke 23:34 (Father, forgive them), Matthew 5:44 (pray for them which despitefully use you)
--          Extras: none warranted
--          Tanakh: Isaiah 53:12 (made intercession for the transgressors — the Servant pattern Job foreshadows)
--   v.10-17 THE RESTORATION / THE DOUBLE — "twice as much... the latter end more than his beginning"
--          NT:     James 5:11 (ye have heard of the patience of Job... Yahuah very pitiful, of tender mercy)
--          Extras: none warranted
--          Tanakh: Joel 2:25 (I will restore the years the locust hath eaten), Isaiah 61:7 (for your shame, double),
--                  Zechariah 9:12 (prisoners of hope — I will render double)
--   v.13-15 the daughters named, given inheritance among their brethren — woven into the restoration thread (gift, not wage)
--   v.16-17 Job died old and full of days — woven into the restoration thread
--
-- THREADS (6):
--   33825  job-42-1-6-mine-eye-seeth-thee-the-repentance-of-the-seeing-creature   [Tanakh + NT]
--   33826  job-42-5-6-i-abhor-myself-and-repent-in-dust-and-ashes                 [Tanakh + NT]  (the contrite-heart weave)
--   33827  job-42-7-8-ye-have-not-spoken-of-me-the-thing-that-is-right            [Tanakh + NT]  (anti-prosperity verdict)
--   33828  job-42-8-10-my-servant-job-shall-pray-for-you-the-intercessor         [Tanakh + NT]
--   33829  job-42-10-the-captivity-turned-when-he-prayed-for-his-friends         [Tanakh + NT]
--   33830  job-42-10-17-twice-as-much-the-latter-end-more-than-the-beginning     [Tanakh + NT]
--
-- FRAMING (anti-prosperity-gospel guard):
--   The repentance (v.6) is the CREATURE humbled before the SEEN Creator, not a confession that suffering proved
--   hidden sin — Yahuah Himself declares in the very next verse that Job "hath spoken of me the thing that is right"
--   (v.7), overturning the friends' retribution doctrine from heaven. The intercession is Job a type of the Servant
--   who "made intercession for the transgressors" (Isa 53:12), the Messiah who has a Father (Luke 23:34). The
--   restoration / double is framed as Yahuah's TENDER MERCY and GIFT (James 5:11), the latter-end blessing as grace,
--   NOT a mechanical wage that righteousness earns — the whole book has dismantled the prosperity/retribution gospel.
--   NOTE: the pre-existing bare cross_reference Job 42:6 → Ezekiel 36:31 (loathe-self repentance) is reused via
--   ON CONFLICT DO NOTHING and linked into the repentance thread (member).

CREATE TEMP VIEW _s318_job42_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================ B. cross_references ============================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: v.1-6 the seen Creator / face to face
    ('canon','job',42,5,'canon','isaiah',6,5,'free',
     E'*Then said I, Woe is me! for I am undone; because I am a man of unclean lips, and I dwell in the midst of a people of unclean lips: for mine eyes have seen the King, Yahuah Tseva''ot (LORD of hosts)* (Isaiah 6:5). Job''s *I have heard of thee by the hearing of the ear: but now mine eye seeth thee* (Job 42:5) is the same encounter — the prophet and the patriarch alike are undone the instant the Glory is SEEN. Hearsay holds out arguments; the seen King silences them.'),
    ('canon','job',42,5,'canon','job',40,4,'free',
     E'*Behold, I am vile; what shall I answer thee? I will lay mine hand upon my mouth* (Job 40:4). Two chapters earlier Job''s hand goes over his mouth; here, having moved from *the hearing of the ear* to *now mine eye seeth thee* (Job 42:5), the silence deepens into repentance — the creature confronted by the Creator he had been contending with.'),
    ('canon','job',42,5,'canon','1-corinthians',13,12,'free',
     E'*For now we see through a glass, darkly; but then face to face: now I know in part; but then shall I know even as also I am known* (1 Corinthians 13:12). Job''s *hearing of the ear* against *now mine eye seeth thee* (Job 42:5) is the same arc the apostle names — the partial, second-hand knowing giving way to the direct sight that the whole book of questions has been straining toward.'),
    ('canon','job',42,5,'canon','1-john',3,2,'free',
     E'*Beloved, now are we the sons of Elohim (God), and it doth not yet appear what we shall be: but we know that, when he shall appear, we shall be like him; for we shall see him as he is* (1 John 3:2). Job''s *now mine eye seeth thee* (Job 42:5) is the down payment of that promised sight — the seeing that transforms; the seen Yahuah is the Formed Son who later took flesh and shall appear.'),

    -- Thread 2: v.5-6 the contrite heart / lothe self in own sight
    ('canon','job',42,6,'canon','psalms',51,17,'free',
     E'*The sacrifices of Elohim (God) are a broken spirit: a broken and a contrite heart, O Elohim (God), thou wilt not despise* (Psalm 51:17). Job''s *Wherefore I abhor myself, and repent in dust and ashes* (Job 42:6) IS the broken and contrite heart Yahuah will not despise — not the cringing of the guilty proved wrong, but the creature undone before the seen Glory.'),
    ('canon','job',42,6,'canon','ezekiel',36,31,'free',
     E'*Then shall ye remember your own evil ways, and your doings that were not good, and shall lothe yourselves in your own sight for your iniquities and for your abominations* (Ezekiel 36:31). The new-heart restoration produces the same self-loathing repentance Job voices — *I abhor myself, and repent in dust and ashes* (Job 42:6); the sight of Yahuah, not the accusation of men, is what bows the seeing soul.'),

    -- Thread 3: v.7-8 the heavenly verdict — friends rebuked, Job vindicated
    ('canon','job',42,7,'canon','james',5,11,'free',
     E'*Behold, we count them happy which endure. Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11). Heaven''s verdict — *ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7) — is the *end of Yahuah*: the patient sufferer is vindicated and the retribution doctrine of the friends is overturned, because Yahuah is pitiful and of tender mercy, not a ledger of wages.'),

    -- Thread 4: v.8-10 Job the intercessor for his accusers
    ('canon','job',42,8,'canon','isaiah',53,12,'free',
     E'*...and he bare the sin of many, and made intercession for the transgressors* (Isaiah 53:12). Yahuah''s word — *my servant Job shall pray for you: for him will I accept* (Job 42:8) — makes the righteous sufferer the priestly intercessor for his accusers, foreshadowing the Servant who *made intercession for the transgressors*; Job''s acceptance turns on his prayer for those who wronged him.'),
    ('canon','job',42,8,'canon','luke',23,34,'free',
     E'*Then said Yahusha (Jesus), Father, forgive them; for they know not what they do. And they parted his raiment, and cast lots* (Luke 23:34). Job praying for the friends who falsely accused him — *my servant Job shall pray for you* (Job 42:8) — is the pattern filled at the cross: the innocent sufferer interceding for his persecutors before his Father.'),
    ('canon','job',42,8,'canon','matthew',5,44,'free',
     E'*But I say unto you, Love your enemies, bless them that curse you, do good to them that hate you, and pray for them which despitefully use you, and persecute you* (Matthew 5:44). Job does exactly this — *my servant Job shall pray for you* (Job 42:8) — praying for the very comforters who despitefully accused him; the Tanakh already enacts the command before it is spoken on the mount.'),

    -- Thread 5: v.10 the captivity turned through the intercession
    ('canon','job',42,10,'canon','isaiah',53,12,'free',
     E'*...and made intercession for the transgressors* (Isaiah 53:12). *And Yahuah (LORD) turned the captivity of Job, when he prayed for his friends* (Job 42:10) — the restoration breaks open precisely THROUGH the intercession, the same hinge as the Servant: the sufferer who bears and prays for others is the one through whom the turning comes.'),
    ('canon','job',42,10,'canon','matthew',5,44,'free',
     E'*...pray for them which despitefully use you, and persecute you* (Matthew 5:44). The captivity is *turned... when he prayed for his friends* (Job 42:10): Job''s blessing returns not while he nurses the wound but in the act of praying for those who inflicted it — the very posture the Messiah commands.'),

    -- Thread 6: v.10-17 the double / latter end greater — gift, not wage
    ('canon','job',42,12,'canon','james',5,11,'free',
     E'*Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11). *So Yahuah (LORD) blessed the latter end of Job more than his beginning* (Job 42:12): the apostle names the doubled latter-end the *end of Yahuah* — the proof not that righteousness earns wealth but that Yahuah is pitiful and tender; the blessing is mercy''s gift, not a wage paid.'),
    ('canon','job',42,10,'canon','joel',2,25,'free',
     E'*And I will restore to you the years that the locust hath eaten, the cankerworm, and the caterpiller, and the palmerworm, my great army which I sent among you* (Joel 2:25). *Yahuah (LORD) gave Job twice as much as he had before* (Job 42:10) is the same restoring mercy Joel promises — Yahuah giving back the devoured years, the latter abundance a gift from the One who first permitted the loss.'),
    ('canon','job',42,10,'canon','isaiah',61,7,'free',
     E'*For your shame ye shall have double; and for confusion they shall rejoice in their portion: therefore in their land they shall possess the double: everlasting joy shall be unto them* (Isaiah 61:7). Job''s *twice as much as he had before* (Job 42:10) is Yahuah''s signature recompense — *double* for shame — the gracious overturning of loss, not a mechanical payout but the tender-mercy portion the prophet sings.'),
    ('canon','job',42,10,'canon','zechariah',9,12,'free',
     E'*Turn you to the strong hold, ye prisoners of hope: even to day do I declare that I will render double unto thee* (Zechariah 9:12). Job, whose captivity Yahuah turned, receives *twice as much as he had before* (Job 42:10) — the *double* Yahuah renders to the prisoners of hope; the restored sufferer is the pattern of the promised double.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job42_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job42_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================ C. threads ============================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-42-1-6-mine-eye-seeth-thee-the-repentance-of-the-seeing-creature',
       E'Job 42:1-6 — “Now mine eye seeth thee”: the repentance of the seeing creature',
       E'After all the questions, the answer is not an argument but a SIGHT. *I have heard of thee by the hearing of the ear: but now mine eye seeth thee* (Job 42:5) — and the second-hand knowing collapses into the direct encounter. Job had already laid his hand on his mouth two chapters before: *Behold, I am vile; what shall I answer thee? I will lay mine hand upon my mouth* (Job 40:4). The prophet Isaiah is undone by the same sight: *Woe is me! for I am undone... for mine eyes have seen the King, Yahuah Tseva''ot (LORD of hosts)* (Isaiah 6:5). The apostle names the arc — *For now we see through a glass, darkly; but then face to face: now I know in part; but then shall I know even as also I am known* (1 Corinthians 13:12) — and the consummation of it: *when he shall appear, we shall be like him; for we shall see him as he is* (1 John 3:2). The seen Yahuah is the Formed Son who later took flesh. This is the lens for the repentance that follows: not a confession that suffering proved hidden sin (heaven declares the opposite in the very next verse), but the creature humbled before the Creator he had been contending with.',
       sv.verse_id, ev.verse_id, 'free', 33825
  FROM _s318_job42_lookup sv, _s318_job42_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=42 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=42 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-42-5-6-i-abhor-myself-and-repent-in-dust-and-ashes',
       E'Job 42:5-6 — “I abhor myself, and repent in dust and ashes”: the broken and contrite heart',
       E'*Wherefore I abhor myself, and repent in dust and ashes* (Job 42:6). This is the broken heart Yahuah honours, not the cringing of a man proved guilty by his losses. *The sacrifices of Elohim (God) are a broken spirit: a broken and a contrite heart, O Elohim (God), thou wilt not despise* (Psalm 51:17). The new-heart restoration produces the very same self-loathing repentance: *Then shall ye remember your own evil ways... and shall lothe yourselves in your own sight for your iniquities and for your abominations* (Ezekiel 36:31). What bows Job is not the accusation of his friends but the sight of the Glory — and heaven is about to vindicate him against those friends. The repentance is the creature''s, drawn out by the seen Creator; it is never an admission that suffering is the wage of sin.',
       sv.verse_id, ev.verse_id, 'free', 33826
  FROM _s318_job42_lookup sv, _s318_job42_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=42 AND sv.verse_number=5
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=42 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-42-7-8-ye-have-not-spoken-of-me-the-thing-that-is-right',
       E'Job 42:7-8 — “Ye have not spoken of me the thing that is right, as my servant Job”: heaven overturns the retribution gospel',
       E'This is the verse the whole book has been pointing to. Yahuah turns to the three comforters who spent thirty-five chapters defending Him by accusing Job, and renders the verdict: *My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). The "God-defending" theology — that suffering must be the wage of hidden sin, that the righteous prosper and the afflicted are guilty — is rebuked FROM HEAVEN. Job''s raw, honest wrestling was right; the friends'' tidy retribution doctrine was wrong. The apostle names the outcome: *Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11). The *end of Yahuah* is mercy and vindication, not a ledger. This is the anti-prosperity-gospel capstone: the prosperity/retribution reading is the thing Yahuah Himself calls not right.',
       sv.verse_id, ev.verse_id, 'free', 33827
  FROM _s318_job42_lookup sv, _s318_job42_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=42 AND sv.verse_number=7
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=42 AND ev.verse_number=8
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-42-8-10-my-servant-job-shall-pray-for-you-the-intercessor',
       E'Job 42:8-10 — “My servant Job shall pray for you”: the righteous sufferer becomes the intercessor for his accusers',
       E'The vindication does not crush the friends — it routes their pardon through the man they wronged. *Take unto you now seven bullocks and seven rams, and go to my servant Job... and my servant Job shall pray for you: for him will I accept* (Job 42:8). The righteous sufferer is made the priestly intercessor for his accusers. This is the Servant pattern: *he bare the sin of many, and made intercession for the transgressors* (Isaiah 53:12) — and it is filled at the cross, where the innocent prays for his persecutors before his Father: *Then said Yahusha (Jesus), Father, forgive them; for they know not what they do* (Luke 23:34). Job enacts the command before it is spoken on the mount: *Love your enemies... and pray for them which despitefully use you* (Matthew 5:44). The Tanakh is already teaching the intercessor''s heart that the Messiah will perfectly bear.',
       sv.verse_id, ev.verse_id, 'free', 33828
  FROM _s318_job42_lookup sv, _s318_job42_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=42 AND sv.verse_number=8
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=42 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-42-10-the-captivity-turned-when-he-prayed-for-his-friends',
       E'Job 42:10 — “Yahuah turned the captivity of Job, when he prayed for his friends”: restoration through intercession',
       E'The turning point is exact and deliberate: *And Yahuah (LORD) turned the captivity of Job, when he prayed for his friends* (Job 42:10). The restoration breaks open THROUGH the intercession — not while Job nurses the wound, but in the act of praying for those who inflicted it. It is the same hinge as the Servant who *made intercession for the transgressors* (Isaiah 53:12): the sufferer who bears for others and prays for them is the one through whom the turning comes. It is the posture the Messiah commands — *pray for them which despitefully use you, and persecute you* (Matthew 5:44) — already at work in Job''s restored fortunes. The captivity turns at the place of forgiveness.',
       sv.verse_id, ev.verse_id, 'free', 33829
  FROM _s318_job42_lookup sv, _s318_job42_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=42 AND sv.verse_number=10
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=42 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-42-10-17-twice-as-much-the-latter-end-more-than-the-beginning',
       E'Job 42:10-17 — “Twice as much... the latter end more than his beginning”: the double as gift, not wage',
       E'*Yahuah (LORD) gave Job twice as much as he had before... So Yahuah (LORD) blessed the latter end of Job more than his beginning* (Job 42:10,12). The doubled herds, the seven sons and three daughters, the daughters named Jemima, Kezia, and Keren-happuch given *inheritance among their brethren* (Job 42:15), the *hundred and forty years* and the four generations seen — this is the latter end greater than the first. But the book has spent forty-one chapters dismantling the lie that righteousness mechanically earns wealth, so the ending must be read as mercy, not math. The apostle names it precisely: *Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11) — the doubled latter-end is the *end of Yahuah*, the proof of His tenderness, not a payout. It is Yahuah''s signature recompense: *I will restore to you the years that the locust hath eaten* (Joel 2:25); *For your shame ye shall have double... in their land they shall possess the double: everlasting joy shall be unto them* (Isaiah 61:7); *Turn you to the strong hold, ye prisoners of hope: even to day do I declare that I will render double unto thee* (Zechariah 9:12). The double is gift, the gracious overturning of loss — never a wage owed.',
       sv.verse_id, ev.verse_id, 'free', 33830
  FROM _s318_job42_lookup sv, _s318_job42_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=42 AND sv.verse_number=10
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=42 AND ev.verse_number=17
ON CONFLICT (slug) DO NOTHING;

