-- ----- fragment: minion_job_8.sql (Job 8) -----
-- Job chapter 8 — Bildad the Shuhite's first speech
-- tag: job08 ; session prefix: s318 ; sort_order band start 32975 (+1 per thread)
-- slug prefix: job-8-...
--
-- LENS NOTE: Bildad, like Eliphaz, fuses a TRUE premise with a FALSE application.
--   TRUE: Elohim does not pervert judgment (8:3) — this is the bedrock of the Tanakh's
--         witness to Yahuah's justice (Deut 32:4; Gen 18:25).
--   FALSE: therefore Job's children died for their sin and Job's losses prove his guilt,
--         and "if thou wert pure" prosperity would return (8:4-6) — the mechanical
--         retribution doctrine the book OVERTURNS when Yahuah rebukes the three friends:
--         "ye have not spoken of me the thing that is right, as my servant Job" (42:7).
--   The threads affirm the true sayings and frame the retribution misapplication as the
--   error Yahuah judges. The premise is gold; the verdict on Job is the friends' sin.
--
-- Job 8 coverage:
--   v.3   (Doth Elohim pervert judgment?) NT: Rom 9:14 (is there unrighteousness with God? God forbid)
--                                          Extras: none warranted
--                                          Tanakh: Deut 32:4 (all his ways are judgment); Gen 18:25 (Judge of all the earth do right); Job 42:7 (the friends rebuked)
--   v.4-6 (children cast away / if pure, prosper) NT: Rom 9:14 (justice not perverted) | Extras: none warranted | Tanakh: Job 42:7 (retribution-application rebuked)
--   v.7   (latter end increase)            NT/Extras/Tanakh: none warranted (Job 42:12 restoration handled in Job 42 chapter)
--   v.8-10(enquire of the former age, the fathers) NT: none warranted
--                                          Extras: Sirach 8:9 (miss not the discourse of the elders, they learned of their fathers)
--                                          Tanakh: none warranted (folded into the fathers-tradition thread)
--   v.11-12 (rush/flag wither without water) NT: none warranted (folded forward into the hope-perishes thread via Ps 1) | Extras: none warranted | Tanakh: Ps 1:3-4 (tree by water vs chaff)
--   v.13-15 (hypocrite's hope perish / spider's web / house shall not stand)
--                                          NT: Matt 7:26-27 (house on sand falls, great the fall)
--                                          Extras: none warranted (Wisdom of the godless's vain hope diffuse; clean canon witnesses suffice)
--                                          Tanakh: Ps 1:6 (way of the ungodly shall perish); Isa 28:15-17 (made lies our refuge; hail sweep away refuge of lies)
--   v.16-19 (green plant rooted then destroyed) NT/Extras/Tanakh: none warranted (poetic continuation of v.11-15 figure; covered)
--   v.20-22 (El will not cast away a perfect man) NT/Extras/Tanakh: none warranted (Bildad's true general maxim, but deployed as retribution promise; covered by thread 1 framing)
--
-- THREADS:
--   1. job-8-doth-el-pervert-judgment-justice-affirmed-application-false (free)
--        v.3-6 -> Deut 32:4, Gen 18:25 (Tanakh, justice affirmed); Rom 9:14 (NT); Job 42:7 (Tanakh, the rebuke of the false application)
--   2. job-8-the-hypocrites-hope-and-the-spiders-web (free)
--        v.13-15 -> Ps 1:3,4,6 (Tanakh, tree/chaff/perish); Isa 28:15,17 (Tanakh, refuge of lies swept away); Matt 7:26-27 (NT, house on sand falls)
--   3. job-8-enquire-of-the-former-age-the-tradition-of-the-fathers (extras)
--        v.8 -> Sirach 8:9 (extras, discourse of the elders learned of their fathers)

-- A. Temp view
CREATE TEMP VIEW _s318_job08_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- B. cross_references INSERT
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: El's justice affirmed, the application false
    ('canon','job',8,3,'canon','deuteronomy',32,4,'free',
      E'*He is the Rock, his work is perfect: for all his ways are judgment: a Elohim (God) of truth and without iniquity, just and right is he* (Deuteronomy 32:4). Bildad''s premise is true and ancient — *Doth Elohim (God) pervert judgment? or doth the Almighty pervert justice?* (Job 8:3). The Song of Moses confesses the same bedrock: Yahuah''s ways are all judgment, He is *without iniquity*. The justice is real; Bildad''s sin is bending this true rock into a verdict against an innocent man.'),
    ('canon','job',8,3,'canon','genesis',18,25,'free',
      E'*That be far from thee to do after this manner, to slay the righteous with the wicked: and that the righteous should be as the wicked, that be far from thee: Shall not the Judge of all the earth do right?* (Genesis 18:25). Abraham appeals to the very justice Bildad invokes — *doth the Almighty pervert justice?* (Job 8:3). But Abraham pleads it to SPARE the righteous; Bildad weaponizes it to condemn one. The premise is shared; the application is inverted.'),
    ('canon','job',8,4,'canon','job',42,7,'free',
      E'*And it was so, that after Yahuah (LORD) had spoken these words unto Job, Yahuah (LORD) said to Eliphaz the Temanite, My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). Bildad reasons *If thy children have sinned against him, and he have cast them away for their transgression* (Job 8:4) — the mechanical retribution doctrine. Yahuah''s own verdict overturns it: the friends did NOT speak rightly of Him. The book judges the application Bildad here makes.'),
    ('canon','job',8,6,'canon','job',42,7,'free',
      E'*...ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). Bildad promises *If thou wert pure and upright; surely now he would awake for thee, and make the habitation of thy righteousness prosperous* (Job 8:6) — prosperity as the proof of purity. This is the doctrine Yahuah rebukes at the book''s end; Job''s suffering was never the wage of secret sin.'),
    ('canon','job',8,3,'canon','romans',9,14,'free',
      E'*What shall we say then? Is there unrighteousness with Elohim (God)? Elohim (God) forbid* (Romans 9:14). Paul echoes Bildad''s true question — *Doth Elohim (God) pervert judgment?* (Job 8:3) — and answers it the same: God forbid. The premise stands in the New Testament unchanged; what Job''s friends got wrong was not God''s justice but their reading of one man''s providence.'),
    -- THREAD 2: the hypocrite's hope and the spider's web
    ('canon','job',8,13,'canon','psalms',1,6,'free',
      E'*For Yahuah (LORD) knoweth the way of the righteous: but the way of the ungodly shall perish* (Psalm 1:6). Bildad says *So are the paths of all that forget Elohim (God); and the hypocrite''s hope shall perish* (Job 8:13). The first Psalm sings the same end — the way of the ungodly perishes. Here Bildad''s general truth is sound; his error is only in pinning Job among the ungodly.'),
    ('canon','job',8,11,'canon','psalms',1,3,'free',
      E'*And he shall be like a tree planted by the rivers of water, that bringeth forth his fruit in his season; his leaf also shall not wither; and whatsoever he doeth shall prosper* (Psalm 1:3). Bildad''s image inverts it: *Can the rush grow up without mire? can the flag grow without water?... it withereth before any other herb* (Job 8:11-12). The righteous, rooted by the waters of Torah-delight, do not wither; the godless rush, cut from the spring, dries up. The Psalm and Bildad share the figure of water as the life of the soul.'),
    ('canon','job',8,15,'canon','isaiah',28,15,'free',
      E'*Because ye have said, We have made a covenant with death, and with hell are we at agreement... for we have made lies our refuge, and under falsehood have we hid ourselves* (Isaiah 28:15). Bildad describes the godless man: *He shall lean upon his house, but it shall not stand: he shall hold it fast, but it shall not endure* (Job 8:15), *whose trust shall be a spider''s web* (Job 8:14). Isaiah names the same false security — the *refuge of lies*, a house leaned on that cannot bear the storm.'),
    ('canon','job',8,15,'canon','isaiah',28,17,'free',
      E'*Judgment also will I lay to the line, and righteousness to the plummet: and the hail shall sweep away the refuge of lies, and the waters shall overflow the hiding place* (Isaiah 28:17). The spider''s-web trust of *He shall lean upon his house, but it shall not stand* (Job 8:15) meets the plummet of judgment. What is leaned on in falsehood the hail sweeps away. The flimsy web is no shelter when Yahuah lays the line.'),
    ('canon','job',8,15,'canon','matthew',7,26,'free',
      E'*And every one that heareth these sayings of mine, and doeth them not, shall be likened unto a foolish man, which built his house upon the sand: And the rain descended, and the floods came, and the winds blew, and beat upon that house; and it fell: and great was the fall of it* (Matthew 7:26-27). Bildad''s figure runs straight forward — *He shall lean upon his house, but it shall not stand: he shall hold it fast, but it shall not endure* (Job 8:15). The house built on sand and the hope that is a spider''s web are one image: a trust that collapses when the storm comes. Yahusha (Jesus) roots the standing house in doing His sayings.'),
    -- THREAD 3: enquire of the former age, the tradition of the fathers
    ('canon','job',8,8,'apocrypha','ecclesiasticus',8,9,'extras',
      E'*Miss not the discourse of the elders: for they also learned of their fathers, and of them you shall learn understanding, and to give answer as need requires* (Sirach 8:9). Bildad appeals to the same inheritance: *For enquire, I pray thee, of the former age, and prepare thyself to the search of their fathers... Shall not they teach thee, and tell thee, and utter words out of their heart?* (Job 8:8,10). The wisdom tradition honors the handed-down counsel of the fathers — yet the book of Job will show that the fathers'' tidy retribution formula does not fit every righteous sufferer.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job08_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job08_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- C. threads INSERT
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-8-doth-el-pervert-judgment-justice-affirmed-application-false',
       E'Doth El pervert judgment? — the justice affirmed, the application false',
       E'Bildad opens with a question that is wholly true: *Doth Elohim (God) pervert judgment? or doth the Almighty pervert justice?* (Job 8:3). The answer is no, and the whole Tanakh confesses it — *He is the Rock, his work is perfect: for all his ways are judgment: a Elohim (God) of truth and without iniquity, just and right is he* (Deuteronomy 32:4); *Shall not the Judge of all the earth do right?* (Genesis 18:25). Paul says the same in the gospel age: *Is there unrighteousness with Elohim (God)? Elohim (God) forbid* (Romans 9:14). But Bildad bends this true rock into a false verdict: *If thy children have sinned against him, and he have cast them away for their transgression* (Job 8:4), and *If thou wert pure and upright; surely now he would awake for thee, and make the habitation of thy righteousness prosperous* (Job 8:6) — the mechanical doctrine that suffering proves sin and prosperity proves purity. The book itself overturns the application: at the end Yahuah says to the three friends, *ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). The premise is gold; the misuse of it against an innocent man is the friends'' sin Yahuah rebukes. Justice is real — but it is not the crude ledger Bildad makes of it.',
       sv.verse_id, ev.verse_id, 'free', 32975
  FROM _s318_job08_lookup sv, _s318_job08_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=8 AND sv.verse_number=3
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=8 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-8-the-hypocrites-hope-and-the-spiders-web',
       E'The hypocrite''s hope and the spider''s web',
       E'Bildad turns to a picture of the godless man''s confidence and its collapse: *So are the paths of all that forget Elohim (God); and the hypocrite''s hope shall perish: Whose hope shall be cut off, and whose trust shall be a spider''s web. He shall lean upon his house, but it shall not stand: he shall hold it fast, but it shall not endure* (Job 8:13-15). The figure begins in the withering rush — *Can the rush grow up without mire? can the flag grow without water?... it withereth before any other herb* (Job 8:11-12) — the inverse of the Psalm''s righteous tree: *he shall be like a tree planted by the rivers of water... his leaf also shall not wither* (Psalm 1:3), while *the way of the ungodly shall perish* (Psalm 1:6). Isaiah names the same false security as a *covenant with death* and a *refuge of lies* that the *hail shall sweep away* (Isaiah 28:15,17), and Yahusha (Jesus) carries the image straight forward: the house built on sand, when the storm beats on it, *fell: and great was the fall of it* (Matthew 7:26-27). The spider''s web, the leaned-on house, the rootless rush, the sand foundation — all one truth: a hope outside the living God does not stand. Bildad''s figure is sound; his only error is to imagine that Job, not he, is the man on the web.',
       sv.verse_id, ev.verse_id, 'free', 32976
  FROM _s318_job08_lookup sv, _s318_job08_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=8 AND sv.verse_number=13
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=8 AND ev.verse_number=15
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-8-enquire-of-the-former-age-the-tradition-of-the-fathers',
       E'Enquire of the former age — the tradition of the fathers',
       E'Bildad grounds his speech not in fresh revelation but in inherited counsel: *For enquire, I pray thee, of the former age, and prepare thyself to the search of their fathers: (For we are but of yesterday, and know nothing, because our days upon earth are a shadow:) Shall not they teach thee, and tell thee, and utter words out of their heart?* (Job 8:8-10). The wisdom tradition prizes exactly this handed-down instruction: *Miss not the discourse of the elders: for they also learned of their fathers, and of them you shall learn understanding* (Sirach 8:9). The fathers'' wisdom is a real inheritance and is rightly honored. Yet the book of Job presses a hard edge against it: the fathers'' tidy formula — that the righteous prosper and the wicked perish in this life — does not fit every case, and a righteous man can suffer without secret guilt. Tradition is a gift, not an infallible verdict; the search of the fathers must bow to the living God who alone weighs the heart.',
       sv.verse_id, ev.verse_id, 'extras', 32977
  FROM _s318_job08_lookup sv, _s318_job08_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=8 AND sv.verse_number=8
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=8 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

-- D. thread_members INSERT
-- Thread 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*all his ways are judgment: a Elohim (God) of truth and without iniquity* (Deuteronomy 32:4) — the Song of Moses confesses the very justice Bildad invokes; the premise is bedrock Tanakh.'
  FROM cross_reference_threads t
  JOIN _s318_job08_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=8 AND sv.verse_number=3
  JOIN _s318_job08_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='deuteronomy' AND tv.chapter_number=32 AND tv.verse_number=4
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-8-doth-el-pervert-judgment-justice-affirmed-application-false'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

