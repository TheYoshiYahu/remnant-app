-- ----- fragment: minion_job_32.sql (Job 32) -----
-- Job chapter 32 — Elihu the Buzite enters; the young man's zeal.
-- tag: job32   session: s318   sort_order band: 33575+ (one per thread)
-- source book_slug=job, edition canon, chapter 32
--
-- Job 32 coverage:
--   v.1-7  (the three cease; Elihu waits because young; "Days should speak")
--          NT:     none warranted (setting/narrative frame for v.8 keystone)
--          Extras: none warranted
--          Tanakh: folded into v.8/v.9 threads (age vs. the breath of El)
--   v.8   ★ "there is a spirit in man: and the inspiration of the Almighty giveth them understanding"
--          NT:     1 Corinthians 2:10-12 (the Spirit searcheth the deep things); James 1:5 (ask of Elohim for wisdom)
--          Extras: Ecclesiasticus 1:1 (all wisdom comes from Yahuah); Wisdom of Solomon 7:7 (the spirit of wisdom came to me)
--          Tanakh: Genesis 2:7 (breath of life); Proverbs 2:6 (Yahuah giveth wisdom); Daniel 2:21-22 (he giveth wisdom unto the wise); Ecclesiastes 12:7 (the spirit returns to Elohim)
--   v.9   "Great men are not always wise: neither do the aged understand judgment"
--          NT:     1 Corinthians 1:26-27 (not many wise/mighty/noble; foolish things confound the wise)
--          Extras: none warranted
--          Tanakh: Ecclesiastes 4:13 (better a poor wise child than an old foolish king)
--   v.10-17 (Elihu's preamble; none convinced Job)
--          NT/Extras/Tanakh: none warranted (transitional rhetoric)
--   v.18-20 "I am full of matter, the spirit within me constraineth me... I will speak, that I may be refreshed"
--          NT:     Acts 4:20 (we cannot but speak the things we have seen and heard)
--          Extras: none warranted
--          Tanakh: Jeremiah 20:9 (his word was as a burning fire shut up in my bones)
--   v.21-22 (no flattering titles; my maker would take me away)
--          NT/Extras/Tanakh: none warranted (folded into v.18-20 thread's compulsion-to-speak-truth note)
--
-- THREADS (3):
--   1. job-32-the-inspiration-of-the-almighty-giveth-understanding  [Tanakh + NT + extras] tier=extras  (v.8)
--        Genesis 2:7, Proverbs 2:6, Daniel 2:21, Daniel 2:22, Ecclesiastes 12:7,
--        1 Corinthians 2:10, 1 Corinthians 2:11, 1 Corinthians 2:12, James 1:5,
--        Ecclesiasticus 1:1 (apocrypha), Wisdom of Solomon 7:7 (apocrypha)
--   2. job-32-great-men-are-not-always-wise  [Tanakh + NT] tier=free  (v.9)
--        Ecclesiastes 4:13, 1 Corinthians 1:26, 1 Corinthians 1:27
--   3. job-32-the-spirit-within-me-constraineth-me  [Tanakh + NT] tier=free  (v.18-20)
--        Jeremiah 20:9, Acts 4:20
--
-- GUARD (v.8): the wisdom that is the inspiration of El Shaddai — the breath in man, the
--   Spirit who giveth understanding — is genuine and is HIS gift, not mere age. The Spirit who
--   inspires is inseparable from the Word: the Spirit searcheth the deep things of Elohim
--   (1 Cor 2:10) and never leads away from the Torah. Elihu is the more measured voice; the
--   text neither fully endorses nor condemns him, so the threads carry his TRUE saying
--   (understanding is the gift of El) without over-claiming his whole speech.

CREATE TEMP VIEW _s318_job32_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================================================
-- B. cross_references
-- ============================================================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: v.8 — the inspiration of the Almighty giveth understanding
    ('canon','job',32,8,'canon','genesis',2,7,'free',
      E'*And Yahuah Elohim (the LORD God) formed man of the dust of the ground, and breathed into his nostrils the breath of life; and man became a living soul.* (Genesis 2:7). Elihu''s *there is a spirit in man: and the inspiration of the Almighty giveth them understanding* (Job 32:8) reaches back to the forming: the breath that made man a living soul is the same divine breath that gives him understanding. Wisdom is not in the years but in the Spirit El breathed.'),
    ('canon','job',32,8,'canon','proverbs',2,6,'free',
      E'*For Yahuah (LORD) giveth wisdom: out of his mouth cometh knowledge and understanding.* (Proverbs 2:6). Where Elihu says *the inspiration of the Almighty giveth them understanding* (Job 32:8), Proverbs names the source plainly — wisdom is given out of the mouth of Yahuah (LORD), not earned by age. The breath of El and the word of El are one fountain.'),
    ('canon','job',32,8,'canon','daniel',2,21,'free',
      E'*And he changeth the times and the seasons: he removeth kings, and setteth up kings: he giveth wisdom unto the wise, and knowledge to them that know understanding:* (Daniel 2:21). Daniel, who received the dream by revelation and not by his standing, confirms Elihu''s claim that *the inspiration of the Almighty giveth them understanding* (Job 32:8): it is Yahuah who *giveth wisdom unto the wise*.'),
    ('canon','job',32,8,'canon','daniel',2,22,'free',
      E'*He revealeth the deep and secret things: he knoweth what is in the darkness, and the light dwelleth with him.* (Daniel 2:22). The One who *revealeth the deep and secret things* is the inspiration behind Elihu''s *there is a spirit in man... giveth them understanding* (Job 32:8); the deep things are not reached by the multitude of years but unveiled by El.'),
    ('canon','job',32,8,'canon','ecclesiastes',12,7,'free',
      E'*Then shall the dust return to the earth as it was: and the spirit shall return unto Elohim (God) who gave it.* (Ecclesiastes 12:7). The spirit in man that Elihu invokes — *there is a spirit in man* (Job 32:8) — is the spirit Elohim gave and to whom it returns; it is on loan from El, the channel of the understanding El breathes.'),
    ('canon','job',32,8,'canon','1-corinthians',2,10,'free',
      E'*But Elohim (God) hath revealed them unto us by his Spirit: for the Spirit searcheth all things, yea, the deep things of Elohim (God).* (1 Corinthians 2:10). Elihu''s *the inspiration of the Almighty giveth them understanding* (Job 32:8) is filled forward: the Spirit who searcheth *the deep things of Elohim* is the very breath that gives a man understanding — never a wisdom apart from El.'),
    ('canon','job',32,8,'canon','1-corinthians',2,11,'free',
      E'*For what man knoweth the things of a man, save the spirit of man which is in him? even so the things of Elohim (God) knoweth no man, but the Spirit of Elohim (God).* (1 Corinthians 2:11). This is Job 32:8 unfolded — *there is a spirit in man* answers to *the spirit of man which is in him*, and only the Spirit of Elohim conveys the things of Elohim; understanding is His inspiration, not man''s achievement.'),
    ('canon','job',32,8,'canon','1-corinthians',2,12,'free',
      E'*Now we have received, not the spirit of the world, but the spirit which is of Elohim (God); that we might know the things that are freely given to us of Elohim (God).* (1 Corinthians 2:12). The understanding Elihu credits to *the inspiration of the Almighty* (Job 32:8) is the spirit *which is of Elohim*, by which alone we know what is *freely given* — wisdom is received, not aged into.'),
    ('canon','job',32,8,'canon','james',1,5,'free',
      E'*If any of you lack wisdom, let him ask of Elohim (God), that giveth to all men liberally, and upbraideth not; and it shall be given him.* (James 1:5). James draws the practical conclusion of Job 32:8 — since *the inspiration of the Almighty giveth them understanding*, wisdom is to be asked of Elohim who *giveth to all men liberally*, not assumed from one''s years.'),
    ('canon','job',32,8,'apocrypha','ecclesiasticus',1,1,'extras',
      E'*All wisdom comes from Yahuah (God), and is with him for ever.* (Ecclesiasticus 1:1). Ben Sira opens his whole book on Elihu''s premise: *the inspiration of the Almighty giveth them understanding* (Job 32:8) — *all wisdom comes from Yahuah*. Age cannot manufacture what is *with him for ever* and given out of His breath.'),
    ('canon','job',32,8,'apocrypha','the-wisdom-of-solomon',7,7,'extras',
      E'*Wherefore I prayed, and understanding was given me: I called upon Yahuah (God), and the spirit of wisdom came to me.* (Wisdom of Solomon 7:7). Solomon embodies Job 32:8 — he did not grow wise by years but *prayed, and understanding was given* him; *the spirit of wisdom came* by calling on Yahuah, the very inspiration of the Almighty.'),

    -- THREAD 2: v.9 — great men are not always wise
    ('canon','job',32,9,'canon','ecclesiastes',4,13,'free',
      E'*Better is a poor and a wise child than an old and foolish king, who will no more be admonished.* (Ecclesiastes 4:13). Elihu''s *Great men are not always wise: neither do the aged understand judgment* (Job 32:9) is the Preacher''s verdict — a *wise child* outweighs *an old and foolish king*; greatness and grey hairs are no guarantee of wisdom.'),
    ('canon','job',32,9,'canon','1-corinthians',1,26,'free',
      E'*For ye see your calling, brethren, how that not many wise men after the flesh, not many mighty, not many noble, are called:* (1 Corinthians 1:26). Job 32:9''s *Great men are not always wise* runs forward into the calling — *not many wise men after the flesh, not many mighty, not many noble*; standing in the world does not make a man wise before El.'),
    ('canon','job',32,9,'canon','1-corinthians',1,27,'free',
      E'*But Elohim (God) hath chosen the foolish things of the world to confound the wise; and Elohim (God) hath chosen the weak things of the world to confound the things which are mighty;* (1 Corinthians 1:27). The young Buzite confounding the aged is the pattern: *Great men are not always wise* (Job 32:9), for *Elohim hath chosen the foolish things of the world to confound the wise* — He gives understanding where He will.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job32_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job32_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 3: v.18-20 — the spirit within me constraineth me
    ('canon','job',32,18,'canon','jeremiah',20,9,'free',
      E'*Then I said, I will not make mention of him, nor speak any more in his name. But his word was in mine heart as a burning fire shut up in my bones, and I was weary with forbearing, and I could not stay.* (Jeremiah 20:9). Elihu''s *I am full of matter, the spirit within me constraineth me* (Job 32:18) is the prophet''s very experience — the word *as a burning fire shut up in my bones* that *could not stay*; the inward Spirit compels the mouth to speak.'),
    ('canon','job',32,20,'canon','acts',4,20,'free',
      E'*For we can not but speak the things which we have seen and heard.* (Acts 4:20). When Elihu says *I will speak, that I may be refreshed: I will open my lips and answer* (Job 32:20), it is the same constraint the apostles knew — *we can not but speak*; what the Spirit puts within cannot be held back.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job32_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job32_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================================================
-- C. threads
-- ============================================================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-32-the-inspiration-of-the-almighty-giveth-understanding',
       E'The Inspiration of the Almighty Giveth Understanding',
       E'Elihu the Buzite, the young man who waited while *days should speak, and multitude of years should teach wisdom* (Job 32:7), overturns his own deference with a single truth: *But there is a spirit in man: and the inspiration of the Almighty giveth them understanding* (Job 32:8). Wisdom is not stored in grey hairs; it is the breath of El. The chapter reaches back to the forming of man — *Yahuah Elohim (the LORD God)... breathed into his nostrils the breath of life; and man became a living soul* (Genesis 2:7) — for the very breath that animates is the breath that illumines, and *the spirit shall return unto Elohim (God) who gave it* (Ecclesiastes 12:7). The source is named openly: *For Yahuah (LORD) giveth wisdom: out of his mouth cometh knowledge and understanding* (Proverbs 2:6), and He *giveth wisdom unto the wise, and knowledge to them that know understanding* (Daniel 2:21), He who *revealeth the deep and secret things* (Daniel 2:22). The restored witnesses sing the same: *All wisdom comes from Yahuah (God), and is with him for ever* (Ecclesiasticus 1:1); *I called upon Yahuah (God), and the spirit of wisdom came to me* (Wisdom of Solomon 7:7). And the apostle fills it forward without abolishing it — *Elohim (God) hath revealed them unto us by his Spirit: for the Spirit searcheth all things, yea, the deep things of Elohim (God)* (1 Corinthians 2:10); for *the things of Elohim (God) knoweth no man, but the Spirit of Elohim (God)* (1 Corinthians 2:11), the spirit *which is of Elohim* by which we know *the things that are freely given to us* (1 Corinthians 2:12). The Spirit who gives this understanding is never a Spirit apart from the Word; He searcheth the deep things of Elohim and leads to them, never away. So the plain counsel: *If any of you lack wisdom, let him ask of Elohim (God), that giveth to all men liberally* (James 1:5). Elihu is the measured voice among Job''s company; the text neither crowns nor condemns him, but his confession here stands — understanding is the gift of El''s breath, asked and received, not aged into.',
       sv.verse_id, ev.verse_id, 'extras', 33575
  FROM _s318_job32_lookup sv, _s318_job32_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=32 AND sv.verse_number=8
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=32 AND ev.verse_number=8
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-32-great-men-are-not-always-wise',
       E'Great Men Are Not Always Wise',
       E'Having declared that understanding is the breath of El and not the dividend of years, Elihu states the corollary: *Great men are not always wise: neither do the aged understand judgment* (Job 32:9). The Preacher said it before him — *Better is a poor and a wise child than an old and foolish king, who will no more be admonished* (Ecclesiastes 4:13) — wisdom is no respecter of crowns or calendars. And the apostle carries it forward into the calling of Yahuah: *not many wise men after the flesh, not many mighty, not many noble, are called* (1 Corinthians 1:26), *but Elohim (God) hath chosen the foolish things of the world to confound the wise; and Elohim (God) hath chosen the weak things of the world to confound the things which are mighty* (1 Corinthians 1:27). The young Buzite confounding his three elders is that very pattern in miniature: El gives understanding where He will, that no flesh should glory in its standing.',
       sv.verse_id, ev.verse_id, 'free', 33576
  FROM _s318_job32_lookup sv, _s318_job32_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=32 AND sv.verse_number=9
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=32 AND ev.verse_number=9
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-32-the-spirit-within-me-constraineth-me',
       E'The Spirit Within Me Constraineth Me',
       E'Elihu cannot keep silent: *For I am full of matter, the spirit within me constraineth me. Behold, my belly is as wine which hath no vent; it is ready to burst like new bottles. I will speak, that I may be refreshed: I will open my lips and answer* (Job 32:18-20). This inward compulsion is the prophet''s own — Jeremiah, resolved to *speak no more in his name*, found *his word was in mine heart as a burning fire shut up in my bones, and I was weary with forbearing, and I could not stay* (Jeremiah 20:9). And it is the apostles before the council: *we can not but speak the things which we have seen and heard* (Acts 4:20). What the Spirit of El puts within a man cannot be held back; it presses to be spoken. Yet Elihu binds his speech to truth and not to flattery — *Let me not, I pray you, accept any man''s person, neither let me give flattering titles unto man* (Job 32:21) — for the word that comes from El''s breath cannot be bent to please men.',
       sv.verse_id, ev.verse_id, 'free', 33577
  FROM _s318_job32_lookup sv, _s318_job32_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=32 AND sv.verse_number=18
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=32 AND ev.verse_number=20
ON CONFLICT (slug) DO NOTHING;

-- ============================================================
-- D. thread_members
-- ============================================================
-- THREAD 1 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('genesis',2,7,1,E'*...breathed into his nostrils the breath of life; and man became a living soul* (Genesis 2:7) — the breath that gives life is the breath that gives the understanding of Job 32:8.'),
    ('proverbs',2,6,2,E'*For Yahuah (LORD) giveth wisdom: out of his mouth cometh knowledge and understanding* (Proverbs 2:6) — the source of Elihu''s inspiration named plainly.'),
    ('daniel',2,21,3,E'*...he giveth wisdom unto the wise, and knowledge to them that know understanding* (Daniel 2:21) — wisdom is dispensed by El, not by age.'),
    ('daniel',2,22,4,E'*He revealeth the deep and secret things...* (Daniel 2:22) — the deep things are unveiled by El, the inspiration behind understanding.'),
    ('ecclesiastes',12,7,5,E'*...the spirit shall return unto Elohim (God) who gave it* (Ecclesiastes 12:7) — the spirit in man is El''s gift, the channel of His understanding.'),
    ('1-corinthians',2,10,6,E'*...the Spirit searcheth all things, yea, the deep things of Elohim (God)* (1 Corinthians 2:10) — Job 32:8 filled forward: understanding is by His Spirit.'),
    ('1-corinthians',2,11,7,E'*...the things of Elohim (God) knoweth no man, but the Spirit of Elohim (God)* (1 Corinthians 2:11) — only the Spirit conveys the things of Elohim.'),
    ('1-corinthians',2,12,8,E'*...the spirit which is of Elohim (God); that we might know the things that are freely given* (1 Corinthians 2:12) — wisdom is received, not aged into.'),
    ('james',1,5,9,E'*If any of you lack wisdom, let him ask of Elohim (God), that giveth to all men liberally* (James 1:5) — the practical sequel: ask El for the understanding He gives.')
  ) AS m(tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-32-the-inspiration-of-the-almighty-giveth-understanding'
  JOIN _s318_job32_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=32 AND sv.verse_number=8
  JOIN _s318_job32_lookup tv ON tv.edition_slug='canon' AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- THREAD 1 extras members (separate INSERT — apocrypha edition)
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('ecclesiasticus',1,1,10,E'*All wisdom comes from Yahuah (God), and is with him for ever* (Ecclesiasticus 1:1) — Ben Sira opens on Job 32:8''s premise.'),
    ('the-wisdom-of-solomon',7,7,11,E'*I called upon Yahuah (God), and the spirit of wisdom came to me* (Wisdom of Solomon 7:7) — Solomon embodies wisdom asked and received, not aged into.')
  ) AS m(tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-32-the-inspiration-of-the-almighty-giveth-understanding'
  JOIN _s318_job32_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=32 AND sv.verse_number=8
  JOIN _s318_job32_lookup tv ON tv.edition_slug='apocrypha' AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

