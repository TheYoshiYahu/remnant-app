-- ----- fragment: minion_job_34.sql (Job 34) -----
-- Job chapter 34 — Elihu on the justice of El (the render-according-to-works principle,
--   life sustained by El's breath, El no respecter of persons, the all-seeing eyes).
-- session prefix: s318   tag: job34   slug prefix: job-34-   sort_order band start: 33625
-- NOTE: Elihu rightly defends El's perfect justice (he renders justly, no respecter of
--   persons), though he wrongly assumes Job denies it. The threads frame the TRUE principle
--   without endorsing the implied accusation of Job. The render-according-to-works principle
--   (34:11) is covenant-justice / final judgment by works that FLOW from faith (Rom 2:6,
--   Rev 22:12) — NOT works-as-flesh-merit-salvation, NOT a contradiction of grace.
-- NOTE on parse: 34:10 and 34:12 read "the Almighty" (not "El Shaddai") in this canon parse;
--   quoted exactly.
--
-- Job 34 coverage:
--   v.10-12 (render according to works / El's perfect justice):
--        NT:     Romans 2:6, 2 Corinthians 5:10, Revelation 22:12
--        Extras: none warranted (canon render-by-works spine is fully witnessed)
--        Tanakh: Psalm 62:12, Proverbs 24:12, Jeremiah 32:19
--   v.13  NT/Extras/Tanakh: none warranted (rhetorical — folded under the justice thread)
--   v.14-15 (life sustained by El's breath / man returns to dust):
--        NT:     none warranted (death-as-breath-withdrawn is carried by Tanakh witnesses)
--        Extras: none warranted
--        Tanakh: Psalm 104:29, Ecclesiastes 12:7, Genesis 3:19
--   v.16-18 NT/Extras/Tanakh: none warranted (set-up for v.19)
--   v.19  (El no respecter of persons — all are the work of his hands):
--        NT:     Acts 10:34, Romans 2:11, Ephesians 6:9
--        Extras: none warranted
--        Tanakh: Deuteronomy 10:17
--   v.20  NT/Extras/Tanakh: none warranted (carried under v.19 / v.21)
--   v.21-22 (his eyes upon the ways of man — the all-seeing):
--        NT:     Hebrews 4:13
--        Extras: none warranted
--        Tanakh: Proverbs 5:21, Proverbs 15:3, Jeremiah 16:17
--   v.23-37 NT/Extras/Tanakh: none warranted (Elihu's closing rebuke — adequately carried
--        by the four spine threads; v.37 multiplying-words rebuke not separately threaded)
--
-- Threads (4):
--   job-34-the-work-of-a-man-shall-he-render-unto-him      [free; Tanakh+NT] v.10-12
--   job-34-he-gather-unto-himself-his-spirit-and-his-breath [free; Tanakh]    v.14-15
--   job-34-accepteth-not-the-persons-of-princes            [free; Tanakh+NT] v.19
--   job-34-his-eyes-are-upon-the-ways-of-man               [free; Tanakh+NT] v.21

-- A. Temp view
CREATE TEMP VIEW _s318_job34_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- B. cross_references
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- v.10-12 render according to works / El's perfect justice
    ('canon','job',34,11,'canon','psalms',62,12,'free',
     E'*Also unto thee, O Yahuah (Lord), belongeth mercy: for thou renderest to every man according to his work.* (Psalm 62:12) — Elihu''s principle that *the work of a man shall he render unto him, and cause every man to find according to his ways* (Job 34:11) is the very thing David sings: the same El who owns mercy renders to each according to his work. Justice and mercy are not at war in him.'),
    ('canon','job',34,11,'canon','proverbs',24,12,'free',
     E'*If thou sayest, Behold, we knew it not; doth not he that pondereth the heart consider it? and he that keepeth thy soul, doth not he know it? and shall not he render to every man according to his works?* (Proverbs 24:12) — Wisdom presses the same render-by-works principle Elihu names in *the work of a man shall he render unto him* (Job 34:11): the One who weighs the heart cannot be deceived, and renders accordingly.'),
    ('canon','job',34,11,'canon','jeremiah',32,19,'free',
     E'*Great in counsel, and mighty in work: for thine eyes are open upon all the ways of the sons of men: to give every one according to his ways, and according to the fruit of his doings* (Jeremiah 32:19) — Jeremiah binds the all-seeing eye to the render-by-works verdict, exactly as Elihu does: *cause every man to find according to his ways* (Job 34:11). El judges by the fruit of the doings, never blindly.'),
    ('canon','job',34,11,'canon','romans',2,6,'free',
     E'*Who will render to every man according to his deeds* (Romans 2:6) — Paul carries Elihu''s principle FORWARD undimmed: the day of *the righteous judgment of Elohim (God)* renders *to every man according to his deeds*, the deeds of *patient continuance in well doing* (Romans 2:7) — judgment by works that FLOW from faith, not flesh-merit earning salvation. *The work of a man shall he render unto him* (Job 34:11) is gospel-true.'),
    ('canon','job',34,11,'canon','2-corinthians',5,10,'free',
     E'*For we must all appear before the judgment seat of Messiah (Christ); that every one may receive the things done in his body, according to that he hath done, whether it be good or bad.* (2 Corinthians 5:10) — the judgment seat enacts what Elihu confessed: *cause every man to find according to his ways* (Job 34:11). The Formed Son judges, rendering to each according to the deeds done in the body.'),
    ('canon','job',34,12,'canon','revelation',22,12,'free',
     E'*And, behold, I come quickly; and my reward is with me, to give every man according as his work shall be.* (Revelation 22:12) — the canon closes on Elihu''s very principle. *Surely Elohim (God) will not do wickedly, neither will the Almighty pervert judgment* (Job 34:12); his perfect justice culminates in the returning Son who gives *every man according as his work shall be* — never a perverted judgment, ever a true one.'),
    -- v.14-15 life sustained by El's breath / man returns to dust
    ('canon','job',34,14,'canon','psalms',104,29,'free',
     E'*Thou hidest thy face, they are troubled: thou takest away their breath, they die, and return to their dust.* (Psalm 104:29) — David sings precisely what Elihu warns: were El to *gather unto himself his spirit and his breath* (Job 34:14), every creature would fail. Life is not self-owned; it is the loaned breath of Yahuah, withdrawn at his will.'),
    ('canon','job',34,15,'canon','ecclesiastes',12,7,'free',
     E'*Then shall the dust return to the earth as it was: and the spirit shall return unto Elohim (God) who gave it.* (Ecclesiastes 12:7) — the Preacher states the two-fold return Elihu names: *all flesh shall perish together, and man shall turn again unto dust* (Job 34:15). The dust to the earth, the spirit/breath back to the El who lent it — man holds neither.'),
    ('canon','job',34,15,'canon','genesis',3,19,'free',
     E'*In the sweat of thy face shalt thou eat bread, till thou return unto the ground; for out of it wast thou taken: for dust thou art, and unto dust shalt thou return.* (Genesis 3:19) — Elihu''s *man shall turn again unto dust* (Job 34:15) is the Edenic sentence itself, the root word of mortality. Adam was taken from the ground and to the ground he returns; his breath was never his own.'),
    -- v.19 El no respecter of persons
    ('canon','job',34,19,'canon','deuteronomy',10,17,'free',
     E'*For Yahuah Elohaychem (the LORD your God) is Elohim (God) of gods, and Lord of lords, a great Elohim (God), a mighty, and a terrible, which regardeth not persons, nor taketh reward* (Deuteronomy 10:17) — Torah grounds Elihu''s confession that El *accepteth not the persons of princes, nor regardeth the rich more than the poor* (Job 34:19). The Most High *regardeth not persons* — prince and pauper alike are *the work of his hands*.'),
    ('canon','job',34,19,'canon','acts',10,34,'free',
     E'*Then Peter opened his mouth, and said, Of a truth I perceive that Elohim (God) is no respecter of persons* (Acts 10:34) — at Cornelius''s house the principle Elihu spoke opens the gate to the scattered: El *accepteth not the persons of princes, nor regardeth the rich more than the poor* (Job 34:19), and so the gathering reaches every house, not by rank but by his own impartial hand.'),
    ('canon','job',34,19,'canon','romans',2,11,'free',
     E'*For there is no respect of persons with Elohim (God).* (Romans 2:11) — Paul states flatly the axiom under Elihu''s words: *he accepteth not the persons of princes, nor regardeth the rich more than the poor; for they all are the work of his hands* (Job 34:19). The render-by-works judgment is impartial because the Judge plays no favourites.'),
    ('canon','job',34,19,'canon','ephesians',6,9,'free',
     E'*And, ye masters, do the same things unto them, forbearing threatening: knowing that your Master also is in heaven; neither is there respect of persons with him.* (Ephesians 6:9) — earthly masters are bound by heaven''s impartiality. Because El *regardeth not the rich more than the poor; for they all are the work of his hands* (Job 34:19), the one who owns servants must mirror the Master who shows no respect of persons.'),
    -- v.21 the all-seeing eyes
    ('canon','job',34,21,'canon','proverbs',5,21,'free',
     E'*For the ways of man are before the eyes of Yahuah (LORD), and he pondereth all his goings.* (Proverbs 5:21) — Wisdom echoes Elihu word for word: *his eyes are upon the ways of man, and he seeth all his goings* (Job 34:21). The hidden way is not hidden; every step is weighed before the eyes of Yahuah.'),
    ('canon','job',34,21,'canon','proverbs',15,3,'free',
     E'*The eyes of Yahuah (LORD) are in every place, beholding the evil and the good.* (Proverbs 15:3) — the all-seeing eye Elihu names — *his eyes are upon the ways of man, and he seeth all his goings* (Job 34:21) — is in EVERY place. No corner is unwatched; the evil and the good are alike beheld.'),
    ('canon','job',34,21,'canon','jeremiah',16,17,'free',
     E'*For mine eyes are upon all their ways: they are not hid from my face, neither is their iniquity hid from mine eyes.* (Jeremiah 16:17) — Yahuah says of himself what Elihu confesses of him: *his eyes are upon the ways of man, and he seeth all his goings* (Job 34:21). Iniquity cannot duck the gaze; *there is no darkness, nor shadow of death, where the workers of iniquity may hide themselves* (Job 34:22).'),
    ('canon','job',34,21,'canon','hebrews',4,13,'free',
     E'*Neither is there any creature that is not manifest in his sight: but all things are naked and opened unto the eyes of him with whom we have to do.* (Hebrews 4:13) — the all-seeing eye runs FORWARD into the judgment-context of the living Word: *his eyes are upon the ways of man, and he seeth all his goings* (Job 34:21). All things lie naked and open; the render-by-works verdict rests on a sight nothing escapes.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job34_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job34_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- C. threads
-- Thread 1: v.10-12 render according to works / El's perfect justice
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-34-the-work-of-a-man-shall-he-render-unto-him',
  E'The work of a man shall he render unto him',
  E'Elihu defends the perfect justice of El (sometimes overstepping in his assumption that Job denies it, yet stating the true principle): *far be it from Elohim (God), that he should do wickedness; and from the Almighty, that he should commit iniquity. For the work of a man shall he render unto him, and cause every man to find according to his ways. Yea, surely Elohim (God) will not do wickedly, neither will the Almighty pervert judgment* (Job 34:10-12). This is the render-according-to-works spine that runs the whole canon — covenant-justice, final judgment by the fruit of one''s ways, never a flesh-merit scheme that earns salvation, never a contradiction of grace. David sings it: *Also unto thee, O Yahuah (Lord), belongeth mercy: for thou renderest to every man according to his work* (Psalm 62:12) — mercy and recompense held in one hand. Wisdom presses it on the heart-searcher who cannot be fooled: *shall not he render to every man according to his works?* (Proverbs 24:12). Jeremiah binds it to the all-seeing eye: *thine eyes are open upon all the ways of the sons of men: to give every one according to his ways, and according to the fruit of his doings* (Jeremiah 32:19). Paul carries it FORWARD intact — the righteous judgment of Elohim *will render to every man according to his deeds* (Romans 2:6), deeds of *patient continuance in well doing*, works that flow FROM faith. The judgment seat enacts it: *that every one may receive the things done in his body... whether it be good or bad* (2 Corinthians 5:10). And the canon closes on it from the mouth of the returning Son: *behold, I come quickly; and my reward is with me, to give every man according as his work shall be* (Revelation 22:12). The Almighty never perverts judgment.',
  sv.verse_id, ev.verse_id, 'free', 33625
  FROM _s318_job34_lookup sv, _s318_job34_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=34 AND sv.verse_number=10
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=34 AND ev.verse_number=12
ON CONFLICT (slug) DO NOTHING;

-- Thread 2: v.14-15 life sustained by El's breath / man returns to dust
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-34-he-gather-unto-himself-his-spirit-and-his-breath',
  E'If he gather unto himself his spirit and his breath',
  E'Elihu strips every creature of its self-sufficiency in a single breath: *if he set his heart upon man, if he gather unto himself his spirit and his breath; all flesh shall perish together, and man shall turn again unto dust* (Job 34:14-15). Life is loaned, not owned — the breath in the lungs belongs to El, withdrawn at his will. David sings the same dependence: *thou hidest thy face, they are troubled: thou takest away their breath, they die, and return to their dust* (Psalm 104:29). The Preacher names the two-fold return at death: *then shall the dust return to the earth as it was: and the spirit shall return unto Elohim (God) who gave it* (Ecclesiastes 12:7) — body to the ground, breath back to the El who lent it. And the root of it all is the Edenic sentence: *for dust thou art, and unto dust shalt thou return* (Genesis 3:19). Man holds neither his breath nor his dust; both are El''s. The God who renders to every man according to his works is the same God in whose hand is the breath of every man — which is why his justice is not to be charged with iniquity.',
  sv.verse_id, ev.verse_id, 'free', 33626
  FROM _s318_job34_lookup sv, _s318_job34_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=34 AND sv.verse_number=14
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=34 AND ev.verse_number=15
ON CONFLICT (slug) DO NOTHING;

-- Thread 3: v.19 El no respecter of persons
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-34-accepteth-not-the-persons-of-princes',
  E'Him that accepteth not the persons of princes',
  E'Elihu names the impartiality that makes El''s render-by-works judgment trustworthy: *how much less to him that accepteth not the persons of princes, nor regardeth the rich more than the poor? for they all are the work of his hands* (Job 34:19). Prince and pauper stand level before their Maker, for both are the work of his hands. Torah grounds it: *Yahuah Elohaychem (the LORD your God) is Elohim (God) of gods, and Lord of lords, a great Elohim (God), a mighty, and a terrible, which regardeth not persons, nor taketh reward* (Deuteronomy 10:17). The principle opens the gate to the scattered when Peter declares it at Cornelius''s door: *of a truth I perceive that Elohim (God) is no respecter of persons* (Acts 10:34). Paul states it as the axiom under the render-by-works judgment: *for there is no respect of persons with Elohim (God)* (Romans 2:11). And it binds the powerful — *neither is there respect of persons with him* (Ephesians 6:9) — so that earthly masters must mirror the heavenly Master who shows none. Because the Judge plays no favourites, his judgment by works is altogether just.',
  sv.verse_id, ev.verse_id, 'free', 33627
  FROM _s318_job34_lookup sv, _s318_job34_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=34 AND sv.verse_number=19
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=34 AND ev.verse_number=19
ON CONFLICT (slug) DO NOTHING;

-- Thread 4: v.21 the all-seeing eyes
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-34-his-eyes-are-upon-the-ways-of-man',
  E'His eyes are upon the ways of man',
  E'The render-by-works judgment rests on a sight nothing escapes: *for his eyes are upon the ways of man, and he seeth all his goings. There is no darkness, nor shadow of death, where the workers of iniquity may hide themselves* (Job 34:21-22). Wisdom echoes Elihu word for word: *for the ways of man are before the eyes of Yahuah (LORD), and he pondereth all his goings* (Proverbs 5:21), and *the eyes of Yahuah (LORD) are in every place, beholding the evil and the good* (Proverbs 15:3) — no corner unwatched. Yahuah says it of himself: *mine eyes are upon all their ways: they are not hid from my face, neither is their iniquity hid from mine eyes* (Jeremiah 16:17). The all-seeing eye runs FORWARD into the judgment-context of the living Word: *neither is there any creature that is not manifest in his sight: but all things are naked and opened unto the eyes of him with whom we have to do* (Hebrews 4:13). Because El sees every going of every man, the verdict that renders to each according to his works can be nothing but true.',
  sv.verse_id, ev.verse_id, 'free', 33628
  FROM _s318_job34_lookup sv, _s318_job34_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=34 AND sv.verse_number=21
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=34 AND ev.verse_number=22
ON CONFLICT (slug) DO NOTHING;

-- D. thread_members
-- Thread 1 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('job',34,11,'canon','psalms',62,12,1,E'*Thou renderest to every man according to his work* (Psalm 62:12) — David sings the render-by-works principle, holding mercy and recompense in one hand.'),
    ('job',34,11,'canon','proverbs',24,12,2,E'*Shall not he render to every man according to his works?* (Proverbs 24:12) — the heart-searcher cannot be deceived and renders accordingly.'),
    ('job',34,11,'canon','jeremiah',32,19,3,E'*To give every one according to his ways, and according to the fruit of his doings* (Jeremiah 32:19) — the all-seeing eye and the render-by-works verdict bound together.'),
    ('job',34,11,'canon','romans',2,6,4,E'*Who will render to every man according to his deeds* (Romans 2:6) — Paul carries Elihu''s principle FORWARD: judgment by works that flow from faith, not flesh-merit.'),
    ('job',34,11,'canon','2-corinthians',5,10,5,E'*Every one may receive the things done in his body... whether it be good or bad* (2 Corinthians 5:10) — the judgment seat enacts the render-by-works verdict.'),
    ('job',34,12,'canon','revelation',22,12,6,E'*My reward is with me, to give every man according as his work shall be* (Revelation 22:12) — the canon closes on Elihu''s principle from the mouth of the returning Son.')
  ) AS m(src_slug,src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-34-the-work-of-a-man-shall-he-render-unto-him'
  JOIN _s318_job34_lookup sv ON sv.edition_slug='canon' AND sv.book_slug=m.src_slug AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job34_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 2 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('job',34,14,'canon','psalms',104,29,1,E'*Thou takest away their breath, they die, and return to their dust* (Psalm 104:29) — life is the loaned breath of Yahuah, withdrawn at his will.'),
    ('job',34,15,'canon','ecclesiastes',12,7,2,E'*The spirit shall return unto Elohim (God) who gave it* (Ecclesiastes 12:7) — the two-fold return: dust to the earth, breath back to its Lender.'),
    ('job',34,15,'canon','genesis',3,19,3,E'*Dust thou art, and unto dust shalt thou return* (Genesis 3:19) — the Edenic root of Elihu''s *man shall turn again unto dust*.')
  ) AS m(src_slug,src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-34-he-gather-unto-himself-his-spirit-and-his-breath'
  JOIN _s318_job34_lookup sv ON sv.edition_slug='canon' AND sv.book_slug=m.src_slug AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job34_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 3 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('job',34,19,'canon','deuteronomy',10,17,1,E'*Which regardeth not persons, nor taketh reward* (Deuteronomy 10:17) — Torah grounds Elihu''s confession of the impartial Most High.'),
    ('job',34,19,'canon','acts',10,34,2,E'*Elohim (God) is no respecter of persons* (Acts 10:34) — at Cornelius''s door the principle opens the gate to the scattered.'),
    ('job',34,19,'canon','romans',2,11,3,E'*There is no respect of persons with Elohim (God)* (Romans 2:11) — Paul states the axiom under the render-by-works judgment.'),
    ('job',34,19,'canon','ephesians',6,9,4,E'*Neither is there respect of persons with him* (Ephesians 6:9) — earthly masters must mirror the impartial heavenly Master.')
  ) AS m(src_slug,src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-34-accepteth-not-the-persons-of-princes'
