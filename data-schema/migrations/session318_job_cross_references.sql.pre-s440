-- ----- fragment: minion_job_25.sql (Job 25) -----
-- Job chapter 25 — Bildad the Shuhite's third and final speech (only 6 verses).
-- session prefix s318 ; tag job25 ; view _s318_job25_lookup ; slug prefix job-25-...
-- sort_order band start 33400 (+1 per thread).
-- Source book_slug=job, chapter 25.
--
-- Job 25 coverage:
--   v.1   (speech header — "Then answered Bildad the Shuhite, and said,") — no thread (header only)
--   v.2   NT:     none warranted
--         Extras: none warranted
--         Tanakh: Psalm 89:7 (greatly feared in the assembly), Daniel 4:35 (none can stay his hand) -> THREAD 1
--   v.3   NT:     none warranted
--         Extras: none warranted
--         Tanakh: folded into THREAD 1 (the sovereign-majesty couplet, "upon whom doth not his light arise")
--   v.4   NT:     Romans 3:10, Romans 3:20 (none righteous / no flesh justified) -> THREAD 2
--         Extras: Wisdom of Solomon 9:15 (corruptible body presseth down the soul) -> THREAD 2
--         Tanakh: Job 4:17 (more pure than his maker), Job 15:14 (born of a woman, that he should be righteous),
--                 Psalm 14:3 (none doeth good) -> THREAD 2
--   v.5   NT:     none warranted
--         Extras: none warranted
--         Tanakh: Job 15:15 (the heavens are not clean in his sight), Job 4:18 (his angels he charged with folly) -> THREAD 2
--   v.6   NT:     none warranted (Adamic-worm; Phil/Heb handled lightly, not threaded)
--         Extras: none warranted
--         Tanakh: Psalm 8:4 (what is man... the son of Adam), Psalm 22:6 (I am a worm, and no man) -> THREAD 3
--
-- THREADS:
--   1. job-25-2-dominion-and-fear-are-with-him-he-maketh-peace-in-his-high-places (free)
--        — El's sovereign majesty; Tanakh laterals Psalm 89:7, Daniel 4:35.
--   2. job-25-4-how-can-he-be-clean-that-is-born-of-a-woman (extras)
--        — the no-man-clean theme reaching its final form; Job 4:17-18, Job 15:14-15, Psalm 14:3,
--          Romans 3:10, Romans 3:20, Wisdom of Solomon 9:15. GUARD: creaturely humility is TRUE —
--          flesh-merit excluded before the Creator (Rom 3), NOT Torah abolished; Bildad weaponizes the
--          truth as a final dismissal of Job, offering only the gulf and no comfort.
--   3. job-25-6-the-son-of-adam-which-is-a-worm (free)
--        — Adamic lowliness; Psalm 8:4 (the son of Adam visited), Psalm 22:6 (I am a worm, and no man) —
--          the Man-of-Sorrows pattern handled lightly. "son of Adam" rendered exactly as the parse gives.

CREATE TEMP VIEW _s318_job25_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================================================ cross_references
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: dominion and fear are with him (25:2-3) -> sovereign-majesty laterals
    ('canon','job',25,2,'canon','psalms',89,7,'free',
      E'*Elohim (God) is greatly to be feared in the assembly of the saints, and to be had in reverence of all them that are about him.* (Psalm 89:7). Bildad''s *Dominion and fear are with him, he maketh peace in his high places* (Job 25:2) is the same confession the psalmist sings of the One feared in the heavenly council — El reigns over the assembly above, and the host trembles before him.'),
    ('canon','job',25,2,'canon','daniel',4,35,'free',
      E'*And all the inhabitants of the earth are reputed as nothing: and he doeth according to his will in the army of heaven, and among the inhabitants of the earth: and none can stay his hand, or say unto him, What doest thou?* (Daniel 4:35). Bildad''s *he maketh peace in his high places* (Job 25:2) and his *Is there any number of his armies?* (Job 25:3) are the very sovereignty Nebuchadnezzar confessed once his understanding returned — El commands the army of heaven and no hand can stay him.'),
    -- THREAD 2: how can he be clean that is born of a woman (25:4-5) -> no-man-clean
    ('canon','job',25,4,'canon','job',4,17,'free',
      E'*Shall mortal man be more just than Elohim (God)? shall a man be more pure than his maker?* (Job 4:17). Bildad''s *How then can man be justified with Elohim (God)? or how can he be clean that is born of a woman?* (Job 25:4) only repeats what Eliphaz had already pressed in the visions of the night — the creature cannot out-pure his Maker. The truth is real, but it is wielded as a club against Job, not a comfort.'),
    ('canon','job',25,5,'canon','job',4,18,'free',
      E'*Behold, he put no trust in his servants; and his angels he charged with folly* (Job 4:18). Bildad''s *Behold even to the moon, and it shineth not; yea, the stars are not pure in his sight* (Job 25:5) reaches back to Eliphaz''s word: if El finds folly even in his angels, the lights of heaven dim before his holiness, and flesh has no standing at all.'),
    ('canon','job',25,4,'canon','job',15,14,'free',
      E'*What is man, that he should be clean? and he which is born of a woman, that he should be righteous?* (Job 15:14). Bildad''s *how can he be clean that is born of a woman?* (Job 25:4) is almost verbatim the question Eliphaz had already laid down — the friends circle the same gulf between the holy El and the man born of woman, never crossing it to mercy.'),
    ('canon','job',25,5,'canon','job',15,15,'free',
      E'*Behold, he putteth no trust in his saints; yea, the heavens are not clean in his sight* (Job 15:15). Bildad''s *the stars are not pure in his sight* (Job 25:5) echoes Eliphaz exactly — if the very heavens are not clean before El, no son of woman may presume purity in his presence.'),
    ('canon','job',25,4,'canon','psalms',14,3,'free',
      E'*They are all gone aside, they are all together become filthy: there is none that doeth good, no, not one* (Psalm 14:3). Bildad''s *How then can man be justified with Elohim (God)?* (Job 25:4) is the same verdict the psalmist pronounces over all the children of men — none clean, none justified of himself before the One who looks down from heaven.'),
    ('canon','job',25,4,'canon','romans',3,10,'free',
      E'*As it is written, There is none righteous, no, not one* (Romans 3:10). Paul gathers up Bildad''s *How then can man be justified with Elohim (God)?* (Job 25:4) and the whole Tanakh witness — the creature cannot stand clean in his own merit. The gulf Bildad names is true; the Besorah (good news) is that it is closed by mercy, not by the flesh''s boast.'),
    ('canon','job',25,4,'canon','romans',3,20,'free',
      E'*Therefore by the deeds of the law there shall no flesh be justified in his sight: for by the law is the knowledge of sin* (Romans 3:20). This is Bildad''s *How then can man be justified with Elohim (God)?* (Job 25:4) read rightly: no flesh is justified by its own works of merit, for the Torah exposes sin rather than purchasing a clean standing — flesh-merit is excluded, while the Torah itself stands as the very thing that shows man his uncleanness.'),
    ('canon','job',25,4,'apocrypha','the-wisdom-of-solomon',9,15,'extras',
      E'*For the corruptible body presseth down the soul, and the earthy tabernacle weigheth down the mind that museth upon many things* (Wisdom of Solomon 9:15). The wisdom-teacher voices the same creaturely lowliness Bildad presses — *how can he be clean that is born of a woman?* (Job 25:4) — the corruptible, earthy frame cannot reach up to the purity of the Most High.'),
    -- THREAD 3: the son of Adam, which is a worm (25:6) -> Adamic lowliness
    ('canon','job',25,6,'canon','psalms',8,4,'free',
      E'*What is man, that thou art mindful of him? and the son of Adam, that thou visitest him?* (Psalm 8:4). Bildad''s *How much less man, that is a worm? and the son of Adam, which is a worm?* (Job 25:6) names the same Adamic smallness the psalmist marvels at — yet where Bildad sees only contempt, the psalm sees El stooping to be mindful of the son of Adam.'),
    ('canon','job',25,6,'canon','psalms',22,6,'free',
      E'*But I am a worm, and no man; a reproach of men, and despised of the people* (Psalm 22:6). Bildad''s *the son of Adam, which is a worm* (Job 25:6) is taken up, in the Man-of-Sorrows psalm, by the Righteous One who willingly bears the worm''s reproach — the lowliness Bildad hurls as an insult becomes the road the Formed Son walks for his people.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job25_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job25_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================================================ threads
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-25-2-dominion-and-fear-are-with-him-he-maketh-peace-in-his-high-places',
       E'Dominion and Fear Are with Him: He Maketh Peace in His High Places',
       E'Bildad''s last words open not with an argument but with a hymn to El''s majesty: *Dominion and fear are with him, he maketh peace in his high places. Is there any number of his armies? and upon whom doth not his light arise?* (Job 25:2-3). The confession is true and towering — and it is the same one the rest of the Tanakh sings. *Elohim (God) is greatly to be feared in the assembly of the saints, and to be had in reverence of all them that are about him* (Psalm 89:7): El reigns over the heavenly council, feared by the host that surrounds him. *And all the inhabitants of the earth are reputed as nothing: and he doeth according to his will in the army of heaven, and among the inhabitants of the earth: and none can stay his hand, or say unto him, What doest thou?* (Daniel 4:35): the sovereign who maketh peace in his high places commands armies without number, and no creature may stay his hand. Bildad''s theology is unimpeachable here; his failure is that he will turn this glory into a wall against Job rather than a refuge for him.',
       sv.verse_id, ev.verse_id, 'free', 33400
  FROM _s318_job25_lookup sv, _s318_job25_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=25 AND sv.verse_number=2
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=25 AND ev.verse_number=3
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-25-4-how-can-he-be-clean-that-is-born-of-a-woman',
       E'How Can He Be Clean That Is Born of a Woman: The No-Man-Clean Theme Reaching Its Final Form',
       E'Three times in this book the friends circle the same gulf, and here Bildad states it in its starkest form: *How then can man be justified with Elohim (God)? or how can he be clean that is born of a woman? Behold even to the moon, and it shineth not; yea, the stars are not pure in his sight* (Job 25:4-5). Eliphaz had said it first in the visions of the night — *Shall mortal man be more just than Elohim (God)? shall a man be more pure than his maker? Behold, he put no trust in his servants; and his angels he charged with folly* (Job 4:17-18) — and again plainly: *What is man, that he should be clean? and he which is born of a woman, that he should be righteous? ... yea, the heavens are not clean in his sight* (Job 15:14-15). The psalmist pronounces the same verdict over all flesh: *They are all gone aside, they are all together become filthy: there is none that doeth good, no, not one* (Psalm 14:3). And the wisdom-teacher voices the creature''s weight: *For the corruptible body presseth down the soul, and the earthy tabernacle weigheth down the mind* (Wisdom of Solomon 9:15). This is true — gloriously, terribly true. Paul gathers it all up: *As it is written, There is none righteous, no, not one* (Romans 3:10), and *Therefore by the deeds of the law there shall no flesh be justified in his sight: for by the law is the knowledge of sin* (Romans 3:20). Mark the framework carefully: no flesh is justified by its own *works of merit*, for the Torah exposes sin — but the Torah itself is not abolished; it is the very mirror that shows the creature his uncleanness. Bildad''s error is not his doctrine but his use of it: he wields the gulf as a final dismissal of his suffering friend, offering only the distance and never the mercy that, in the Besorah (good news), closes it.',
       sv.verse_id, ev.verse_id, 'extras', 33401
  FROM _s318_job25_lookup sv, _s318_job25_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=25 AND sv.verse_number=4
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=25 AND ev.verse_number=5
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-25-6-the-son-of-adam-which-is-a-worm',
       E'The Son of Adam, Which Is a Worm: The Adamic Lowliness',
       E'Bildad ends where the friends always end — with man crushed to nothing: *How much less man, that is a worm? and the son of Adam, which is a worm?* (Job 25:6). The phrase carries the weight of the seed of Adam, the dust-born lineage. The psalmist takes up the very same smallness, but turns it toward wonder: *What is man, that thou art mindful of him? and the son of Adam, that thou visitest him?* (Psalm 8:4) — El stoops to be mindful of the worm. And in the Man-of-Sorrows psalm the lowliness Bildad hurls as contempt is willingly taken up by the Righteous One: *But I am a worm, and no man; a reproach of men, and despised of the people* (Psalm 22:6). What Bildad means as a verdict of worthlessness becomes, in the seed of the woman, the road the Formed Son walks down into the dust for his people — the worm''s reproach borne to lift the sons of Adam.',
       sv.verse_id, ev.verse_id, 'free', 33402
  FROM _s318_job25_lookup sv, _s318_job25_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=25 AND sv.verse_number=6
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=25 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

