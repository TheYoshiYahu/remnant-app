SELECT t.id, cr.id, 5, E'Psalm 49:7-8 — *None... can... redeem his brother, nor give to Elohim (God) a ransom for him*: no man can pay; the ransom of Job 33:24 must be divine.'
  FROM cross_reference_threads t
  JOIN _s318_job33_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=33 AND sv.verse_number=24
  JOIN _s318_job33_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=49 AND tv.verse_number=7
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-33-the-interpreter-one-among-a-thousand-i-have-found-a-ransom'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

