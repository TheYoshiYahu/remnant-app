-- ----- fragment: minion_job_4.sql (Job 4) -----
-- Job chapter 4 — Eliphaz the Temanite's FIRST speech.  Session prefix s318 ; tag job04.
-- Slug prefix job-4-... ; sort_order band start 32875 (+1 per thread).
-- A friend's speech: it mixes TRUE creaturely-humility sayings with FALSE retribution theology.
-- The whole book of Job exists to OVERTURN the friends' "the righteous never suffer" doctrine
-- (Yahuah's whirlwind speeches + the prologue + Yahuah's verdict in 42:7). The notes below
-- distinguish the two: false-doctrine verses are FRAMED as the error; true sayings are threaded
-- forward as the humility of the creature, NOT as antinomian flesh-merit grace.
--
-- Job 4 coverage:
--   v.7-9 (who ever perished being innocent / plow iniquity reap the same) — the FALSE retribution doctrine
--        NT:     none warranted (refutation kept inside the book + wisdom lateral)
--        Extras: none warranted
--        Tanakh: Job 42:7 (Yahuah: ye have NOT spoken of me the thing that is right) [REFUTATION];
--                Ecclesiastes 8:14 (just men treated as the wicked = vanity) [REFUTATION];
--                Job 1:1 (Job perfect and upright = the living refutation, the innocent who DID suffer)
--   v.12-16 (night vision / a spirit passed before my face, the hair of my flesh stood up)
--        NT/Extras/Tanakh: none warranted — atmospheric framing of the oracle, no framework weave
--   v.17 (Shall mortal man be more just than Eloah? more pure than his maker?) — TRUE creaturely humility
--        NT:     Romans 3:10 (none righteous), Romans 3:20 (no flesh justified — flesh-merit, NOT Torah abolished)
--        Extras: none warranted
--        Tanakh: Job 9:2 (how should man be just with Elohim?), Job 15:14, Job 25:4, Psalm 143:2
--   v.18 (he put no trust in his servants; his angels he charged with folly) — the fallen Watchers
--        NT:     2 Peter 2:4 (angels that sinned), Jude 6 (angels which kept not their first estate)
--        Extras: 1 Enoch 15:3 (the Watchers who left the high holy heaven), Jubilees 5:1 (angels took wives)
--        Tanakh: none warranted (Genesis 6 root carried by the extras witnesses)
--   v.19-21 (houses of clay, foundation in the dust, crushed before the moth, die without wisdom)
--        folded into v.17 thread as the continuation of the creature's frailty
--
-- THREADS (3):
--   job-4-who-ever-perished-being-innocent-the-false-retribution-the-book-overturns  [free]  Tanakh
--   job-4-shall-mortal-man-be-more-just-than-eloah-the-humility-of-the-creature       [free]  Tanakh + NT
--   job-4-his-angels-he-charged-with-folly-the-watchers-that-kept-not-their-estate    [extras] NT + Enoch + Jubilees

CREATE TEMP VIEW _s318_job04_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: the false retribution doctrine (4:7-9) and what the book does with it
    ('canon','job',4,7,  'canon','job',42,7, 'free',
      E'After the speeches Yahuah (the LORD) renders his verdict on the friends'' theology: *And it was so, that after Yahuah (LORD) had spoken these words unto Job, Yahuah (LORD) said to Eliphaz the Temanite, My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). Eliphaz''s opening axiom — *who ever perished, being innocent? or where were the righteous cut off?* (Job 4:7) — is named here by Yahuah Himself as the thing that is NOT right. The book exists to overturn this neat retribution doctrine; the innocent sufferer is not a contradiction but the refutation.'),
    ('canon','job',4,7,  'canon','ecclesiastes',8,14, 'free',
      E'The Preacher records the very anomaly Eliphaz''s doctrine denies: *There is a vanity which is done upon the earth; that there be just men, unto whom it happeneth according to the work of the wicked; again, there be wicked men, to whom it happeneth according to the work of the righteous: I said that this also is vanity* (Ecclesiastes 8:14). Against *they that plow iniquity, and sow wickedness, reap the same* (Job 4:8), the canon witnesses that under the sun the righteous are sometimes treated as the wicked — Yahuah''s justice is real but not mechanical, and not bounded by what the friends can see.'),
    ('canon','job',4,7,  'canon','job',1,1, 'free',
      E'The prologue already answers the question before Eliphaz asks it: *There was a man in the land of Uz, whose name was Job; and that man was perfect and upright, and one that feared Elohim (God), and eschewed evil* (Job 1:1). When Eliphaz demands *who ever perished, being innocent?* (Job 4:7), the reader knows what he does not — the man before him IS innocent and IS suffering. Job is the living refutation of the doctrine; the suffering of the upright is not proof of hidden sin.'),
    -- THREAD 2: the humility of the creature (4:17) — true even on a flawed speaker's lips
    ('canon','job',4,17, 'canon','job',9,2, 'free',
      E'Job will affirm the truth of the oracle''s premise even while rejecting the friend who wields it: *I know it is so of a truth: but how should man be just with Elohim (God)?* (Job 9:2). The night-voice''s question — *Shall mortal man be more just than Elohim (God)? shall a man be more pure than his maker?* (Job 4:17) — is sound creaturely humility; the error is not the premise but Eliphaz''s use of it to convict the righteous. No creature out-righteouses his Maker.'),
    ('canon','job',4,17, 'canon','job',15,14, 'free',
      E'Eliphaz himself repeats the saying in his second speech: *What is man, that he should be clean? and he which is born of a woman, that he should be righteous?* (Job 15:14). The refrain of human frailty before Elohim is genuine wisdom — *shall a man be more pure than his maker?* (Job 4:17) — even where the speaker misapplies it. The truth of the creature''s impurity is not the same as the false charge laid against Job.'),
    ('canon','job',4,17, 'canon','job',25,4, 'free',
      E'Bildad closes the friends'' case with the same confession: *How then can man be justified with Elohim (God)? or how can he be clean that is born of a woman? Behold even to the moon, and it shineth not; yea, the stars are not pure in his sight* (Job 25:4-5). The whole canon of the friends'' wisdom orbits Job 4:17 — *shall mortal man be more just than Elohim (God)?* — a true word about the gulf between creature and Maker, even on flawed lips.'),
    ('canon','job',4,17, 'canon','psalms',143,2, 'free',
      E'David prays the same humility, turning it Godward instead of using it as a weapon: *And enter not into judgment with thy servant: for in thy sight shall no man living be justified* (Psalm 143:2). The night-voice asks *shall mortal man be more just than Elohim (God)?* (Job 4:17); David answers by pleading mercy, not merit — the right posture toward the creature''s impurity is supplication, not the accusation Eliphaz makes of it.'),
    ('canon','job',4,17, 'canon','romans',3,10, 'free',
      E'Paul gathers the Tanakh''s verdict on flesh-merit: *As it is written, There is none righteous, no, not one* (Romans 3:10). The night-voice already pressed it — *shall mortal man be more just than Elohim (God)?* (Job 4:17). This is the humility of the creature before the Maker, the universal exclusion of self-justification — NOT a charge against the Torah, which Paul upholds (Romans 3:31), but against any flesh boasting itself pure before its maker.'),
    ('canon','job',4,17, 'canon','romans',3,20, 'free',
      E'Paul draws the line where Job 4:17 draws it — between the creature and his maker, never against the covenant instruction: *Therefore by the deeds of the law there shall no flesh be justified in his sight: for by the law is the knowledge of sin* (Romans 3:20). *Shall a man be more pure than his maker?* (Job 4:17) — no flesh is justified by parading its own works, yet the Torah stands as the very thing that shows man his impurity. The exclusion is of flesh-merit, not of the law.'),
    -- THREAD 3: the angels charged with folly (4:18) — the fallen Watchers
    ('canon','job',4,18, 'canon','2-peter',2,4, 'extras',
      E'Kepha (Peter) names the angels Eliphaz''s oracle glances at: *For if Elohim (God) spared not the angels that sinned, but cast them down to hell, and delivered them into chains of darkness, to be reserved unto judgment* (2 Peter 2:4). The night-voice says *Behold, he put no trust in his servants; and his angels he charged with folly* (Job 4:18) — even the heavenly host is not pure before its Maker; some of them fell, and Yahuah holds them in judgment.'),
    ('canon','job',4,18, 'canon','jude',1,6, 'extras',
      E'Yahudah (Jude) gives the same witness: *And the angels which kept not their first estate, but left their own habitation, he hath reserved in everlasting chains under darkness unto the judgment of the great day* (Jude 1:6). If Yahuah *his angels he charged with folly* (Job 4:18), how much less the man of clay — yet the verse also opens a window onto the Watchers who left their estate, the rebellion the restored library testifies in full.'),
    ('canon','job',4,18, 'enoch','1-enoch',15,3, 'extras',
      E'The 1 Enoch witness names the folly directly, the charge spoken against the Watchers: *Wherefore have ye left the high, holy, and eternal heaven, and lain with women, and defiled yourselves with the daughters of men and taken to yourselves wives, and done like the children of earth, and begotten giants (as your) sons?* (1 Enoch 15:3). *His angels he charged with folly* (Job 4:18) — this is that folly, the watchers who abandoned the holy heaven, the Genesis 6 rebellion the apparatus carries.'),
    ('canon','job',4,18, 'jubilees','jubilees',5,1, 'extras',
      E'Jubilees records the same fall: *And it came to pass when the children of men began to multiply on the face of the earth and daughters were born to them, that the angels of Elohim (God) saw them on a certain year of this jubilee, that they were beautiful to look upon; and they took themselves wives of all whom they chose, and they bare to them sons and they were giants* (Jubilees 5:1). When the night-voice says *his angels he charged with folly* (Job 4:18), Jubilees and Enoch supply the history — the servants Yahuah put no trust in are these.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job04_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job04_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== threads =====
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-4-who-ever-perished-being-innocent-the-false-retribution-the-book-overturns',
  E'Who ever perished, being innocent? — the false retribution the book overturns',
  E'Eliphaz the Temanite opens with the friends'' axiom: *Remember, I pray thee, who ever perished, being innocent? or where were the righteous cut off?* (Job 4:7), and presses it into a law of cause and effect — *they that plow iniquity, and sow wickedness, reap the same. By the blast of Elohim (God) they perish* (Job 4:8-9). It is tidy and it is false. The whole book of Job exists to overturn it. Yahuah (the LORD) Himself renders the verdict at the end: *for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). The prologue has already given the lie before Eliphaz draws breath — *that man was perfect and upright, and one that feared Elohim (God), and eschewed evil* (Job 1:1) — so the innocent man before him is not the exception that proves hidden sin but the living refutation of the doctrine. And the Preacher records the same anomaly Eliphaz denies: *that there be just men, unto whom it happeneth according to the work of the wicked* (Ecclesiastes 8:14). Yahuah''s justice is real, but it is not the mechanical ledger the friends imagine; the righteous DO suffer, and their suffering is not proof against them. Do not let *who ever perished, being innocent?* stand as endorsed truth — it is the error the book was written to dismantle.',
  sv.verse_id, ev.verse_id, 'free', 32875
  FROM _s318_job04_lookup sv, _s318_job04_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=4 AND sv.verse_number=7
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=4 AND ev.verse_number=9
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-4-shall-mortal-man-be-more-just-than-eloah-the-humility-of-the-creature',
  E'Shall mortal man be more just than Eloah? — the humility of the creature',
  E'Out of the night vision a voice asks the question that runs through the whole book: *Shall mortal man be more just than Elohim (God)? shall a man be more pure than his maker?* (Job 4:17). On Eliphaz''s lips it becomes a bludgeon against Job; but the premise itself is sound creaturely humility, and the canon affirms it again and again. Job grants it: *how should man be just with Elohim (God)?* (Job 9:2). Eliphaz repeats it: *What is man, that he should be clean?* (Job 15:14). Bildad seals it: *How then can man be justified with Elohim (God)? or how can he be clean that is born of a woman?* (Job 25:4). David turns it Godward into a plea for mercy rather than a weapon: *enter not into judgment with thy servant: for in thy sight shall no man living be justified* (Psalm 143:2). The continuation in Job 4 only deepens the frailty — *them that dwell in houses of clay, whose foundation is in the dust, which are crushed before the moth... they die, even without wisdom* (Job 4:19-21). Paul gathers the same verdict on flesh-merit: *There is none righteous, no, not one* (Romans 3:10), and *by the deeds of the law there shall no flesh be justified in his sight: for by the law is the knowledge of sin* (Romans 3:20). This is the gulf between creature and Maker, the exclusion of self-righteousness — NOT the abolition of the Torah, which Paul upholds (Romans 3:31), and which is itself the mirror that shows man his impurity. The right posture before the Maker is supplication, not the accusation Eliphaz makes of it.',
  sv.verse_id, ev.verse_id, 'free', 32876
  FROM _s318_job04_lookup sv, _s318_job04_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=4 AND sv.verse_number=17
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=4 AND ev.verse_number=17
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-4-his-angels-he-charged-with-folly-the-watchers-that-kept-not-their-estate',
  E'His angels he charged with folly — the Watchers that kept not their first estate',
  E'The night-voice presses past the frailty of man to the host of heaven: *Behold, he put no trust in his servants; and his angels he charged with folly* (Job 4:18). Even the heavenly servants are not pure before their Maker; some of them fell. The apostolic witness names them: *Elohim (God) spared not the angels that sinned, but cast them down to hell, and delivered them into chains of darkness, to be reserved unto judgment* (2 Peter 2:4); *the angels which kept not their first estate, but left their own habitation, he hath reserved in everlasting chains under darkness unto the judgment of the great day* (Jude 1:6). The restored library supplies the history these allude to. The 1 Enoch witness names the very folly: *Wherefore have ye left the high, holy, and eternal heaven, and lain with women, and defiled yourselves with the daughters of men and taken to yourselves wives, and done like the children of earth, and begotten giants (as your) sons?* (1 Enoch 15:3). And Jubilees records the fall: *the angels of Elohim (God) saw them... that they were beautiful to look upon; and they took themselves wives of all whom they chose, and they bare to them sons and they were giants* (Jubilees 5:1). The Watchers who left their estate are the servants Yahuah put no trust in — the Genesis 6 rebellion the whole apparatus testifies. If the angels themselves were charged with folly, how much less *them that dwell in houses of clay, whose foundation is in the dust* (Job 4:19).',
  sv.verse_id, ev.verse_id, 'extras', 32877
  FROM _s318_job04_lookup sv, _s318_job04_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=4 AND sv.verse_number=18
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=4 AND ev.verse_number=18
ON CONFLICT (slug) DO NOTHING;

-- ===== thread_members =====
-- THREAD 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'Job 42:7 — Yahuah''s verdict: *ye have not spoken of me the thing that is right* — the book itself names Eliphaz''s axiom as the error.'
  FROM cross_reference_threads t
  JOIN _s318_job04_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=4 AND sv.verse_number=7
  JOIN _s318_job04_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=42 AND tv.verse_number=7
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-4-who-ever-perished-being-innocent-the-false-retribution-the-book-overturns'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
