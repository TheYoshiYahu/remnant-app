SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('job',14,14, 'canon','job',19,25, 1, E'*I know that my redeemer liveth, and that he shall stand at the latter day upon the earth* (Job 19:25) -- Job''s own answer to his own question.'),
    ('job',14,14, 'canon','job',19,26, 2, E'*yet in my flesh shall I see Elohim* (Job 19:26) -- the change named: body rots, yet the flesh shall see.'),
    ('job',14,14, 'canon','daniel',12,2, 3, E'*many of them that sleep in the dust of the earth shall awake* (Daniel 12:2) -- the awakening Job longed to see.'),
