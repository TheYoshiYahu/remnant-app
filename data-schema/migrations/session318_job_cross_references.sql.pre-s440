  JOIN _s318_job14_lookup sv ON sv.edition_slug='canon' AND sv.book_slug=m.src_slug AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job14_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_15.sql (Job 15) -----
-- Job chapter 15 — Eliphaz's second speech (harsher). Tag job15 ; session s318.
-- sort_order band: 33150..33153 (+1 per thread).
-- Source book_slug=job, chapter 15. All targets weighed across NT / extras / Tanakh.
--
-- Job 15 coverage:
--   v.6  (thine own mouth condemneth thee)
--        NT:     none warranted (lawsuit motif; framed Tanakh-internally)
--        Extras: none warranted
--        Tanakh: Job 42:7 (Yahuah's verdict — the friends spoke NOT what is right) — woven into thread T3/T4
--   v.14-16 (what is man that he should be clean / heavens not clean / drinketh iniquity like water)
--        NT:     Romans 3:10-12 (none righteous, no not one); 1 John 1:8 (if we say we have no sin)
--        Extras: none warranted (clean creaturely-impurity witness already strong in canon)
--        Tanakh: Psalm 14:1-3 (none that doeth good); Job 4:17-18; Job 25:4-5 (the same no-man-clean refrain)
--   v.15 (he putteth no trust in his saints; heavens not clean in his sight)
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: Job 4:18 (his angels he charged with folly); Job 25:5 (stars not pure in his sight) — lateral
--   v.20-35 (the wicked man travaileth with pain all his days — retribution portrait)
--        NT:     none warranted (the doctrine the BOOK overturns; not endorsed forward)
--        Extras: none warranted
--        Tanakh: Job 21:7 (wherefore do the wicked live, become old); Psalm 73:3 (prosperity of the wicked);
--                Job 42:7 (Yahuah's rebuke of Eliphaz) — the doctrine Yahuah overturns
--
-- THREADS:
--   T1 job-15-what-is-man-that-he-should-be-clean (15:14 -> 15:16) — NT(Romans, 1 John) + Tanakh(Psalm 14) — FREE
--   T2 job-15-the-heavens-are-not-clean-in-his-sight (15:15 -> 15:15) — Tanakh(Job 4, Job 25) — FREE
--   T3 job-15-thine-own-mouth-condemneth-thee (15:5 -> 15:6) — Tanakh(Job 42) — FREE
--   T4 job-15-the-wicked-man-travaileth-with-pain (15:20 -> 15:35) — Tanakh(Job 21, Psalm 73, Job 42) — FREE
--
-- GUARD: 15:14-16's no-man-clean is a TRUE creaturely humility being WEAPONIZED by Eliphaz against the
-- righteous sufferer — the truth is threaded FORWARD (Rom 3 / 1 John 1: flesh-merit excluded, NOT Torah
-- abolished) while the prose names the misapplication. The wicked-man portrait (15:20ff) is the retribution
-- doctrine Yahuah REBUKES at Job 42:7 — threaded as overturned, never endorsed forward.

CREATE TEMP VIEW _s318_job15_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- T1: what is man, that he should be clean (15:14-16) -> Rom 3, 1 John 1, Psalm 14
    ('canon','job',15,14,'canon','romans',3,10,'free',
      E'*As it is written, There is none righteous, no, not one* (Romans 3:10). Eliphaz speaks a true creaturely word — *What is man, that he should be clean? and he which is born of a woman, that he should be righteous?* (Job 15:14) — the same verdict Sha''ul (Paul) gathers from the Tanakh: no flesh has standing to merit before Yahuah (God). The truth stands; Eliphaz only wields it wrongly, as a club against the righteous sufferer rather than as honest confession.'),
    ('canon','job',15,16,'canon','romans',3,12,'free',
      E'*They are all gone out of the way, they are together become unprofitable; there is none that doeth good, no, not one* (Romans 3:12). Eliphaz''s *How much more abominable and filthy is man, which drinketh iniquity like water?* (Job 15:16) names the flesh''s thirst for sin — the very condition Sha''ul (Paul) cites to stop every mouth. Flesh-merit is excluded; this never abolishes the Torah, it drives the creature to the covenant mercy of Yahuah (God).'),
    ('canon','job',15,16,'canon','1-john',1,8,'free',
      E'*If we say that we have no sin, we deceive ourselves, and the truth is not in us* (1 John 1:8). Job 15:16''s *which drinketh iniquity like water* is honest creaturely truth — yet Eliphaz turns it into an accusation, not a confession. Yochanan (John) keeps it where it belongs: a man owns his sin and walks in the light, where *the blood... cleanseth us from all sin* (1 John 1:7).'),
    ('canon','job',15,14,'canon','psalms',14,3,'free',
      E'*They are all gone aside, they are all together become filthy: there is none that doeth good, no, not one* (Psalm 14:3). The Psalm sings the same indictment Eliphaz presses — *What is man, that he should be clean?* (Job 15:14). It is the floor of the whole canon: the creature has no clean merit of his own, and so the seed of promise and the covenant mercy of Yahuah (God) are everything.'),

    -- T2: the heavens are not clean in his sight (15:15) -> Job 4:18, Job 25:5
    ('canon','job',15,15,'canon','job',4,18,'free',
      E'*Behold, he put no trust in his servants; and his angels he charged with folly* (Job 4:18). Eliphaz had said this once already in his night-vision; now he repeats it as *Behold, he putteth no trust in his saints; yea, the heavens are not clean in his sight* (Job 15:15). Even the messengers of heaven are not pure before the Most High — a true note of creaturely smallness, here pressed to crush Job rather than to humble Eliphaz himself.'),
    ('canon','job',15,15,'canon','job',25,5,'free',
      E'*Behold even to the moon, and it shineth not; yea, the stars are not pure in his sight* (Job 25:5). Bildad will echo the same refrain Eliphaz sounds here — *the heavens are not clean in his sight* (Job 15:15). The friends agree among themselves that nothing in the created order is clean before Yahuah (God); the book exposes how they twist this true smallness into a false charge against the innocent.'),

    -- T3: thine own mouth condemneth thee (15:5-6) -> Job 42:7
    ('canon','job',15,6,'canon','job',42,7,'free',
      E'*Yahuah (LORD) said to Eliphaz the Temanite, My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). Eliphaz charges *Thine own mouth condemneth thee, and not I* (Job 15:6) — but at the end Yahuah (God) Himself reverses the verdict: it is the accusers, not Job, whose words are wrong. The friend who claimed to speak for heaven is the one heaven indicts.'),

    -- T4: the wicked man travaileth with pain all his days (15:20-35) -> Job 21:7, Psalm 73:3, Job 42:7
    ('canon','job',15,20,'canon','job',21,7,'free',
      E'*Wherefore do the wicked live, become old, yea, are mighty in power?* (Job 21:7). Eliphaz''s creed is *The wicked man travaileth with pain all his days* (Job 15:20) — the tidy retribution doctrine that the wicked always suffer and the righteous always prosper. Job answers from the world as it actually is: the wicked often grow old and strong. The book lets reality break the friends'' formula.'),
    ('canon','job',15,20,'canon','psalms',73,3,'free',
      E'*For I was envious at the foolish, when I saw the prosperity of the wicked* (Psalm 73:3). Asaph saw exactly what Eliphaz''s doctrine denies — the wicked prospering while the upright is afflicted. Against Job 15:20''s *The wicked man travaileth with pain all his days*, the Psalm confesses the scandal honestly and waits on the judgment of Yahuah (God) rather than forcing it onto the present.'),
    ('canon','job',15,35,'canon','job',42,7,'free',
      E'*Ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). Eliphaz closes his portrait with *They conceive mischief, and bring forth vanity, and their belly prepareth deceit* (Job 15:35) — aiming the whole indictment at Job. Yahuah (God) overturns the entire retribution scheme at the end: the speech meant to convict the sufferer is itself the speech that earns the rebuke.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job15_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job15_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- T1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-15-what-is-man-that-he-should-be-clean',
       E'What is man, that he should be clean?',
       E'Eliphaz''s harsher second speech reaches its center at the great creaturely confession: *What is man, that he should be clean? and he which is born of a woman, that he should be righteous?... How much more abominable and filthy is man, which drinketh iniquity like water?* (Job 15:14, 16). The word is TRUE — the flesh has no clean merit of its own before Yahuah (God) — yet Eliphaz weaponizes it, hurling it at the righteous sufferer as an accusation rather than owning it as confession. The Psalm sounds the same floor: *there is none that doeth good, no, not one* (Psalm 14:3). Sha''ul (Paul) gathers exactly this Tanakh verdict to stop every mouth — *There is none righteous, no, not one... there is none that doeth good, no, not one* (Romans 3:10, 12) — flesh-merit excluded, which never abolishes the Torah but drives the creature to covenant mercy. Yochanan (John) keeps the truth where it belongs, in the mouth of the one confessing: *If we say that we have no sin, we deceive ourselves, and the truth is not in us* (1 John 1:8). The doctrine is sound; the misapplication is Eliphaz''s.',
       sv.verse_id, ev.verse_id, 'free', 33150
  FROM _s318_job15_lookup sv, _s318_job15_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=15 AND sv.verse_number=14
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=15 AND ev.verse_number=16
ON CONFLICT (slug) DO NOTHING;

-- T2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-15-the-heavens-are-not-clean-in-his-sight',
       E'The heavens are not clean in his sight',
       E'*Behold, he putteth no trust in his saints; yea, the heavens are not clean in his sight* (Job 15:15). Eliphaz repeats the very word his night-vision gave him in his first speech — *Behold, he put no trust in his servants; and his angels he charged with folly* (Job 4:18) — and Bildad will sound the same note: *Behold even to the moon, and it shineth not; yea, the stars are not pure in his sight* (Job 25:5). The three friends agree among themselves that nothing in the created order — not the holy ones, not the heavens, not the stars — is pure before Yahuah (God). The smallness of the creature before the Most High is a true thing. But the book exposes how they bend this true humility into a false charge, using the impurity of all flesh to convict an innocent man whom Yahuah (God) Himself will vindicate.',
       sv.verse_id, ev.verse_id, 'free', 33151
  FROM _s318_job15_lookup sv, _s318_job15_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=15 AND sv.verse_number=15
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=15 AND ev.verse_number=15
ON CONFLICT (slug) DO NOTHING;

-- T3
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-15-thine-own-mouth-condemneth-thee',
       E'Thine own mouth condemneth thee',
       E'The accusation hardens: *For thy mouth uttereth thine iniquity, and thou choosest the tongue of the crafty. Thine own mouth condemneth thee, and not I: yea, thine own lips testify against thee* (Job 15:5-6). Eliphaz frames himself as the neutral witness merely reporting what Job''s own words prove. But the book keeps the gavel for Yahuah (God), and His verdict falls the other way: *Yahuah (LORD) said to Eliphaz the Temanite, My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). The friend who claimed Job''s lips condemned him is the one whose own speech earns the rebuke of heaven. The covenant lawsuit is real, but the One who judges is not Eliphaz.',
       sv.verse_id, ev.verse_id, 'free', 33152
  FROM _s318_job15_lookup sv, _s318_job15_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=15 AND sv.verse_number=5
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=15 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

-- T4
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-15-the-wicked-man-travaileth-with-pain',
       E'The wicked man travaileth with pain all his days',
       E'Eliphaz unrolls the traditional retribution portrait — *The wicked man travaileth with pain all his days... He shall not be rich, neither shall his substance continue... For the congregation of hypocrites shall be desolate... They conceive mischief, and bring forth vanity, and their belly prepareth deceit* (Job 15:20, 29, 34, 35). It is the tidy creed the whole book exists to overturn: that the wicked always suffer now and the righteous always prosper now — and Eliphaz means it as a portrait of Job. Job himself answers from the world as it actually is: *Wherefore do the wicked live, become old, yea, are mighty in power?* (Job 21:7). Asaph confesses the same scandal in the sanctuary: *For I was envious at the foolish, when I saw the prosperity of the wicked* (Psalm 73:3). And Yahuah (God) Himself overturns the entire scheme at the close: *ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). The doctrine aimed to convict the sufferer is the very speech heaven rebukes.',
       sv.verse_id, ev.verse_id, 'free', 33153
  FROM _s318_job15_lookup sv, _s318_job15_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=15 AND sv.verse_number=20
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=15 AND ev.verse_number=35
ON CONFLICT (slug) DO NOTHING;

-- ===== thread_members =====

-- T1 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*There is none righteous, no, not one* (Romans 3:10) — Sha''ul (Paul) gathers the Tanakh''s no-man-clean verdict; the truth Eliphaz misapplies stands.'
  FROM cross_reference_threads t
  JOIN _s318_job15_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=15 AND sv.verse_number=14
  JOIN _s318_job15_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='romans' AND tv.chapter_number=3 AND tv.verse_number=10
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-15-what-is-man-that-he-should-be-clean'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

