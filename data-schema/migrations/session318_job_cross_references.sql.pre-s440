    ('job',14,14, 'canon','john',5,29, 5, E'*shall come forth... unto the resurrection of life* (John 5:29) -- the two resurrections, the direct reply.'),
    ('job',14,14, 'canon','1-corinthians',15,51, 6, E'*We shall not all sleep, but we shall all be changed* (1 Corinthians 15:51) -- the very word Job groped for: my change.'),
    ('job',14,14, 'canon','1-corinthians',15,52, 7, E'*the dead shall be raised incorruptible, and we shall be changed* (1 Corinthians 15:52) -- the change come, at the last trump.'),
    ('job',14,14, 'apocrypha','2-esdras',7,32, 8, E'*the earth shall restore those that are asleep in her* (2 Esdras 7:32) -- the Second-Temple hope speaks Job''s answer plainly.')
  ) AS m(src_slug,src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
