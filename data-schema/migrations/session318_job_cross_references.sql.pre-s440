-- Thread 3 — one fashioned us in the womb
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*hath not one Elohim (God) created us?* (Malachi 2:10) — one Maker, one fashioning hand, the ground of justice to the servant.'
  FROM cross_reference_threads t
  JOIN _s318_job31_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=15
  JOIN _s318_job31_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='malachi' AND tv.chapter_number=2 AND tv.verse_number=10
