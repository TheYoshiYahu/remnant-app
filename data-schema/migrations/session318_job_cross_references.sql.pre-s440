-- Thread 2 — even balance
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*A just weight and balance are the LORD''S* (Proverbs 16:11) — the scale Job invites is Yahuah''s own instrument.'
  FROM cross_reference_threads t
  JOIN _s318_job31_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=6
  JOIN _s318_job31_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='proverbs' AND tv.chapter_number=16 AND tv.verse_number=11
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-31-6-weighed-in-an-even-balance'
