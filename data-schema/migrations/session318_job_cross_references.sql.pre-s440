-- ----- fragment: minion_job_37.sql (Job 37) -----
-- Job 37 — Elihu on the storm: El's voice in the thunder, the prelude to the whirlwind
-- tag: job37 ; session prefix: s318 ; sort band: 33700-33704
-- source book_slug=job, chapter 37 (canon)
--
-- LENS: El's voice in the storm = the Creator's majesty, setting up the whirlwind
-- theophany of ch38 — and the One who answers out of that whirlwind is the Formed Son,
-- Yahuah (LORD) who has a Father. "Stand still and consider" = the posture of awe before
-- the Creator; "we cannot find him out" = the unsearchable Most High whose light no man
-- can approach. All members canon → every thread tier 'free'.
--
-- Job 37 coverage:
--   v.1-2 (heart trembleth / hear the noise of his voice)
--        NT:     Revelation 10:3 (seven thunders uttered their voices) — threaded
--        Extras: none warranted
--        Tanakh: Psalm 29:3-4 (voice of Yahuah upon the waters, powerful, full of majesty);
--                Psalm 18:13 (Yahuah thundered in the heavens, the Highest gave his voice) — threaded
--   v.3-4 (directeth it under heaven / a voice roareth)  — folded into the thunder thread
--   v.5  (El thundereth marvellously; great things we cannot comprehend) — thread anchor end
--        NT:     none warranted (comprehension theme carried to unsearchable-majesty thread)
--        Extras: none warranted
--        Tanakh: Psalm 29 (same theophany)
--   v.6  (he saith to the snow, Be thou on the earth; small/great rain)
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: Psalm 147:16,18 (giveth snow like wool; sendeth his word and melteth) — threaded
--   v.7  (sealeth up the hand of every man that all may know his work) — folded with v.14 awe
--   v.8-13 (beasts to dens; whirlwind; frost; clouds turned by his counsels) — covered by thunder/snow threads
--   v.14 ★ (Hearken, O Job: stand still, and consider the wondrous works of El)
--        NT:     none warranted (the still-and-behold posture is a Tanakh weave)
--        Extras: none warranted
--        Tanakh: Psalm 46:10 (Be still, and know that I am Elohim); Exodus 14:13 (stand still,
--                and see the salvation of Yahuah); Psalm 111:2 (works of Yahuah are great,
--                sought out of all them that have pleasure therein) — threaded
--   v.15-21 (balancings of the clouds; warm garments; spread sky; we cannot order our speech)
--        NT/Extras/Tanakh: none warranted — wonder-list folded under v.14 consider-his-works
--   v.22-23 ★ (fair weather out of the north; with El terrible majesty; El Shaddai we cannot find him out)
--        NT:     1 Timothy 6:16 (dwelling in the light which no man can approach unto) — threaded
--        Extras: none warranted
--        Tanakh: Isaiah 40:28 (no searching of his understanding); Job 36:26 (Elohim is great,
--                we know him not, neither can the number of his years be searched out) — threaded
--   v.24 (Men do therefore fear him: he respecteth not any that are wise of heart)
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: Proverbs 3:7 (Be not wise in thine own eyes: fear Yahuah, and depart from evil) — threaded
--
-- Threads (5):
--   job-37-the-voice-of-el-in-the-thunder                  (canon) v.1-5  → Ps29:3, Ps29:4, Ps18:13, Rev10:3
--   job-37-he-saith-to-the-snow-be-thou-on-the-earth       (canon) v.6    → Ps147:16, Ps147:18
--   job-37-stand-still-and-consider-the-wondrous-works     (canon) v.14   → Ps46:10, Exod14:13, Ps111:2
--   job-37-touching-el-shaddai-we-cannot-find-him-out      (canon) v.22-23→ Isa40:28, Job36:26, 1Tim6:16
--   job-37-men-do-therefore-fear-him                       (canon) v.24   → Prov3:7

CREATE TEMP VIEW _s318_job37_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== B. cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: the voice of El in the thunder (vv.1-5)
    ('canon','job',37,2,'canon','psalms',29,3,'free',
     E'*The voice of Yahuah (LORD) is upon the waters: the Elohim (God) of glory thundereth: Yahuah (LORD) is upon many waters* (Psalm 29:3). Elihu bids Job *Hear attentively the noise of his voice, and the sound that goeth out of his mouth* (Job 37:2); the Psalmist names that same voice in the storm — the Elohim of glory thundering over the deep, the Creator''s majesty audible in the heavens.'),
    ('canon','job',37,4,'canon','psalms',29,4,'free',
     E'*The voice of Yahuah (LORD) is powerful; the voice of Yahuah (LORD) is full of majesty* (Psalm 29:4). When Elihu says *he thundereth with the voice of his excellency* (Job 37:4), he sings the same note as Psalm 29 — the divine voice is power and majesty itself, the prelude to the whirlwind out of which Yahuah will answer.'),
    ('canon','job',37,4,'canon','psalms',18,13,'free',
     E'*Yahuah (LORD) also thundered in the heavens, and the Highest gave his voice; hail stones and coals of fire* (Psalm 18:13). David''s theophany matches Elihu''s — *After it a voice roareth: he thundereth with the voice of his excellency* (Job 37:4). The Highest (the Most High Father) gives his voice in the storm; the visible majesty that thunders is the Formed Son who bears the Name, Yahuah who has a Father.'),
    ('canon','job',37,5,'canon','revelation',10,3,'free',
     E'*And cried with a loud voice, as when a lion roareth: and when he had cried, seven thunders uttered their voices* (Revelation 10:3). Elihu''s *Elohim (God) thundereth marvellously with his voice; great things doeth he, which we cannot comprehend* (Job 37:5) reaches forward to the mighty messenger clothed with a cloud whose cry looses the seven thunders — the same uncomprehended voice of the Creator, now in the apocalyptic storm.'),
    -- Thread 2: he saith to the snow (v.6)
    ('canon','job',37,6,'canon','psalms',147,16,'free',
     E'*He giveth snow like wool: he scattereth the hoarfrost like ashes* (Psalm 147:16). Elihu''s *For he saith to the snow, Be thou on the earth* (Job 37:6) is the very wonder the Psalmist sings: the snow falls at the Creator''s bare command, His word alone setting it on the ground.'),
    ('canon','job',37,6,'canon','psalms',147,18,'free',
     E'*He sendeth out his word, and melteth them: he causeth his wind to blow, and the waters flow* (Psalm 147:18). What Elihu sees as El commanding *the small rain, and the great rain of his strength* (Job 37:6), Psalm 147 names as His word governing the snow and the thaw — the weather itself obedient to the spoken decree of Yahuah.'),
    -- Thread 3: stand still and consider the wondrous works (v.14)
    ('canon','job',37,14,'canon','psalms',46,10,'free',
     E'*Be still, and know that I am Elohim (God): I will be exalted among the heathen, I will be exalted in the earth* (Psalm 46:10). Elihu''s charge *Hearken unto this, O Job: stand still, and consider the wondrous works of Elohim (God)* (Job 37:14) is the same posture — cease striving, be still, and let the Creator''s majesty be known and exalted.'),
    ('canon','job',37,14,'canon','exodus',14,13,'free',
     E'*And Moses said unto the people, Fear ye not, stand still, and see the salvation of Yahuah (LORD)* (Exodus 14:13). The very phrase Elihu uses — *stand still, and consider the wondrous works of Elohim (God)* (Job 37:14) — is Moses'' word at the sea: the posture of awe is to halt and behold what Yahuah does, whether in the parted waters or in the gathering storm.'),
    ('canon','job',37,14,'canon','psalms',111,2,'free',
     E'*The works of Yahuah (LORD) are great, sought out of all them that have pleasure therein* (Psalm 111:2). Elihu commands Job to *consider the wondrous works of Elohim (God)* (Job 37:14); the Psalmist makes that considering a delight — the great works of Yahuah searched out by all who take pleasure in Him.'),
    -- Thread 4: touching El Shaddai we cannot find him out (vv.22-23)
    ('canon','job',37,23,'canon','isaiah',40,28,'free',
     E'*Hast thou not known? hast thou not heard, that El Olam (the everlasting God), Yahuah (LORD), the Creator of the ends of the earth, fainteth not, neither is weary? there is no searching of his understanding* (Isaiah 40:28). Elihu''s *Touching the Almighty, we cannot find him out: he is excellent in power, and in judgment, and in plenty of justice* (Job 37:23) is Isaiah''s confession exactly — the Most High Creator whose understanding is past all searching.'),
    ('canon','job',37,23,'canon','job',36,26,'free',
     E'*Behold, Elohim (God) is great, and we know him not, neither can the number of his years be searched out* (Job 36:26). Elihu had already said it the chapter before; now he seals it: *Touching the Almighty, we cannot find him out* (Job 37:23). The Creator''s greatness outruns the creature''s reckoning — He is known truly only as He reveals Himself.'),
    ('canon','job',37,23,'canon','1-timothy',6,16,'free',
     E'*Who only hath immortality, dwelling in the light which no man can approach unto; whom no man hath seen, nor can see: to whom be honour and power everlasting* (1 Timothy 6:16). Elihu''s *with Elohim (God) is terrible majesty. Touching the Almighty, we cannot find him out* (Job 37:22-23) reaches forward to Paul''s doxology of the formless Father in unapproachable light — the Most High whom no man finds out, made known only through the Formed Son who appeared.'),
    -- Thread 5: men do therefore fear him (v.24)
    ('canon','job',37,24,'canon','proverbs',3,7,'free',
     E'*Be not wise in thine own eyes: fear Yahuah (LORD), and depart from evil* (Proverbs 3:7). Elihu''s closing word — *Men do therefore fear him: he respecteth not any that are wise of heart* (Job 37:24) — is Proverbs'' wisdom in a sentence: the One of terrible majesty regards not the self-wise, and the only fitting posture is the fear of Yahuah.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job37_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job37_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== C. threads =====
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-37-the-voice-of-el-in-the-thunder',
       E'The Voice of El in the Thunder',
       E'Elihu''s heart breaks open at the rising storm: *At this also my heart trembleth, and is moved out of his place. Hear attentively the noise of his voice, and the sound that goeth out of his mouth* (Job 37:1-2). The thunder is not weather only — it is the audible majesty of the Creator: *Elohim (God) thundereth marvellously with his voice; great things doeth he, which we cannot comprehend* (Job 37:5). The Psalmist sang the same theophany: *The voice of Yahuah (LORD) is upon the waters: the Elohim (God) of glory thundereth* (Psalm 29:3), *the voice of Yahuah (LORD) is powerful; the voice of Yahuah (LORD) is full of majesty* (Psalm 29:4); and David: *Yahuah (LORD) also thundered in the heavens, and the Highest gave his voice* (Psalm 18:13) — the Highest, the Most High Father, giving His voice through the One who bears the Name in the storm. The same uncomprehended voice loosens the apocalyptic thunders: *and when he had cried, seven thunders uttered their voices* (Revelation 10:3). This is the prelude to the whirlwind of chapter 38, out of which Yahuah Himself will answer Job.',
       sv.verse_id, ev.verse_id, 'free', 33700
  FROM _s318_job37_lookup sv, _s318_job37_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=37 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=37 AND ev.verse_number=5
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-37-he-saith-to-the-snow-be-thou-on-the-earth',
       E'He Saith to the Snow, Be Thou on the Earth',
       E'The Creator governs the weather by bare command: *For he saith to the snow, Be thou on the earth; likewise to the small rain, and to the great rain of his strength* (Job 37:6). No mechanism stands between His word and the falling snow — He speaks and it is. The Psalmist sings the identical wonder: *He giveth snow like wool: he scattereth the hoarfrost like ashes* (Psalm 147:16), and the thaw is no less His word — *He sendeth out his word, and melteth them: he causeth his wind to blow, and the waters flow* (Psalm 147:18). Snow, rain, frost, and the warming wind are all the obedient servants of the spoken decree of Yahuah, the same word that *runneth very swiftly* (Psalm 147:15) over the earth.',
       sv.verse_id, ev.verse_id, 'free', 33701
  FROM _s318_job37_lookup sv, _s318_job37_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=37 AND sv.verse_number=6
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=37 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-37-stand-still-and-consider-the-wondrous-works',
       E'Stand Still, and Consider the Wondrous Works of El',
       E'At the heart of Elihu''s storm-speech is a command of posture: *Hearken unto this, O Job: stand still, and consider the wondrous works of Elohim (God)* (Job 37:14). Before the Creator''s majesty the creature is to stop striving and behold. It is the very posture Moses pressed on a terrified people at the sea: *Fear ye not, stand still, and see the salvation of Yahuah (LORD)* (Exodus 14:13). It is the Psalmist''s summons in the shaking of nations: *Be still, and know that I am Elohim (God): I will be exalted among the heathen, I will be exalted in the earth* (Psalm 46:10). And it is the delight of the upright, who turn that beholding into worship: *The works of Yahuah (LORD) are great, sought out of all them that have pleasure therein* (Psalm 111:2). To consider the balancings of the clouds and the spread-out sky is to be silenced into awe before the One who is *perfect in knowledge* (Job 37:16).',
       sv.verse_id, ev.verse_id, 'free', 33702
  FROM _s318_job37_lookup sv, _s318_job37_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=37 AND sv.verse_number=14
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=37 AND ev.verse_number=14
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-37-touching-el-shaddai-we-cannot-find-him-out',
       E'Touching El Shaddai, We Cannot Find Him Out',
       E'Elihu''s speech climbs to the unsearchable majesty of the Most High: *Fair weather cometh out of the north: with Elohim (God) is terrible majesty. Touching the Almighty, we cannot find him out: he is excellent in power, and in judgment, and in plenty of justice: he will not afflict* (Job 37:22-23). He had already confessed it: *Behold, Elohim (God) is great, and we know him not, neither can the number of his years be searched out* (Job 36:26). Isaiah sings the same Creator: *Yahuah (LORD), the Creator of the ends of the earth, fainteth not, neither is weary? there is no searching of his understanding* (Isaiah 40:28). And Paul seals the doxology of the formless Father: *Who only hath immortality, dwelling in the light which no man can approach unto; whom no man hath seen, nor can see* (1 Timothy 6:16). The Most High is not found out by the creature''s searching; He is known only as He reveals Himself — and He has done so through the Formed Son who appeared, spoke, and led His people, Yahuah who has a Father.',
       sv.verse_id, ev.verse_id, 'free', 33703
  FROM _s318_job37_lookup sv, _s318_job37_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=37 AND sv.verse_number=22
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=37 AND ev.verse_number=23
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-37-men-do-therefore-fear-him',
       E'Men Do Therefore Fear Him',
       E'Elihu lands his storm-speech on the only fitting response to terrible majesty: *Men do therefore fear him: he respecteth not any that are wise of heart* (Job 37:24). The One who cannot be found out regards not the self-wise; before Him the wisdom of the proud is nothing. Proverbs distils the same instruction: *Be not wise in thine own eyes: fear Yahuah (LORD), and depart from evil* (Proverbs 3:7). The whole chapter has been a schooling in this fear — to stand still, to consider, to confess we cannot comprehend — and it issues in the trembling reverence that is *the beginning of wisdom*, the posture in which Job will finally meet his Maker out of the whirlwind.',
       sv.verse_id, ev.verse_id, 'free', 33704
  FROM _s318_job37_lookup sv, _s318_job37_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=37 AND sv.verse_number=24
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=37 AND ev.verse_number=24
ON CONFLICT (slug) DO NOTHING;

