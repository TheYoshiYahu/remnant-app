-- ----- fragment: minion_job_17.sql (Job 17) -----
-- Job chapter 17 — the righteous sufferer's despair deepens toward the grave
-- tag: job17 ; session prefix: s318 ; temp view: _s318_job17_lookup
-- slug prefix: job-17-... ; sort_order band start: 33200 (+1 per thread)
-- Source: canon / job / chapter 17. GUARD: this is the righteous sufferer in the depths,
--   NOT sin to be rebuked; 17:9's "righteous shall hold on his way" is genuine
--   perseverance-of-the-righteous the NT roots forward.
--
-- Job 17 coverage:
--   v.1   ("My breath is corrupt, my days are extinct, the graves are ready for me")
--         carried into the hope-in-the-grave thread (v.13-16); see thread 3.
--         NT: 1 Cor 15:54-55 (used in thread 3)
--         Extras: none warranted
--         Tanakh: Job 19:25-27 / Ps 16:9-10 / Dan 12:2 (used in thread 3)
--   v.6   ("He hath made me also a byword of the people; and aforetime I was as a tabret")
--         NT: none warranted (suffering-servant reproach carried by the Psalms here)
--         Extras: none warranted
--         Tanakh: Ps 44:14 (byword among the heathen), Ps 69:11-12 (proverb / song of
--                 the drunkards) — THREAD 1
--   v.7   (eye dim by sorrow, members as a shadow) — folded into v.6 reproach picture; no
--         separate thread warranted.
--   v.8   (upright astonied) — runs straight into v.9; covered by thread 2 header.
--   v.9   ("The righteous also shall hold on his way, and he that hath clean hands shall
--         be stronger and stronger") — the flash of perseverance amid despair.
--         NT: Gal 6:9 (faint not), Heb 10:36-39 (patience / the just live by faith / draw
--             not back) — THREAD 2
--         Extras: none warranted
--         Tanakh: Ps 24:4 (clean hands and a pure heart), Prov 4:18 (path of the just
--                 shineth more and more) — THREAD 2
--   v.10-12 (return / days past / night into day) — Job's turn back to the friends; no
--         independent framework thread; left unthreaded.
--   v.13-16 ("the grave is mine house... where is now my hope?... down to the bars of the
--         pit") — the hope that seems to descend to Sheol, answered only by resurrection.
--         NT: 1 Cor 15:54-55 (Death is swallowed up in victory; O grave, where is thy
--             victory) — THREAD 3
--         Extras: none warranted (Dan 12 canon resurrection witness preferred)
--         Tanakh: Job 19:25-27 (my redeemer liveth, lateral within Job), Ps 16:9-10
--                 (flesh rest in hope, not left in hell), Dan 12:2 (sleep in dust awake)
--                 — THREAD 3
--
-- THREADS (all members canon → every thread tier_required='free'):
--   1. job-17-made-a-byword-of-the-people-the-righteous-made-a-reproach (sort 33200)
--        targets: Tanakh (Ps 44:14, Ps 69:11, Ps 69:12)
--   2. job-17-the-righteous-shall-hold-on-his-way-clean-hands-stronger (sort 33201)
--        targets: Tanakh (Ps 24:4, Prov 4:18) + NT (Gal 6:9, Heb 10:36, Heb 10:38, Heb 10:39)
--   3. job-17-where-is-now-my-hope-the-grave-mine-house-answered-by-resurrection (sort 33202)
--        targets: Tanakh (Job 19:25, Job 19:26, Ps 16:9, Ps 16:10, Dan 12:2) + NT (1 Cor 15:54, 1 Cor 15:55)

-- A. Temp view
CREATE TEMP VIEW _s318_job17_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- B. cross_references
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: made a byword (17:6)
    ('canon','job',17,6,'canon','psalms',44,14,'free',
     E'*Thou makest us a byword among the heathen, a shaking of the head among the people.* (Psalm 44:14) Job''s lament that *He hath made me also a byword of the people* (Job 17:6) is the same wound the covenant people sing in Psalm 44 — the righteous, not the wicked, made a scorn. The friends read his ruin as guilt; the Psalm refuses that reading, protesting *yet have we not forgotten thee, neither have we dealt falsely in thy covenant* (Psalm 44:17). Suffering is not proof of sin.'),
    ('canon','job',17,6,'canon','psalms',69,11,'free',
     E'*I made sackcloth also my garment; and I became a proverb to them.* (Psalm 69:11) Job, *as a tabret* once but now *a byword of the people* (Job 17:6), is the figure the suffering psalmist of Psalm 69 fills out — the innocent man turned into a proverb, mocked for his very piety, *the reproaches of them that reproached thee are fallen upon me* (Psalm 69:9). This is the reproach later borne to the cross.'),
    ('canon','job',17,6,'canon','psalms',69,12,'free',
     E'*They that sit in the gate speak against me; and I was the song of the drunkards.* (Psalm 69:12) Job''s *byword of the people* (Job 17:6) becomes the drunkards'' song in Psalm 69 — the righteous sufferer made public entertainment, jeered at the gate. The pattern is constant across the canon: the upright are astonied (Job 17:8) and the scoffers make sport, yet the hope holds.'),

    -- THREAD 2: the righteous shall hold on his way (17:9)
    ('canon','job',17,9,'canon','psalms',24,4,'free',
     E'*He that hath clean hands, and a pure heart; who hath not lifted up his soul unto vanity, nor sworn deceitfully.* (Psalm 24:4) Job''s *he that hath clean hands shall be stronger and stronger* (Job 17:9) is the very man Psalm 24 says shall *ascend into the hill of Yahuah (LORD)* and *stand in his holy place* (Psalm 24:3). Clean hands are not sinless perfection but covenant faithfulness — the perseverance that, even in the ash heap, does not let go.'),
    ('canon','job',17,9,'canon','proverbs',4,18,'free',
     E'*But the path of the just is as the shining light, that shineth more and more unto the perfect day.* (Proverbs 4:18) Job''s *The righteous also shall hold on his way, and he that hath clean hands shall be stronger and stronger* (Job 17:9) is the same ascending line — not weaker and dimmer as the wicked expect of a broken man, but *stronger and stronger*, the just man''s path brightening toward the perfect day even from the depths.'),
    ('canon','job',17,9,'canon','galatians',6,9,'free',
     E'*And let us not be weary in well doing: for in due season we shall reap, if we faint not.* (Galatians 6:9) The perseverance Job sees in his despair — *the righteous also shall hold on his way* (Job 17:9) — is the very endurance the assembly is charged to keep: do not faint, the harvest comes in its season. Job holds on his way without yet seeing the harvest; the promise stands behind him.'),
    ('canon','job',17,9,'canon','hebrews',10,36,'free',
     E'*For ye have need of patience, that, after ye have done the will of Elohim (God), ye might receive the promise.* (Hebrews 10:36) Job''s clinging — *the righteous also shall hold on his way* (Job 17:9) — is the patience Hebrews names as the marrow of faith: the will of Elohim done, then the promise received, with a long dark waiting between. Job is the proving-ground of this very endurance.'),
    ('canon','job',17,9,'canon','hebrews',10,38,'free',
     E'*Now the just shall live by faith: but if any man draw back, my soul shall have no pleasure in him.* (Hebrews 10:38) Job, *stronger and stronger* (Job 17:9) precisely when every comfort is stripped, is the just man living by faith and refusing to draw back. The friends counsel him to confess a sin he did not commit; he holds his integrity and his way, and Elohim takes pleasure in him (Job 42:7-8).'),
    ('canon','job',17,9,'canon','hebrews',10,39,'free',
     E'*But we are not of them who draw back unto perdition; but of them that believe to the saving of the soul.* (Hebrews 10:39) The contrast Hebrews draws — drawing back versus believing to the saving of the soul — is exactly Job''s *the righteous also shall hold on his way* (Job 17:9). He does not draw back into the curse the friends press on him; he holds, and is saved.'),

    -- THREAD 3: where is now my hope (17:13-16) answered by resurrection
    ('canon','job',17,15,'canon','job',19,25,'free',
     E'*For I know that my redeemer liveth, and that he shall stand at the latter day upon the earth* (Job 19:25) Job''s cry *where is now my hope? as for my hope, who shall see it?* (Job 17:15) is answered two chapters later out of Job''s own mouth — the hope he could not see in the darkness is the living Redeemer who *shall stand at the latter day upon the earth*. The despair of chapter 17 is not the last word Job himself speaks.'),
    ('canon','job',17,16,'canon','job',19,26,'free',
     E'*And though after my skin worms destroy this body, yet in my flesh shall I see Elohim (God)* (Job 19:26) Job has said to the worm, *Thou art my mother, and my sister* (Job 17:14), and watched his hope *go down to the bars of the pit* (Job 17:16) — yet here he answers that the worm''s destruction is not the end: *in my flesh shall I see Elohim*. The grave-bound hope of chapter 17 reaches its floor and turns into resurrection.'),
    ('canon','job',17,16,'canon','psalms',16,9,'free',
     E'*Therefore my heart is glad, and my glory rejoiceth: my flesh also shall rest in hope.* (Psalm 16:9) Job lays his bed in darkness and asks *where is now my hope?* (Job 17:15); Psalm 16 names where the hope rests — *my flesh also shall rest in hope*. The same flesh Job gives to corruption is the flesh that rests, not perishes, awaiting the morning.'),
    ('canon','job',17,16,'canon','psalms',16,10,'free',
     E'*For thou wilt not leave my soul in hell; neither wilt thou suffer thine Holy One to see corruption.* (Psalm 16:10) Job''s hope seems to *go down to the bars of the pit* (Job 17:16); Psalm 16 promises the soul is not left there. Fulfilled first in the Formed Son who saw no corruption, it is the ground of every righteous sufferer''s hope that Sheol does not keep him.'),
    ('canon','job',17,16,'canon','daniel',12,2,'free',
     E'*And many of them that sleep in the dust of the earth shall awake, some to everlasting life, and some to shame and everlasting contempt.* (Daniel 12:2) Job''s rest *together... in the dust* (Job 17:16) is not annihilation: Daniel declares the dust-sleepers shall awake. The grave that Job calls his house becomes, in the latter day, the place from which the righteous rise to everlasting life.'),
    ('canon','job',17,16,'canon','1-corinthians',15,54,'free',
     E'*So when this corruptible shall have put on incorruption, and this mortal shall have put on immortality, then shall be brought to pass the saying that is written, Death is swallowed up in victory.* (1 Corinthians 15:54) Job said to corruption, *Thou art my father* (Job 17:14), and saw his hope sink to the pit (Job 17:16); the resurrection swallows that corruption up in victory. The bed in the darkness is unmade.'),
    ('canon','job',17,16,'canon','1-corinthians',15,55,'free',
     E'*O death, where is thy sting? O grave, where is thy victory?* (1 Corinthians 15:55) Job asked *where is now my hope?* (Job 17:15) from inside the grave; the risen man turns the question back on the grave itself — *O grave, where is thy victory?* The pit that seemed to swallow Job''s hope is the very thing emptied of its claim.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job17_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job17_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- C. threads

-- THREAD 1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-17-made-a-byword-of-the-people-the-righteous-made-a-reproach',
       E'Made a byword of the people — the righteous made a reproach',
       E'Job''s shame is the shame of the upright, not the wicked: *He hath made me also a byword of the people; and aforetime I was as a tabret* (Job 17:6) — once a man of music and standing, now a thing pointed at. The friends read his ruin as the wage of secret sin; the canon refuses that reading. The covenant people sing the same wound in **Psalm 44**, *Thou makest us a byword among the heathen, a shaking of the head among the people* (Psalm 44:14), and protest in the same breath that they have *not forgotten thee, neither have we dealt falsely in thy covenant* (Psalm 44:17) — reproach without guilt. **Psalm 69** fills the figure out: *I made sackcloth also my garment; and I became a proverb to them* (Psalm 69:11), *They that sit in the gate speak against me; and I was the song of the drunkards* (Psalm 69:12) — the innocent man turned into entertainment, mocked for his very piety. This is the suffering-servant reproach the whole canon carries forward: *the reproaches of them that reproached thee are fallen upon me* (Psalm 69:9). To be made a byword is not the verdict of guilt the comforters suppose; it is the mark, again and again, of the righteous in a scoffing world.',
       sv.verse_id, ev.verse_id, 'free', 33200
  FROM _s318_job17_lookup sv, _s318_job17_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=17 AND sv.verse_number=6
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=17 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-17-the-righteous-shall-hold-on-his-way-clean-hands-stronger',
       E'The righteous shall hold on his way — clean hands, stronger and stronger',
       E'In the middle of his despair Job throws out a flash of light that the rest of the canon catches and carries: *The righteous also shall hold on his way, and he that hath clean hands shall be stronger and stronger* (Job 17:9). The wicked expect a broken man to dim and fail; Job declares the opposite — the just man grows *stronger and stronger* under the very pressure meant to undo him. **Psalm 24** names this man as the one fit to ascend Yahuah''s (the LORD''s) hill: *He that hath clean hands, and a pure heart... He shall receive the blessing from Yahuah (LORD)* (Psalm 24:4-5). **Proverbs** draws the rising line: *the path of the just is as the shining light, that shineth more and more unto the perfect day* (Proverbs 4:18) — brighter, not dimmer, toward the end. The Renewed-Covenant writings root this same perseverance forward without ever making it a new law: *let us not be weary in well doing: for in due season we shall reap, if we faint not* (Galatians 6:9); *ye have need of patience, that, after ye have done the will of Elohim (God), ye might receive the promise* (Hebrews 10:36); *Now the just shall live by faith: but if any man draw back, my soul shall have no pleasure in him* (Hebrews 10:38); *we are not of them who draw back unto perdition; but of them that believe to the saving of the soul* (Hebrews 10:39). Job is the proving-ground of this endurance — counseled to confess a sin he never committed, he holds his integrity and his way, draws not back, and Elohim takes pleasure in him (Job 42:7-8). Clean hands here are covenant faithfulness held through the dark, not flawless perfection; the genuine perseverance of the righteous, rooted in the Tanakh, confirmed forward.',
       sv.verse_id, ev.verse_id, 'free', 33201
  FROM _s318_job17_lookup sv, _s318_job17_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=17 AND sv.verse_number=9
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=17 AND ev.verse_number=9
ON CONFLICT (slug) DO NOTHING;

-- THREAD 3
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-17-where-is-now-my-hope-the-grave-mine-house-answered-by-resurrection',
       E'Where is now my hope? — the grave mine house, answered only by resurrection',
       E'Job''s despair reaches its floor: *If I wait, the grave is mine house: I have made my bed in the darkness. I have said to corruption, Thou art my father: to the worm, Thou art my mother, and my sister. And where is now my hope? as for my hope, who shall see it? They shall go down to the bars of the pit, when our rest together is in the dust* (Job 17:13-16). The hope seems to descend with him into Sheol — and there is no answer in chapter 17 itself. But the canon does not leave the question hanging. Job himself answers it two chapters later: *For I know that my redeemer liveth, and that he shall stand at the latter day upon the earth: and though after my skin worms destroy this body, yet in my flesh shall I see Elohim (God)* (Job 19:25-26) — the worm that he called mother and sister does not get the last word. **Psalm 16** names where the grave-bound hope rests: *my flesh also shall rest in hope* (Psalm 16:9), *For thou wilt not leave my soul in hell; neither wilt thou suffer thine Holy One to see corruption* (Psalm 16:10) — fulfilled first in the Formed Son who saw no corruption, and so the ground of every righteous sufferer''s hope. **Daniel** declares the dust-sleepers Job lies down among shall not stay asleep: *many of them that sleep in the dust of the earth shall awake, some to everlasting life* (Daniel 12:2). And the resurrection swallows the pit''s claim outright: *Death is swallowed up in victory. O death, where is thy sting? O grave, where is thy victory?* (1 Corinthians 15:54-55). Job asked *where is now my hope?* from inside the grave; the risen man turns the very question back on the grave. The bed in the darkness is unmade.',
       sv.verse_id, ev.verse_id, 'free', 33202
  FROM _s318_job17_lookup sv, _s318_job17_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=17 AND sv.verse_number=13
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=17 AND ev.verse_number=16
ON CONFLICT (slug) DO NOTHING;

