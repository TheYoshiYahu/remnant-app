INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'*we have made lies our refuge, and under falsehood have we hid ourselves* (Isaiah 28:15) — the false security Bildad calls the spider''s web and the house that will not stand (Job 8:14-15).'
  FROM cross_reference_threads t
  JOIN _s318_job08_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=8 AND sv.verse_number=15
  JOIN _s318_job08_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='isaiah' AND tv.chapter_number=28 AND tv.verse_number=15
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-8-the-hypocrites-hope-and-the-spiders-web'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 4, E'*the hail shall sweep away the refuge of lies, and the waters shall overflow the hiding place* (Isaiah 28:17) — the leaned-on house meets the plummet; the web is no shelter when Yahuah lays the line.'
  FROM cross_reference_threads t
  JOIN _s318_job08_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=8 AND sv.verse_number=15
  JOIN _s318_job08_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='isaiah' AND tv.chapter_number=28 AND tv.verse_number=17
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-8-the-hypocrites-hope-and-the-spiders-web'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 5, E'*built his house upon the sand... it fell: and great was the fall of it* (Matthew 7:26-27) — Yahusha (Jesus) carries the figure forward; the spider''s web and the sand house are one collapsing trust.'
  FROM cross_reference_threads t
  JOIN _s318_job08_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=8 AND sv.verse_number=15
  JOIN _s318_job08_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='matthew' AND tv.chapter_number=7 AND tv.verse_number=26
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-8-the-hypocrites-hope-and-the-spiders-web'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 3
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*Miss not the discourse of the elders: for they also learned of their fathers* (Sirach 8:9) — the wisdom tradition honors the handed-down counsel Bildad appeals to in *the search of their fathers* (Job 8:8); yet Job shows the fathers'' formula does not fit every righteous sufferer.'
  FROM cross_reference_threads t
  JOIN _s318_job08_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=8 AND sv.verse_number=8
  JOIN _s318_job08_lookup tv ON tv.edition_slug='apocrypha' AND tv.book_slug='ecclesiasticus' AND tv.chapter_number=8 AND tv.verse_number=9
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-8-enquire-of-the-former-age-the-tradition-of-the-fathers'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_9.sql (Job 9) -----
-- Book: Job  Chapter: 9  (Job's reply — the cry for a daysman/mediator)
-- Tag: job09   Session prefix: s318   View: _s318_job09_lookup
-- Sort band: 33000+ (one per thread)
-- Source edition: canon, book_slug=job, chapter 9
--
-- Job 9 coverage:
--   v.2  (how should man be just with El) NT:     Romans 3:20 (by the law is the knowledge of sin — flesh-merit excluded)
--                                          Extras: none warranted (Tanakh/NT carry it)
--                                          Tanakh: Job 4:17, Job 25:4, Psalm 143:2
--   v.5-10 (Creator doxology — Arcturus/Orion/Pleiades) NT: none warranted (the doxology stays in the Tanakh/extras frame)
--                                          Extras: Ecclesiasticus 18:4-6 (who shall find out his noble acts)
--                                          Tanakh: Job 38:31, Isaiah 40:26, Amos 5:8
--   v.10 (great things past finding out)   NT:     none warranted
--                                          Extras: Ecclesiasticus 18:4-6
--                                          Tanakh: Isaiah 40:28 (no searching of his understanding)
--   v.32 (he is not a man, as I am)        NT:     1 Timothy 2:5 (the man HaMashiach — the Formed who took flesh)
--                                          Extras: none warranted
--                                          Tanakh: (carried into the daysman thread)
--   v.33 (KEYSTONE — the daysman betwixt us) NT:   1 Timothy 2:5, Hebrews 8:6, Hebrews 9:15
--                                          Extras: none warranted (NT answer is decisive)
--                                          Tanakh: Job 33:23-24 (the messenger/ransom — Elihu's answer)
--
-- Threads (5):
--   1. job-9-how-should-man-be-just-with-el          [free]   Tanakh Job4:17/Job25:4/Ps143:2 + NT Rom3:20
--   2. job-9-which-maketh-arcturus-orion-and-pleiades [free]  Tanakh Job38:31/Isa40:26/Amos5:8
--   3. job-9-great-things-past-finding-out           [extras] Extras Ecclus18:4-6 + Tanakh Isa40:28
--   4. job-9-he-is-not-a-man-as-i-am                 [free]   NT 1Tim2:5
--   5. job-9-neither-is-there-any-daysman-betwixt-us [free]   Tanakh Job33:23-24 + NT 1Tim2:5/Heb8:6/Heb9:15  (KEYSTONE)
--
-- Framework notes:
--   * 9:2 framed as creaturely humility / anti-flesh-merit (Rom 3:20 = "by the law is the
--     knowledge of sin"), NOT antinomian — the Torah is not abolished; flesh-credential before
--     the Creator is excluded.
--   * 9:33 daysman = the great Messianic longing answered in the Formed Son, the ONE mediator
--     who is Yahuah-of-the-Name AND the man (1 Tim 2:5), who lays his hand on both because he is
--     the Formed who took flesh and HAS a Father — never a co-equal third party / trinity.

CREATE TEMP VIEW _s318_job09_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: how should man be just with El (9:2)
    ('canon','job',9,2,'canon','job',4,17,'free',
     E'*Shall mortal man be more just than Elohim (God)? shall a man be more pure than his maker?* (Job 4:17). The spirit-voice that came to Eliphaz frames the very question Job now seizes — *how should man be just with Elohim (God)?* (Job 9:2) — the creature before the Creator, no flesh-credential standing.'),
    ('canon','job',9,2,'canon','job',25,4,'free',
     E'*How then can man be justified with Elohim (God)? or how can he be clean that is born of a woman?* (Job 25:4). Bildad later echoes Job''s own cry, *how should man be just with Elohim (God)?* (Job 9:2) — three times the book presses the question that the whole Tanakh answers, that no man stands before the Most High on the merit of his own flesh.'),
    ('canon','job',9,2,'canon','psalms',143,2,'free',
     E'*And enter not into judgment with thy servant: for in thy sight shall no man living be justified* (Psalm 143:2). David sings what Job laments — *how should man be just with Elohim (God)?* (Job 9:2). The plea is not against the Torah but the confession that flesh cannot be vindicated by entering judgment with its Maker; mercy, not merit, is the ground.'),
    ('canon','job',9,2,'canon','romans',3,20,'free',
     E'*Therefore by the deeds of the law there shall no flesh be justified in his sight: for by the law is the knowledge of sin* (Romans 3:20). Job''s ancient question — *how should man be just with Elohim (God)?* (Job 9:2) — is Paul''s premise: no flesh is justified by flesh-merit. This excludes the boast of the creature, NOT the Torah, which establishes itself as the knowledge of sin (Romans 3:31).'),

    -- Thread 2: which maketh Arcturus, Orion, and Pleiades (9:5-10) — Creator doxology
    ('canon','job',9,9,'canon','job',38,31,'free',
     E'*Canst thou bind the sweet influences of Pleiades, or loose the bands of Orion?* (Job 38:31). Job confesses the One *which maketh Arcturus, Orion, and Pleiades, and the chambers of the south* (Job 9:9); out of the whirlwind Yahuah (LORD) turns Job''s own doxology back on him — the constellations Job named in awe are the Maker''s to bind and loose.'),
    ('canon','job',9,9,'canon','isaiah',40,26,'free',
     E'*Lift up your eyes on high, and behold who hath created these things, that bringeth out their host by number: he calleth them all by names by the greatness of his might, for that he is strong in power; not one faileth* (Isaiah 40:26). The Creator *which maketh Arcturus, Orion, and Pleiades* (Job 9:9) numbers and names the stars; the same majesty that humbles Job comforts scattered Yashar''el (Israel) — the One who keeps the host keeps his people.'),
    ('canon','job',9,9,'canon','amos',5,8,'free',
     E'*Seek him that maketh the seven stars and Orion, and turneth the shadow of death into the morning, and maketh the day dark with night: that calleth for the waters of the sea, and poureth them out upon the face of the earth: Yahuah (LORD) is his name* (Amos 5:8). Amos sets the same star-doxology Job sang — *which maketh Arcturus, Orion, and Pleiades* (Job 9:9) — as the summons: seek the Maker, and his name is Yahuah (LORD).'),

    -- Thread 3: great things past finding out (9:10) — unsearchable majesty [extras]
    ('canon','job',9,10,'apocrypha','ecclesiasticus',18,4,'extras',
     E'*To whom has he given power to declare his works? and who shall find out his noble acts?* (Ecclesiasticus 18:4). Ben Sira voices Job''s wonder — the One *which doeth great things past finding out; yea, and wonders without number* (Job 9:10) — the works of the Maker are beyond the reach of the creature to declare.'),
    ('canon','job',9,10,'apocrypha','ecclesiasticus',18,6,'extras',
     E'*As for the wondrous works of Yahuah (God), there may nothing be taken from them, neither may any thing be put to them, neither can the ground of them be found out* (Ecclesiasticus 18:6). The ground of the Maker''s works cannot be found out — exactly Job''s *great things past finding out* (Job 9:10) — the same posture the Torah commands toward the perfect work of Yahuah (LORD).'),
    ('canon','job',9,10,'canon','isaiah',40,28,'free',
     E'*Hast thou not known? hast thou not heard, that El Olam (the everlasting God), Yahuah (LORD), the Creator of the ends of the earth, fainteth not, neither is weary? there is no searching of his understanding* (Isaiah 40:28). Isaiah seals Job''s confession — *great things past finding out* (Job 9:10) — *there is no searching of his understanding*; the unsearchable Creator is the everlasting El Olam.'),

    -- Thread 4: he is not a man, as I am (9:32) — answered in the Formed who took flesh
    ('canon','job',9,32,'canon','1-timothy',2,5,'free',
     E'*For there is one Elohim (God), and one mediator between Elohim (God) and men, the man HaMashiach Yahusha (Christ Jesus)* (1 Timothy 2:5). Job grieves that *he is not a man, as I am, that I should answer him, and we should come together in judgment* (Job 9:32) — the gulf he names is answered in the man HaMashiach Yahusha, the Formed Son who took flesh and so can come together with man in judgment; he is Yahuah (LORD) and has a Father, never a co-equal third party.'),

    -- Thread 5: KEYSTONE — neither is there any daysman betwixt us (9:33)
    ('canon','job',9,33,'canon','job',33,23,'free',
     E'*If there be a messenger with him, an interpreter, one among a thousand, to shew unto man his uprightness* (Job 33:23). Job longed for a *daysman betwixt us, that might lay his hand upon us both* (Job 9:33); Elihu answers that the interpreter, one among a thousand, is the very mediator Job sought to stand between El and man.'),
    ('canon','job',9,33,'canon','job',33,24,'free',
     E'*Then he is gracious unto him, and saith, Deliver him from going down to the pit: I have found a ransom* (Job 33:24). The daysman Job cried for — *that might lay his hand upon us both* (Job 9:33) — is the one who brings the ransom; the umpire between Elohim (God) and man is the ransom-bearer, fulfilled forward in the Formed Son.'),
    ('canon','job',9,33,'canon','1-timothy',2,5,'free',
     E'*For there is one Elohim (God), and one mediator between Elohim (God) and men, the man HaMashiach Yahusha (Christ Jesus)* (1 Timothy 2:5). This is the daysman of Job 9:33 — *neither is there any daysman betwixt us, that might lay his hand upon us both* — the ONE mediator who lays his hand on both because he is Yahuah-of-the-Name AND the man, the Formed Son who took flesh and HAS a Father, never a co-equal trinity.'),
    ('canon','job',9,33,'canon','hebrews',8,6,'free',
     E'*But now hath he obtained a more excellent ministry, by how much also he is the mediator of a better covenant, which was established upon better promises* (Hebrews 8:6). The mediator of the better covenant is the daysman Job lacked — *that might lay his hand upon us both* (Job 9:33) — the covenant of the Torah written on the heart (Jeremiah 31:33), not the Torah replaced.'),
    ('canon','job',9,33,'canon','hebrews',9,15,'free',
     E'*And for this cause he is the mediator of the new testament, that by means of death, for the redemption of the transgressions that were under the first testament, they which are called might receive the promise of eternal inheritance* (Hebrews 9:15). The daysman who lays his hand on both — *neither is there any daysman betwixt us* (Job 9:33) — is the mediator whose death redeems and brings the promised inheritance; Job''s longing finds its answer in the Formed Son.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job09_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job09_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== threads =====
-- Thread 1
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-9-how-should-man-be-just-with-el',
       E'How Should Man Be Just With El?',
       E'Job seizes the question the whole book circles: *I know it is so of a truth: but how should man be just with Elohim (God)?* (Job 9:2). It is the creature before the Creator — the spirit-voice asked it of Eliphaz, *Shall mortal man be more just than Elohim (God)? shall a man be more pure than his maker?* (Job 4:17), and Bildad presses it again, *How then can man be justified with Elohim (God)? or how can he be clean that is born of a woman?* (Job 25:4). David sings the same surrender: *enter not into judgment with thy servant: for in thy sight shall no man living be justified* (Psalm 143:2). Paul makes it his premise — *by the deeds of the law there shall no flesh be justified in his sight: for by the law is the knowledge of sin* (Romans 3:20). The boast excluded is the boast of flesh-merit, NOT the Torah; the very next breath establishes it (Romans 3:31). No man stands vindicated before the Most High on the strength of his own flesh — only mercy is ground enough.',
       sv.verse_id, ev.verse_id, 'free', 33000
  FROM _s318_job09_lookup sv, _s318_job09_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=9 AND sv.verse_number=2
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=9 AND ev.verse_number=2
ON CONFLICT (slug) DO NOTHING;

-- Thread 2
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-9-which-maketh-arcturus-orion-and-pleiades',
       E'Which Maketh Arcturus, Orion, And Pleiades',
       E'Job answers the question of his own justification with a doxology of the Creator''s cosmic majesty: the One *which removeth the mountains, and they know not* (Job 9:5), *which commandeth the sun, and it riseth not; and sealeth up the stars* (Job 9:7), *which alone spreadeth out the heavens, and treadeth upon the waves of the sea* (Job 9:8), *which maketh Arcturus, Orion, and Pleiades, and the chambers of the south* (Job 9:9). Out of the whirlwind Yahuah (LORD) turns Job''s own words back on him: *Canst thou bind the sweet influences of Pleiades, or loose the bands of Orion?* (Job 38:31). Isaiah lifts the same eyes: *Lift up your eyes on high, and behold who hath created these things, that bringeth out their host by number: he calleth them all by names by the greatness of his might... not one faileth* (Isaiah 40:26). And Amos makes the star-doxology a summons: *Seek him that maketh the seven stars and Orion... Yahuah (LORD) is his name* (Amos 5:8). The Maker of the constellations is the One before whom no flesh can plead.',
       sv.verse_id, ev.verse_id, 'free', 33001
  FROM _s318_job09_lookup sv, _s318_job09_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=9 AND sv.verse_number=5
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=9 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

-- Thread 3
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-9-great-things-past-finding-out',
       E'Great Things Past Finding Out',
       E'Job closes the doxology with the confession of the unsearchable: the One *which doeth great things past finding out; yea, and wonders without number* (Job 9:10). The restored library sings the same posture — *To whom has he given power to declare his works? and who shall find out his noble acts?* (Ecclesiasticus 18:4), and *As for the wondrous works of Yahuah (God), there may nothing be taken from them, neither may any thing be put to them, neither can the ground of them be found out* (Ecclesiasticus 18:6). Isaiah seals it in the canon: *Hast thou not known? hast thou not heard, that El Olam (the everlasting God), Yahuah (LORD), the Creator of the ends of the earth, fainteth not, neither is weary? there is no searching of his understanding* (Isaiah 40:28). The ground of the Maker''s works cannot be found out; the creature''s only wisdom is the fear of him.',
       sv.verse_id, ev.verse_id, 'extras', 33002
  FROM _s318_job09_lookup sv, _s318_job09_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=9 AND sv.verse_number=10
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=9 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

-- Thread 4
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-9-he-is-not-a-man-as-i-am',
       E'He Is Not A Man, As I Am',
       E'Job names the gulf between the creature and the Creator: *For he is not a man, as I am, that I should answer him, and we should come together in judgment* (Job 9:32). How shall flesh stand in judgment with the Most High, who is not a man? The longing is answered forward in the One who bridged it — *there is one Elohim (God), and one mediator between Elohim (God) and men, the man HaMashiach Yahusha (Christ Jesus)* (1 Timothy 2:5). The man HaMashiach Yahusha is the Formed Son who took flesh, so that the One who *is not a man* could yet come together with man in judgment. He is Yahuah (LORD) and has a Father — the Formed drawn from the Formless, never a co-equal third party.',
       sv.verse_id, ev.verse_id, 'free', 33003
  FROM _s318_job09_lookup sv, _s318_job09_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=9 AND sv.verse_number=32
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=9 AND ev.verse_number=32
ON CONFLICT (slug) DO NOTHING;

-- Thread 5 (KEYSTONE)
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-9-neither-is-there-any-daysman-betwixt-us',
       E'Neither Is There Any Daysman Betwixt Us',
       E'This is the great Messianic longing of the book — the cry for an umpire to stand between El and man: *Neither is there any daysman betwixt us, that might lay his hand upon us both* (Job 9:33). Job has no mediator who can touch both the Maker and the made. Elihu answers from within the Tanakh: *If there be a messenger with him, an interpreter, one among a thousand, to shew unto man his uprightness* (Job 33:23), *Then he is gracious unto him, and saith, Deliver him from going down to the pit: I have found a ransom* (Job 33:24) — the interpreter, one among a thousand, who brings the ransom. The longing is consummated in the Formed Son: *there is one Elohim (God), and one mediator between Elohim (God) and men, the man HaMashiach Yahusha (Christ Jesus)* (1 Timothy 2:5). He lays his hand on both because he is Yahuah-of-the-Name AND the man — the Formed who took flesh and HAS a Father, never a co-equal trinity. He is *the mediator of a better covenant, which was established upon better promises* (Hebrews 8:6) — the Torah written on the heart, not replaced — *the mediator of the new testament, that by means of death... they which are called might receive the promise of eternal inheritance* (Hebrews 9:15). The daysman Job lacked is the Son who lays his hand on both.',
       sv.verse_id, ev.verse_id, 'free', 33004
  FROM _s318_job09_lookup sv, _s318_job09_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=9 AND sv.verse_number=33
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=9 AND ev.verse_number=33
ON CONFLICT (slug) DO NOTHING;

-- ===== thread_members =====
-- Thread 1 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (4,17,1,E'*Shall mortal man be more just than Elohim (God)?* (Job 4:17) — the spirit-voice frames Job''s question.'),
    (25,4,2,E'*How then can man be justified with Elohim (God)?* (Job 25:4) — Bildad presses the same cry.'),
    (143,2,3,E'*In thy sight shall no man living be justified* (Psalm 143:2) — David''s surrender of flesh-merit.'),
    (3,20,4,E'*By the law is the knowledge of sin* (Romans 3:20) — flesh-merit excluded, the Torah established.')
  ) AS m(tgt_ch,tgt_v,sort_order,member_note)
  JOIN _s318_job09_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=9 AND sv.verse_number=2
  JOIN _s318_job09_lookup tv ON tv.edition_slug='canon'
       AND tv.book_slug = CASE m.tgt_ch WHEN 4 THEN 'job' WHEN 25 THEN 'job' WHEN 143 THEN 'psalms' WHEN 3 THEN 'romans' END
       AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
  JOIN cross_reference_threads t ON t.slug='job-9-how-should-man-be-just-with-el'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 2 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('job',38,31,1,E'*Canst thou bind the sweet influences of Pleiades, or loose the bands of Orion?* (Job 38:31) — the whirlwind turns Job''s doxology back on him.'),
    ('isaiah',40,26,2,E'*He calleth them all by names by the greatness of his might... not one faileth* (Isaiah 40:26) — the Maker numbers and names the host.'),
    ('amos',5,8,3,E'*Seek him that maketh the seven stars and Orion... Yahuah (LORD) is his name* (Amos 5:8) — the star-doxology as summons.')
  ) AS m(tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN _s318_job09_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=9 AND sv.verse_number=9
  JOIN _s318_job09_lookup tv ON tv.edition_slug='canon' AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
  JOIN cross_reference_threads t ON t.slug='job-9-which-maketh-arcturus-orion-and-pleiades'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- Thread 3 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    ('apocrypha','ecclesiasticus',18,4,1,E'*Who shall find out his noble acts?* (Ecclesiasticus 18:4) — Ben Sira voices Job''s wonder.'),
    ('apocrypha','ecclesiasticus',18,6,2,E'*Neither can the ground of them be found out* (Ecclesiasticus 18:6) — the works of the Maker beyond reach.'),
    ('canon','isaiah',40,28,3,E'*There is no searching of his understanding* (Isaiah 40:28) — Isaiah seals the unsearchable El Olam.')
