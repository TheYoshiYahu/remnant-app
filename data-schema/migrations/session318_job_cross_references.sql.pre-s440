-- ----- fragment: minion_job_6.sql (Job 6) -----
-- Book: Job   Chapter: 6   (Job answers Eliphaz)
-- Tag: job06   Temp view: _s318_job06_lookup   Session: s318
-- Sort band: 32925..32928 (+1 per thread, 4 threads)
--
-- Job 6 coverage:
--   v.2-3  (grief weighed / heavier than sand)
--          NT:     none warranted
--          Extras: none warranted
--          Tanakh: folded into the arrows/lament thread context
--   v.4    (the arrows of the Almighty are within me; terrors set in array)
--          NT:     Hebrews 12:5-7 (chastening of sons) [T1]
--          Extras: none warranted
--          Tanakh: Psalm 38:1-2 (thine arrows stick fast in me) [T1]
--   v.8-10 (Oh that Eloah would grant my request and cut me off; not concealed the words of the Holy One)
--          NT:     none warranted (folded into arrows-lament as context)
--          Extras: none warranted
--          Tanakh: Psalm 38 (companion lament) [T1 context]
--   v.11-13 (What is my strength, that I should hope? is my flesh of brass?)
--          NT:     James 5:11 (patience of Job); James 1:12 (blessed is he that endureth) [T4]
--          Extras: none warranted
--          Tanakh: none warranted
--   v.14   (to him that is afflicted pity should be shewed from his friend)
--          NT:     none warranted
--          Extras: Ecclesiasticus/Sirach 37:4 (friend against him in time of trouble) [T2]
--          Tanakh: Psalm 69:20 (looked for pity, none); Job 16:2 (miserable comforters); Proverbs 18:24 (friend that sticketh closer) [T2]
--   v.15-20 (brethren dealt deceitfully as a brook; the dried-up deceiving stream; Tema/Sheba ashamed)
--          NT:     none warranted
--          Extras: none warranted
--          Tanakh: Jeremiah 15:18 (as waters that fail) [T3]
--   v.21-23 (now ye are nothing; did I ask a reward / deliverance of you)
--          NT:     none warranted
--          Extras: none warranted
--          Tanakh: folded into false-comfort indictment [T2 anchor end]
--   v.24-30 (teach me; how forcible are right words; my righteousness is in it)
--          NT:     none warranted
--          Extras: none warranted
--          Tanakh: none warranted
--
-- Threads (slug — target libraries):
--   T1 job-6-the-arrows-of-the-almighty-are-within-me   — Tanakh (Psalm) + NT (Hebrews)            FREE
--   T2 job-6-to-him-that-is-afflicted-pity-should-be-shewed — Tanakh (Psalm/Job/Proverbs) + Extras (Sirach)  EXTRAS
--   T3 job-6-my-brethren-have-dealt-deceitfully-as-a-brook — Tanakh (Jeremiah)                       FREE
--   T4 job-6-what-is-my-strength-that-i-should-hope     — NT (James x2)                              FREE
--
-- FRAMING: Job's complaint is honest lament held inside faith (6:10 "I have not concealed the
-- words of the Holy One"), never sin. The indictment falls on the friends' pity-failure (6:14),
-- not on Job. The deceitful-brook image (6:15-20) is comfortless counsel that fails the thirsty,
-- matched to Jeremiah's "waters that fail." No verse forced; "none warranted" recorded above.

CREATE TEMP VIEW _s318_job06_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- T1: the arrows of the Almighty
    ('canon','job',6,4,'canon','psalms',38,1,'free',
     E'*O Yahuah (LORD), rebuke me not in thy wrath: neither chasten me in thy hot displeasure. For thine arrows stick fast in me, and thy hand presseth me sore* (Psalm 38:1-2). David names the same wound Job names — *the arrows of the Almighty are within me, the poison whereof drinketh up my spirit* (Job 6:4). The afflicted righteous feel the hand of Yahuah (the LORD) pressing, and pour the lament back to him, not away from him.'),
    ('canon','job',6,4,'canon','hebrews',12,5,'free',
     E'*My son, despise not thou the chastening of Yahuah (Lord), nor faint when thou art rebuked of him: For whom Yahuah (Lord) loveth he chasteneth, and scourgeth every son whom he receiveth* (Hebrews 12:5-6). Job''s *terrors of Elohim (God) do set themselves in array against me* (Job 6:4) is read forward as the chastening of a son, not the wrath of an enemy — the suffering held inside sonship.'),
    -- T2: pity should be shewed from his friend
    ('canon','job',6,14,'canon','psalms',69,20,'free',
     E'*Reproach hath broken my heart; and I am full of heaviness: and I looked for some to take pity, but there was none; and for comforters, but I found none* (Psalm 69:20). This is Job''s wound exactly — *to him that is afflicted pity should be shewed from his friend* (Job 6:14) — and the failure is theirs, not his.'),
    ('canon','job',6,14,'canon','job',16,2,'free',
     E'*I have heard many such things: miserable comforters are ye all* (Job 16:2). Job will name in chapter 16 what he begins to name here: the friends who owed him pity (Job 6:14) became the burden instead of the balm.'),
    ('canon','job',6,14,'canon','proverbs',18,24,'free',
     E'*A man that hath friends must shew himself friendly: and there is a friend that sticketh closer than a brother* (Proverbs 18:24). The wisdom standard measures the friends against the friend they failed to be — Job''s plea that *pity should be shewed from his friend* (Job 6:14) is the very friendship Proverbs commends.'),
    ('canon','job',6,14,'apocrypha','ecclesiasticus',37,4,'extras',
     E'*There is a companion, which rejoices in the prosperity of a friend, but in the time of trouble will be against him* (Ecclesiasticus 37:4). Sirach diagnoses the fair-weather friend who fails in *the day of affliction*; this is the friend Job indicts — they came to comfort and dealt deceitfully (Job 6:14-15).'),
    -- T3: deceitful as a brook
    ('canon','job',6,15,'canon','jeremiah',15,18,'free',
     E'*Why is my pain perpetual, and my wound incurable, which refuseth to be healed? wilt thou be altogether unto me as a liar, and as waters that fail?* (Jeremiah 15:18). Jeremiah uses Job''s very image — *as waters that fail* answers *my brethren have dealt deceitfully as a brook* (Job 6:15): the dried-up stream that promises and disappoints the thirsty caravan.'),
    -- T4: what is my strength, that I should hope
    ('canon','job',6,11,'canon','james',5,11,'free',
     E'*Behold, we count them happy which endure. Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11). The man who cried *what is my strength, that I should hope?* (Job 6:11) is held up as the pattern of endurance whose end Yahuah (the Lord) crowned with mercy.'),
    ('canon','job',6,11,'canon','james',1,12,'free',
     E'*Blessed is the man that endureth temptation: for when he is tried, he shall receive the crown of life, which Yahuah (Lord) hath promised to them that love him* (James 1:12). Job''s strength was spent and his hope all but gone (Job 6:11-12), yet the trial endured to its end becomes the crown of life — the suffering of the righteous held inside faith.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job06_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job06_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== threads =====
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-6-the-arrows-of-the-almighty-are-within-me',
       E'The arrows of the Almighty are within me',
       E'Job answers Eliphaz not with denial but with honest lament: *Oh that my grief were throughly weighed, and my calamity laid in the balances together! For now it would be heavier than the sand of the sea* (Job 6:2-3). The wound has a Hand behind it — *the arrows of the Almighty are within me, the poison whereof drinketh up my spirit: the terrors of Elohim (God) do set themselves in array against me* (Job 6:4). This is the cry of the afflicted righteous, and David sings the same wound: *O Yahuah (LORD), rebuke me not in thy wrath: neither chasten me in thy hot displeasure. For thine arrows stick fast in me, and thy hand presseth me sore* (Psalm 38:1-2). The lament is poured back toward Yahuah (the LORD), not away from him — even Job''s longing to be cut off keeps faith: *I have not concealed the words of the Holy One* (Job 6:10). Read forward, the arrows become the chastening of a son: *My son, despise not thou the chastening of Yahuah (Lord), nor faint when thou art rebuked of him: For whom Yahuah (Lord) loveth he chasteneth, and scourgeth every son whom he receiveth* (Hebrews 12:5-6). The terror set in array is not an enemy''s wrath but a Father''s correction, the suffering held inside sonship.',
       sv.verse_id, ev.verse_id, 'free', 32925
  FROM _s318_job06_lookup sv, _s318_job06_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=6 AND sv.verse_number=4
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=6 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-6-to-him-that-is-afflicted-pity-should-be-shewed',
       E'To him that is afflicted pity should be shewed from his friend',
       E'Here is the indictment, and it falls on the friends, not on Job: *To him that is afflicted pity should be shewed from his friend; but he forsaketh the fear of the Almighty* (Job 6:14). They came to comfort and brought no comfort — *for now ye are nothing; ye see my casting down, and are afraid* (Job 6:21). This is the wound the suffering righteous know well; the Psalmist names it word for word: *Reproach hath broken my heart; and I am full of heaviness: and I looked for some to take pity, but there was none; and for comforters, but I found none* (Psalm 69:20). Job himself will give them their name: *I have heard many such things: miserable comforters are ye all* (Job 16:2). They failed the very standard wisdom sets — *a man that hath friends must shew himself friendly: and there is a friend that sticketh closer than a brother* (Proverbs 18:24) — and Sirach has already drawn their portrait: *there is a companion, which rejoices in the prosperity of a friend, but in the time of trouble will be against him* (Ecclesiasticus 37:4). The fear of the Almighty is forsaken not by the man who laments, but by the friend who withholds pity in the day of affliction.',
       sv.verse_id, ev.verse_id, 'extras', 32926
  FROM _s318_job06_lookup sv, _s318_job06_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=6 AND sv.verse_number=14
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=6 AND ev.verse_number=21
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-6-my-brethren-have-dealt-deceitfully-as-a-brook',
       E'My brethren have dealt deceitfully as a brook',
       E'Job sharpens the failure of false comfort into a single image — the wadi that fills in the cold and vanishes in the heat: *My brethren have dealt deceitfully as a brook, and as the stream of brooks they pass away; which are blackish by reason of the ice, and wherein the snow is hid: what time they wax warm, they vanish: when it is hot, they are consumed out of their place* (Job 6:15-17). The thirsty caravan trusts the channel and is undone: *the troops of Tema looked, the companies of Sheba waited for them. They were confounded because they had hoped; they came thither, and were ashamed* (Job 6:19-20). Comfortless counsel is a stream that promises water and delivers a dry bed. Jeremiah, wounded and looking to Yahuah (the LORD), reaches for the same picture: *why is my pain perpetual, and my wound incurable, which refuseth to be healed? wilt thou be altogether unto me as a liar, and as waters that fail?* (Jeremiah 15:18). The brook that fails is the friend who fails — and the prophets keep the image to mark every comfort that cannot reach the thirsty soul.',
       sv.verse_id, ev.verse_id, 'free', 32927
  FROM _s318_job06_lookup sv, _s318_job06_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=6 AND sv.verse_number=15
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=6 AND ev.verse_number=20
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-6-what-is-my-strength-that-i-should-hope',
       E'What is my strength, that I should hope?',
       E'Job''s strength is spent to the bottom: *What is my strength, that I should hope? and what is mine end, that I should prolong my life? Is my strength the strength of stones? or is my flesh of brass?* (Job 6:11-12). He is not stone and not brass; he is a man at the end of himself — and this is exactly the man the apostle holds up as the pattern of faith that endures: *Behold, we count them happy which endure. Ye have heard of the patience of Job, and have seen the end of Yahuah (Lord); that Yahuah (Lord) is very pitiful, and of tender mercy* (James 5:11). The end Job could not see from chapter 6 is the end James names — mercy waiting past the trial. And the trial itself, endured, becomes a crown: *Blessed is the man that endureth temptation: for when he is tried, he shall receive the crown of life, which Yahuah (Lord) hath promised to them that love him* (James 1:12). The suffering of the righteous is held inside faith — strength gone, hope thin, yet the man does not let go of the Holy One, and the end is mercy.',
       sv.verse_id, ev.verse_id, 'free', 32928
  FROM _s318_job06_lookup sv, _s318_job06_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=6 AND sv.verse_number=11
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=6 AND ev.verse_number=13
ON CONFLICT (slug) DO NOTHING;

-- ===== thread_members =====
-- T1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'Psalm 38:1-2 — *thine arrows stick fast in me, and thy hand presseth me sore*: David''s lament matches Job''s *arrows of the Almighty are within me* (Job 6:4), the afflicted righteous owning the Hand behind the wound.'
  FROM cross_reference_threads t
  JOIN _s318_job06_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=6 AND sv.verse_number=4
  JOIN _s318_job06_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=38 AND tv.verse_number=1
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-6-the-arrows-of-the-almighty-are-within-me'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

