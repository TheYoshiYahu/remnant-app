-- THREAD 1 members
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (22,6,'job',31,16,1,E'*If I have withheld the poor from their desire, or have caused the eyes of the widow to fail* (Job 31:16) — Job''s oath denies the pledge-stripping Eliphaz invents at 22:6.'),
    (22,7,'job',31,17,2,E'*Or have eaten my morsel myself alone, and the fatherless hath not eaten thereof* (Job 31:17) — answers the charge that Job withheld bread (22:7).'),
    (22,7,'job',31,19,3,E'*If I have seen any perish for want of clothing, or any poor without covering* (Job 31:19) — Job clothed the perishing, the opposite of 22:7.'),
    (22,9,'job',31,21,4,E'*If I have lifted up my hand against the fatherless, when I saw my help in the gate* (Job 31:21) — mirror of the broken arms of the fatherless charged at 22:9.'),
    (22,9,'job',31,22,5,E'*Then let mine arm fall... and mine arm be broken from the bone* (Job 31:22) — Job calls the very breaking of 22:9 down on his own arm if guilty.'),
    (22,5,'job',42,7,6,E'*ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7) — Yahuah''s verdict against the slander of 22:5.')
  ) AS m(src_ch,src_v,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN _s318_job22_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=m.src_ch AND sv.verse_number=m.src_v
  JOIN _s318_job22_lookup tv ON tv.edition_slug='canon' AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
  JOIN cross_reference_threads t ON t.slug='job-22-the-invented-sins-the-slander-Yahuah-rebukes'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

