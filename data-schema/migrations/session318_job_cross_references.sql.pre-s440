INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*neither is there any daysman betwixt us* (Job 9:33) — the mediator first mourned as absent, now cried for in 16:21.'
  FROM cross_reference_threads t
  JOIN _s318_job16_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=16 AND sv.verse_number=21
  JOIN _s318_job16_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=9 AND tv.verse_number=33
