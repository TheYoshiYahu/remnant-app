-- ----- fragment: minion_job_23.sql (Job 23) -----
-- Job 23 — full-library cross-references (Tanakh foundation layer)
-- Session prefix: s318 | tag: job23 | slug prefix: job-23-... | sort band: 33350+
-- Source book_slug=job, chapter 23.
--
-- Job 23 coverage:
--   v.3-7  (longing for El''s seat / order my cause / the daysman, delivered for ever from my judge)
--          NT:     1 Timothy 2:5 (one mediator between Elohim and men, the man HaMashiach Yahusha) -> THREAD 3
--          Extras: none warranted (canon Job 9:33 + Job 19:25 carry the daysman/Redeemer weight better)
--          Tanakh: Job 9:33 (no daysman betwixt us), Job 19:25 (my redeemer liveth) -> THREAD 3
--   v.8-9  (forward/backward/left/right — he hideth himself, I cannot see him)
--          NT:     none warranted (folded into the longing-for-the-seat prose, not a distinct weave)
--          Extras: none warranted
--          Tanakh: none warranted
--   v.10   (when he hath tried me, I shall come forth as gold — the refining/testing of the righteous)
--          NT:     1 Peter 1:7 (trial of faith more precious than gold tried with fire), James 1:12 (crown of life to him that endureth) -> THREAD 1
--          Extras: Ecclesiasticus (Sirach) 2:5 (gold is tried in the fire, and acceptable men in the furnace of adversity) -> THREAD 1
--          Tanakh: Malachi 3:3 (purge them as gold and silver), Zechariah 13:9 (try them as gold is tried), Proverbs 17:3 (Yahuah trieth the hearts) -> THREAD 1
--   v.11-12 (my foot hath held his steps, his way have I kept; the words of his mouth more than my necessary food — Job''s Torah-faithfulness)
--          NT:     Matthew 4:4 (man shall not live by bread alone but by every word) -> THREAD 2
--          Extras: none warranted
--          Tanakh: Deuteronomy 8:3 (man doth not live by bread only, but by every word), Psalm 119:103 (thy words sweeter than honey), Jeremiah 15:16 (thy words were found, and I did eat them) -> THREAD 2
--   v.13-17 (he is in one mind; Elohim maketh my heart soft) — none warranted; folds into thread 1/3 frame.
--
-- THREADS (3):
--   job-23-tried-i-shall-come-forth-as-gold          [free? NO -> extras] 1Pet1:7, Mal3:3, Zech13:9, Prov17:3, Jas1:12, Sirach2:5
--   job-23-the-words-of-his-mouth-more-than-my-bread  [free]  Deut8:3, Matt4:4, Ps119:103, Jer15:16
--   job-23-oh-that-i-knew-where-i-might-find-him      [free]  Job9:33, 1Tim2:5, Job19:25
--
-- GUARD NOTES: 23:10 gold = the REFINING of the righteous sufferer (the test PURIFIES, it does not
-- prove guilt) — Job is vindicated, not condemned, by the fire. 23:11-12 = Job''s genuine
-- Torah-faithfulness (the word treasured ABOVE bread) — covenant-obedience the framework treasures;
-- Torah is never abolished. 23:3-7 daysman/seat = the longing for a Mediator answered in the Formed
-- Son (1 Tim 2:5), never a co-equal-persons grammar.

CREATE TEMP VIEW _s318_job23_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== B. cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: gold / refining (Job 23:10)
    ('canon','job',23,10,'canon','1-peter',1,7,'free',
     E'*That the trial of your faith, being much more precious than of gold that perisheth, though it be tried with fire, might be found unto praise and honour and glory at the appearing of Yahusha HaMashiach (Jesus Christ)* (1 Peter 1:7). Job''''s confession *when he hath tried me, I shall come forth as gold* (Job 23:10) is the very figure Kepha unfolds: the fire is not punishment that proves guilt but a refining that brings the righteous forth tried and precious.'),
    ('canon','job',23,10,'canon','malachi',3,3,'free',
     E'*And he shall sit as a refiner and purifier of silver: and he shall purify the sons of Levi, and purge them as gold and silver, that they may offer unto Yahuah (LORD) an offering in righteousness* (Malachi 3:3). The Formed Son who *shall come to his temple* sits as the refiner; Job''''s *I shall come forth as gold* (Job 23:10) is the same purifying fire, set on the covenant people to bring forth an offering in righteousness, not to consume.'),
    ('canon','job',23,10,'canon','zechariah',13,9,'free',
     E'*And I will bring the third part through the fire, and will refine them as silver is refined, and will try them as gold is tried: they shall call on my name, and I will hear them: I will say, It is my people* (Zechariah 13:9). The remnant tried *as gold is tried* is owned again as *my people* — Job''''s *I shall come forth as gold* (Job 23:10) is the personal anticipation of that two-house refining unto restoration.'),
    ('canon','job',23,10,'canon','proverbs',17,3,'free',
     E'*The fining pot is for silver, and the furnace for gold: but Yahuah (LORD) trieth the hearts* (Proverbs 17:3). The proverb names the assayer of Job''''s ordeal: the furnace is for gold, but it is Yahuah who *trieth the hearts*. Job''''s *when he hath tried me, I shall come forth as gold* (Job 23:10) submits the heart to that trial and trusts the verdict.'),
    ('canon','job',23,10,'canon','james',1,12,'free',
     E'*Blessed is the man that endureth temptation: for when he is tried, he shall receive the crown of life, which Yahuah (Lord) hath promised to them that love him* (James 1:12). Ya''''aqob crowns the endurance Job models: *when he is tried* the man receives the crown of life — the same confidence as *when he hath tried me, I shall come forth as gold* (Job 23:10).'),
    ('canon','job',23,10,'apocrypha','ecclesiasticus',2,5,'extras',
     E'*For gold is tried in the fire, and acceptable men in the furnace of adversity* (Ecclesiasticus 2:5). Ben Sira sets the proverb of the sufferer almost word for word beside Job: gold tried in the fire, acceptable men in the furnace of adversity. Job''''s *I shall come forth as gold* (Job 23:10) is exactly this — the righteous proved acceptable by the affliction, not condemned by it.'),

    -- THREAD 2: word above bread / Torah-faithfulness (Job 23:11-12)
    ('canon','job',23,12,'canon','deuteronomy',8,3,'free',
     E'*And he humbled thee, and suffered thee to hunger, and fed thee with manna... that he might make thee know that man doth not live by bread only, but by every word that proceedeth out of the mouth of Yahuah (LORD) doth man live* (Deuteronomy 8:3). Job lives the wilderness lesson before it was spoken to Yashar''''el: *I have esteemed the words of his mouth more than my necessary food* (Job 23:12) — the word of Yahuah''''s mouth weighed above bread.'),
    ('canon','job',23,12,'canon','matthew',4,4,'free',
     E'*But he answered and said, It is written, Man shall not live by bread alone, but by every word that proceedeth out of the mouth of Elohim (God)* (Matthew 4:4). The Formed Son, fasting and tried, answers the tempter with the very valuation Job already held: *I have esteemed the words of his mouth more than my necessary food* (Job 23:12). The word of Elohim''''s mouth outweighs bread for the faithful sufferer.'),
    ('canon','job',23,12,'canon','psalms',119,103,'free',
     E'*How sweet are thy words unto my taste! yea, sweeter than honey to my mouth!* (Psalm 119:103). The Torah-psalmist tastes what Job treasures: the words of Yahuah''''s mouth as food sweeter than honey. *I have esteemed the words of his mouth more than my necessary food* (Job 23:12) is the same delight, the covenant-word eaten as bread.'),
    ('canon','job',23,12,'canon','jeremiah',15,16,'free',
     E'*Thy words were found, and I did eat them; and thy word was unto me the joy and rejoicing of mine heart: for I am called by thy name, O Yahuah Elohim (LORD God) of hosts* (Jeremiah 15:16). Yirmeyahu eats the word as Job esteems it above food; *I have esteemed the words of his mouth more than my necessary food* (Job 23:12) names the same hunger for the commandment that the suffering prophet would not let go.'),

    -- THREAD 3: longing for the seat / the daysman (Job 23:3-7)
    ('canon','job',23,3,'canon','job',9,33,'free',
     E'*Neither is there any daysman betwixt us, that might lay his hand upon us both* (Job 9:33). The cry that there is no daysman is what drives *Oh that I knew where I might find him! that I might come even to his seat!* (Job 23:3) — Job longs to plead his cause before El but knows of no mediator who can lay a hand on both parties.'),
    ('canon','job',23,7,'canon','1-timothy',2,5,'free',
     E'*For there is one Elohim (God), and one mediator between Elohim (God) and men, the man HaMashiach Yahusha (Christ Jesus)* (1 Timothy 2:5). The daysman Job lacked is answered in the Formed Son, the one Mediator — the man who lays his hand on both. Job''''s hope *so should I be delivered for ever from my judge* (Job 23:7) is fulfilled where a true mediator stands between Elohim and men.'),
    ('canon','job',23,3,'canon','job',19,25,'free',
     E'*For I know that my redeemer liveth, and that he shall stand at the latter day upon the earth* (Job 19:25). The longing to come before El''''s seat is the same faith that already confessed a living Redeemer who will stand at last; *that I might come even to his seat! I would order my cause before him* (Job 23:3-4) reaches toward that very vindicator.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job23_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job23_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== C. threads =====
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-23-tried-i-shall-come-forth-as-gold',
       E'Tried, I Shall Come Forth as Gold',
       E'From the depth of his ordeal Job utters one of the great confessions of the suffering righteous: *But he knoweth the way that I take: when he hath tried me, I shall come forth as gold* (Job 23:10). The fire is not the proof of guilt his friends insist on — it is a refining, and Job trusts the assayer. *The fining pot is for silver, and the furnace for gold: but Yahuah (LORD) trieth the hearts* (Proverbs 17:3). The prophets carry the figure into the covenant people: *he shall purify the sons of Levi, and purge them as gold and silver, that they may offer unto Yahuah (LORD) an offering in righteousness* (Malachi 3:3); *I will bring the third part through the fire, and will refine them as silver is refined, and will try them as gold is tried... I will say, It is my people* (Zechariah 13:9) — the trial brings the remnant forth owned, not consumed. Ben Sira sets the proverb beside Job almost word for word: *For gold is tried in the fire, and acceptable men in the furnace of adversity* (Ecclesiasticus 2:5). And the apostles fill it: *That the trial of your faith, being much more precious than of gold that perisheth, though it be tried with fire, might be found unto praise and honour and glory at the appearing of Yahusha HaMashiach (Jesus Christ)* (1 Peter 1:7); *Blessed is the man that endureth temptation: for when he is tried, he shall receive the crown of life, which Yahuah (Lord) hath promised to them that love him* (James 1:12). The fire purifies the faithful; it does not prove them guilty.',
       sv.verse_id, ev.verse_id, 'extras', 33350
  FROM _s318_job23_lookup sv, _s318_job23_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=23 AND sv.verse_number=10
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=23 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-23-the-words-of-his-mouth-more-than-my-bread',
       E'The Words of His Mouth More Than My Bread',
       E'In the same breath as his refining, Job names the covenant-faithfulness that the fire is purifying: *My foot hath held his steps, his way have I kept, and not declined. Neither have I gone back from the commandment of his lips; I have esteemed the words of his mouth more than my necessary food* (Job 23:11-12). This is genuine Torah-keeping — the word of Yahuah valued above bread — and it is the very lesson Yahuah later teaches Yashar''''el in the wilderness: *man doth not live by bread only, but by every word that proceedeth out of the mouth of Yahuah (LORD) doth man live* (Deuteronomy 8:3). The Formed Son, fasting and tried, answers the tempter with it: *Man shall not live by bread alone, but by every word that proceedeth out of the mouth of Elohim (God)* (Matthew 4:4). The Torah-psalmist tastes its sweetness — *How sweet are thy words unto my taste! yea, sweeter than honey to my mouth!* (Psalm 119:103) — and the suffering prophet eats it as his joy: *Thy words were found, and I did eat them; and thy word was unto me the joy and rejoicing of mine heart* (Jeremiah 15:16). Job''''s righteousness is no flesh-credential; it is the commandment of Yahuah''''s lips treasured above his daily bread. The covenant-word is never abolished — it is food.',
       sv.verse_id, ev.verse_id, 'free', 33351
  FROM _s318_job23_lookup sv, _s318_job23_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=23 AND sv.verse_number=11
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=23 AND ev.verse_number=12
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-23-oh-that-i-knew-where-i-might-find-him',
       E'Oh That I Knew Where I Might Find Him',
       E'Job longs for a court and a Mediator: *Oh that I knew where I might find him! that I might come even to his seat! I would order my cause before him, and fill my mouth with arguments* (Job 23:3-4). He does not fear the verdict — *Will he plead against me with his great power? No; but he would put strength in me. There the righteous might dispute with him; so should I be delivered for ever from my judge* (Job 23:6-7). But the agony of the book is that he knows no one to bring him there: *Neither is there any daysman betwixt us, that might lay his hand upon us both* (Job 9:33). The longing for that daysman is answered in the Formed Son: *For there is one Elohim (God), and one mediator between Elohim (God) and men, the man HaMashiach Yahusha (Christ Jesus)* (1 Timothy 2:5) — the man who can lay his hand on both, the one who brings the righteous before the seat and delivers him from his judge. It is the same faith Job already confessed: *For I know that my redeemer liveth, and that he shall stand at the latter day upon the earth* (Job 19:25). The Redeemer lives; the seat will be found.',
       sv.verse_id, ev.verse_id, 'free', 33352
  FROM _s318_job23_lookup sv, _s318_job23_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=23 AND sv.verse_number=3
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=23 AND ev.verse_number=7
ON CONFLICT (slug) DO NOTHING;

