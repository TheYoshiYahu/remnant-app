SELECT t.id, cr.id, 3, E'Revelation 5:6 — *stood a Lamb as it had been slain*: the slain-yet-living Lamb who STANDS, Job''s redeemer who liveth though the flesh fails and stands at the latter day.'
  FROM cross_reference_threads t
  JOIN _s318_job19_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=19 AND sv.verse_number=25
  JOIN _s318_job19_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='revelation' AND tv.chapter_number=5 AND tv.verse_number=6
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-19-he-shall-stand-at-the-latter-day-upon-the-earth'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

