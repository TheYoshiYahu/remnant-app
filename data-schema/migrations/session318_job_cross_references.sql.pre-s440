INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 4, E'*ye have not spoken of me the thing that is right* (Job 42:7) — the prosperity-promise of *make the habitation of thy righteousness prosperous* (Job 8:6) is the very doctrine Yahuah rebukes.'
  FROM cross_reference_threads t
