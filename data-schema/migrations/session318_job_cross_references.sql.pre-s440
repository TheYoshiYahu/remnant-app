-- THREAD 33076
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'Proverbs 8:14 — *Counsel is mine, and sound wisdom: I am understanding; I have strength* — Wisdom personified speaks Job''s *with him is wisdom and strength* (12:13).'
  FROM cross_reference_threads t
  JOIN _s318_job12_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=12 AND sv.verse_number=13
  JOIN _s318_job12_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='proverbs' AND tv.chapter_number=8 AND tv.verse_number=14
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-12-with-him-is-wisdom-and-strength'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

