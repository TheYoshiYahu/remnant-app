-- ----- fragment: minion_job_20.sql (Job 20) -----
-- Job 20 — Zophar the Naamathite's second speech (the retribution doctrine)
-- session prefix: s318 ; tag: job20 ; temp view: _s318_job20_lookup
-- slug prefix: job-20-... ; sort_order band start: 33275 (+1 per thread)
-- source: canon, book_slug=job, chapter 20
--
-- FRAME GUARD: Zophar's whole speech is the mechanical retribution doctrine aimed AT Job —
-- TRUE of the truly wicked (the short triumph of the wicked is a genuine wisdom theme,
-- Psalm 37 / Psalm 73), but FALSELY weaponized against a righteous sufferer. This is the very
-- error Yahuah (LORD) rebukes at Job 42:7. We thread the real wisdom-laterals AND name the
-- misapplication, pointing to Job's vindication.
--
-- Job 20 coverage:
--   v.5  (triumphing of the wicked is short)
--        NT:     none warranted (the lateral force is the Tanakh wisdom corpus)
--        Extras: none warranted here (Sirach woven at v.15 thread instead)
--        Tanakh: Psalm 37:35-36 (green bay tree, then "he was not"); Psalm 73:18-20
--                ("brought into desolation, as in a moment"; "as a dream when one awaketh")
--   v.6-11 (mounts to heaven then perishes like dung / flies as a dream)
--        NT/Extras/Tanakh: folded into the v.5 short-triumph thread (Ps 73:20 dream-image)
--   v.12-15 (wickedness sweet in mouth, meat turned to gall, swallowed riches vomited up)
--        NT:     none warranted
--        Extras: Ecclesiasticus (Sirach) 40:13 — "goods of the unjust shall be dried up like a river"
--        Tanakh: Proverbs 23:8 (the morsel eaten shalt thou vomit up); Proverbs 10:2
--                (treasures of wickedness profit nothing)
--   v.16-28 (poison of asps, restitution, fury of wrath, heaven reveals his iniquity)
--        folded into the swallowed-riches thread (v.18,28 goods flow away = Sirach 40:13)
--   v.29 (this is the portion of a wicked man from Elohim)
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: Job 42:7 (Yahuah's rebuke — "ye have not spoken of me the thing that is right")
--                = the FRAME GUARD: the retribution formula is true doctrine, false application
--
-- THREADS (3):
--   1. job-20-the-triumphing-of-the-wicked-is-short   [free]  Ps37, Ps73 (Tanakh laterals)
--   2. job-20-he-swallowed-riches-and-shall-vomit-them-up  [extras]  Prov23, Prov10 (Tanakh) + Sirach40 (extras)
--   3. job-20-the-portion-of-a-wicked-man-falsely-applied  [free]  Job42 (Tanakh — vindication/frame guard)

CREATE TEMP VIEW _s318_job20_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================ cross_references ============================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: the triumphing of the wicked is short (20:5)
    ('canon','job',20,5,'canon','psalms',37,35,'free',
     E'Zophar reaches for a true thing — *That the triumphing of the wicked is short, and the joy of the hypocrite but for a moment?* (Job 20:5). David saw the same: *I have seen the wicked in great power, and spreading himself like a green bay tree* (Psalm 37:35). The prosperity of the wicked is real but rooted in nothing.'),
    ('canon','job',20,5,'canon','psalms',37,36,'free',
     E'*Yet he passed away, and, lo, he was not: yea, I sought him, but he could not be found* (Psalm 37:36). This is exactly Zophar''s *Yet he shall perish for ever like his own dung: they which have seen him shall say, Where is he?* (Job 20:7) — the doctrine itself is sound; the sin is aiming it at the righteous Job.'),
    ('canon','job',20,5,'canon','psalms',73,18,'free',
     E'Asaph went into the sanctuary and understood the end of the wicked: *Surely thou didst set them in slippery places: thou castedst them down into destruction* (Psalm 73:18). The brief height of *Though his excellency mount up to the heavens* (Job 20:6) ends on slippery ground.'),
    ('canon','job',20,5,'canon','psalms',73,19,'free',
     E'*How are they brought into desolation, as in a moment! they are utterly consumed with terrors* (Psalm 73:19). The *but for a moment* of Job 20:5 is Asaph''s *as in a moment* — the same wisdom verdict on the wicked''s ruin.'),
    ('canon','job',20,5,'canon','psalms',73,20,'free',
     E'*As a dream when one awaketh; so, O Yahuah (Lord), when thou awakest, thou shalt despise their image* (Psalm 73:20). Zophar said the wicked *shall fly away as a dream, and shall not be found* (Job 20:8) — the dream-image of prosperity dissolves when Yahuah (Lord) awakes to judge.'),

    -- THREAD 2: he hath swallowed down riches, and he shall vomit them up (20:15)
    ('canon','job',20,15,'canon','proverbs',23,8,'free',
     E'Zophar paints the wicked man''s gain as food that turns: *He hath swallowed down riches, and he shall vomit them up again: Elohim (God) shall cast them out of his belly* (Job 20:15). Solomon uses the same picture for a grudging host''s fare: *The morsel which thou hast eaten shalt thou vomit up, and lose thy sweet words* (Proverbs 23:8) — ill-gotten sweetness will not stay down.'),
    ('canon','job',20,15,'canon','proverbs',10,2,'free',
     E'*Treasures of wickedness profit nothing: but righteousness delivereth from death* (Proverbs 10:2). Job 20:15''s vomited riches are the same lesson — what was *sweet in his mouth* (Job 20:12) profits nothing because the gain itself is wickedness.'),
    ('canon','job',20,15,'apocrypha','ecclesiasticus',40,13,'extras',
     E'Ben Sira sings the same dissolving wealth: *The goods of the unjust shall be dried up like a river, and shall vanish with noise, like a great thunder in rain* (Ecclesiasticus / Sirach 40:13). Zophar''s *The increase of his house shall depart, and his goods shall flow away in the day of his wrath* (Job 20:28) is the river drying up — the wisdom tradition guards this truth even where Zophar misuses it.'),

    -- THREAD 3: the portion of a wicked man, falsely applied (20:29) — FRAME GUARD
    ('canon','job',20,29,'canon','job',42,7,'free',
     E'Zophar seals his speech with the retribution formula: *This is the portion of a wicked man from Elohim (God), and the heritage appointed unto him by Elohim (God)* (Job 20:29). But Yahuah (LORD) himself overturns the application: *My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). The doctrine of the wicked''s portion is true — laying it on the righteous Job is the lie Yahuah (LORD) rebukes.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job20_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job20_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================ threads ============================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-20-the-triumphing-of-the-wicked-is-short',
       E'The triumphing of the wicked is short',
       E'Zophar the Naamathite opens his second speech with a verdict that is, in itself, true wisdom: *That the triumphing of the wicked is short, and the joy of the hypocrite but for a moment? Though his excellency mount up to the heavens, and his head reach unto the clouds; Yet he shall perish for ever like his own dung* (Job 20:5-7). The Tanakh''s wisdom corpus says exactly this. David: *I have seen the wicked in great power, and spreading himself like a green bay tree. Yet he passed away, and, lo, he was not: yea, I sought him, but he could not be found* (Psalm 37:35-36). Asaph, who went into the sanctuary and understood their end: *Surely thou didst set them in slippery places: thou castedst them down into destruction. How are they brought into desolation, as in a moment! they are utterly consumed with terrors. As a dream when one awaketh; so, O Yahuah (Lord), when thou awakest, thou shalt despise their image* (Psalm 73:18-20). Zophar''s *as a dream* (Job 20:8) is Asaph''s dream that vanishes when Yahuah (Lord) awakes. The doctrine is sound. The error — which Yahuah (LORD) will rebuke at Job 42:7 — is aiming it at Job, who is not the wicked man but the righteous sufferer.',
       sv.verse_id, ev.verse_id, 'free', 33275
  FROM _s318_job20_lookup sv, _s318_job20_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=20 AND sv.verse_number=5
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=20 AND ev.verse_number=8
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-20-he-swallowed-riches-and-shall-vomit-them-up',
       E'He hath swallowed down riches, and he shall vomit them up',
       E'Zophar pictures the wicked man''s gain as food that betrays the body: *Though wickedness be sweet in his mouth, though he hide it under his tongue... Yet his meat in his bowels is turned, it is the gall of asps within him. He hath swallowed down riches, and he shall vomit them up again: Elohim (God) shall cast them out of his belly* (Job 20:12-15). Solomon used the same image of fare that will not stay down: *The morsel which thou hast eaten shalt thou vomit up, and lose thy sweet words* (Proverbs 23:8), and named the reason plainly: *Treasures of wickedness profit nothing: but righteousness delivereth from death* (Proverbs 10:2). Ben Sira sings the same dissolving wealth: *The goods of the unjust shall be dried up like a river, and shall vanish with noise, like a great thunder in rain* (Ecclesiasticus / Sirach 40:13) — which is Zophar''s own *The increase of his house shall depart, and his goods shall flow away in the day of his wrath* (Job 20:28). Across the Tanakh and the wisdom witnesses the verdict on ill-gotten gain holds: sweet in the mouth, gall in the belly, vomited up. The wisdom is real; Zophar''s sin is pressing it as proof that Job''s losses convict Job of wickedness.',
       sv.verse_id, ev.verse_id, 'extras', 33276
  FROM _s318_job20_lookup sv, _s318_job20_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=20 AND sv.verse_number=12
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=20 AND ev.verse_number=28
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-20-the-portion-of-a-wicked-man-falsely-applied',
       E'The portion of a wicked man — true doctrine, false application',
       E'Zophar closes with the retribution formula in its bare form: *This is the portion of a wicked man from Elohim (God), and the heritage appointed unto him by Elohim (God)* (Job 20:29). Taken as a statement about the truly wicked, it is true — the whole chapter''s wisdom-laterals (Psalm 37, Psalm 73, Proverbs, Sirach) affirm that the wicked''s portion is ruin. But Zophar has aimed every word of it at Job, treating Job''s suffering as evidence of hidden wickedness. The book itself reverses the verdict in the mouth of Yahuah (LORD): *My wrath is kindled against thee, and against thy two friends: for ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). The mechanical doctrine — every sufferer must be a sinner getting his portion — is the lie. Yahuah (LORD) does not deny that the wicked have a portion; he denies that Job is the wicked man. This is the frame guard for the whole chapter: thread the truth, name the misapplication, and let Job''s vindication stand.',
       sv.verse_id, ev.verse_id, 'free', 33277
  FROM _s318_job20_lookup sv, _s318_job20_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=20 AND sv.verse_number=29
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=20 AND ev.verse_number=29
ON CONFLICT (slug) DO NOTHING;

-- ============================ thread_members ============================
-- THREAD 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*I have seen the wicked in great power, and spreading himself like a green bay tree* (Psalm 37:35) — the real but rootless prosperity Zophar describes.'
  FROM cross_reference_threads t
  JOIN _s318_job20_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=20 AND sv.verse_number=5
  JOIN _s318_job20_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=37 AND tv.verse_number=35
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-20-the-triumphing-of-the-wicked-is-short'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'*Yet he passed away, and, lo, he was not: yea, I sought him, but he could not be found* (Psalm 37:36) — David''s echo of Zophar''s *Where is he?* (Job 20:7).'
  FROM cross_reference_threads t
  JOIN _s318_job20_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=20 AND sv.verse_number=5
  JOIN _s318_job20_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=37 AND tv.verse_number=36
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-20-the-triumphing-of-the-wicked-is-short'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'*thou castedst them down into destruction* (Psalm 73:18) — Asaph''s sanctuary verdict on the wicked''s slippery height.'
  FROM cross_reference_threads t
  JOIN _s318_job20_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=20 AND sv.verse_number=5
  JOIN _s318_job20_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=73 AND tv.verse_number=18
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-20-the-triumphing-of-the-wicked-is-short'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 4, E'*How are they brought into desolation, as in a moment!* (Psalm 73:19) — the *but for a moment* of Job 20:5 in Asaph''s words.'
  FROM cross_reference_threads t
  JOIN _s318_job20_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=20 AND sv.verse_number=5
  JOIN _s318_job20_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=73 AND tv.verse_number=19
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-20-the-triumphing-of-the-wicked-is-short'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 5, E'*As a dream when one awaketh... thou shalt despise their image* (Psalm 73:20) — Zophar''s *fly away as a dream* (Job 20:8) dissolving when Yahuah (Lord) awakes.'
  FROM cross_reference_threads t
  JOIN _s318_job20_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=20 AND sv.verse_number=5
  JOIN _s318_job20_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=73 AND tv.verse_number=20
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-20-the-triumphing-of-the-wicked-is-short'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

