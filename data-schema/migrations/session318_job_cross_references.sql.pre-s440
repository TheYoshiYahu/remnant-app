    ('job',14,15, 'apocrypha','the-wisdom-of-solomon',3,4, 3, E'*their hope full of immortality* (Wisdom 3:4) -- the desire of the Creator for the work of his hands does not die.')
  ) AS m(src_slug,src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
