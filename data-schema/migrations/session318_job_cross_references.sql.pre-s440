SELECT t.id, cr.id, 1, E'*set me as a mark for the arrow* (Lamentations 3:12) — the same target-of-the-bow image as Job''s *set me up for his mark*.'
  FROM cross_reference_threads t
  JOIN _s318_job16_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=16 AND sv.verse_number=12
