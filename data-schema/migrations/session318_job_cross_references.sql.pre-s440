-- ----- fragment: minion_job_24.sql (Job 24) -----
-- Job 24 — the hidden injustice and the delay of judgment
-- tag: job24 ; session prefix: s318 ; sort band start: 33375 (+1 per thread)
-- source book_slug=job, chapter 24 (edition canon)
--
-- Job 24 coverage:
--   v.1  (times not hidden, do they not see his days? — the cry over deferred justice)
--        NT:     James 5:7-8 (judge standeth before the door) — folded into the cry-thread
--        Extras: 1 Enoch 99:3 (prayers as memorial before the Most High) — weighed, Sirach 35 chosen for the delay
--        Tanakh: Amos 8:4-7 (the end is come, I will not forget their works) — used in cry-thread
--   v.2  (some remove the landmarks)
--        NT:     none warranted (no NT landmark text — the Torah statute is the standard)
--        Extras: none warranted
--        Tanakh: Deuteronomy 19:14; Deuteronomy 27:17; Proverbs 22:28 — landmark thread
--   v.3-9 (drive away ass of fatherless, take widow's ox for pledge, pluck fatherless from breast, take pledge of poor)
--        NT:     none warranted directly (Mal 3:5 carries the forward swift-witness)
--        Extras: Ecclesiasticus 34:21-22 (defraud labourer = bloodshedder); 35:13-15 (cry of widow/fatherless) — oppression thread
--        Tanakh: Exodus 22:22-24; Deuteronomy 24:14-15,17; Isaiah 10:1-2; Malachi 3:5 — oppression thread
--   v.12 (men groan from the city... yet Elohim layeth not folly to them — the seeming impunity)
--        NT:     James 5:4-6 (the hire kept back by fraud crieth) — cry thread
--        Extras: Ecclesiasticus 35:17-18 (prayer of humble pierces clouds till He judge) — oppression thread
--        Tanakh: Amos 8:4-7 — cry thread
--   v.13-17 (the murderer, adulterer, thief who know not the light) — covered as conduct within the catalogue; no separate thread warranted
--   v.22-24 (he draweth the mighty... exalted for a little while, but gone and brought low)
--        NT:     none warranted (James already in cry thread)
--        Extras: 1 Enoch 96:1-2,10,13 (woe to you mighty in unrighteousness, your might cut off, destroyed like grass) — reckoning thread
--        Tanakh: Psalm 73:17-20 (their end: slippery places, consumed with terrors) — reckoning thread
--
-- THREADS (4):
--   s318: job-24-thou-shalt-not-remove-thy-neighbours-landmark           [free]   Tanakh: Deut19:14, Deut27:17, Prov22:28
--   s318: job-24-the-widow-and-fatherless-the-torahs-protected-poor       [extras] Tanakh: Exod22:22-24, Deut24:14-15+17, Isa10:1-2, Mal3:5 ; Extras: Sirach34:21-22, Sirach35:13-15
--   s318: job-24-the-cry-of-the-defrauded-entered-into-the-ears-of-yahuah [free]   Tanakh: Amos8:4-7 ; NT: James5:4-6
--   s318: job-24-exalted-for-a-little-while-but-brought-low               [extras] Tanakh: Ps73:17-20 ; Extras: 1Enoch96:1-2,10,13
--
-- GUARD: Job's honest naming of real-world injustice the retribution doctrine cannot explain — the Torah's
-- own statutes (landmark, pledge, widow/orphan protection) are the standard the wicked VIOLATE (Torah affirmed
-- as the measure of justice, never the curse); final judgment, not present prosperity, settles the account.

CREATE TEMP VIEW _s318_job24_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================ CROSS REFERENCES ============================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1 — landmark removal (Job 24:2)
    ('canon','job',24,2,'canon','deuteronomy',19,14,'free',
     E'*Thou shalt not remove thy neighbour''s landmark, which they of old time have set in thine inheritance, which thou shalt inherit in the land that Yahuah Elohayka (the LORD thy God) giveth thee to possess it.* (Deuteronomy 19:14). Job''s catalogue opens with the very first crime the Torah names against the inheritance — *Some remove the landmarks; they violently take away flocks, and feed thereof* (Job 24:2). The landmark is the boundary of the covenant portion; to move it is to steal a man''s standing in the land Yahuah (the LORD) gave. Job is not inventing a wrong; he is reciting a statute the wicked have broken.'),
    ('canon','job',24,2,'canon','deuteronomy',27,17,'free',
     E'*Cursed be he that removeth his neighbour''s landmark. And all the people shall say, Amen.* (Deuteronomy 27:17). On mount Ebal the whole congregation pronounced this curse with their own voice. Job''s wicked man who *remove[s] the landmarks* (Job 24:2) stands already under that Amen — the Torah did not leave the boundary-thief unjudged, and Job''s honest puzzle is only why the sentence delays, not whether it stands.'),
    ('canon','job',24,2,'canon','proverbs',22,28,'free',
     E'*Remove not the ancient landmark, which thy fathers have set.* (Proverbs 22:28). Wisdom repeats the Torah in a single line, joining Job''s lament to the same standard: the boundary belongs to *thy fathers*, the inheritance handed down the paternal line. When Job''s oppressors *remove the landmarks* (Job 24:2) they tear at the seed-promise itself — the portion carried from generation to generation.'),

    -- THREAD 2 — the widow, fatherless, the Torah''s protected poor (Job 24:3-9)
    ('canon','job',24,3,'canon','exodus',22,22,'free',
     E'*Ye shall not afflict any widow, or fatherless child.* (Exodus 22:22). Job names the exact victims the covenant fences round: *They drive away the ass of the fatherless, they take the widow''s ox for a pledge* (Job 24:3). The oppressors are not breaking some private custom — they are trampling the named class Yahuah (the LORD) swore to defend, the widow and the fatherless of the Torah.'),
    ('canon','job',24,3,'canon','exodus',22,24,'free',
     E'*And my wrath shall wax hot, and I will kill you with the sword; and your wives shall be widows, and your children fatherless.* (Exodus 22:24). The statute attaches its own sanction: afflict the widow and Yahuah (the LORD) himself becomes the avenger. Job''s wicked man who *take[s] the widow''s ox for a pledge* (Job 24:3) has called down this very wrath; the delay Job grieves over is not its absence.'),
    ('canon','job',24,9,'canon','deuteronomy',24,17,'free',
     E'*Thou shalt not pervert the judgment of the stranger, nor of the fatherless; nor take a widow''s raiment to pledge.* (Deuteronomy 24:17). The pledge-law is precise — you may not strip the defenceless of what keeps them alive. Job''s oppressors do the forbidden thing twice over: *They pluck the fatherless from the breast, and take a pledge of the poor* (Job 24:9). Every clause of Job''s indictment is a clause of the Torah turned inside out.'),
    ('canon','job',24,10,'canon','deuteronomy',24,15,'free',
     E'*At his day thou shalt give him his hire, neither shall the sun go down upon it; for he is poor, and setteth his heart upon it: lest he cry against thee unto Yahuah (LORD), and it be sin unto thee.* (Deuteronomy 24:15). Job sees the labourers stripped: *they take away the sheaf from the hungry* (Job 24:10), made to *tread their winepresses, and suffer thirst* (Job 24:11). The Torah had already armed the poor man with a cry that reaches Yahuah (the LORD) — the same cry Job hears groaning from the city.'),
    ('canon','job',24,4,'canon','isaiah',10,2,'free',
     E'*To turn aside the needy from judgment, and to take away the right from the poor of my people, that widows may be their prey, and that they may rob the fatherless!* (Isaiah 10:2). Isaiah''s woe describes Job''s scene exactly: *They turn the needy out of the way: the poor of the earth hide themselves together* (Job 24:4). What Job laments as unpunished, Isaiah answers — *what will ye do in the day of visitation?* (Isaiah 10:3). The reckoning Job cannot yet see, the prophet declares is coming.'),
    ('canon','job',24,12,'canon','malachi',3,5,'free',
     E'*And I will come near to you to judgment; and I will be a swift witness against the sorcerers, and against the adulterers, and against false swearers, and against those that oppress the hireling in his wages, the widow, and the fatherless, and that turn aside the stranger from his right, and fear not me, saith Yahuah Tseva''ot (LORD of hosts).* (Malachi 3:5). Job''s ache — *Men groan from out of the city... yet Elohim (God) layeth not folly to them* (Job 24:12) — is met by Malachi''s promise that Yahuah (the LORD) becomes a *swift witness* against precisely these oppressors of hireling, widow, and fatherless. The folly is laid to their charge; the witness is only delayed, never withdrawn.'),
    ('canon','job',24,9,'apocrypha','ecclesiasticus',34,22,'extras',
     E'*He that takes away his neighbour''s living slayeth him; and he that defraudeth the labourer of his hire is a bloodshedder.* (Ecclesiasticus 34:22). The wisdom of Ben Sira names the crime of Job''s oppressors for what it is — bloodshed. To *take a pledge of the poor* (Job 24:9) and strip the labourer is not mere theft; it is to slay a man by inches. The restored library keeps the Torah''s verdict: the defrauder of the poor is a murderer.'),
    ('canon','job',24,12,'apocrypha','ecclesiasticus',35,17,'extras',
     E'*The prayer of the humble pierces the clouds: and till it come nigh, he will not be comforted; and will not depart, till the Most High shall behold to judge righteously, and execute judgment.* (Ecclesiasticus 35:17). Where Job sees the groan of the wounded rise unanswered (Job 24:12), Ben Sira tracks that same cry upward — it *pierces the clouds* and does not rest until the Most High judges. The delay Job feels is the prayer still climbing; the answer is certain.'),
    ('canon','job',24,12,'apocrypha','ecclesiasticus',35,18,'extras',
     E'*For Yahuah (God) will not be slack, neither will the Mighty be patient toward them, till he have struck in sunder the loins of the unmerciful, and repayed vengeance to the heathen.* (Ecclesiasticus 35:18). This is the direct answer to Job''s complaint that *Elohim (God) layeth not folly to them* (Job 24:12). He is *not slack* — the patience is not impunity but the held breath before the loins of the unmerciful are struck in sunder.'),

    -- THREAD 3 — the cry of the defrauded entered into the ears of Yahuah (Job 24:1,12)
    ('canon','job',24,12,'canon','james',5,4,'free',
     E'*Behold, the hire of the labourers who have reaped down your fields, which is of you kept back by fraud, crieth: and the cries of them which have reaped are entered into the ears of Yahuah (Lord) of sabaoth.* (James 5:4). James turns Job''s groan into an indictment: the wages held back from the reaper *crieth*, and that cry has *entered into the ears of Yahuah (the Lord) of sabaoth*. Job''s *the soul of the wounded crieth out* (Job 24:12) is not lost — it is filed in heaven against the day of payment.'),
    ('canon','job',24,1,'canon','james',5,7,'free',
     E'*Be patient therefore, brethren, unto the coming of Yahuah (Lord)... and the cries of them which have reaped are entered into the ears of Yahuah (Lord) of sabaoth... behold, the judge standeth before the door.* (James 5:7,9). Job asks *why... do they that know him not see his days?* (Job 24:1) — why is the day of reckoning unseen. James answers the why: the day is fixed, *the judge standeth before the door*; the husbandman waits for the harvest, and so must the wronged. The deferral Job grieves is the patience James commands.'),
    ('canon','job',24,1,'canon','amos',8,7,'free',
     E'*Yahuah (LORD) hath sworn by the excellency of Jacob, Surely I will never forget any of their works.* (Amos 8:7). Amos thunders against the same oppressors — *ye that swallow up the needy... making the ephah small, and the shekel great, and falsifying the balances by deceit* (Amos 8:4-5). To Job''s anxious *seeing times are not hidden from the Almighty* (Job 24:1), Amos seals the answer with an oath: their works are not forgotten. The times are not hidden, and neither are the deeds.'),

    -- THREAD 4 — exalted for a little while, but brought low (Job 24:22-24)
    ('canon','job',24,24,'canon','psalms',73,18,'free',
     E'*Surely thou didst set them in slippery places: thou castedst them down into destruction.* (Psalm 73:18). Asaph, like Job, was staggered by the prosperity of the wicked — *envious... when I saw the prosperity of the wicked* (Psalm 73:3) — until *I went into the sanctuary of Elohim (God); then understood I their end* (Psalm 73:17). Job already knows that end: *They are exalted for a little while, but are gone and brought low* (Job 24:24). The slippery height is the whole of the wicked man''s safety.'),
    ('canon','job',24,24,'canon','psalms',73,20,'free',
     E'*As a dream when one awaketh; so, O Yahuah (Lord), when thou awakest, thou shalt despise their image.* (Psalm 73:20). The exaltation Job watches is dream-stuff — real only till the sleeper wakes. *They are taken out of the way as all other, and cut off as the tops of the ears of corn* (Job 24:24). When Yahuah (the LORD) rises, the towering image dissolves; this is the reckoning that does come.'),
    ('canon','job',24,22,'enoch','1-enoch',96,1,'extras',
     E'*Woe to you who devour the might of others, And live in wickedness and oppression... And tread upon the righteous with your might.* (1 Enoch 96:1). Enoch''s woe names Job''s strong man — *He draweth also the mighty with his power: he riseth up, and no man is sure of life* (Job 24:22). The same trampling power that makes men despair of their lives is the very thing heaven marks for woe.'),
    ('canon','job',24,24,'enoch','1-enoch',96,2,'extras',
     E'*Woe to you who are mighty in unrighteousness! For your might shall be cut off.* (1 Enoch 96:2). Job''s verdict and Enoch''s are one word: the might is *cut off*. *They are exalted for a little while, but are gone and brought low* (Job 24:24). The restored witness underwrites Job''s hope — the mighty in unrighteousness do not keep their might.'),
    ('canon','job',24,24,'enoch','1-enoch',96,10,'extras',
     E'*But you shall be destroyed like grass, And like the young grass that withers, And you shall be cast into the fiery furnace.* (1 Enoch 96:10). Job''s image is the harvest sickle — *cut off as the tops of the ears of corn* (Job 24:24); Enoch''s is the withering grass and the furnace. Both see the same brevity: the oppressor flourishes a season and is mown. The delay is *a little while*, not forever.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job24_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job24_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================ THREADS ============================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-24-thou-shalt-not-remove-thy-neighbours-landmark',
       E'Thou shalt not remove thy neighbour''s landmark',
       E'Job''s catalogue of the wicked opens with the oldest crime against the inheritance: *Some remove the landmarks; they violently take away flocks, and feed thereof* (Job 24:2). He is not inventing a private grievance — he is reciting a Torah statute the oppressors have broken. *Thou shalt not remove thy neighbour''s landmark, which they of old time have set in thine inheritance* (Deuteronomy 19:14): the boundary marks a man''s portion in the land Yahuah (the LORD) gave, and to move it is to steal his standing in the covenant. On mount Ebal the whole congregation made the sanction their own — *Cursed be he that removeth his neighbour''s landmark. And all the people shall say, Amen* (Deuteronomy 27:17). Wisdom repeats it in a line — *Remove not the ancient landmark, which thy fathers have set* (Proverbs 22:28) — binding the boundary to the paternal line, the seed-promise handed down. So Job''s wicked man already stands under the Amen of all Israel. The Torah is not the curse here; the Torah is the measure of justice the wicked violate, and Job''s honest puzzle is only why the sentence delays, never whether it stands.',
       sv.verse_id, ev.verse_id, 'free', 33375
  FROM _s318_job24_lookup sv, _s318_job24_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=24 AND sv.verse_number=2
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=24 AND ev.verse_number=2
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-24-the-widow-and-fatherless-the-torahs-protected-poor',
       E'The widow and the fatherless — the Torah''s protected poor',
       E'Verse by verse Job names the exact classes the covenant fences round, and verse by verse he shows them stripped: *They drive away the ass of the fatherless, they take the widow''s ox for a pledge* (Job 24:3); *They pluck the fatherless from the breast, and take a pledge of the poor* (Job 24:9). Every clause is a Torah clause turned inside out. *Ye shall not afflict any widow, or fatherless child* (Exodus 22:22) — and the statute arms itself: *my wrath shall wax hot... and your wives shall be widows, and your children fatherless* (Exodus 22:24). The pledge-law is precise: *Thou shalt not pervert the judgment of the stranger, nor of the fatherless; nor take a widow''s raiment to pledge* (Deuteronomy 24:17); and the withheld wage is given a cry — *lest he cry against thee unto Yahuah (LORD), and it be sin unto thee* (Deuteronomy 24:15). Isaiah pronounces the woe over Job''s very scene — *that widows may be their prey, and that they may rob the fatherless!* (Isaiah 10:2) — and asks *what will ye do in the day of visitation?* (Isaiah 10:3). Malachi seals the answer: Yahuah (the LORD) becomes *a swift witness... against those that oppress the hireling in his wages, the widow, and the fatherless* (Malachi 3:5). The restored library keeps the same verdict: *he that defraudeth the labourer of his hire is a bloodshedder* (Ecclesiasticus 34:22), and the cry of the wronged *pierces the clouds... till the Most High shall behold to judge* (Ecclesiasticus 35:17), for *Yahuah (God) will not be slack* (Ecclesiasticus 35:18). Job''s lament that *Elohim (God) layeth not folly to them* (Job 24:12) is answered from every shelf: the folly is laid to their charge, the witness only delayed.',
       sv.verse_id, ev.verse_id, 'extras', 33376
  FROM _s318_job24_lookup sv, _s318_job24_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=24 AND sv.verse_number=3
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=24 AND ev.verse_number=12
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-24-the-cry-of-the-defrauded-entered-into-the-ears-of-yahuah',
       E'The cry of the defrauded entered into the ears of Yahuah',
       E'Job opens with the question that the whole chapter circles: *Why, seeing times are not hidden from the Almighty, do they that know him not see his days?* (Job 24:1) — why is the day of reckoning unseen? And he hears the unanswered groan: *Men groan from out of the city, and the soul of the wounded crieth out* (Job 24:12). The cry is not lost. James files it in heaven: *the hire of the labourers... kept back by fraud, crieth: and the cries of them which have reaped are entered into the ears of Yahuah (Lord) of sabaoth* (James 5:4). And James answers Job''s *why*: *Be patient... unto the coming of Yahuah (Lord)... behold, the judge standeth before the door* (James 5:7,9). The day is not absent; it is fixed, and the judge already stands at the threshold. Amos seals it with an oath against the same oppressors — *ye that swallow up the needy... making the ephah small, and the shekel great* (Amos 8:4-5) — *Yahuah (LORD) hath sworn by the excellency of Jacob, Surely I will never forget any of their works* (Amos 8:7). The times are not hidden; neither are the deeds. The deferral Job grieves is the patience the apostle commands and the oath the prophet swears — never impunity.',
       sv.verse_id, ev.verse_id, 'free', 33377
  FROM _s318_job24_lookup sv, _s318_job24_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=24 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=24 AND ev.verse_number=12
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-24-exalted-for-a-little-while-but-brought-low',
       E'Exalted for a little while, but brought low',
       E'Job ends the catalogue not with despair but with the verdict the retribution doctrine could not give him on its own terms: *He draweth also the mighty with his power: he riseth up, and no man is sure of life... They are exalted for a little while, but are gone and brought low; they are taken out of the way as all other, and cut off as the tops of the ears of corn* (Job 24:22,24). The strong man''s height is real, and brief. Asaph was staggered by the same prosperity — *envious... when I saw the prosperity of the wicked* (Psalm 73:3) — until the sanctuary opened his eyes: *Surely thou didst set them in slippery places: thou castedst them down into destruction* (Psalm 73:18); *as a dream when one awaketh; so, O Yahuah (Lord), when thou awakest, thou shalt despise their image* (Psalm 73:20). The restored witness of Enoch underwrites the verdict with woe upon woe: *Woe to you who devour the might of others... And tread upon the righteous with your might* (1 Enoch 96:1); *Woe to you who are mighty in unrighteousness! For your might shall be cut off* (1 Enoch 96:2); *But you shall be destroyed like grass, And like the young grass that withers* (1 Enoch 96:10). Job''s sickle, Asaph''s waking dream, Enoch''s withering grass — three libraries, one reckoning. The exaltation is *a little while*; the cutting off is sure.',
       sv.verse_id, ev.verse_id, 'extras', 33378
  FROM _s318_job24_lookup sv, _s318_job24_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=24 AND sv.verse_number=22
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=24 AND ev.verse_number=24
ON CONFLICT (slug) DO NOTHING;

-- ============================ THREAD MEMBERS ============================
-- THREAD 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*Thou shalt not remove thy neighbour''s landmark... in thine inheritance* (Deuteronomy 19:14) — the first crime in Job''s catalogue is a named Torah statute against the covenant portion.'
  FROM cross_reference_threads t
  JOIN _s318_job24_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=24 AND sv.verse_number=2
  JOIN _s318_job24_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='deuteronomy' AND tv.chapter_number=19 AND tv.verse_number=14
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-24-thou-shalt-not-remove-thy-neighbours-landmark'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'*Cursed be he that removeth his neighbour''s landmark. And all the people shall say, Amen* (Deuteronomy 27:17) — all Israel pronounced the curse Job''s landmark-thief already stands under.'
  FROM cross_reference_threads t
  JOIN _s318_job24_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=24 AND sv.verse_number=2
  JOIN _s318_job24_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='deuteronomy' AND tv.chapter_number=27 AND tv.verse_number=17
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-24-thou-shalt-not-remove-thy-neighbours-landmark'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'*Remove not the ancient landmark, which thy fathers have set* (Proverbs 22:28) — wisdom binds the boundary to the paternal line, the seed-promise handed down.'
  FROM cross_reference_threads t
  JOIN _s318_job24_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=24 AND sv.verse_number=2
  JOIN _s318_job24_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='proverbs' AND tv.chapter_number=22 AND tv.verse_number=28
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-24-thou-shalt-not-remove-thy-neighbours-landmark'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*Ye shall not afflict any widow, or fatherless child* (Exodus 22:22) — Job''s victims are the named class the covenant swore to defend.'
  FROM cross_reference_threads t
  JOIN _s318_job24_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=24 AND sv.verse_number=3
  JOIN _s318_job24_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='exodus' AND tv.chapter_number=22 AND tv.verse_number=22
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-24-the-widow-and-fatherless-the-torahs-protected-poor'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
