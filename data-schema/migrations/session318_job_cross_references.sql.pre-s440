-- ----- fragment: minion_job_39.sql (Job 39) -----
-- Book: Job   Chapter: 39   Tag: job39   Session: s318
-- Sort band: 33750.. (+1 per thread)
-- Source edition: canon  book_slug=job  chapter=39
--
-- CHAPTER FOCUS: The whirlwind continues — Yahuah parades the untameable wild
-- creation before Job to answer his demand for an accounting with the vastness of
-- El's sovereign wisdom and provision over a world man cannot command. The wild
-- goats and hinds that calve in the wilderness, the wild ass loosed free who
-- scorneth the multitude of the city, the unicorn/wild ox that will not serve in
-- the furrow, the ostrich deprived of wisdom, the war-horse clothed with thunder
-- (El's gift, not man's), and the hawk and eagle that fly and nest on high by His
-- wisdom. The Provider who feeds the wild ravens is the same who feeds and clothes
-- His people (Matthew 6:26 forward).
--
-- Job 39 coverage:
--   v.1-4 (wild goats, hinds calve):
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: Psalm 104:18 (high hills a refuge for wild goats) [T1]
--   v.5-8 (wild ass loosed free, scorneth the city):
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: Psalm 104:10-11 (springs to the valleys, wild asses quench their thirst) [T1]
--   v.9-12 (unicorn will not serve / harrow / bring home thy seed):
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: Psalm 104:24 (in wisdom hast thou made them all) [T1]
--   v.13-18 (ostrich deprived of wisdom; scorneth horse & rider):
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: folded into T1 (untameable wild creation) / v.18 transitions to T2
--   v.19-25 (the war-horse: strength, thunder-neck, mocketh at fear, ha ha):
--        NT:     none warranted
--        Extras: none warranted
--        Tanakh: Psalm 147:10 (He delighteth not in the strength of the horse) [T2]
--   v.26-30 (hawk by His wisdom, eagle nests on high, young ones suck blood, where slain are):
--        NT:     Matthew 6:26 (the fowls fed by your heavenly Father); Luke 12:24 (the ravens fed) [T3]
--        Extras: none warranted (Sirach 43 weighed — magnifies works, but no creature-provision verse as tight)
--        Tanakh: Psalm 147:9 (the young ravens which cry); Psalm 104:27 (their meat in due season); Job 38:41 (the raven's food, young ones cry) [T3]
--
-- THREADS:
--   T1 job-39-the-wild-creatures-no-man-can-tame-bow-to-their-maker  (free; Tanakh: Psalm 104) sort 33750
--   T2 job-39-the-war-horse-clothed-with-thunder-el-gave-his-strength  (free; Tanakh: Psalm 147) sort 33751
--   T3 job-39-the-provider-who-feeds-the-wild-ravens-feeds-his-people  (free; Tanakh: Psalm 104/147, Job 38; NT: Matthew 6 / Luke 12) sort 33752
--
-- All three threads canon-only => tier_required 'free' (and every member tier 'free').

CREATE TEMP VIEW _s318_job39_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== B. cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- T1: the untameable wild creation — Psalm 104 sings the same care
    ('canon','job',39,5,'canon','psalms',104,11,'free',
     E'*They give drink to every beast of the field: the wild asses quench their thirst* (Psalm 104:11). Job asks *Who hath sent out the wild ass free? or who hath loosed the bands of the wild ass?* (Job 39:5) — and the Psalm answers: the same Yahuah (LORD) who *sendeth the springs into the valleys* (104:10) gives the free wild ass its drink. The creature man never bridled is fed and watered by its Maker''s hand, not man''s.'),
    ('canon','job',39,8,'canon','psalms',104,18,'free',
     E'*The high hills are a refuge for the wild goats; and the rocks for the conies* (Psalm 104:18). Job''s *range of the mountains is his pasture* (Job 39:8) and the wild goats of the rock that *bring forth* in the wilderness (39:1) are no oversight — the Psalm names the high hills as the refuge Yahuah (LORD) appointed for the very creatures man cannot herd.'),
    ('canon','job',39,11,'canon','psalms',104,24,'free',
     E'*O Yahuah (LORD), how manifold are thy works! in wisdom hast thou made them all: the earth is full of thy riches* (Psalm 104:24). The unicorn that *will not be willing to serve thee* nor *abide by thy crib* (Job 39:9) — whose *strength is great* (39:11) yet bows to no plough — testifies the same wisdom the Psalm magnifies: a world made full and free by El''s design, beyond man''s command.'),
    -- T2: the war-horse — strength is El''s gift, not man''s glory
    ('canon','job',39,19,'canon','psalms',147,10,'free',
     E'*He delighteth not in the strength of the horse: he taketh not pleasure in the legs of a man* (Psalm 147:10). Yahuah (LORD) asks *Hast thou given the horse strength? hast thou clothed his neck with thunder?* (Job 39:19) — the answer is plainly El, not Job; and the Psalm draws the lesson home: the One who gave the war-horse its terror takes no pleasure in that strength, but *in them that fear him* (147:11). Man''s power is a loan, not a boast.'),
    -- T3: the Provider who feeds the wild ravens feeds his people (forward to the Gospel)
    ('canon','job',39,29,'canon','job',38,41,'free',
     E'*Who provideth for the raven his food? when his young ones cry unto Elohim (God), they wander for lack of meat* (Job 38:41). The eagle that *seeketh the prey* and whose *young ones also suck up blood* (Job 39:29-30) is fed from the same open hand the whirlwind named one chapter before: the wild raven''s cry is heard, and El feeds it. The Maker provides for the creatures no man tends.'),
    ('canon','job',39,29,'canon','psalms',147,9,'free',
     E'*He giveth to the beast his food, and to the young ravens which cry* (Psalm 147:9). The eagle that *from thence... seeketh the prey, and her eyes behold afar off* (Job 39:29) hunts under the same providence — the young ravens cry and are answered; the Provider over the wild is no absentee, but feeds *the beast his food* in its season.'),
    ('canon','job',39,29,'canon','psalms',104,27,'free',
     E'*These wait all upon thee; that thou mayest give them their meat in due season* (Psalm 104:27). The eagle that *seeketh the prey* (Job 39:29) and the whole wild company of this chapter *wait all upon* their Maker — none of them sows nor stores, yet each is fed *in due season*. The vastness of El''s daily care is the answer to Job''s demand for an accounting.'),
    ('canon','job',39,29,'canon','matthew',6,26,'free',
     E'*Behold the fowls of the air: for they sow not, neither do they reap, nor gather into barns; yet your heavenly Father feedeth them. Are ye not much better than they?* (Matthew 6:26). The eagle that *mount up at thy command* (Job 39:27) and *seeketh the prey* (39:29) is fed by the Father — and Yahusha (Jesus) carries the whirlwind''s lesson forward: the same Provider who feeds the untended fowl will feed and clothe his people, who are *much better than they*.'),
    ('canon','job',39,29,'canon','luke',12,24,'free',
     E'*Consider the ravens: for they neither sow nor reap; which neither have storehouse nor barn; and Elohim (God) feedeth them: how much more are ye better than the fowls?* (Luke 12:24). The eagle whose *young ones also suck up blood* (Job 39:30) and the ravens of Job 38:41 are fed without barn or harvest — and Yahusha (Jesus) presses the *how much more*: if El feeds the wild raven, his people need *take no thought* for their life.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job39_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job39_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== C. threads =====
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-39-the-wild-creatures-no-man-can-tame-bow-to-their-maker',
       E'The Wild Creatures No Man Can Tame Bow to Their Maker',
       E'Out of the whirlwind Yahuah (LORD) parades the untameable creation before Job: *Knowest thou the time when the wild goats of the rock bring forth? or canst thou mark when the hinds do calve?* (Job 39:1). Job never numbered their months nor watched them bear; *Who hath sent out the wild ass free? or who hath loosed the bands of the wild ass?* (39:5) — the creature that *scorneth the multitude of the city, neither regardeth he the crying of the driver* (39:7). *Will the unicorn be willing to serve thee, or abide by thy crib?* (39:9) — no; *Canst thou bind the unicorn with his band in the furrow?* (39:10) — no. Man neither bred nor broke these creatures, yet they are fed and free. The Psalm sings the same providence: *He sendeth the springs into the valleys... They give drink to every beast of the field: the wild asses quench their thirst* (Psalm 104:10-11); *The high hills are a refuge for the wild goats; and the rocks for the conies* (104:18). And the whole wild company is no accident but design — *O Yahuah (LORD), how manifold are thy works! in wisdom hast thou made them all: the earth is full of thy riches* (104:24). The point answers Job''s demand: the world man cannot command is held, fed, and ordered by the wisdom of El — vast beyond accounting.',
       sv.verse_id, ev.verse_id, 'free', 33750
  FROM _s318_job39_lookup sv, _s318_job39_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=39 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=39 AND ev.verse_number=12
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-39-the-war-horse-clothed-with-thunder-el-gave-his-strength',
       E'The War-Horse Clothed With Thunder — El Gave His Strength',
       E'The whirlwind turns to the most terrible of beasts: *Hast thou given the horse strength? hast thou clothed his neck with thunder?* (Job 39:19). The war-horse *paweth in the valley, and rejoiceth in his strength: he goeth on to meet the armed men* (39:21); *He mocketh at fear, and is not affrighted; neither turneth he back from the sword* (39:22); *He saith among the trumpets, Ha, ha; and he smelleth the battle afar off, the thunder of the captains, and the shouting* (39:25). The glory of the horse is breathtaking — and not one thread of it is man''s doing. Yahuah (LORD) gave it. The Psalm draws the lesson out: *He delighteth not in the strength of the horse: he taketh not pleasure in the legs of a man. Yahuah (LORD) taketh pleasure in them that fear him, in those that hope in his mercy* (Psalm 147:10-11). The Maker who clothed that neck with thunder is unimpressed by the very might he bestowed; man''s power, like the horse''s, is a loan from El — never a ground for boasting before the One who gave it.',
       sv.verse_id, ev.verse_id, 'free', 33751
  FROM _s318_job39_lookup sv, _s318_job39_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=39 AND sv.verse_number=19
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=39 AND ev.verse_number=25
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-39-the-provider-who-feeds-the-wild-ravens-feeds-his-people',
       E'The Provider Who Feeds the Wild Ravens Feeds His People',
       E'The chapter closes in the high places: *Doth the eagle mount up at thy command, and make her nest on high?* (Job 39:27); *She dwelleth and abideth on the rock... From thence she seeketh the prey, and her eyes behold afar off* (39:28-29). The eagle hunts and is fed — not by man''s hand, but by El''s. One chapter earlier the whirlwind had already named it: *Who provideth for the raven his food? when his young ones cry unto Elohim (God), they wander for lack of meat* (Job 38:41). The Psalms answer the same: *He giveth to the beast his food, and to the young ravens which cry* (Psalm 147:9); *These wait all upon thee; that thou mayest give them their meat in due season* (Psalm 104:27). The Provider over the wild is no absentee — every untended creature is fed. And Yahusha (Jesus) carries the whirlwind''s lesson straight forward to his people: *Behold the fowls of the air: for they sow not, neither do they reap, nor gather into barns; yet your heavenly Father feedeth them. Are ye not much better than they?* (Matthew 6:26); *Consider the ravens: for they neither sow nor reap; which neither have storehouse nor barn; and Elohim (God) feedeth them: how much more are ye better than the fowls?* (Luke 12:24). The same care that holds the wild raven holds the covenant household — *take no thought for your life*.',
       sv.verse_id, ev.verse_id, 'free', 33752
  FROM _s318_job39_lookup sv, _s318_job39_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=39 AND sv.verse_number=26
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=39 AND ev.verse_number=30
ON CONFLICT (slug) DO NOTHING;

-- ===== D. thread_members =====
-- T1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*They give drink to every beast of the field: the wild asses quench their thirst* (Psalm 104:11) — the free wild ass of Job 39:5 watered by the same hand that *sendeth the springs into the valleys*.'
  FROM cross_reference_threads t
  JOIN _s318_job39_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=39 AND sv.verse_number=5
  JOIN _s318_job39_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=104 AND tv.verse_number=11
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-39-the-wild-creatures-no-man-can-tame-bow-to-their-maker'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'*The high hills are a refuge for the wild goats; and the rocks for the conies* (Psalm 104:18) — the wild goats of the rock (Job 39:1,8) given their appointed refuge by Yahuah (LORD).'
  FROM cross_reference_threads t
  JOIN _s318_job39_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=39 AND sv.verse_number=8
  JOIN _s318_job39_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=104 AND tv.verse_number=18
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-39-the-wild-creatures-no-man-can-tame-bow-to-their-maker'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'*in wisdom hast thou made them all: the earth is full of thy riches* (Psalm 104:24) — the unbroken unicorn of Job 39:9-11 a piece of the wisdom that filled a free, untameable world.'
  FROM cross_reference_threads t
  JOIN _s318_job39_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=39 AND sv.verse_number=11
  JOIN _s318_job39_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=104 AND tv.verse_number=24
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-39-the-wild-creatures-no-man-can-tame-bow-to-their-maker'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- T2
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*He delighteth not in the strength of the horse: he taketh not pleasure in the legs of a man* (Psalm 147:10) — the One who *clothed his neck with thunder* (Job 39:19) is unimpressed by the very might he gave; strength is El''s loan, not man''s boast.'
  FROM cross_reference_threads t
  JOIN _s318_job39_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=39 AND sv.verse_number=19
  JOIN _s318_job39_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=147 AND tv.verse_number=10
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-39-the-war-horse-clothed-with-thunder-el-gave-his-strength'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- T3
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*Who provideth for the raven his food? when his young ones cry unto Elohim (God), they wander for lack of meat* (Job 38:41) — the whirlwind''s own answer one chapter before: the wild raven''s cry is heard and fed.'
  FROM cross_reference_threads t
  JOIN _s318_job39_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=39 AND sv.verse_number=29
  JOIN _s318_job39_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=38 AND tv.verse_number=41
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-39-the-provider-who-feeds-the-wild-ravens-feeds-his-people'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

