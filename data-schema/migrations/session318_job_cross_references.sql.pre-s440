 WHERE t.slug='job-35-they-cry-but-none-giveth-answer'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_36.sql (Job 36) -----
-- Job 36 — Elihu: El is mighty and just, the Teacher who disciplines in love.
-- session prefix: s318 | tag: job36 | temp view: _s318_job36_lookup
-- sort_order band start: 33675 (+1 per thread)
-- source: canon book_slug=job, chapter 36
--
-- THREADS (4):
--   1) job-36-the-eye-of-el-is-upon-the-righteous   [free]  band 33675
--        members: Ps 33:18, Ps 34:15, 1 Pet 3:12  (Tanakh + NT)
--   2) job-36-he-openeth-their-ear-to-discipline    [free]  band 33676
--        members: Ps 119:67, Ps 119:71, Deut 8:5, Heb 12:10, Heb 12:11  (Tanakh + NT)
--   3) job-36-who-teacheth-like-him                 [free]  band 33677
--        members: Isa 48:17, Ps 25:8, Ps 25:9, John 6:45  (Tanakh + NT)
--   4) job-36-el-is-great-and-we-know-him-not       [free]  band 33678
--        members: Ps 90:2, Ps 102:27, Rom 11:33  (Tanakh + NT)
--
-- CONTESTED / FRAMEWORK-LOAD-BEARING FRAMING:
--   * 36:8-10 affliction-as-discipline: framed as the GENUINE Father's chastening that opens
--     the teachable ear (Deut 8:5, Ps 119, Heb 12) — TRUE of the willing. But guarded: Elihu
--     wrongly presses it onto Job as proof of secret sin, and the book OVERTURNS that at
--     Job 42:7 ("ye have not spoken of me the thing that is right, as my servant Job hath").
--     The thread affirms chastening-that-opens-the-ear WITHOUT endorsing the accusation that
--     Job's suffering proves guilt.
--   * 36:22 "who teacheth like him": El the supreme Teacher = the Formed Son who teaches and
--     HAS a Father (John 6:45 — "learned of the Father, cometh unto me"). NO co-equal grammar.
--
-- COVERAGE CHECKLIST:
--   v.5,7  El mighty / eye on the righteous:
--        NT:     1 Peter 3:12 (eyes over the righteous) — USED (thread 1)
--        Extras: none warranted
--        Tanakh: Psalm 33:18, Psalm 34:15 — USED (thread 1)
--   v.8-10,15  bound in fetters / openeth the ear to discipline:
--        NT:     Hebrews 12:10-11 (chastening yields peaceable fruit) — USED (thread 2)
--        Extras: none warranted (Sirach has affliction-as-trial material but Heb/Deut/Ps
--                carry the framework cleanly; no extras member needed)
--        Tanakh: Psalm 119:67, Psalm 119:71, Deuteronomy 8:5 — USED (thread 2)
--   v.16-21  the strait / broad place / wrath / ransom:  woven into thread 2 prose; no standalone
--        NT:     none warranted   Extras: none warranted   Tanakh: none warranted (Elihu's accusation, guarded)
--   v.22  El exalteth / who teacheth like him:
--        NT:     John 6:45 (taught of Elohim, learned of the Father) — USED (thread 3)
--        Extras: none warranted
--        Tanakh: Isaiah 48:17, Psalm 25:8, Psalm 25:9 — USED (thread 3)
--   v.26  El is great, we know him not, his years unsearchable:
--        NT:     Romans 11:33 (unsearchable judgments, ways past finding out) — USED (thread 4)
--        Extras: none warranted
--        Tanakh: Psalm 90:2, Psalm 102:27 — USED (thread 4)
--   v.27-33  rain, clouds, the prelude to the storm-theophany:
--        NT:     none warranted   Extras: none warranted
--        Tanakh: none warranted (sign-post to the Yahuah-out-of-the-whirlwind theophany ch38;
--                left for the Job 37-38 threads to carry)

CREATE TEMP VIEW _s318_job36_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===================== B. cross_references =====================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: the eye of El is upon the righteous (36:5,7)
    ('canon','job',36,7,'canon','psalms',33,18,'free',
      E'Elihu says of the righteous, *He withdraweth not his eyes from the righteous: but with kings are they on the throne; yea, he doth establish them for ever, and they are exalted* (Job 36:7). The Psalm sings the same watchful eye: *Behold, the eye of Yahuah (LORD) is upon them that fear him, upon them that hope in his mercy* (Psalm 33:18). El''s gaze on the righteous is not surveillance for accusation but the keeping eye of mercy.'),
    ('canon','job',36,7,'canon','psalms',34,15,'free',
      E'*The eyes of Yahuah (LORD) are upon the righteous, and his ears are open unto their cry* (Psalm 34:15). Where Elihu says *He withdraweth not his eyes from the righteous* (Job 36:7), the Psalm adds the open ear — the same El who watches also hears the cry of the afflicted just one.'),
    ('canon','job',36,7,'canon','1-peter',3,12,'free',
      E'Kepha (Peter) carries the very eye and ear forward: *For the eyes of Yahuah (Lord) are over the righteous, and his ears are open unto their prayers: but the face of Yahuah (Lord) is against them that do evil* (1 Peter 3:12). Elihu''s *He withdraweth not his eyes from the righteous* (Job 36:7) and *He preserveth not the life of the wicked* (Job 36:6) are the same two-sided gaze the apostle quotes from Psalm 34 — watching to keep the just, set against the wicked.'),

    -- Thread 2: he openeth their ear to discipline (36:8-10,15)
    ('canon','job',36,10,'canon','psalms',119,67,'free',
      E'*He openeth also their ear to discipline, and commandeth that they return from iniquity* (Job 36:10). The psalmist confesses the very opening of that ear through affliction: *Before I was afflicted I went astray: but now have I kept thy word* (Psalm 119:67). The discipline that opens the ear bends the wanderer back to the covenant word.'),
    ('canon','job',36,10,'canon','psalms',119,71,'free',
      E'*It is good for me that I have been afflicted; that I might learn thy statutes* (Psalm 119:71). This is Elihu''s *He openeth also their ear to discipline* (Job 36:10) sung from the inside — affliction received as the schooling that teaches the Torah''s statutes, the chastening that calls to *return from iniquity*.'),
    ('canon','job',36,8,'canon','deuteronomy',8,5,'free',
      E'Moses names the chastening as a father''s: *Thou shalt also consider in thine heart, that, as a man chasteneth his son, so Yahuah Elohayka (the LORD thy God) chasteneth thee* (Deuteronomy 8:5). Elihu''s *if they be bound in fetters, and be holden in cords of affliction* (Job 36:8) is true of the teachable son — yet Elihu wrongly presses it onto Job as proof of hidden guilt, and the book overturns that charge (Job 42:7). The genuine cords are a Father''s correction, not a verdict of secret sin.'),
    ('canon','job',36,8,'canon','hebrews',12,10,'free',
      E'The Letter to the Ibrim (Hebrews) carries the Father''s chastening forward: *For they verily for a few days chastened us after their own pleasure; but he for our profit, that we might be partakers of his holiness* (Hebrews 12:10). Elihu''s *cords of affliction* (Job 36:8) that *openeth their ear to discipline* (36:10) are, in the teachable, this profit-bearing chastening — never the proof of guilt Elihu mistakes it for (Job 42:7).'),
    ('canon','job',36,10,'canon','hebrews',12,11,'free',
      E'*Now no chastening for the present seemeth to be joyous, but grievous: nevertheless afterward it yieldeth the peaceable fruit of righteousness unto them which are exercised thereby* (Hebrews 12:11). This is the harvest of Elihu''s opened ear — *He openeth also their ear to discipline, and commandeth that they return from iniquity* (Job 36:10) — the after-fruit of the discipline that bends the just back to the way.'),

    -- Thread 3: who teacheth like him (36:22)
    ('canon','job',36,22,'canon','isaiah',48,17,'free',
      E'*Behold, Elohim (God) exalteth by his power: who teacheth like him?* (Job 36:22). Yeshayahu (Isaiah) answers with the Teacher''s own voice: *Thus saith Yahuah (LORD), thy Redeemer, the Holy One of Yashar''el (Israel); I am Yahuah Elohayka (the LORD thy God) which teacheth thee to profit, which leadeth thee by the way that thou shouldest go* (Isaiah 48:17). None teaches like the El who is also Redeemer and Guide.'),
    ('canon','job',36,22,'canon','psalms',25,8,'free',
      E'*Good and upright is Yahuah (LORD): therefore will he teach sinners in the way* (Psalm 25:8). Elihu''s *who teacheth like him?* (Job 36:22) is answered: the supreme Teacher stoops to teach even sinners the way — goodness, not merely might, is the root of his instruction.'),
    ('canon','job',36,22,'canon','psalms',25,9,'free',
      E'*The meek will he guide in judgment: and the meek will he teach his way* (Psalm 25:9). The El of whom Elihu asks *who teacheth like him?* (Job 36:22) teaches the lowly his way — the very meekness Job is being driven toward, taught not by Elihu''s accusation but by El himself.'),
    ('canon','job',36,22,'canon','john',6,45,'free',
      E'The Formed Son names this teaching El and binds it to the Father: *It is written in the prophets, And they shall be all taught of Elohim (God). Every man therefore that hath heard, and hath learned of the Father, cometh unto me* (John 6:45). Elihu''s *who teacheth like him?* (Job 36:22) finds its fullness here — the Son who teaches is the One drawn from the Father, who himself learned of and points to the Father; he teaches as none other, and he HAS a Father.'),

    -- Thread 4: El is great, and we know him not (36:26)
    ('canon','job',36,26,'canon','psalms',90,2,'free',
      E'*Behold, Elohim (God) is great, and we know him not, neither can the number of his years be searched out* (Job 36:26). Moses'' psalm measures those unsearchable years: *Before the mountains were brought forth, or ever thou hadst formed the earth and the world, even from everlasting to everlasting, thou art Elohim (God)* (Psalm 90:2). The years that cannot be numbered are the everlasting-to-everlasting of the eternal One.'),
    ('canon','job',36,26,'canon','psalms',102,27,'free',
      E'*But thou art the same, and thy years shall have no end* (Psalm 102:27). Where Elihu says *neither can the number of his years be searched out* (Job 36:26), the Psalm gives the reason no number reaches them — they have no end; the unchanging One outlasts the heavens that perish.'),
    ('canon','job',36,26,'canon','romans',11,33,'free',
      E'Sha''ul (Paul) breaks into the same wonder: *O the depth of the riches both of the wisdom and knowledge of Elohim (God)! how unsearchable are his judgments, and his ways past finding out!* (Romans 11:33). Elihu''s *Elohim (God) is great, and we know him not* (Job 36:26) is this confession early — the El whose years and ways alike are past searching out.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job36_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job36_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===================== C. threads =====================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-36-the-eye-of-el-is-upon-the-righteous',
       E'The eye of El is upon the righteous',
       E'Elihu testifies that El does not look away from the just: *He withdraweth not his eyes from the righteous: but with kings are they on the throne; yea, he doth establish them for ever, and they are exalted* (Job 36:7), set against *He preserveth not the life of the wicked* (Job 36:6). The Psalms sing the same watchful gaze — *Behold, the eye of Yahuah (LORD) is upon them that fear him, upon them that hope in his mercy* (Psalm 33:18); *The eyes of Yahuah (LORD) are upon the righteous, and his ears are open unto their cry* (Psalm 34:15) — the eye that watches and the ear that hears. Kepha (Peter) gathers both forward: *For the eyes of Yahuah (Lord) are over the righteous, and his ears are open unto their prayers: but the face of Yahuah (Lord) is against them that do evil* (1 Peter 3:12). The two-sided gaze Elihu names — keeping the just, set against the wicked — is the same the apostle quotes whole.',
       sv.verse_id, ev.verse_id, 'free', 33675
  FROM _s318_job36_lookup sv, _s318_job36_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=36 AND sv.verse_number=5
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=36 AND ev.verse_number=7
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-36-he-openeth-their-ear-to-discipline',
       E'He openeth their ear to discipline',
       E'*And if they be bound in fetters, and be holden in cords of affliction... He openeth also their ear to discipline, and commandeth that they return from iniquity* (Job 36:8,10); *He delivereth the poor in his affliction, and openeth their ears in oppression* (Job 36:15). The psalmist sings this very opening from inside: *Before I was afflicted I went astray: but now have I kept thy word* (Psalm 119:67); *It is good for me that I have been afflicted; that I might learn thy statutes* (Psalm 119:71). Moses names the cords a Father''s hand — *as a man chasteneth his son, so Yahuah Elohayka (the LORD thy God) chasteneth thee* (Deuteronomy 8:5) — and the Letter to the Ibrim (Hebrews) carries it whole: *he for our profit, that we might be partakers of his holiness* (Hebrews 12:10), and *afterward it yieldeth the peaceable fruit of righteousness unto them which are exercised thereby* (Hebrews 12:11). GUARD: this chastening-that-opens-the-ear is true of the teachable son, but Elihu wrongly wields it as proof that Job''s suffering exposes hidden sin — and the book overturns that very charge, *ye have not spoken of me the thing that is right, as my servant Job hath* (Job 42:7). The genuine cords are a Father''s correction calling the wanderer back to the Torah''s statutes, never a verdict that affliction proves guilt.',
       sv.verse_id, ev.verse_id, 'free', 33676
  FROM _s318_job36_lookup sv, _s318_job36_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=36 AND sv.verse_number=8
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=36 AND ev.verse_number=15
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-36-who-teacheth-like-him',
       E'Who teacheth like him',
       E'*Behold, Elohim (God) exalteth by his power: who teacheth like him?* (Job 36:22). Yeshayahu (Isaiah) answers in the Teacher''s own voice: *I am Yahuah Elohayka (the LORD thy God) which teacheth thee to profit, which leadeth thee by the way that thou shouldest go* (Isaiah 48:17) — the Teacher who is also Redeemer. The Psalm shows his teaching stooping low: *Good and upright is Yahuah (LORD): therefore will he teach sinners in the way* (Psalm 25:8); *The meek will he guide in judgment: and the meek will he teach his way* (Psalm 25:9). The Formed Son binds this teaching El to the Father: *It is written in the prophets, And they shall be all taught of Elohim (God). Every man therefore that hath heard, and hath learned of the Father, cometh unto me* (John 6:45). None teaches like him — and the Son who teaches is himself drawn from and points to the Father; he is Yahuah and he HAS a Father.',
       sv.verse_id, ev.verse_id, 'free', 33677
  FROM _s318_job36_lookup sv, _s318_job36_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=36 AND sv.verse_number=22
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=36 AND ev.verse_number=22
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-36-el-is-great-and-we-know-him-not',
       E'El is great, and we know him not',
       E'*Behold, Elohim (God) is great, and we know him not, neither can the number of his years be searched out* (Job 36:26). Moses'' psalm measures those unsearchable years: *Before the mountains were brought forth, or ever thou hadst formed the earth and the world, even from everlasting to everlasting, thou art Elohim (God)* (Psalm 90:2), and another Psalm gives why no number reaches them: *But thou art the same, and thy years shall have no end* (Psalm 102:27). Sha''ul (Paul) breaks into the same wonder: *O the depth of the riches both of the wisdom and knowledge of Elohim (God)! how unsearchable are his judgments, and his ways past finding out!* (Romans 11:33). The El whose years cannot be numbered is the everlasting One whose ways are likewise past finding out — known truly, yet never exhausted by the creature''s knowing.',
       sv.verse_id, ev.verse_id, 'free', 33678
  FROM _s318_job36_lookup sv, _s318_job36_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=36 AND sv.verse_number=26
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=36 AND ev.verse_number=26
ON CONFLICT (slug) DO NOTHING;

-- ===================== D. thread_members =====================
-- Thread 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*Behold, the eye of Yahuah (LORD) is upon them that fear him* (Psalm 33:18) — the watchful eye of mercy Elihu names in *He withdraweth not his eyes from the righteous* (Job 36:7).'
  FROM cross_reference_threads t
  JOIN _s318_job36_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=36 AND sv.verse_number=7
  JOIN _s318_job36_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=33 AND tv.verse_number=18
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-36-the-eye-of-el-is-upon-the-righteous'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'*The eyes of Yahuah (LORD) are upon the righteous, and his ears are open unto their cry* (Psalm 34:15) — the eye that watches joined to the ear that hears.'
  FROM cross_reference_threads t
  JOIN _s318_job36_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=36 AND sv.verse_number=7
  JOIN _s318_job36_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=34 AND tv.verse_number=15
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-36-the-eye-of-el-is-upon-the-righteous'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

