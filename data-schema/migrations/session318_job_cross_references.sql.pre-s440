-- ----- fragment: minion_job_21.sql (Job 21) -----
-- Chapter: Job 21 — Job's reply: the wicked DO prosper (the demolition of the friends' retribution doctrine)
-- Tag: job21   Session prefix: s318   Temp view: _s318_job21_lookup
-- Sort band: 33300 + 1 per thread (33300, 33301, 33302, 33303)
-- Source book_slug=job, chapter 21 (canon edition).
--
-- FRAMING: Job 21 is the canon's OWN refutation of the prosperity-gospel / retribution lie.
-- The friends preached "the righteous prosper, the wicked perish" — suffering proves sin,
-- wealth proves righteousness. Job 21:7 names the real-world fact they deny: the wicked DO
-- live, grow old, grow mighty; their houses are safe, their children dance, they spend their
-- days in wealth and "in a moment go down to the grave" (21:7-13). Job is vindicated by
-- Yahuah himself (Job 42:7 — the friends "have not spoken of me the thing that is right").
-- The answer is NOT present prosperity but the day of wrath, the deferred final judgment
-- (21:30) — understood only "in the sanctuary" (Ps 73:17) and at the great reversal
-- (Luke 16:25). Asaph (Ps 73), Jeremiah (12:1), and Malachi (3:15) name the IDENTICAL fact.
--
-- Job 21 coverage:
--   v.7-13 (the wicked live, grow mighty, prosper, die in a moment):
--        NT:     none warranted (the Luke 16:25 reversal is carried at the 21:30-34 block)
--        Extras: Wisdom of Solomon 2:6-9 (the ungodly's "let us enjoy the good things present")
--        Tanakh: Psalm 73:3-12 (Asaph envied the prosperity of the wicked), Jeremiah 12:1
--                (wherefore doth the way of the wicked prosper), Malachi 3:15 (we call the proud happy)
--   v.14-15 (they say unto El, Depart from us; we desire not the knowledge of thy ways):
--        NT:     none warranted
--        Extras: Wisdom of Solomon 2:12,16 (the ungodly lie in wait for the righteous, deride his El-as-father)
--        Tanakh: Psalm 73:11 (How doth Elohim know?), Malachi 3:14 (it is vain to serve Elohim)
--   v.16-21 (the candle of the wicked put out; El layeth up his iniquity for his children):
--        NT:     none warranted
--        Extras: Wisdom of Solomon 5:14 (hope of the ungodly is as dust blown away),
--                Ecclesiasticus 11:19 (he knoweth not what time shall come upon him, must die)
--        Tanakh: Psalm 73:18-19 (set in slippery places, brought into desolation in a moment)
--   v.22-26 (one dieth at ease, another in bitterness; alike in the dust):
--        NT:     none warranted   Extras: none warranted (death-levels-all carried in prose)
--        Tanakh: none warranted (folded into v.16-21 thread's framing)
--   v.27-29 (I know your thoughts; ye say Where is the house of the prince):
--        NT:/Extras:/Tanakh: none warranted (transitional, the rebuttal turns to v.30)
--   v.30-34 (the wicked reserved to the day of destruction / day of wrath; how comfort ye me in vain):
--        NT:     Luke 16:25 (the great reversal — thy good things now, his evil things now)
--        Extras: Wisdom of Solomon 5:1-3 (the righteous stand in boldness; the wicked repent too late)
--        Tanakh: Psalm 73:17 (until I went into the sanctuary; then understood I their end),
--                Malachi 3:18 (then shall ye discern between the righteous and the wicked)
--
-- Threads (4):
--   1. job-21-wherefore-do-the-wicked-live           [Tanakh + Extras]  band 33300
--   2. job-21-they-say-unto-el-depart-from-us         [Tanakh + Extras]  band 33301
--   3. job-21-the-candle-of-the-wicked-put-out        [Tanakh + Extras]  band 33302
--   4. job-21-then-understood-i-their-end             [Tanakh + NT + Extras] band 33303

-- ===================================================================
-- A. TEMP VIEW
-- ===================================================================
CREATE TEMP VIEW _s318_job21_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===================================================================
-- B. cross_references
-- ===================================================================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: Wherefore do the wicked live (21:7-13)
    ('canon','job',21,7,'canon','psalms',73,3,'free',
     E'Asaph names the same scandal Job names: ''For I was envious at the foolish, when I saw the prosperity of the wicked'' (Psalm 73:3). Job''s ''Wherefore do the wicked live, become old, yea, are mighty in power?'' (Job 21:7) is not doubt but observation — the real-world fact the friends'' retribution doctrine cannot survive.'),
    ('canon','job',21,8,'canon','psalms',73,12,'free',
     E'Asaph''s verdict matches Job''s catalogue: ''Behold, these are the ungodly, who prosper in the world; they increase in riches'' (Psalm 73:12). Job''s ''Their seed is established in their sight with them, and their offspring before their eyes'' (Job 21:8) dismantles the lie that the wicked are cut off in this life.'),
    ('canon','job',21,7,'canon','jeremiah',12,1,'free',
     E'Jeremiah pleads the identical complaint: ''Righteous art thou, O Yahuah (LORD)... yet let me talk with thee of thy judgments: Wherefore doth the way of the wicked prosper? wherefore are all they happy that deal very treacherously?'' (Jeremiah 12:1). The prophet, like Job, refuses to pretend the wicked are punished in the present.'),
    ('canon','job',21,13,'canon','malachi',3,15,'free',
     E'Malachi quotes the same hard fact: ''And now we call the proud happy; yea, they that work wickedness are set up; yea, they that tempt Elohim (God) are even delivered'' (Malachi 3:15). Job''s ''They spend their days in wealth, and in a moment go down to the grave'' (Job 21:13) is the very prosperity the canon repeatedly refuses to deny.'),
    ('canon','job',21,12,'apocrypha','the-wisdom-of-solomon',2,6,'extras',
     E'The ungodly''s own creed, given voice: ''Come on therefore, let us enjoy the good things that are present: and let us speedily use the creatures like as in youth'' (Wisdom of Solomon 2:6). Job''s wicked who ''take the timbrel and harp, and rejoice at the sound of the organ'' (Job 21:12) are the same revellers who treat present pleasure as their whole portion.'),

    -- Thread 2: They say unto El, Depart from us (21:14-15)
    ('canon','job',21,14,'canon','psalms',73,11,'free',
     E'The wicked''s creed in Asaph''s mouth: ''And they say, How doth Elohim (God) know? and is there knowledge in the El Elyon (most High)?'' (Psalm 73:11). Job''s wicked say it plainer — ''Depart from us; for we desire not the knowledge of thy ways'' (Job 21:14): prosperity has taught them to deny that El judges or even sees.'),
    ('canon','job',21,15,'canon','malachi',3,14,'free',
     E'Malachi gives the wicked''s cost-accounting: ''Ye have said, It is vain to serve Elohim (God): and what profit is it that we have kept his ordinance?'' (Malachi 3:14). Job''s wicked reason the same way — ''What is the Almighty, that we should serve him? and what profit should we have, if we pray unto him?'' (Job 21:15): they weigh obedience by present gain alone.'),
    ('canon','job',21,15,'apocrypha','the-wisdom-of-solomon',2,16,'extras',
     E'Wisdom unmasks the same contempt: ''We are esteemed of him as counterfeits: he abstaineth from our ways as from filthiness... and makes his boast that Yahuah (God) is his father'' (Wisdom of Solomon 2:16). The wicked who ask ''What is the Almighty, that we should serve him?'' (Job 21:15) despise the knowledge of his ways as the deluded do who lie in wait for the righteous.'),

    -- Thread 3: The candle of the wicked put out (21:16-21)
    ('canon','job',21,18,'canon','psalms',73,18,'free',
     E'Asaph answers Job''s rhetorical ''How oft cometh their destruction?'': ''Surely thou didst set them in slippery places: thou castedst them down into destruction'' (Psalm 73:18). Job''s wicked who are ''as stubble before the wind, and as chaff that the storm carrieth away'' (Job 21:18) meet exactly that slippery footing — but in Yahuah''s time, not the friends''.'),
    ('canon','job',21,17,'canon','psalms',73,19,'free',
     E'The destruction Job questions comes suddenly when it comes: ''How are they brought into desolation, as in a moment! they are utterly consumed with terrors'' (Psalm 73:19). Job asks ''How oft is the candle of the wicked put out!'' (Job 21:17) — challenging the friends'' claim that it happens reliably and now.'),
    ('canon','job',21,19,'apocrypha','ecclesiasticus',11,19,'extras',
     E'Ben Sira draws the same lesson on the rich man''s false security: ''Whereas he says, I have found rest, and now will eat continually of my goods; and yet he knoweth not what time shall come upon him, and that he must leave those things to others, and die'' (Ecclesiasticus 11:19). Where Job protests ''Elohim (God) layeth up his iniquity for his children'' (Job 21:19), the reckoning is real but reserved.'),
    ('canon','job',21,18,'apocrypha','the-wisdom-of-solomon',5,14,'extras',
     E'Wisdom seals the wicked''s end the friends could not deliver on schedule: ''For the hope of the ungodly is like dust that is blown away with the wind; like a thin froth that is driven away with the storm... and passeth away as the remembrance of a guest that tarrieth but a day'' (Wisdom of Solomon 5:14). Job''s ''stubble before the wind... chaff that the storm carrieth away'' (Job 21:18) is the same vanishing — at the end, not the middle.'),

    -- Thread 4: Then understood I their end (21:30-34)
    ('canon','job',21,30,'canon','psalms',73,17,'free',
     E'Asaph found the resolution Job points toward: ''Until I went into the sanctuary of Elohim (God); then understood I their end'' (Psalm 73:17). Job already saw it — ''the wicked is reserved to the day of destruction... brought forth to the day of wrath'' (Job 21:30): the measure is the end, not the middle.'),
    ('canon','job',21,30,'canon','malachi',3,18,'free',
     E'Malachi promises the discernment the friends thought they already had: ''Then shall ye return, and discern between the righteous and the wicked, between him that serveth Elohim (God) and him that serveth him not'' (Malachi 3:18). Job insists the verdict belongs to ''the day of wrath'' (Job 21:30), when the reserved reckoning is at last revealed.'),
    ('canon','job',21,30,'canon','luke',16,25,'free',
     E'Messiah tells the reversal in full: ''Son, remember that thou in thy lifetime receivedst thy good things, and likewise Lazarus evil things: but now he is comforted, and thou art tormented'' (Luke 16:25). The wicked ''reserved to the day of destruction'' (Job 21:30) spend their good things now and account for them after — the friends'' books are balanced beyond the grave.'),
    ('canon','job',21,30,'apocrypha','the-wisdom-of-solomon',5,3,'extras',
     E'Wisdom shows the wicked''s too-late repentance at the day Job foretells: ''And they repenting and groaning for anguish of spirit shall say within themselves, This was he, whom we had sometimes in derision, and a proverb of reproach'' (Wisdom of Solomon 5:3). The wicked ''brought forth to the day of wrath'' (Job 21:30) face there the righteous they once despised.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job21_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job21_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===================================================================
-- C. cross_reference_threads
-- ===================================================================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-21-wherefore-do-the-wicked-live',
       E'Wherefore Do the Wicked Live? — Job Demolishes the Retribution Lie',
       E'The friends preached a tidy ledger: the righteous prosper, the wicked perish — suffering proves sin, wealth proves righteousness. Job answers with the one thing their doctrine cannot survive, the plain fact: *Wherefore do the wicked live, become old, yea, are mighty in power?* (Job 21:7). He spreads the evidence out — *Their seed is established in their sight with them, and their offspring before their eyes* (Job 21:8); *Their houses are safe from fear, neither is the rod of Elohim (God) upon them* (Job 21:9); their children dance, *They take the timbrel and harp, and rejoice at the sound of the organ* (Job 21:12); and the verdict, *They spend their days in wealth, and in a moment go down to the grave* (Job 21:13). This is not the speech of a doubting man but of an honest one, and Yahuah will vindicate it (Job 42:7). The canon names the same scandal again and again. Asaph: *For I was envious at the foolish, when I saw the prosperity of the wicked* (Psalm 73:3); *Behold, these are the ungodly, who prosper in the world; they increase in riches* (Psalm 73:12). Jeremiah: *Wherefore doth the way of the wicked prosper? wherefore are all they happy that deal very treacherously?* (Jeremiah 12:1). Malachi: *And now we call the proud happy; yea, they that work wickedness are set up* (Malachi 3:15). And the restored library gives the wicked''s own creed: *Come on therefore, let us enjoy the good things that are present: and let us speedily use the creatures like as in youth* (Wisdom of Solomon 2:6). The prosperity-gospel — that wealth is a sign of favour and affliction a sign of guilt — is the friends'' error, and Scripture refutes it from its own mouth.',
       sv.verse_id, ev.verse_id, 'extras', 33300
  FROM _s318_job21_lookup sv, _s318_job21_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=21 AND sv.verse_number=7
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=21 AND ev.verse_number=13
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-21-they-say-unto-el-depart-from-us',
       E'Depart From Us — The Creed of the Prospering Wicked',
       E'Prosperity, untested by adversity, breeds contempt for the One who gives it. Job hears the wicked say it openly: *Therefore they say unto Elohim (God), Depart from us; for we desire not the knowledge of thy ways* (Job 21:14); *What is the Almighty, that we should serve him? and what profit should we have, if we pray unto him?* (Job 21:15). It is a cost-accounting of obedience: they weigh serving Yahuah by present gain alone, and finding their barns already full, they dismiss him. Asaph caught the same arrogance: *And they say, How doth Elohim (God) know? and is there knowledge in the El Elyon (most High)?* (Psalm 73:11). Malachi caught it among the covenant people themselves: *Ye have said, It is vain to serve Elohim (God): and what profit is it that we have kept his ordinance?* (Malachi 3:14) — the very same profit-and-loss reasoning Job''s wicked use. And the restored Wisdom of Solomon unmasks where it leads: the ungodly esteem the righteous a counterfeit, despise that he *makes his boast that Yahuah (God) is his father* (Wisdom of Solomon 2:16), and lie in wait for him. Note carefully: the offense is not Torah-keeping but its abandonment. These are men who *desire not the knowledge of thy ways* — the ways being Yahuah''s instruction, his covenant walk. The prosperity that should have drawn them to thanksgiving has instead taught them to push El away.',
       sv.verse_id, ev.verse_id, 'extras', 33301
  FROM _s318_job21_lookup sv, _s318_job21_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=21 AND sv.verse_number=14
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=21 AND ev.verse_number=15
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-21-the-candle-of-the-wicked-put-out',
       E'How Oft Is the Candle of the Wicked Put Out? — The Reckoning Is Reserved, Not Immediate',
       E'The friends insisted the wicked are punished promptly and visibly — so Job turns their own slogan into a question: *How oft is the candle of the wicked put out! and how oft cometh their destruction upon them!* (Job 21:17). Not nearly so oft as their doctrine requires. He grants that judgment is real — *They are as stubble before the wind, and as chaff that the storm carrieth away* (Job 21:18); *Elohim (God) layeth up his iniquity for his children* (Job 21:19) — but insists it is *laid up*, reserved, not handed out on the friends'' timetable. Asaph confirms both halves: the wicked do fall, *Surely thou didst set them in slippery places: thou castedst them down into destruction* (Psalm 73:18); *How are they brought into desolation, as in a moment! they are utterly consumed with terrors* (Psalm 73:19) — but suddenly, in Yahuah''s hour, not on demand. The restored library teaches the same patience. Ben Sira on the secure rich man: *he knoweth not what time shall come upon him, and that he must leave those things to others, and die* (Ecclesiasticus 11:19). And Wisdom on the wicked''s end: *For the hope of the ungodly is like dust that is blown away with the wind... and passeth away as the remembrance of a guest that tarrieth but a day* (Wisdom of Solomon 5:14). Job''s chaff and stubble vanish — but at the appointed end, which is precisely why present prosperity proves nothing about a man''s standing before Yahuah.',
       sv.verse_id, ev.verse_id, 'extras', 33302
  FROM _s318_job21_lookup sv, _s318_job21_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=21 AND sv.verse_number=16
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=21 AND ev.verse_number=21
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-21-then-understood-i-their-end',
       E'Reserved to the Day of Wrath — The End, Not the Middle, Is the Measure',
       E'Job gives the answer his friends never reached: present prosperity is no verdict, because the verdict is reserved for *the day of destruction*. *That the wicked is reserved to the day of destruction? they shall be brought forth to the day of wrath* (Job 21:30). The man who flourishes now still answers later — *Yet shall he be brought to the grave* (Job 21:32) — and so Job''s closing rebuke lands: *How then comfort ye me in vain, seeing in your answers there remaineth falsehood?* (Job 21:34). Their whole comfort was built on a measure the canon rejects. Asaph found the same resolution only when he stopped counting the present: *Until I went into the sanctuary of Elohim (God); then understood I their end* (Psalm 73:17). Malachi promises that discernment is coming: *Then shall ye return, and discern between the righteous and the wicked, between him that serveth Elohim (God) and him that serveth him not* (Malachi 3:18). Messiah tells the reversal in full — the rich man who fared sumptuously and the beggar at his gate trade places beyond death: *Son, remember that thou in thy lifetime receivedst thy good things, and likewise Lazarus evil things: but now he is comforted, and thou art tormented* (Luke 16:25). And Wisdom of Solomon shows the wicked''s too-late awakening at that very day: *they repenting and groaning for anguish of spirit shall say within themselves, This was he, whom we had sometimes in derision, and a proverb of reproach* (Wisdom of Solomon 5:3). Job is vindicated (Job 42:7): wealth is no proof of righteousness, and affliction no proof of sin — the books are balanced at the end.',
       sv.verse_id, ev.verse_id, 'extras', 33303
  FROM _s318_job21_lookup sv, _s318_job21_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=21 AND sv.verse_number=30
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=21 AND ev.verse_number=34
ON CONFLICT (slug) DO NOTHING;

-- ===================================================================
-- D. cross_reference_thread_members
-- ===================================================================
-- Thread 1: job-21-wherefore-do-the-wicked-live
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'Asaph''s confession — ''I was envious at the foolish, when I saw the prosperity of the wicked'' (Psalm 73:3): the identical scandal Job names.'
  FROM cross_reference_threads t
  JOIN _s318_job21_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=21 AND sv.verse_number=7
  JOIN _s318_job21_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=73 AND tv.verse_number=3
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-21-wherefore-do-the-wicked-live'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

