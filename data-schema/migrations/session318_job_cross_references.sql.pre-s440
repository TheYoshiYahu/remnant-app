 WHERE t.slug='job-28-the-price-of-wisdom-is-above-rubies-tree-of-life'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'Proverbs 3:18 — *She is a tree of life to them that lay hold upon her* — beyond Job 28:19''s topaz and pure gold lies Eden restored.'
  FROM cross_reference_threads t
  JOIN _s318_job28_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=28 AND sv.verse_number=19
  JOIN _s318_job28_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='proverbs' AND tv.chapter_number=3 AND tv.verse_number=18
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-28-the-price-of-wisdom-is-above-rubies-tree-of-life'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_29.sql (Job 29) -----
-- Job 29 — Job remembers his former days of honour and righteous rule
-- tag: job29 ; session prefix: s318 ; temp view: _s318_job29_lookup
-- slug prefix: job-29-... ; sort_order band start 33500 (+1 per thread)
--
-- Job 29 coverage:
--   v.2-3  (Oh that I were as in months past... when his candle shined upon my head, and when by his light I walked through darkness)
--          NT:     none warranted (light/lamp answered forward only lightly; the lateral Tanakh witness is stronger here)
--          Extras: none warranted
--          Tanakh: Ps 18:28 (thou wilt light my candle), Ps 119:105 (thy word is a lamp unto my feet)  [THREAD 1]
--   v.4-5  (the secret of Elohim upon my tabernacle... when the Almighty was yet with me)
--          NT/Extras/Tanakh: none warranted (the lost-fellowship note folds into THREAD 1 prose; no separate strong target)
--   v.6-11 (washed my steps with butter... the ear heard me and blessed me)
--          none warranted (scene-setting of the honour Job held; witnessed-by-eye folds toward the righteous-deeds thread)
--   v.12-17 ★ (I delivered the poor... the fatherless... eyes to the blind, feet to the lame... a father to the poor... brake the jaws of the wicked)
--          NT:     Isa61:1→Luke4:18 + Matt25:35-36/40 (the Servant''s works; eyes-to-blind/feet-to-lame anticipated)  [THREAD 3]
--          Extras: Ecclesiasticus(Sirach) 4:10 (be as a father to the fatherless)  [THREAD 2]
--          Tanakh: Job22:9 (the slander answered), Deut10:18 (judgment of fatherless & widow), Isa1:17 (plead for the widow), Ps72:12-14 (righteous king delivers the needy)  [THREADS 2 & 3]
--   v.18-20 (I shall die in my nest... my root was spread out by the waters... my glory fresh, my bow renewed)
--          NT:     none warranted
--          Extras: none warranted
--          Tanakh: Ps1:3 (tree planted by rivers of water), Jer17:8 (tree planted by the waters, spreadeth out her roots)  [THREAD 4]
--   v.21-25 (men gave ear... waited for me as for the rain... I sat chief, dwelt as a king... comforteth the mourners)
--          none warranted (folds into THREAD 1/THREAD 2 prose as the picture of the righteous-ruler''s honour now mourned)
--
-- THREADS:
--   1. job-29-the-candle-of-Yahuah-shined-upon-my-head        (free)   Tanakh: Ps18:28, Ps119:105
--   2. job-29-i-delivered-the-poor-the-fatherless-covenant-justice-enacted (extras) Tanakh: Job22:9, Deut10:18, Isa1:17 ; Extras: Sirach4:10
--   3. job-29-eyes-to-the-blind-feet-to-the-lame-the-servants-works (free) Tanakh: Ps72:12 ; NT: Isa61:1, Luke4:18, Matt25:35
--   4. job-29-my-root-was-spread-out-by-the-waters             (free)   Tanakh: Ps1:3, Jer17:8
--
-- GUARD: Job''s righteous deeds (29:12-17) = genuine covenant-justice — the Torah''s protection of
-- widow/orphan/poor ENACTED, the answer to Eliphaz''s false slander (Job 22:6-9), the works that flow
-- from the fear of Yahuah, NEVER works-as-flesh-merit. The candle of Yahuah = the fellowship/light Job
-- mourns losing, answered forward in the true Light.

CREATE TEMP VIEW _s318_job29_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================ B. cross_references ============================
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- THREAD 1: the candle / lamp of Yahuah (29:2-3)
    ('canon','job',29,3,'canon','psalms',18,28,'free',
     E'*For thou wilt light my candle: Yahuah Elohai (the LORD my God) will enlighten my darkness.* (Psalm 18:28). Job mourns the very thing the psalmist sings as restored — *when his candle shined upon my head, and when by his light I walked through darkness* (Job 29:3). The lamp of Yahuah is not Job''s own light but the fellowship of the Almighty given, and Job grieves its loss, knowing the light is His to give and His to take.'),
    ('canon','job',29,3,'canon','psalms',119,105,'free',
     E'*Thy word is a lamp unto my feet, and a light unto my path.* (Psalm 119:105). Job''s *by his light I walked through darkness* (Job 29:3) is the same lamp: it is Yahuah''s word and presence that lights the righteous walk, never a man''s own brightness. To lose the candle is to lose the path.'),

    -- THREAD 2: covenant-justice enacted — the answer to the slander of ch 22 (29:12-17)
    ('canon','job',29,12,'canon','job',22,9,'free',
     E'*Thou hast sent widows away empty, and the arms of the fatherless have been broken.* (Job 22:9). This is Eliphaz''s slander — he accuses Job of crushing widow and orphan. Job''s remembrance is the flat refutation: *I delivered the poor that cried, and the fatherless, and him that had none to help him* (Job 29:12). The false witness against the righteous is answered not by argument but by the record of his deeds.'),
    ('canon','job',29,12,'canon','deuteronomy',10,18,'free',
     E'*He doth execute the judgment of the fatherless and widow, and loveth the stranger, in giving him food and raiment.* (Deuteronomy 10:18). Job''s care for *the poor that cried, and the fatherless* (Job 29:12) is the image of Yahuah Himself enacted in a man — the Torah''s justice for the defenceless, the covenant-walk of one who fears Elohim, never a merit hoarded against Him.'),
    ('canon','job',29,16,'canon','isaiah',1,17,'free',
     E'*Learn to do well; seek judgment, relieve the oppressed, judge the fatherless, plead for the widow.* (Isaiah 1:17). This is the very thing Job did — *I was a father to the poor: and the cause which I knew not I searched out* (Job 29:16). Isaiah commands of Yashar''el (Israel) what Job already lived: the covenant-justice that is the heart of Torah, not its ceremonies emptied of mercy.'),
    ('canon','job',29,16,'apocrypha','ecclesiasticus',4,10,'extras',
     E'*Be as a father to the fatherless, and instead of an husband to their mother: so shalt thou be as the son of the Most High, and he shall love thee more than thy mother doth.* (Ecclesiasticus / Sirach 4:10). The wisdom tradition names exactly Job''s deed — *I was a father to the poor* (Job 29:16) — and weighs it as the mark of a son of the Most High: covenant-mercy is the fruit by which the righteous are known.'),

    -- THREAD 3: eyes to the blind, feet to the lame — the Servant''s works (29:15)
    ('canon','job',29,15,'canon','psalms',72,12,'free',
     E'*For he shall deliver the needy when he crieth; the poor also, and him that hath no helper.* (Psalm 72:12). The royal psalm of the righteous king draws the same portrait Job draws of himself — *I delivered... him that had none to help him* (Job 29:12), *I was eyes to the blind, and feet was I to the lame* (Job 29:15). Job ruled as such a king; the psalm reaches forward to the King in whom this rule is perfected.'),
    ('canon','job',29,15,'canon','isaiah',61,1,'free',
     E'*The Spirit of Adonai Yahuah (the Lord GOD) is upon me; because Yahuah (LORD) hath anointed me to preach good tidings unto the meek; he hath sent me to bind up the brokenhearted, to proclaim liberty to the captives, and the opening of the prison to them that are bound;* (Isaiah 61:1). Job''s *eyes to the blind, and feet... to the lame* (Job 29:15) is the same ministry the Anointed One comes to fulfil — sight to the bound and the broken. What Job did in his city, the Servant does for the whole people.'),
    ('canon','job',29,15,'canon','luke',4,18,'free',
     E'*The Spirit of Yahuah (Lord) is upon me, because he hath anointed me to preach the gospel to the poor; he hath sent me to heal the brokenhearted, to preach deliverance to the captives, and recovering of sight to the blind, to set at liberty them that are bruised,* (Luke 4:18). Yahusha (Jesus) reads Isaiah 61 over Himself, and the works named are Job''s works enlarged — *I was eyes to the blind, and feet was I to the lame* (Job 29:15). The righteous deed Job remembers is the very pattern the Messiah''s ministry consummates.'),
    ('canon','job',29,16,'canon','matthew',25,35,'free',
     E'*For I was an hungred, and ye gave me meat: I was thirsty, and ye gave me drink: I was a stranger, and ye took me in:* (Matthew 25:35). The King judges by the deeds Job lived — *I was a father to the poor* (Job 29:16) — and counts mercy to the least as done unto Himself (Matthew 25:40). Job''s remembered care for the helpless is weighed in the same balance the Son of Adam will use.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job29_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job29_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- THREAD 4 cross_references (root by the waters, 29:19)
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    ('canon','job',29,19,'canon','psalms',1,3,'free',
     E'*And he shall be like a tree planted by the rivers of water, that bringeth forth his fruit in his season; his leaf also shall not wither; and whatsoever he doeth shall prosper.* (Psalm 1:3). Job describes his former flourishing in the same figure — *My root was spread out by the waters, and the dew lay all night upon my branch* (Job 29:19). The blessed man rooted by the water is the man who delights in the Torah of Yahuah; Job''s lament is the cry of such a tree feeling the drought.'),
    ('canon','job',29,19,'canon','jeremiah',17,8,'free',
     E'*For he shall be as a tree planted by the waters, and that spreadeth out her roots by the river, and shall not see when heat cometh, but her leaf shall be green; and shall not be careful in the year of drought, neither shall cease from yielding fruit.* (Jeremiah 17:8). Jeremiah''s tree that *spreadeth out her roots by the river* is Job''s very phrase — *My root was spread out by the waters* (Job 29:19) — the man whose trust is in Yahuah, who does not fail in the year of drought. Job''s grief is that the season of testing has come upon a rooted and righteous man.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job29_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job29_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================ C. threads ============================
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-29-the-candle-of-Yahuah-shined-upon-my-head',
       E'The candle of Yahuah shined upon my head',
       E'Job''s lament opens not with bitterness but with longing: *Oh that I were as in months past, as in the days when Elohim (God) preserved me; When his candle shined upon my head, and when by his light I walked through darkness* (Job 29:2-3). The light he mourns was never his own — it was the fellowship of the Almighty, the lamp Yahuah gives to the righteous and may withdraw. The psalmist sings of the same lamp as a gift restored: *For thou wilt light my candle: Yahuah Elohai (the LORD my God) will enlighten my darkness* (Psalm 18:28); and again, *Thy word is a lamp unto my feet, and a light unto my path* (Psalm 119:105). To walk by His light through darkness is to walk in His word and His presence. Job''s grief is exactly this loss — *the secret of Elohim (God) was upon my tabernacle; When the Almighty was yet with me* (Job 29:4-5) — the candle dimmed not by Job''s sin but in a hidden contest he cannot yet see. The light is the LORD''s to give, and the true Light answers this longing forward.',
       sv.verse_id, ev.verse_id, 'free', 33500
  FROM _s318_job29_lookup sv, _s318_job29_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=29 AND sv.verse_number=2
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=29 AND ev.verse_number=5
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-29-i-delivered-the-poor-the-fatherless-covenant-justice-enacted',
       E'I delivered the poor and the fatherless — covenant-justice enacted',
       E'Here is the heart of Job''s defence, and the flat refutation of his accusers. Eliphaz had slandered him: *Thou hast sent widows away empty, and the arms of the fatherless have been broken* (Job 22:9). Job answers not with argument but with the record of his life: *Because I delivered the poor that cried, and the fatherless, and him that had none to help him... I was a father to the poor: and the cause which I knew not I searched out. And I brake the jaws of the wicked, and plucked the spoil out of his teeth* (Job 29:12,16-17). This is the Torah''s justice walked out in a man. Yahuah Himself *doth execute the judgment of the fatherless and widow, and loveth the stranger, in giving him food and raiment* (Deuteronomy 10:18), and Job is His image enacted. Isaiah commands of Yashar''el (Israel) precisely what Job already lived: *Learn to do well; seek judgment, relieve the oppressed, judge the fatherless, plead for the widow* (Isaiah 1:17). The wisdom tradition weighs the same deed as the mark of a true son: *Be as a father to the fatherless, and instead of an husband to their mother: so shalt thou be as the son of the Most High* (Ecclesiasticus / Sirach 4:10). These are not works hoarded as flesh-merit against the Almighty; they are the fruit that grows from the fear of Yahuah — the covenant-mercy by which the righteous are known.',
       sv.verse_id, ev.verse_id, 'extras', 33501
  FROM _s318_job29_lookup sv, _s318_job29_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=29 AND sv.verse_number=12
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=29 AND ev.verse_number=17
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-29-eyes-to-the-blind-feet-to-the-lame-the-servants-works',
       E'Eyes to the blind, feet to the lame — the Servant''s works foreshadowed',
       E'*I was eyes to the blind, and feet was I to the lame* (Job 29:15). Job describes himself as the helper of the helpless, the one who delivered *him that had none to help him* (Job 29:12) — and in this he is the very portrait of the righteous king the psalm sings: *For he shall deliver the needy when he crieth; the poor also, and him that hath no helper* (Psalm 72:12). Yet the portrait reaches further than Job. The Anointed One comes bearing exactly these works: *The Spirit of Adonai Yahuah (the Lord GOD) is upon me; because Yahuah (LORD) hath anointed me to preach good tidings unto the meek; he hath sent me to bind up the brokenhearted, to proclaim liberty to the captives* (Isaiah 61:1), which Yahusha (Jesus) reads over Himself in the synagogue — *recovering of sight to the blind, to set at liberty them that are bruised* (Luke 4:18). And the King will judge the nations by this same standard, counting mercy to the least as done unto Himself: *For I was an hungred, and ye gave me meat... I was a stranger, and ye took me in* (Matthew 25:35). What Job did in his city — eyes to the blind, feet to the lame, a father to the poor — is the pattern the Messiah''s whole ministry consummates and the measure by which all shall be weighed.',
       sv.verse_id, ev.verse_id, 'free', 33502
  FROM _s318_job29_lookup sv, _s318_job29_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=29 AND sv.verse_number=12
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=29 AND ev.verse_number=16
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-29-my-root-was-spread-out-by-the-waters',
       E'My root was spread out by the waters',
       E'Job pictures his former flourishing in the figure the whole canon reserves for the blessed and rooted man: *My root was spread out by the waters, and the dew lay all night upon my branch. My glory was fresh in me, and my bow was renewed in my hand* (Job 29:19-20). This is the tree of the first psalm — *like a tree planted by the rivers of water, that bringeth forth his fruit in his season; his leaf also shall not wither* (Psalm 1:3) — the man whose delight is in the Torah of Yahuah. Jeremiah uses Job''s very phrase: *he shall be as a tree planted by the waters, and that spreadeth out her roots by the river... and shall not be careful in the year of drought* (Jeremiah 17:8), the man whose trust is in Yahuah. Job was such a tree; his lament is the cry of the rooted and righteous when the year of drought comes upon him — not because the root failed, but because a hidden testing has been permitted, that his righteousness might be shown to be real and not for reward.',
       sv.verse_id, ev.verse_id, 'free', 33503
  FROM _s318_job29_lookup sv, _s318_job29_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=29 AND sv.verse_number=19
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=29 AND ev.verse_number=20
ON CONFLICT (slug) DO NOTHING;

-- ============================ D. thread_members ============================
-- THREAD 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (29,3,'canon','psalms',18,28,1,E'*For thou wilt light my candle: Yahuah Elohai (the LORD my God) will enlighten my darkness.* (Psalm 18:28) — the lamp Job mourns losing is the LORD''s gift restored.'),
    (29,3,'canon','psalms',119,105,2,E'*Thy word is a lamp unto my feet, and a light unto my path.* (Psalm 119:105) — to walk by His light is to walk in His word.')
  ) AS m(src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-29-the-candle-of-Yahuah-shined-upon-my-head'
  JOIN _s318_job29_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=29 AND sv.verse_number=m.src_v
  JOIN _s318_job29_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- THREAD 2
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (29,12,'canon','job',22,9,1,E'*Thou hast sent widows away empty, and the arms of the fatherless have been broken.* (Job 22:9) — Eliphaz''s slander, flatly refuted by Job''s record.'),
    (29,12,'canon','deuteronomy',10,18,2,E'*He doth execute the judgment of the fatherless and widow... loveth the stranger.* (Deuteronomy 10:18) — Job is Yahuah''s own justice enacted in a man.'),
    (29,16,'canon','isaiah',1,17,3,E'*Seek judgment, relieve the oppressed, judge the fatherless, plead for the widow.* (Isaiah 1:17) — Isaiah commands what Job already lived.'),
    (29,16,'apocrypha','ecclesiasticus',4,10,4,E'*Be as a father to the fatherless... so shalt thou be as the son of the Most High.* (Sirach 4:10) — the wisdom tradition names Job''s deed as the mark of a true son.')
  ) AS m(src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-29-i-delivered-the-poor-the-fatherless-covenant-justice-enacted'
  JOIN _s318_job29_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=29 AND sv.verse_number=m.src_v
  JOIN _s318_job29_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- THREAD 3
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (29,15,'canon','psalms',72,12,1,E'*For he shall deliver the needy when he crieth; the poor also, and him that hath no helper.* (Psalm 72:12) — the righteous king Job pictured himself to be.'),
    (29,15,'canon','isaiah',61,1,2,E'*The Spirit of Adonai Yahuah is upon me... to bind up the brokenhearted, to proclaim liberty to the captives.* (Isaiah 61:1) — the Servant''s works enlarge Job''s.'),
    (29,15,'canon','luke',4,18,3,E'*Recovering of sight to the blind, to set at liberty them that are bruised.* (Luke 4:18) — Yahusha (Jesus) reads Isaiah 61 over Himself; Job''s deed consummated.'),
    (29,16,'canon','matthew',25,35,4,E'*I was an hungred, and ye gave me meat... I was a stranger, and ye took me in.* (Matthew 25:35) — the King judges by the very mercy Job lived.')
  ) AS m(src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-29-eyes-to-the-blind-feet-to-the-lame-the-servants-works'
  JOIN _s318_job29_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=29 AND sv.verse_number=m.src_v
  JOIN _s318_job29_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- THREAD 4
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, m.sort_order, m.member_note
  FROM (VALUES
    (29,19,'canon','psalms',1,3,1,E'*Like a tree planted by the rivers of water... his leaf also shall not wither.* (Psalm 1:3) — the blessed man rooted in Torah, the figure Job claims.'),
    (29,19,'canon','jeremiah',17,8,2,E'*As a tree planted by the waters, that spreadeth out her roots by the river.* (Jeremiah 17:8) — Job''s very phrase: the man whose trust is in Yahuah.')
  ) AS m(src_ch,src_v,tgt_ed,tgt_slug,tgt_ch,tgt_v,sort_order,member_note)
  JOIN cross_reference_threads t ON t.slug='job-29-my-root-was-spread-out-by-the-waters'
  JOIN _s318_job29_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=29 AND sv.verse_number=m.src_v
  JOIN _s318_job29_lookup tv ON tv.edition_slug=m.tgt_ed AND tv.book_slug=m.tgt_slug AND tv.chapter_number=m.tgt_ch AND tv.verse_number=m.tgt_v
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

-- ----- fragment: minion_job_30.sql (Job 30) -----
-- Book: Job   Chapter: 30   Tag: job30   Session prefix: s318
-- Sort band: 33525.. (+1 per thread)
-- The reversal: the once-honored chief is now despised, mocked, his cry unanswered,
--   his compassion repaid with calamity. The righteous sufferer's abasement, held
--   inside faith — never deserved punishment; the despised-and-mocked pattern lightly
--   anticipates the Man of Sorrows.
--
-- Job 30 coverage:
--   v.1   NT:     Isaiah 53:3 (forward, despised — light)   Extras: Wisdom 2:19-20 (mocked just man)   Tanakh: Psalm 69:11-12, Job 19:18-19
--   v.9   NT:     Matthew 27:30 (spit/mock — light)         Extras: Wisdom 2:19-20                      Tanakh: Psalm 69:11-12, Psalm 35:15-16, Lamentations 3:14
--   v.10  NT:     Matthew 27:30                             Extras: none warranted                     Tanakh: Psalm 35:15-16 (spit/gnash)
--   v.20  NT:     Matthew 27:46 (forsaken cry)              Extras: Sirach 35:17 (prayer pierces clouds)Tanakh: Psalm 22:1-2, Lamentations 3:8
--   v.21  NT:     Matthew 27:46                             Extras: none warranted                     Tanakh: Psalm 22:1-2
--   v.23  NT:     Hebrews 9:27 (appointed to die)           Extras: none warranted                     Tanakh: none warranted
--   v.25  NT:     none warranted                            Extras: Wisdom 2:17-18 (the just tested)    Tanakh: Psalm 35:13-14 (wept for the sick)
--   v.26  NT:     none warranted                            Extras: Wisdom 2:17-18                      Tanakh: Psalm 35:13-14
--   v.29-30 NT:   none warranted (desolation imagery; held within the threads above)   Extras/Tanakh: none warranted
--
-- Threads (4):
--   1. job-30-now-am-i-their-song-the-once-honored-mocked        [extras]  (v.1->v.10)  Ps69, Ps35, Lam3, Job19 (Tanakh) + Isa53, Matt27 (NT) + Wisdom2 (extras)
--   2. job-30-i-cry-and-thou-dost-not-hear-the-hidden-face       [extras]  (v.20->v.21) Ps22, Lam3 (Tanakh) + Matt27 (NT) + Sirach35 (extras)
--   3. job-30-the-house-appointed-for-all-living                 [free]    (v.23->v.23) Heb9 (NT)
--   4. job-30-when-i-waited-for-light-there-came-darkness        [extras]  (v.25->v.26) Ps35 (Tanakh) + Wisdom2 (extras)

CREATE TEMP VIEW _s318_job30_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ===== cross_references =====
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: now am I their song (v.1, v.9, v.10)
    ('canon','job',30,1,'canon','psalms',69,11,'free',
      E'*I made sackcloth also my garment; and I became a proverb to them* (Psalm 69:11). The same reversal sounds in the psalm of the righteous sufferer as in Job''s *But now they that are younger than I have me in derision* (Job 30:1): the honored man becomes the proverb, the byword, of the very people beneath him.'),
    ('canon','job',30,9,'canon','psalms',69,12,'free',
      E'*They that sit in the gate speak against me; and I was the song of the drunkards* (Psalm 69:12). Job''s *And now am I their song, yea, I am their byword* (Job 30:9) is the identical reproach — the man of God made the mockers'' tune in the street.'),
    ('canon','job',30,9,'canon','lamentations',3,14,'free',
      E'*I was a derision to all my people; and their song all the day* (Lamentations 3:14). The afflicted in Lamentations sings Job''s own line — *And now am I their song, yea, I am their byword* (Job 30:9) — the righteous made the daylong jest of those who should have honored him.'),
    ('canon','job',30,10,'canon','psalms',35,15,'free',
      E'*But in mine adversity they rejoiced, and gathered themselves together: yea, the abjects gathered themselves together against me, and I knew it not; they did tear me, and ceased not* (Psalm 35:15). The abjects gather against the psalmist as the basest gather against Job, who says *They abhor me, they flee far from me, and spare not to spit in my face* (Job 30:10).'),
    ('canon','job',30,10,'canon','psalms',35,16,'free',
      E'*With hypocritical mockers in feasts, they gnashed upon me with their teeth* (Psalm 35:16). The mockers'' gnashing answers the spitting in Job''s face — *spare not to spit in my face* (Job 30:10) — the contempt of the unworthy poured on the righteous man.'),
    ('canon','job',30,1,'canon','job',19,18,'free',
      E'*Yea, young children despised me; I arose, and they spake against me* (Job 19:18). Job had already cried that the basest mocked him; here in *they that are younger than I have me in derision* (Job 30:1) the derision of the young returns, the chief now scorned by those he would have set with the dogs of his flock.'),
    ('canon','job',30,1,'canon','job',19,19,'free',
      E'*All my inward friends abhorred me: and they whom I loved are turned against me* (Job 19:19). The abhorrence that began with friends widens until even *they that are younger than I have me in derision* (Job 30:1) — the whole order of honor inverted upon the suffering man.'),
    ('canon','job',30,1,'canon','isaiah',53,3,'free',
      E'*He is despised and rejected of men; a man of sorrows, and acquainted with grief: and we hid as it were our faces from him; he was despised, and we esteemed him not* (Isaiah 53:3). Job''s abasement — *they that are younger than I have me in derision* (Job 30:1) — faintly foreshadows the Servant who would be despised and esteemed not; the righteous sufferer is a shadow of the Man of Sorrows.'),
    ('canon','job',30,9,'canon','matthew',27,30,'free',
      E'*And they spit upon him, and took the reed, and smote him on the head* (Matthew 27:30). The spitting and mocking Job endured — *And now am I their song, yea, I am their byword* (Job 30:9), *spare not to spit in my face* (Job 30:10) — is filled up in the Formed Son, the true righteous Sufferer who bore the contempt of men.'),
    ('canon','job',30,9,'apocrypha','the-wisdom-of-solomon',2,19,'extras',
      E'*Let us examine him with despitefulness and torture, that we may know his meekness, and prove his patience* (Wisdom of Solomon 2:19). The wicked plot the testing of the just man with mockery and torment, the very contempt Job tastes — *And now am I their song, yea, I am their byword* (Job 30:9) — the abasement of the righteous as the wicked''s sport.'),
    ('canon','job',30,9,'apocrypha','the-wisdom-of-solomon',2,20,'extras',
      E'*Let us condemn him with a shameful death: for by his own saying he shall be respected* (Wisdom of Solomon 2:20). The shameful end appointed for the just man by his mockers gathers Job''s reproach — *I am their byword* (Job 30:9) — forward toward the Man of Sorrows condemned by the very pattern.'),

    -- Thread 2: I cry, and thou dost not hear (v.20, v.21)
    ('canon','job',30,20,'canon','psalms',22,1,'free',
      E'*My Elohim (God), my Elohim (God), why hast thou forsaken me? why art thou so far from helping me, and from the words of my roaring?* (Psalm 22:1). Job''s *I cry unto thee, and thou dost not hear me* (Job 30:20) is the same forsaken-feeling cry of the righteous sufferer — the hidden face, the prayer that seems to strike heaven and fall back, yet still addressed to the One he will not let go.'),
    ('canon','job',30,20,'canon','psalms',22,2,'free',
      E'*O my Elohim (God), I cry in the daytime, but thou hearest not; and in the night season, and am not silent* (Psalm 22:2). The unanswered cry day and night is Job''s own complaint — *I cry unto thee, and thou dost not hear me: I stand up, and thou regardest me not* (Job 30:20) — the bewildered persistence of faith that prays on through silence.'),
    ('canon','job',30,20,'canon','lamentations',3,8,'free',
      E'*Also when I cry and shout, he shutteth out my prayer* (Lamentations 3:8). The shut-out prayer of Lamentations answers Job''s *I cry unto thee, and thou dost not hear me* (Job 30:20) — the same dark hour where the cry seems barred from heaven, held inside the covenant nonetheless.'),
    ('canon','job',30,21,'canon','matthew',27,46,'free',
      E'*And about the ninth hour Yahusha (Jesus) cried with a loud voice, saying, Eli, Eli, lama sabachthani? that is to say, My Elohim (God), my Elohim (God), why hast thou forsaken me?* (Matthew 27:46). The forsaken cry of the Formed Son fills up the righteous sufferer''s anguish — Job''s *Thou art become cruel to me: with thy strong hand thou opposest thyself against me* (Job 30:21) is taken up and answered in the One who cried out and was heard.'),
    ('canon','job',30,20,'apocrypha','ecclesiasticus',35,17,'extras',
      E'*The prayer of the humble pierces the clouds: and till it come nigh, he will not be comforted; and will not depart, till the Most High shall behold to judge righteously, and execute judgment* (Ecclesiasticus 35:17). The humble man''s prayer is not abandoned though it goes uncomforted — the very tension of Job''s *I cry unto thee, and thou dost not hear me* (Job 30:20): the cry pierces the clouds and waits on the Most High''s appointed regard.'),

    -- Thread 3: the house appointed for all living (v.23)
    ('canon','job',30,23,'canon','hebrews',9,27,'free',
      E'*And as it is appointed unto men once to die, but after this the judgment* (Hebrews 9:27). Job''s certainty — *I know that thou wilt bring me to death, and to the house appointed for all living* (Job 30:23) — is the same appointment: the house of death waits for all flesh, and beyond it the judgment of the Most High.'),

    -- Thread 4: when I waited for light, there came darkness (v.25, v.26)
    ('canon','job',30,25,'canon','psalms',35,13,'free',
      E'*But as for me, when they were sick, my clothing was sackcloth: I humbled my soul with fasting; and my prayer returned into mine own bosom* (Psalm 35:13). The psalmist mourned for the sick who later turned on him, exactly Job''s grief: *Did not I weep for him that was in trouble? was not my soul grieved for the poor?* (Job 30:25) — compassion poured out, then repaid with contempt.'),
    ('canon','job',30,25,'canon','psalms',35,14,'free',
      E'*I behaved myself as though he had been my friend or brother: I bowed down heavily, as one that mourneth for his mother* (Psalm 35:14). The depth of the psalmist''s mourning for others matches Job''s — *was not my soul grieved for the poor?* (Job 30:25) — the righteous man who grieved for the troubled and met only calamity in return.'),
    ('canon','job',30,26,'apocrypha','the-wisdom-of-solomon',2,17,'extras',
      E'*Let us see if his words be true: and let us prove what shall happen in the end of him* (Wisdom of Solomon 2:17). The wicked wait to see calamity overtake the just man — and the just man himself is bewildered by it: *When I looked for good, then evil came unto me: and when I waited for light, there came darkness* (Job 30:26).'),
    ('canon','job',30,26,'apocrypha','the-wisdom-of-solomon',2,18,'extras',
      E'*For if the just man be the son of Yahuah (God), he will help him, and deliver him from the hand of his enemies* (Wisdom of Solomon 2:18). The taunt that no deliverance comes is the very darkness Job waited in — *when I waited for light, there came darkness* (Job 30:26) — the righteous sufferer''s good hope met by evil, his trust held in the dark.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job30_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job30_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ===== threads =====
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-30-now-am-i-their-song-the-once-honored-mocked',
  E'Now Am I Their Song — the Once-Honored Made a Byword',
  E'The chief who once sat in honor is now mocked by the basest: *But now they that are younger than I have me in derision, whose fathers I would have disdained to have set with the dogs of my flock* (Job 30:1), until *And now am I their song, yea, I am their byword* (Job 30:9) and *They abhor me, they flee far from me, and spare not to spit in my face* (Job 30:10). It is the reversal the righteous sufferer knows by heart. The psalmist sings it: *I made sackcloth also my garment; and I became a proverb to them* (Psalm 69:11), *and I was the song of the drunkards* (Psalm 69:12); *the abjects gathered themselves together against me... they did tear me, and ceased not* (Psalm 35:15), *with hypocritical mockers in feasts, they gnashed upon me with their teeth* (Psalm 35:16). Lamentations takes up the same line — *I was a derision to all my people; and their song all the day* (Lamentations 3:14) — and Job had already felt it from his own household: *young children despised me; I arose, and they spake against me* (Job 19:18), *all my inward friends abhorred me: and they whom I loved are turned against me* (Job 19:19). The wicked''s scheme against the just man names it plainly: *Let us examine him with despitefulness and torture, that we may know his meekness, and prove his patience* (Wisdom of Solomon 2:19), *let us condemn him with a shameful death* (Wisdom of Solomon 2:20). And the whole pattern foreshadows the Man of Sorrows: *He is despised and rejected of men; a man of sorrows, and acquainted with grief... he was despised, and we esteemed him not* (Isaiah 53:3) — fulfilled when *they spit upon him, and took the reed, and smote him on the head* (Matthew 27:30). The abasement of the righteous is never the verdict on his righteousness.',
  sv.verse_id, ev.verse_id, 'extras', 33525
  FROM _s318_job30_lookup sv, _s318_job30_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=30 AND sv.verse_number=1
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=30 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-30-i-cry-and-thou-dost-not-hear-the-hidden-face',
  E'I Cry, and Thou Dost Not Hear — the Hidden Face',
  E'Job comes to the hardest place a believer knows: the cry that seems to fall back unanswered. *I cry unto thee, and thou dost not hear me: I stand up, and thou regardest me not. Thou art become cruel to me: with thy strong hand thou opposest thyself against me* (Job 30:20-21). This is not the speech of an unbeliever but of faith in the dark — the same anguish the psalm of the righteous sufferer pours out: *My Elohim (God), my Elohim (God), why hast thou forsaken me? why art thou so far from helping me, and from the words of my roaring?* (Psalm 22:1), *I cry in the daytime, but thou hearest not; and in the night season, and am not silent* (Psalm 22:2). Lamentations groans the same shut door: *Also when I cry and shout, he shutteth out my prayer* (Lamentations 3:8). Yet the cry is never truly lost — *The prayer of the humble pierces the clouds: and till it come nigh, he will not be comforted; and will not depart, till the Most High shall behold to judge righteously* (Ecclesiasticus 35:17). The forsaken cry finds its fullest voice and its answer in the Formed Son: *Yahusha (Jesus) cried with a loud voice, saying... My Elohim (God), my Elohim (God), why hast thou forsaken me?* (Matthew 27:46) — the One who entered the silence and was heard.',
  sv.verse_id, ev.verse_id, 'extras', 33526
  FROM _s318_job30_lookup sv, _s318_job30_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=30 AND sv.verse_number=20
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=30 AND ev.verse_number=21
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-30-the-house-appointed-for-all-living',
  E'The House Appointed for All Living',
  E'In the midst of his affliction Job names the one certainty that levels every man: *For I know that thou wilt bring me to death, and to the house appointed for all living* (Job 30:23). The grave is the appointed house, the destination of all flesh. The same appointment is taken up forward — *And as it is appointed unto men once to die, but after this the judgment* (Hebrews 9:27): death waits for all, and beyond the house of the dead stands the judgment of the Most High. Job''s certainty is sober, not despairing; he speaks it inside the faith that the One who brings him to that house is the same One he still cries to.',
  sv.verse_id, ev.verse_id, 'free', 33527
  FROM _s318_job30_lookup sv, _s318_job30_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=30 AND sv.verse_number=23
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=30 AND ev.verse_number=23
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-30-when-i-waited-for-light-there-came-darkness',
  E'When I Waited for Light, There Came Darkness',
  E'Job''s deepest bewilderment is that his own compassion was repaid with calamity: *Did not I weep for him that was in trouble? was not my soul grieved for the poor? When I looked for good, then evil came unto me: and when I waited for light, there came darkness* (Job 30:25-26). The psalmist had walked the same road — *when they were sick, my clothing was sackcloth: I humbled my soul with fasting; and my prayer returned into mine own bosom* (Psalm 35:13), *I behaved myself as though he had been my friend or brother: I bowed down heavily, as one that mourneth for his mother* (Psalm 35:14) — and met only adversity from those he mourned for. The wicked''s test of the just man frames the darkness from the other side: *Let us see if his words be true: and let us prove what shall happen in the end of him* (Wisdom of Solomon 2:17), *For if the just man be the son of Yahuah (God), he will help him, and deliver him from the hand of his enemies* (Wisdom of Solomon 2:18). The righteous waits for light and is given darkness — not as the wage of his sin, but as the furnace in which his trust is proven.',
  sv.verse_id, ev.verse_id, 'extras', 33528
  FROM _s318_job30_lookup sv, _s318_job30_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=30 AND sv.verse_number=25
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=30 AND ev.verse_number=26
ON CONFLICT (slug) DO NOTHING;

-- ===== thread_members =====
-- Thread 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'*I made sackcloth also my garment; and I became a proverb to them* (Psalm 69:11) — the righteous made a proverb, as Job is mocked by his juniors (Job 30:1).'
  FROM cross_reference_threads t
  JOIN _s318_job30_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=30 AND sv.verse_number=1
  JOIN _s318_job30_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=69 AND tv.verse_number=11
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-30-now-am-i-their-song-the-once-honored-mocked'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'*and I was the song of the drunkards* (Psalm 69:12) — the byword of Job 30:9 sung in the gate.'
  FROM cross_reference_threads t
  JOIN _s318_job30_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=30 AND sv.verse_number=9
  JOIN _s318_job30_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=69 AND tv.verse_number=12
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-30-now-am-i-their-song-the-once-honored-mocked'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'*I was a derision to all my people; and their song all the day* (Lamentations 3:14) — Job''s very line, the daylong jest of his people.'
  FROM cross_reference_threads t
  JOIN _s318_job30_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=30 AND sv.verse_number=9
  JOIN _s318_job30_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='lamentations' AND tv.chapter_number=3 AND tv.verse_number=14
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-30-now-am-i-their-song-the-once-honored-mocked'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 4, E'*the abjects gathered themselves together against me... they did tear me, and ceased not* (Psalm 35:15) — the basest gather, as in Job 30:10.'
  FROM cross_reference_threads t
  JOIN _s318_job30_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=30 AND sv.verse_number=10
  JOIN _s318_job30_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=35 AND tv.verse_number=15
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-30-now-am-i-their-song-the-once-honored-mocked'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 5, E'*with hypocritical mockers in feasts, they gnashed upon me with their teeth* (Psalm 35:16) — the mockers'' contempt answering the spit in Job''s face (Job 30:10).'
  FROM cross_reference_threads t
  JOIN _s318_job30_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=30 AND sv.verse_number=10
  JOIN _s318_job30_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=35 AND tv.verse_number=16
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-30-now-am-i-their-song-the-once-honored-mocked'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 6, E'*young children despised me; I arose, and they spake against me* (Job 19:18) — the derision of the young Job already named, now returned (Job 30:1).'
  FROM cross_reference_threads t
  JOIN _s318_job30_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=30 AND sv.verse_number=1
  JOIN _s318_job30_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=19 AND tv.verse_number=18
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-30-now-am-i-their-song-the-once-honored-mocked'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

