INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'*TEKEL; Thou art weighed in the balances, and art found wanting* (Daniel 5:27) — the same balance finds the wicked wanting; Job asks to be weighed unafraid.'
  FROM cross_reference_threads t
  JOIN _s318_job31_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=6
  JOIN _s318_job31_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='daniel' AND tv.chapter_number=5 AND tv.verse_number=27
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-31-6-weighed-in-an-even-balance'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'*by him actions are weighed* (1 Samuel 2:3) — Hannah''s song names the truth Job stakes his oath upon.'
  FROM cross_reference_threads t
  JOIN _s318_job31_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=31 AND sv.verse_number=6
  JOIN _s318_job31_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='1-samuel' AND tv.chapter_number=2 AND tv.verse_number=3
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-31-6-weighed-in-an-even-balance'
