-- ----- fragment: minion_job_27.sql (Job 27) -----
-- Job 27 — Job holds fast his integrity; the portion of the wicked with El.
-- session prefix: s318 ; tag: job27 ; slug prefix: job-27-... ; sort band start: 33450
-- Source: canon/job ch.27. Greenfield (no job-27 slugs in EXISTING_SLUGS.txt; no job slugs at all).
--
-- Job 27 coverage:
--   v.2-6 (the oath; integrity held fast; "My righteousness I hold fast"):
--        NT:     Acts 24:16 (a conscience void of offence) — WARRANTED (the genuine Torah-faithful conscience)
--        Extras: none warranted
--        Tanakh: Job 1:8 + 2:3 (Yahuah Himself attests the perfect/upright man holding fast integrity);
--                Psalm 26:1 (judge me, I have walked in mine integrity); Proverbs 11:3 (integrity of the upright) — WARRANTED
--   v.8-10 (hope of the hypocrite; will El hear his cry):
--        NT:     none warranted
--        Extras: Wisdom of Solomon 5:14 (the hope of the ungodly like dust driven away with the storm) — WARRANTED
--        Tanakh: lateral folded into thread 4 (Ps 73 end of the wicked) — kept distinct here as the "no hope" frame
--   v.13-17 (portion of the wicked; heap silver but the just shall put it on):
--        NT:     none warranted
--        Extras: Ecclesiasticus 11:18-19 (waxeth rich by pinching... must leave to others and die) — WARRANTED
--        Tanakh: Proverbs 13:22 (wealth of the sinner laid up for the just); Ecclesiastes 2:26 (sinner gathers to give to the good) — WARRANTED
--   v.18-23 (rich man not gathered; terrors as waters; east wind; El casts and spares not):
--        NT:     none warranted
--        Extras: none warranted (Wisdom 5:14 already carried in thread 2)
--        Tanakh: Psalm 73:17-20 (the sanctuary; understood I their end; cast down into destruction; consumed with terrors) — WARRANTED
--
-- GUARD: 27:5-6 "my righteousness I hold fast" framed as covenant-integrity / the blameless walk
--   Yahuah Himself attested (Job 1:8; 2:3), NOT a claim of sinless flesh-merit; the integrity of the
--   upright the framework upholds, distinct from the self-justifying boast. The wicked's portion =
--   real final reckoning on Yahuah's timing (not the friends' mechanical scheme).
--
-- Threads (4):
--   1. job-27-i-hold-fast-mine-integrity            [free]   -> Job 1:8, Job 2:3, Psalm 26:1, Proverbs 11:3, Acts 24:16
--   2. job-27-the-hope-of-the-hypocrite             [extras] -> Wisdom of Solomon 5:14
--   3. job-27-the-portion-laid-up-for-the-just      [extras] -> Proverbs 13:22, Ecclesiastes 2:26, Ecclesiasticus 11:18-19
--   4. job-27-terrors-take-hold-on-the-wicked       [free]   -> Psalm 73:17, Psalm 73:18, Psalm 73:19, Psalm 73:20

-- A. Temp view
CREATE TEMP VIEW _s318_job27_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- B. cross_references
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
    -- Thread 1: integrity held fast
    ('canon','job',27,6,'canon','job',1,8,'free',
     E'Job does not boast a sinless flesh-merit; he holds fast the very integrity Yahuah (LORD) Himself attested before the accuser: *And Yahuah (LORD) said unto Satan, Hast thou considered my servant Job, that there is none like him in the earth, a perfect and an upright man, one that feareth Elohim (God), and escheweth evil?* (Job 1:8). When Job says *My righteousness I hold fast, and will not let it go* (Job 27:6), he is refusing to surrender the blameless covenant-walk the Most High had already named — the integrity of the upright, not the self-justifying boast.'),
    ('canon','job',27,6,'canon','job',2,3,'free',
     E'Even after the second trial Yahuah (LORD) renews the witness: *a perfect and an upright man, one that feareth Elohim (God), and escheweth evil? and still he holdeth fast his integrity* (Job 2:3). Heaven itself uses the same words Job uses — *holdeth fast his integrity* — so Job 27:6, *My righteousness I hold fast, and will not let it go*, is faithful testimony, not arrogance: he clings to the conscience Yahuah (LORD) Himself vindicated.'),
    ('canon','job',27,5,'canon','psalms',26,1,'free',
     E'David asks for the same vindication on the same ground: *Judge me, O Yahuah (LORD); for I have walked in mine integrity: I have trusted also in Yahuah (LORD); therefore I shall not slide* (Psalm 26:1). Job''s vow *till I die I will not remove mine integrity from me* (Job 27:5) is this walk — the upright conscience that submits itself to Yahuah''s judgment, never a claim to need no mercy.'),
    ('canon','job',27,6,'canon','proverbs',11,3,'free',
     E'Wisdom names the very thing Job will not let go: *The integrity of the upright shall guide them: but the perverseness of transgressors shall destroy them* (Proverbs 11:3). Job''s *My righteousness I hold fast* (Job 27:6) is the upright''s guide held to the death, set over against the friends'' charge that his suffering proves him a transgressor.'),
    ('canon','job',27,6,'canon','acts',24,16,'free',
     E'Sha''ul (Paul) before the governor names the same discipline of the kept conscience: *And herein do I exercise myself, to have always a conscience void of offence toward Elohim (God), and toward men* (Acts 24:16). Job''s *my heart shall not reproach me so long as I live* (Job 27:6) is exactly this — the Torah-faithful conscience that does not accuse its keeper, the integrity the framework upholds.'),
    -- Thread 2: hope of the hypocrite
    ('canon','job',27,8,'apocrypha','the-wisdom-of-solomon',5,14,'extras',
     E'Job asks *what is the hope of the hypocrite, though he hath gained, when Elohim (God) taketh away his soul?* (Job 27:8), and Wisdom answers in the same breath of wind and storm: *For the hope of the ungodly is like dust that is blown away with the wind; like a thin froth that is driven away with the storm; ... and passeth away as the remembrance of a guest that tarrieth but a day* (Wisdom of Solomon 5:14). The godless man''s confidence has no anchor before Yahuah; when trouble comes (Job 27:9) it scatters like dust.'),
    -- Thread 3: portion laid up for the just
    ('canon','job',27,17,'canon','proverbs',13,22,'free',
     E'Job''s reckoning — *He may prepare it, but the just shall put it on, and the innocent shall divide the silver* (Job 27:17) — is the proverb''s own verdict: *A good man leaveth an inheritance to his children''s children: and the wealth of the sinner is laid up for the just* (Proverbs 13:22). The oppressor heaps silver as the dust (Job 27:16), but it is only stored up; Yahuah transfers it to the upright in His own time.'),
    ('canon','job',27,17,'canon','ecclesiastes',2,26,'free',
     E'Qoheleth says the same of the sinner''s hoard: *but to the sinner he giveth travail, to gather and to heap up, that he may give to him that is good before Elohim (God)* (Ecclesiastes 2:26). Job''s *the just shall put it on* (Job 27:17) is this very handing-over — the wicked labours, but Elohim (God) assigns the gain to the good, on His timing, not the friends'' mechanical scheme.'),
    ('canon','job',27,16,'apocrypha','ecclesiasticus',11,18,'extras',
     E'Ben Sira draws the same portrait of the man who heaps up silver: *There is that waxeth rich by his wariness and pinching, and this is the portion of his reward: Whereas he says, I have found rest, and now will eat continually of my goods; and yet he knoweth not what time shall come upon him, and that he must leave those things to others, and die* (Ecclesiasticus 11:18-19). Job''s wicked man who *heap[s] up silver as the dust* (Job 27:16) leaves it all behind — the silver passes to others, exactly as Job foretells.'),
    -- Thread 4: terrors take hold; the end of the wicked
    ('canon','job',27,20,'canon','psalms',73,17,'free',
     E'Job''s friends saw the wicked prosper and called him cursed; Job answers that the reckoning is real but on Yahuah''s timing — the truth Asaph found only in the sanctuary: *Until I went into the sanctuary of Elohim (God); then understood I their end* (Psalm 73:17). The *terrors [that] take hold on him as waters* (Job 27:20) are that end, seen by faith and not by the friends'' ledger.'),
    ('canon','job',27,21,'canon','psalms',73,18,'free',
     E'Job says *The east wind carrieth him away, and he departeth: and as a storm hurleth him out of his place* (Job 27:21); Asaph saw the footing give way the same instant: *Surely thou didst set them in slippery places: thou castedst them down into destruction* (Psalm 73:18). The prosperous wicked stands on nothing; the storm of Yahuah hurls him from his place.'),
    ('canon','job',27,19,'canon','psalms',73,19,'free',
     E'*The rich man shall lie down, but he shall not be gathered: he openeth his eyes, and he is not* (Job 27:19) — and Asaph: *How are they brought into desolation, as in a moment! they are utterly consumed with terrors* (Psalm 73:19). The end is sudden and total; the man wakes to find himself swept away, the portion of a wicked man with Elohim (God).'),
    ('canon','job',27,23,'canon','psalms',73,20,'free',
     E'Job''s closing image — *Men shall clap their hands at him, and shall hiss him out of his place* (Job 27:23) — is the dream that vanishes at waking: *As a dream when one awaketh; so, O Yahuah (LORD), when thou awakest, thou shalt despise their image* (Psalm 73:20). When Elohim (God) casts upon the wicked and spares not (Job 27:22), his whole standing is despised and dispersed.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job27_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job27_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- C. threads
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-27-i-hold-fast-mine-integrity', E'I Hold Fast Mine Integrity — the Blameless Walk Yahuah Attested',
  E'Job swears by the living El the oath that frames the whole chapter: *As Elohim (God) liveth, who hath taken away my judgment; and the Almighty, who hath vexed my soul* (Job 27:2). Then the vow: *My lips shall not speak wickedness, nor my tongue utter deceit* (Job 27:4); *till I die I will not remove mine integrity from me* (Job 27:5); *My righteousness I hold fast, and will not let it go: my heart shall not reproach me so long as I live* (Job 27:6). Read through the antichrist lens this sounds like flesh-merit — a man boasting he needs no mercy. It is not. Job is clinging to the very integrity Yahuah (LORD) Himself had twice attested before the accuser: *a perfect and an upright man, one that feareth Elohim (God), and escheweth evil* (Job 1:8); *and still he holdeth fast his integrity* (Job 2:3) — heaven uses Job''s own words. So his refusal to *remove mine integrity* is faithful testimony against the friends'' charge that his suffering proves him a covenant-breaker. David walks the same ground: *Judge me, O Yahuah (LORD); for I have walked in mine integrity: I have trusted also in Yahuah (LORD); therefore I shall not slide* (Psalm 26:1) — integrity submitted to Yahuah''s judgment, never a claim to need no mercy. Wisdom names it the upright''s guide: *The integrity of the upright shall guide them* (Proverbs 11:3). And Sha''ul (Paul) names the discipline that keeps it: *to have always a conscience void of offence toward Elohim (God), and toward men* (Acts 24:16) — the Torah-faithful conscience that does not reproach its keeper. This is the integrity the framework upholds: the genuine blameless walk, distinct from the self-justifying boast.',
  sv.verse_id, ev.verse_id, 'free', 33450
  FROM _s318_job27_lookup sv, _s318_job27_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=27 AND sv.verse_number=2
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=27 AND ev.verse_number=6
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-27-the-hope-of-the-hypocrite', E'What Is the Hope of the Hypocrite — the Godless Without Anchor',
  E'Against his friends'' assumption that the godless can rest secure in his gain, Job asks the question that exposes the hollowness of it: *For what is the hope of the hypocrite, though he hath gained, when Elohim (God) taketh away his soul? Will Elohim (God) hear his cry when trouble cometh upon him? Will he delight himself in the Almighty? will he always call upon Elohim (God)?* (Job 27:8-10). The man who never sought Yahuah in the day of ease has no anchor in the day of trouble; his cry has nowhere to land. The restored wisdom-witness paints exactly this hope dissolving in wind and storm: *For the hope of the ungodly is like dust that is blown away with the wind; like a thin froth that is driven away with the storm; like as the smoke which is dispersed here and there with a tempest, and passeth away as the remembrance of a guest that tarrieth but a day* (Wisdom of Solomon 5:14). The hypocrite''s confidence scatters like dust the moment El takes his soul.',
  sv.verse_id, ev.verse_id, 'extras', 33451
  FROM _s318_job27_lookup sv, _s318_job27_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=27 AND sv.verse_number=8
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=27 AND ev.verse_number=10
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-27-the-portion-laid-up-for-the-just', E'He Heapeth Up Silver, but the Just Shall Put It On',
  E'Job now declares *the portion of a wicked man with Elohim (God), and the heritage of oppressors* (Job 27:13) — affirming, against the friends'' mechanical timetable, that the wicked DO face a reckoning, but on Yahuah''s timing. The oppressor *heap[s] up silver as the dust, and prepare[s] raiment as the clay* (Job 27:16), yet the gain is only stored: *He may prepare it, but the just shall put it on, and the innocent shall divide the silver* (Job 27:17). The same verdict runs through wisdom: *A good man leaveth an inheritance to his children''s children: and the wealth of the sinner is laid up for the just* (Proverbs 13:22); *but to the sinner he giveth travail, to gather and to heap up, that he may give to him that is good before Elohim (God)* (Ecclesiastes 2:26). And Ben Sira draws the same portrait of the hoarder who never reckons his hour: *There is that waxeth rich by his wariness and pinching, and this is the portion of his reward: Whereas he says, I have found rest, and now will eat continually of my goods; and yet he knoweth not what time shall come upon him, and that he must leave those things to others, and die* (Ecclesiasticus 11:18-19). The wicked labours; Yahuah hands the wealth to the upright.',
  sv.verse_id, ev.verse_id, 'extras', 33452
  FROM _s318_job27_lookup sv, _s318_job27_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=27 AND sv.verse_number=13
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=27 AND ev.verse_number=17
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-27-terrors-take-hold-on-the-wicked', E'Terrors Take Hold as Waters — the End of the Wicked on Yahuah''s Timing',
  E'The chapter closes on the sudden, total end of the prosperous wicked: *The rich man shall lie down, but he shall not be gathered: he openeth his eyes, and he is not* (Job 27:19); *Terrors take hold on him as waters, a tempest stealeth him away in the night* (Job 27:20); *The east wind carrieth him away, and he departeth: and as a storm hurleth him out of his place* (Job 27:21); *For Elohim (God) shall cast upon him, and not spare* (Job 27:22); *Men shall clap their hands at him, and shall hiss him out of his place* (Job 27:23). This is Job answering the friends not by denying the reckoning but by setting its timing in Yahuah''s hand — the very truth Asaph could not see until he entered the sanctuary: *Until I went into the sanctuary of Elohim (God); then understood I their end* (Psalm 73:17); *Surely thou didst set them in slippery places: thou castedst them down into destruction* (Psalm 73:18); *How are they brought into desolation, as in a moment! they are utterly consumed with terrors* (Psalm 73:19); *As a dream when one awaketh; so, O Yahuah (LORD), when thou awakest, thou shalt despise their image* (Psalm 73:20). The wicked stands on slippery places; the storm of Yahuah hurls him out, his image despised and dispersed.',
  sv.verse_id, ev.verse_id, 'free', 33453
  FROM _s318_job27_lookup sv, _s318_job27_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=27 AND sv.verse_number=19
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=27 AND ev.verse_number=23
ON CONFLICT (slug) DO NOTHING;

-- D. thread_members
-- Thread 1
INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 1, E'Job 1:8 — Yahuah (LORD) Himself names him *a perfect and an upright man... that feareth Elohim (God)*; the integrity Job holds fast is the one heaven attested.'
  FROM cross_reference_threads t
  JOIN _s318_job27_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=27 AND sv.verse_number=6
  JOIN _s318_job27_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=1 AND tv.verse_number=8
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-27-i-hold-fast-mine-integrity'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 2, E'Job 2:3 — *and still he holdeth fast his integrity*: heaven uses Job''s own words, so 27:6 is testimony, not arrogance.'
  FROM cross_reference_threads t
  JOIN _s318_job27_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=27 AND sv.verse_number=6
  JOIN _s318_job27_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='job' AND tv.chapter_number=2 AND tv.verse_number=3
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-27-i-hold-fast-mine-integrity'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 3, E'Psalm 26:1 — *I have walked in mine integrity... therefore I shall not slide*: the same upright walk submitted to Yahuah''s judgment.'
  FROM cross_reference_threads t
  JOIN _s318_job27_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=27 AND sv.verse_number=5
  JOIN _s318_job27_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='psalms' AND tv.chapter_number=26 AND tv.verse_number=1
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-27-i-hold-fast-mine-integrity'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

INSERT INTO cross_reference_thread_members (thread_id, cross_reference_id, sort_order, member_note)
SELECT t.id, cr.id, 4, E'Proverbs 11:3 — *The integrity of the upright shall guide them*: the very thing Job will not let go.'
  FROM cross_reference_threads t
  JOIN _s318_job27_lookup sv ON sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=27 AND sv.verse_number=6
  JOIN _s318_job27_lookup tv ON tv.edition_slug='canon' AND tv.book_slug='proverbs' AND tv.chapter_number=11 AND tv.verse_number=3
  JOIN cross_references cr ON cr.source_verse_id=sv.verse_id AND cr.target_verse_id=tv.verse_id AND cr.source='manual'
 WHERE t.slug='job-27-i-hold-fast-mine-integrity'
ON CONFLICT (thread_id, cross_reference_id) DO NOTHING;

