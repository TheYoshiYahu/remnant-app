-- ----- fragment: minion_job_28.sql (Job 28) -----
-- Job 28 — THE HYMN TO WISDOM ("Where shall wisdom be found?")
-- tag: job28   session prefix: s318   sort band: 33475 (+1/thread)
-- source book_slug=job, chapter 28
--
-- Job 28 coverage:
--   v.1-11 (man mines the earth for every precious thing):
--        NT:     none warranted (mining frame is setup for v.12 turn)
--        Extras: Baruch 3:17 (hoarded silver/gold) — folded into the not-buyable thread
--        Tanakh: none warranted standalone
--   v.12,20 (but WHERE shall wisdom be found? / Whence then cometh wisdom?):
--        NT:     1 Cor 1:24,30; Col 2:3; James 1:5 (Messiah the wisdom of Elohim; ask of Elohim)
--        Extras: Baruch 3:15 ("Who has found out her place?"); Sirach 1:1 ("All wisdom comes from Yahuah")
--        Tanakh: Prov 8:22-30 (wisdom at creation)
--   v.13-19 (man knoweth not the price; not gotten for gold/silver/Ophir; above rubies):
--        NT:     none warranted (price-language)
--        Extras: Baruch 3:17,30 (silver men trust in; bring her for pure gold) — folded
--        Tanakh: Prov 3:13-18 (more precious than rubies; tree of life)
--   v.23-27 (Elohim knoweth her place; weight for winds, decree for rain — wisdom present at creation):
--        NT:     Col 2:3 (treasures hid in Messiah) — folded to wisdom-found thread
--        Extras: Sirach 1:4 (wisdom created before all things)
--        Tanakh: Prov 8:22-30 (wisdom brought forth before the works of old)
--   v.28 (★ the fear of Yahuah, THAT is wisdom; and to depart from evil is understanding):
--        NT:     none warranted (the OT wisdom-axiom is answered laterally + Eccl)
--        Extras: Sirach 1:14 (folded into creation thread / fear-thread context)
--        Tanakh: Prov 1:7; Prov 9:10; Psalm 111:10; Eccl 12:13 (fear + keep commandments)
--
-- THREADS (5):
--   1. job-28-where-shall-wisdom-be-found-not-minable-not-buyable  [free+extras] v.12-19 → Baruch3:15,17,30 / Sirach1:1 / Prov8:22
--   2. job-28-the-fear-of-yahuah-that-is-wisdom-depart-from-evil    [free]        v.28 → Prov1:7 / Prov9:10 / Ps111:10 / Eccl12:13
--   3. job-28-elohim-knew-her-place-wisdom-present-at-creation      [free+extras] v.23-27 → Prov8:22,25,27,30 / Sirach1:4
--   4. job-28-messiah-the-wisdom-of-elohim-treasures-hid-in-him     [free]        v.12,20 → 1Cor1:24,30 / Col2:3 / James1:5
--   5. job-28-the-price-of-wisdom-is-above-rubies-tree-of-life      [free]        v.15-19 → Prov3:13,15,18
--
-- GUARDS: the fear of Yahuah = wisdom is Torah-grounded — "depart from evil" = the obedient walk
--   (Eccl 12:13 keep his commandments = whole duty; Ps 111:10 do his commandments). The wisdom
--   present BEFORE the works of old (28:25-27 / Prov 8:22-30) is the Formed Son / the expressed
--   Word, the agent of creation who HAS a Father — never a co-equal trinity person, never a
--   created goddess. Messiah "made unto us wisdom" (1 Cor 1:30) is that same Formed Wisdom in flesh.

CREATE TEMP VIEW _s318_job28_lookup AS
SELECT e.slug AS edition_slug, b.slug AS book_slug, c.chapter_number, v.verse_number, v.id AS verse_id
  FROM verses v JOIN chapters c ON v.chapter_id=c.id JOIN books b ON c.book_id=b.id
  JOIN editions e ON b.edition_id=e.id
 WHERE e.slug IN ('canon','enoch','jubilees','jasher','apocrypha','apocrypha-charles-vol1','pseudepigrapha','adam-eve-conflict','apocalypse-of-abraham','ascension-isaiah','sonnini-acts-29');

-- ============================================================ cross_references
INSERT INTO cross_references (source_verse_id, target_verse_id, source, note, tier_required)
SELECT sv.verse_id, tv.verse_id, 'manual', i.note, i.tier::content_tier
  FROM (VALUES
   -- THREAD 1: where shall wisdom be found — not minable, not buyable
   ('canon','job',28,12,
    'apocrypha','baruch-with-the-letter-of-jeremiah',3,15,'extras',
    E'Baruch hears Job''s very question and presses it: *Who has found out her place? or who has come into her treasures?* (Baruch 3:15). Job had cried *But where shall wisdom be found? and where is the place of understanding?* (Job 28:12) — and this restored witness in the wisdom-tradition is a near-paraphrase of the whole chapter, ransacking the earth, the sea, and the heathen princes and finding wisdom in none of them, until the answer comes home to Elohim alone.'),
   ('canon','job',28,17,
    'apocrypha','baruch-with-the-letter-of-jeremiah',3,17,'extras',
    E'Of the gold-hoarders Baruch asks *...they that hoarded up silver and gold, in which men trust, and made no end of their getting?* — and answers that they vanished and went down to the grave (Baruch 3:17-19). It is Job''s verdict exactly: *The gold and the crystal cannot equal it... the price of wisdom is above rubies* (Job 28:17-18). The thing men trust to buy everything cannot buy her.'),
   ('canon','job',28,19,
    'apocrypha','baruch-with-the-letter-of-jeremiah',3,30,'extras',
    E'*Who has gone over the sea, and found her, and will bring her for pure gold?* (Baruch 3:30) — no one. Job had already weighed her against *pure gold* and *the topaz of Ethiopia* and found gold wanting: *neither shall it be valued with pure gold* (Job 28:19). Wisdom is not an article of trade; she is given, not bought.'),
   ('canon','job',28,12,
    'apocrypha','ecclesiasticus',1,1,'extras',
    E'Ben Sira opens his whole book on Job''s answer: *All wisdom comes from Yahuah (God), and is with him for ever* (Sirach 1:1). Job asked *where shall wisdom be found?* (Job 28:12); the wisdom-tradition replies in one line — her source and her home are with Yahuah, and from no mine, market, or sea is she dug or bought.'),
   ('canon','job',28,20,
    'canon','proverbs',8,22,'free',
    E'Wisdom herself answers Job''s repeated cry *Whence then cometh wisdom?* (Job 28:20): *Yahuah (LORD) possessed me in the beginning of his way, before his works of old* (Proverbs 8:22). She is no buried ore but the firstborn of Yahuah''s way — brought forth before the earth was, the Formed Word who was *by him, as one brought up with him* (Proverbs 8:30), and who has a Father.'),

   -- THREAD 2: the fear of Yahuah, THAT is wisdom
   ('canon','job',28,28,
    'canon','proverbs',1,7,'free',
    E'Job''s climax becomes the cornerstone of all wisdom-literature: *The fear of Yahuah (LORD) is the beginning of knowledge: but fools despise wisdom and instruction* (Proverbs 1:7). What Elohim declared to man — *Behold, the fear of Yahuah (Lord), that is wisdom* (Job 28:28) — Solomon sets as the doorway: there is no knowledge that does not begin in reverent obedience to Yahuah.'),
   ('canon','job',28,28,
    'canon','proverbs',9,10,'free',
    E'*The fear of Yahuah (LORD) is the beginning of wisdom: and the knowledge of the holy is understanding* (Proverbs 9:10). It is Job 28:28 set as a refrain — *the fear of Yahuah, that is wisdom; and to depart from evil is understanding* — the two halves matched: to fear is wisdom, to know the Holy One (and so depart from evil) is understanding.'),
   ('canon','job',28,28,
    'canon','psalms',111,10,'free',
    E'The Psalmist seals the same axiom and shows what *depart from evil* means: *The fear of Yahuah (LORD) is the beginning of wisdom: a good understanding have all they that do his commandments: his praise endureth for ever* (Psalm 111:10). Departing from evil (Job 28:28) is not vague piety but the obedient walk — *all they that do his commandments* — the Torah kept, never abolished.'),
   ('canon','job',28,28,
    'canon','ecclesiastes',12,13,'free',
    E'Qoheleth gathers the whole of life into Job''s single sentence: *Let us hear the conclusion of the whole matter: Fear Elohim (God), and keep his commandments: for this is the whole duty of man* (Ecclesiastes 12:13). To fear Yahuah (Job 28:28) and to *depart from evil* is precisely to keep his commandments — the fear and the obedience are one thing, the whole duty of man.'),

   -- THREAD 3: Elohim knew her place — wisdom present at creation
   ('canon','job',28,25,
    'canon','proverbs',8,25,'free',
    E'Job marvels that Elohim made wisdom''s creation-order — *To make the weight for the winds; and he weigheth the waters by measure* (Job 28:25). Wisdom was there to see it: *Before the mountains were settled, before the hills was I brought forth* (Proverbs 8:25). The measured winds and weighed waters were not blind force; they were laid by the Formed Wisdom brought forth before the hills.'),
   ('canon','job',28,26,
    'canon','proverbs',8,27,'free',
    E'*When he made a decree for the rain, and a way for the lightning of the thunder* (Job 28:26) — and Wisdom answers, *When he prepared the heavens, I was there: when he set a compass upon the face of the depth* (Proverbs 8:27). The decree for the rain and the compass on the deep are the same act seen from two sides: Yahuah ordering creation, the Formed Word present and rejoicing as the agent of it.'),
   ('canon','job',28,27,
    'canon','proverbs',8,30,'free',
    E'*Then did he see it, and declare it; he prepared it, yea, and searched it out* (Job 28:27) — Elohim seeing, declaring, preparing wisdom at the founding of the world. Proverbs names the One beside him: *Then I was by him, as one brought up with him: and I was daily his delight, rejoicing always before him* (Proverbs 8:30) — the Formed Son, Yahuah''s delight, who has a Father and is the agent of the work.'),
   ('canon','job',28,27,
    'apocrypha','ecclesiasticus',1,4,'extras',
    E'The wisdom-tradition confesses what Job glimpses: *Wisdom has been created before all things, and the understanding of prudence from everlasting* (Sirach 1:4). When Elohim *prepared it, yea, and searched it out* (Job 28:27), wisdom was already brought forth — not a thing dug from the earth in time, but with Yahuah from everlasting, the firstborn of his way.'),

   -- THREAD 4: Messiah the wisdom of Elohim
   ('canon','job',28,12,
    'canon','1-corinthians',1,24,'free',
    E'The place Job could not find, the New Covenant names a Person: *Messiah (Christ) the power of Elohim (God), and the wisdom of Elohim (God)* (1 Corinthians 1:24). Job asked *where shall wisdom be found?* (Job 28:12); she is found not in a mine but in the Formed Son made flesh — the very Wisdom of Proverbs 8 standing among men.'),
   ('canon','job',28,12,
    'canon','1-corinthians',1,30,'free',
    E'*But of him are ye in HaMashiach Yahusha (Christ Jesus), who of Elohim (God) is made unto us wisdom, and righteousness, and sanctification, and redemption* (1 Corinthians 1:30). The wisdom Job could not buy with the gold of Ophir is *made unto us* — given, not purchased — in Messiah; the answer to *where shall wisdom be found?* (Job 28:12) is a gift in the Son who has a Father.'),
   ('canon','job',28,20,
    'canon','colossians',2,3,'free',
    E'Job searched the depth and the sea and could not find her; the treasure was hidden in another place entirely: *In whom are hid all the treasures of wisdom and knowledge* (Colossians 2:3). *Whence then cometh wisdom?* (Job 28:20) — from Messiah, in whom the whole hoard the miners of verse 1-11 dug for in vain lies hid and freely opened.'),
   ('canon','job',28,20,
    'canon','james',1,5,'free',
    E'And the way to her is not the pickaxe but the prayer: *If any of you lack wisdom, let him ask of Elohim (God), that giveth to all men liberally, and upbraideth not; and it shall be given him* (James 1:5). Job''s unanswerable *whence then cometh wisdom?* (Job 28:20) is answered by the open hand of Elohim — she is asked for and given, exactly as Job 28:23 says he alone *knoweth the place thereof*.'),

   -- THREAD 5: the price of wisdom is above rubies — tree of life
   ('canon','job',28,15,
    'canon','proverbs',3,13,'free',
    E'What cannot be bought can yet be found by the man who seeks her rightly: *Happy is the man that findeth wisdom, and the man that getteth understanding* (Proverbs 3:13). Job says *It cannot be gotten for gold* (Job 28:15) — not with silver, but the seeker who fears Yahuah is called blessed, for he gains what no merchandise can purchase.'),
   ('canon','job',28,18,
    'canon','proverbs',3,15,'free',
    E'Job and Solomon weigh wisdom in the same scales: *for the price of wisdom is above rubies* (Job 28:18); *She is more precious than rubies: and all the things thou canst desire are not to be compared unto her* (Proverbs 3:15). Above coral, pearls, and rubies — she outweighs every desirable thing the earth can yield.'),
   ('canon','job',28,19,
    'canon','proverbs',3,18,'free',
    E'Beyond the topaz and the pure gold Job names (Job 28:19) lies what gold can never be: *She is a tree of life to them that lay hold upon her: and happy is every one that retaineth her* (Proverbs 3:18). The wisdom no mine yields is the tree of life of Eden restored — life itself, not merely treasure — to the man who lays hold and keeps her.')
  ) AS i(src_edition,src_slug,src_ch,src_v,tgt_edition,tgt_slug,tgt_ch,tgt_v,tier,note)
  JOIN _s318_job28_lookup sv ON sv.edition_slug=i.src_edition AND sv.book_slug=i.src_slug AND sv.chapter_number=i.src_ch AND sv.verse_number=i.src_v
  JOIN _s318_job28_lookup tv ON tv.edition_slug=i.tgt_edition AND tv.book_slug=i.tgt_slug AND tv.chapter_number=i.tgt_ch AND tv.verse_number=i.tgt_v
 WHERE sv.verse_id <> tv.verse_id
ON CONFLICT (source_verse_id, target_verse_id, source) DO NOTHING;

-- ============================================================ threads
INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-28-where-shall-wisdom-be-found-not-minable-not-buyable',
  E'But Where Shall Wisdom Be Found? — Not Minable, Not Buyable',
  E'Job has just watched man tear the earth open for every buried treasure — *Surely there is a vein for the silver, and a place for gold... Iron is taken out of the earth, and brass is molten out of the stone* (Job 28:1-2) — sinking shafts where no fowl or lion has trod, *and his eye seeth every precious thing* (28:10). Then the turn that names the whole chapter: *But where shall wisdom be found? and where is the place of understanding?* (Job 28:12), repeated at *Whence then cometh wisdom?* (28:20). And the verdict: *Man knoweth not the price thereof; neither is it found in the land of the living. The depth saith, It is not in me: and the sea saith, It is not with me* (28:13-14). She cannot be dug and she cannot be bought: *It cannot be gotten for gold, neither shall silver be weighed for the price thereof... the price of wisdom is above rubies* (28:15,18).\n\nThe restored wisdom-tradition takes up Job''s very words. Baruch is almost a paraphrase of this chapter: *Who has found out her place? or who has come into her treasures?* (Baruch 3:15) — ransacking the silver-hoarders *in which men trust* (3:17), the merchants, the heathen princes, and finding wisdom in none, asking at last *Who has gone over the sea, and found her, and will bring her for pure gold?* (3:30) — and answering that only Yahuah *has found out all the way of knowledge, and has given it to Jacob his servant, and to Yashar''el (Israel) his beloved* (3:36). Ben Sira opens his whole book on the same note: *All wisdom comes from Yahuah (God), and is with him for ever* (Sirach 1:1). And Wisdom herself, in Proverbs, lifts the curtain on where she dwelt all along: *Yahuah (LORD) possessed me in the beginning of his way, before his works of old* (Proverbs 8:22) — not buried ore but the firstborn of Yahuah''s way, the Formed Word brought forth before the earth was. She is never mined or marketed; she is given to those who fear him.',
  sv.verse_id, ev.verse_id, 'extras', 33475
  FROM _s318_job28_lookup sv, _s318_job28_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=28 AND sv.verse_number=12
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=28 AND ev.verse_number=20
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-28-the-fear-of-yahuah-that-is-wisdom-depart-from-evil',
  E'The Fear of Yahuah, That Is Wisdom — and to Depart from Evil Is Understanding',
  E'After the whole hymn has searched the mine, the sea, the depth, and the air and found wisdom in none of them, Elohim gives the answer to man directly: *And unto man he said, Behold, the fear of Yahuah (Lord), that is wisdom; and to depart from evil is understanding* (Job 28:28). This single verse becomes the cornerstone of all the wisdom-books. Solomon sets it as the very doorway of knowledge: *The fear of Yahuah (LORD) is the beginning of knowledge: but fools despise wisdom and instruction* (Proverbs 1:7), and again as a refrain: *The fear of Yahuah (LORD) is the beginning of wisdom: and the knowledge of the holy is understanding* (Proverbs 9:10).\n\nAnd lest *depart from evil* be softened into a vague, lawless piety, the Psalmist defines it exactly: *The fear of Yahuah (LORD) is the beginning of wisdom: a good understanding have all they that do his commandments: his praise endureth for ever* (Psalm 111:10). To depart from evil is to *do his commandments* — the Torah kept, not the Torah abolished. Qoheleth gathers all of life into the same word: *Let us hear the conclusion of the whole matter: Fear Elohim (God), and keep his commandments: for this is the whole duty of man* (Ecclesiastes 12:13). The fear of Yahuah and obedience to his commandments are one and the same wisdom — the whole duty of man, and the only place wisdom is ever found.',
  sv.verse_id, ev.verse_id, 'free', 33476
  FROM _s318_job28_lookup sv, _s318_job28_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=28 AND sv.verse_number=28
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=28 AND ev.verse_number=28
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-28-elohim-knew-her-place-wisdom-present-at-creation',
  E'Elohim Knoweth Her Place — Wisdom Present at Creation',
  E'Where man''s deepest shaft cannot reach, Elohim alone has the map: *Elohim (God) understandeth the way thereof, and he knoweth the place thereof. For he looketh to the ends of the earth, and seeth under the whole heaven* (Job 28:23-24). And the proof that he knows her place is that he was wielding her when he set the world in order: *To make the weight for the winds; and he weigheth the waters by measure. When he made a decree for the rain, and a way for the lightning of the thunder: Then did he see it, and declare it; he prepared it, yea, and searched it out* (Job 28:25-27).\n\nProverbs lets that same Wisdom speak from inside the act: *Before the mountains were settled, before the hills was I brought forth* (Proverbs 8:25); *When he prepared the heavens, I was there: when he set a compass upon the face of the depth* (8:27); *Then I was by him, as one brought up with him: and I was daily his delight, rejoicing always before him* (8:30). The measured winds, the weighed waters, the decree for the rain are not blind force — they are laid by the Formed Wisdom, the expressed Word brought forth before the works of old, the agent of creation who is Yahuah''s daily delight and who has a Father. The wisdom-tradition confesses the same: *Wisdom has been created before all things, and the understanding of prudence from everlasting* (Sirach 1:4). She was never dug out of the earth in time; she was with Yahuah from everlasting — the firstborn of his way, not a created goddess and not a co-equal rival to the Most High, but the Formed Son who would one day take flesh.',
  sv.verse_id, ev.verse_id, 'extras', 33477
  FROM _s318_job28_lookup sv, _s318_job28_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=28 AND sv.verse_number=23
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=28 AND ev.verse_number=27
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-28-messiah-the-wisdom-of-elohim-treasures-hid-in-him',
  E'Messiah the Wisdom of Elohim — All the Treasures Hid in Him',
  E'Job''s twice-asked cry — *where shall wisdom be found?* (Job 28:12), *whence then cometh wisdom?* (28:20) — hangs over the whole chapter unanswered by any mine, market, or sea. The New Covenant answers it not with a place but with a Person. *Messiah (Christ) the power of Elohim (God), and the wisdom of Elohim (God)* (1 Corinthians 1:24): the very Wisdom of Proverbs 8, brought forth before the works of old, has stepped into flesh. And she comes not as a purchase but as a gift — *But of him are ye in HaMashiach Yahusha (Christ Jesus), who of Elohim (God) is made unto us wisdom, and righteousness, and sanctification, and redemption* (1 Corinthians 1:30). The wisdom Job could not buy *for the gold of Ophir* (28:16) is *made unto us*, freely, in the Son who has a Father.\n\nThe treasure the miners of verses 1-11 tore the earth for in vain lies hid in another place entirely: *In whom are hid all the treasures of wisdom and knowledge* (Colossians 2:3). And the way to her is not the pickaxe but the open hand: *If any of you lack wisdom, let him ask of Elohim (God), that giveth to all men liberally, and upbraideth not; and it shall be given him* (James 1:5). What Job 28:23 declared — that Elohim alone *knoweth the place thereof* — the gospel makes a gift: ask, and the place is Messiah, in whom the whole hoard is freely opened.',
  sv.verse_id, ev.verse_id, 'free', 33478
  FROM _s318_job28_lookup sv, _s318_job28_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=28 AND sv.verse_number=12
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=28 AND ev.verse_number=20
ON CONFLICT (slug) DO NOTHING;

INSERT INTO cross_reference_threads (slug, title, summary_md, anchor_verse_id_start, anchor_verse_id_end, tier_required, sort_order)
SELECT 'job-28-the-price-of-wisdom-is-above-rubies-tree-of-life',
  E'The Price of Wisdom Is Above Rubies — and a Tree of Life',
  E'Job lays out the whole treasury of the earth and finds it all too cheap: *It cannot be gotten for gold, neither shall silver be weighed for the price thereof. It cannot be valued with the gold of Ophir, with the precious onyx, or the sapphire... No mention shall be made of coral, or of pearls: for the price of wisdom is above rubies. The topaz of Ethiopia shall not equal it, neither shall it be valued with pure gold* (Job 28:15-19). Solomon weighs her in the same scales and draws out what Job leaves implicit — that the man who finds what gold cannot buy is blessed: *Happy is the man that findeth wisdom, and the man that getteth understanding* (Proverbs 3:13); *She is more precious than rubies: and all the things thou canst desire are not to be compared unto her* (3:15).\n\nAnd then Proverbs names what wisdom actually is, beyond all the topaz and pure gold Job had measured her against: *She is a tree of life to them that lay hold upon her: and happy is every one that retaineth her* (Proverbs 3:18). The wisdom no mine yields and no silver buys is the tree of life of Eden restored — life itself, not merely treasure — laid hold of by the man who fears Yahuah and keeps her.',
  sv.verse_id, ev.verse_id, 'free', 33479
  FROM _s318_job28_lookup sv, _s318_job28_lookup ev
 WHERE sv.edition_slug='canon' AND sv.book_slug='job' AND sv.chapter_number=28 AND sv.verse_number=15
   AND ev.edition_slug='canon' AND ev.book_slug='job' AND ev.chapter_number=28 AND ev.verse_number=19
ON CONFLICT (slug) DO NOTHING;

